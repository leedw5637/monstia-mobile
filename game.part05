"};

const BGM_GAIN = {
  title:1.38, wild_battle:0.90,
  legend_eldrief:0.78, legend_blazien:0.86, legend_aquarex:0.75,
  legend_tempest:0.80, legend_akrai:0.88, legend_zerkaon:0.88,
  blackmoon_city:0.80, rift_citadel:0.72,
  interior_calm:0.82, shop_bright:0.80, bank_calm:0.78, casino_neon:0.72,
  region_grass:0.82, region_moonstone:0.80, region_harbor:0.82,
  region_snow:0.80, region_thunder:0.78, region_astral:0.80,
  region_dawn:0.82, region_emerald:0.82,
  gym_interior:0.78, trainer_battle:0.84, gym_battle:0.82,
  mythical_battle:0.80, field_boss:0.82, tower_battle:0.82,
};

class MusicManager {
  constructor(data) {
    this.data=data; this.master=0.34; this.enabled=true; this.unlocked=false;
    this.requestedKey=null; this.currentKey=null; this.active=0; this.raf=0;
    this.channels=[new Audio(),new Audio()];
    for (const a of this.channels) { a.loop=true; a.preload='auto'; a.volume=0; }
    const wake=()=>this.unlock();
    window.addEventListener('pointerdown',wake,{once:true,passive:true});
    window.addEventListener('keydown',wake,{once:true});
    window.addEventListener('touchstart',wake,{once:true,passive:true});
    document.addEventListener('visibilitychange',()=>{
      if (document.hidden) this.pauseAll();
      else if (this.enabled && this.requestedKey) this.play(this.requestedKey,true);
    });
  }
  syncSetting(game) {
    const on = game?.state?.settings?.music !== false;
    if (on !== this.enabled) this.setEnabled(on);
  }
  unlock() {
    this.unlocked=true;
    if (this.enabled && this.requestedKey) this.play(this.requestedKey,true);
  }
  setEnabled(on) {
    this.enabled=!!on;
    if (!this.enabled) { this.pauseAll(); return; }
    if (this.requestedKey) this.play(this.requestedKey,true);
  }
  pauseAll() {
    cancelAnimationFrame(this.raf);
    for (const a of this.channels) { try { a.pause(); } catch {} a.volume=0; }
    this.currentKey=null;
  }
  play(key, force=false) {
    if (!key || !this.data[key]) return;
    this.requestedKey=key;
    if (!this.enabled || !this.unlocked) return;
    if (!force && this.currentKey===key && !this.channels[this.active].paused) return;
    const old=this.channels[this.active];
    const nextIndex=1-this.active, next=this.channels[nextIndex];
    cancelAnimationFrame(this.raf);
    try { next.pause(); next.currentTime=0; } catch {}
    next.src=this.data[key]; next.loop=true; next.volume=0;
    const target=Math.min(1,this.master*(BGM_GAIN[key]||0.82));
    const started=performance.now(), fadeMs=720;
    const p=next.play(); if (p && p.catch) p.catch(()=>{});
    this.currentKey=key; this.active=nextIndex;
    const oldStart=old.volume||0;
    const step=(now)=>{
      const q=Math.min(1,(now-started)/fadeMs);
      next.volume=target*q; old.volume=oldStart*(1-q);
      if(q<1) this.raf=requestAnimationFrame(step);
      else { try { old.pause(); old.currentTime=0; } catch {} old.volume=0; }
    };
    this.raf=requestAnimationFrame(step);
  }
  playForMap(mapId,map) {
    const id=String(mapId||''), name=String(map?.name||'');
    let key='region_grass';
    if (/은행/.test(name) || /^bank\d*$/.test(id)) key='bank_calm';
    else if (/카지노/.test(name) || /^casino\d*$/.test(id)) key='casino_neon';
    else if (map?.areaType==='gym' || /^gym\d*$/.test(id)) key='gym_interior';
    else if (/^shop\d*$/.test(id)) key='shop_bright';
    else if (id==='home' || id==='lab' || /^center\d*$/.test(id) || map?.indoor) key='interior_calm';
    else if (/흑월도시|흑월/.test(name) || /^(town09|route09a|route09b)$/.test(id)) key='blackmoon_city';
    else if (/균열성채|균열|차원/.test(name) || /^(town10|route10a|route10b|hidden_void_v100)$/.test(id)) key='rift_citadel';
    else if (/청록마을|청록|대지협곡/.test(name) || /^(town08|route08a|route08b)$/.test(id)) key='region_emerald';
    else if (/^(town02|cave01|route02|route02b|route02c|backroad02|hidden_fire)$/.test(id)) key='region_moonstone';
    else if (/^(town03|route03|route03b|route03c|sunset_alley|backroad03|hidden_water)$/.test(id)) key='region_harbor';
    else if (/^(town04|route04|route04b|route04c|backroad04|hidden_wind)$/.test(id)) key='region_snow';
    else if (/^(town05|route05a|route05b|backroad05|hidden_thunder)$/.test(id)) key='region_thunder';
    else if (/^(town06|route06a|route06b|backroad06)$/.test(id)) key='region_astral';
    else if (/^(town07|route07a|route07b|backroad07)$/.test(id)) key='region_dawn';
    this.play(key);
  }
  battleKey(enemy,opts={}) {
    const sp=MONSTERS[enemy?.id]||{}, name=String(sp.name||'');
    if (/엘드리프/.test(name)) return 'legend_eldrief';
    if (/블레이젠/.test(name)) return 'legend_blazien';
    if (/아쿠아렉스|아쿠라렉스/.test(name)) return 'legend_aquarex';
    if (/템페스트|템페스토/.test(name)) return 'legend_tempest';
    if (/아크라이/.test(name)) return 'legend_akrai';
    if (/제르카온/.test(name)) return 'legend_zerkaon';
    if (opts.trainer?.tower) return 'tower_battle';
    if (opts.trainer?.gym) return 'gym_battle';
    if (opts.trainer) return 'trainer_battle';
    if (sp.mythical) return 'mythical_battle';
    if (opts.fieldBoss || opts.elite) return 'field_boss';
    if (opts.legendary || sp.legendary) return 'field_boss';
    return 'wild_battle';
  }
  playBattle(enemy,opts={}) { this.play(this.battleKey(enemy,opts)); }
}
const music = new MusicManager(BGM_DATA);

// Final v1.0.3 prototypes are already installed above; wrap them without removing any gameplay logic.
const _bgmWorldLoad = World.prototype.load;
World.prototype.load = function(mapId,x,y,dir='down') {
  const result=_bgmWorldLoad.call(this,mapId,x,y,dir);
  music.syncSetting(this.game); music.playForMap(this.mapId,this.map);
  return result;
};

const _bgmTrainerBattle = Game.prototype.startTrainerBattle;
Game.prototype.startTrainerBattle = function(npc,isRematch=false) {
  if (this.state.party.some(m=>m.hp>0)) {
    music.syncSetting(this);
    music.play(npc?.trainer?.gym ? 'gym_battle' : 'trainer_battle');
  }
  return _bgmTrainerBattle.call(this,npc,isRematch);
};

const _bgmWildBattle = Game.prototype.startWildBattle;
Game.prototype.startWildBattle = function(table,opts={}) {
  // Capture the exact enemy selected by the untouched v1.0.3 encounter routine.
  const originalRoll=rollFromTable;
  let selected=null;
  rollFromTable=function(...args){ selected=originalRoll(...args); return selected; };
  try {
    const out=_bgmWildBattle.call(this,table,opts);
    if(selected){ music.syncSetting(this); music.playBattle(selected,opts); }
    return out;
  } finally { rollFromTable=originalRoll; }
};

const _bgmTowerFloor = Game.prototype.startTowerFloor;
Game.prototype.startTowerFloor = function(floor) {
  if (this.state.party.some(m=>m.hp>0)) { music.syncSetting(this); music.play('tower_battle'); }
  return _bgmTowerFloor.call(this,floor);
};

const _bgmEndBattle = Game.prototype.endBattle;
Game.prototype.endBattle = function(result) {
  const out=_bgmEndBattle.call(this,result);
  setTimeout(()=>{
    if(this.mode==='field' && this.world?.map) {
      music.syncSetting(this); music.playForMap(this.world.mapId,this.world.map);
    }
  },620);
  return out;
};

const _bgmReturnTitle = Game.prototype.returnToTitle;
Game.prototype.returnToTitle = function() {
  const out=_bgmReturnTitle.call(this);
  music.syncSetting(this); music.play('title');
  return out;
};

const _bgmLoadingUpdate = LoadingScene.prototype.update;
LoadingScene.prototype.update = function(dt,game) {
  const before=game.mode, out=_bgmLoadingUpdate.call(this,dt,game);
  if(before!=='title' && game.mode==='title') { music.syncSetting(game); music.play('title'); }
  return out;
};
/* ======================== MONSTIA v1.0.4 BGM SYSTEM END ======================== */

const game = new Game(root);

input.attach(root);

const chat = new CheatConsole(game);
chat.attach(root);
game.chat = chat;
game.fit();
game.start();
music.syncSetting(game);
music.play('title');
// v1.0.0: 클라우드 세션만 초기화한다. 자동 저장/자동 불러오기는 하지 않는다.
cloud.init(game);

const refit = () => game.fit();
window.addEventListener('resize', refit);
window.addEventListener('orientationchange', () => setTimeout(refit, 120));
if (window.visualViewport) window.visualViewport.addEventListener('resize', refit);

// 오디오는 첫 사용자 입력에서 깨어난다 (모바일 브라우저 정책)
const wake = () => { sfx.ensure(); music.unlock(); };
window.addEventListener('pointerdown', wake, { once: true });
window.addEventListener('keydown', wake, { once: true });

// 디버그용
window.MONSTIA = game;
window.CHAT = chat;

</script>
</body>
</html>
