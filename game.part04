MAPS.town08={areaType:'town',bgColor:'#315c62',name:'청록마을',
 grid:[
  '###########--###########','##...~~~~...--...~~~~...##','##...~~~~...--...~~~~...##','##.........----.........##',
  '##.........----.........##','##....===...--...===....##','##....~~~...--...~~~....##','##....~~~...--...~~~....##',
  '##.........----.........##','##----------------------##','##.........----.........##','##..~~~....----....~~~..##',
  '##..~~~....----....~~~..##','##..===....----....===..##','##.........----.........##','##....,,...----...,,....##',
  '##.........----.........##','##..........--..........##','###########--###########'],
 objects:[
  {kind:'building',style:'center',x:2,y:4,w:5,h:4,door:4},{kind:'building',style:'shop',x:17,y:4,w:5,h:4,door:19},
  {kind:'building',style:'gym',x:2,y:11,w:5,h:4,door:4},{kind:'building',style:'house',x:17,y:11,w:5,h:4,door:19},
  {kind:'sign',x:10,y:3,solid:true,text:['청록마을 · 수로정원','산에서 내려온 물길이 마을 네 갈래 운하로 흐르는 수향 마을이다.']},
  {kind:'sign',x:15,y:13,solid:true,text:['MONSTIA BANK →','예금에는 시간당 이자가 붙는다.']},
  {kind:'bench',x:8,y:15,w:2,h:1,solid:true,text:['물소리를 들으며 쉬는 돌벤치다.']},{kind:'well',x:13,y:15,w:2,h:2,solid:true,text:['수로의 수위를 조절하는 오래된 수문 장치다.']}
 ],
 npcs:[
  {id:'basin_ecologist',name:'운하 생태원',x:8,y:6,dir:'right',palette:'researcher',quest:'q_basin_water',lines:['수로에 처음 보는 물결 흔적이 남았어.','청록초원의 수생 몬스터를 조사하고 있어.']},
  {id:'basin_mason',name:'석공 장인',x:14,y:6,dir:'left',palette:'hiker',quest:'q_basin_earth',lines:['이 마을 돌담은 대지협곡에서 가져온 돌로 쌓았지.','요즘 밤마다 누가 돌담을 긁고 가는군.']},
  {id:'basin_scholar',name:'고문서 연구가',x:8,y:12,dir:'right',palette:'prof',quest:'q_basin_key',lines:['옛 지도에 열쇠 모양이 하나 표시되어 있어.','그 표식은 북쪽 협곡을 가리키고 있지.']},
  {id:'basin_fisher',name:'수로 낚시꾼',x:14,y:12,dir:'left',palette:'villagerA',lines:['여긴 바다가 아니야. 산에서 내려온 맑은 물이지.','가끔 파란 지느러미가 수면을 가르고 지나가.']},
  {id:'basin_child',name:'물레방아 꼬마',x:10,y:16,dir:'down',palette:'kid',lines:['다리 아래로 동전 던지면 안 돼!','은행에 가져가야지!']},
  {id:'basin_traveler',name:'순례 여행자',x:19,y:16,dir:'left',palette:'villagerB',lines:['성운이나 뇌광마을과는 분위기가 완전히 다르네.','여긴 물소리 때문에 밤에도 마음이 편해.']}
 ],
 warps:[{x:11,y:18,to:'route07b',tx:8,ty:1,dir:'down'},{x:12,y:18,to:'route07b',tx:9,ty:1,dir:'down'},{x:11,y:0,to:'route08a',tx:8,ty:18,dir:'up'},{x:12,y:0,to:'route08a',tx:9,ty:18,dir:'up'},
  {x:4,y:7,to:'center8',tx:5,ty:6,dir:'up'},{x:19,y:7,to:'shop8',tx:4,ty:6,dir:'up'},{x:4,y:14,to:'gym8',tx:5,ty:6,dir:'up'},{x:19,y:14,to:'bank8',tx:5,ty:6,dir:'up'}]};

