  '%%RRRRRRR----RRRRRRR%%','%%--------------------%%','%%RRRRRRR----RRRRRRR%%','%%^R-----R^--^R-----R^%%',
  '%%^R-----R^--^R-----R^%%','%%^RRRRRRR^--^RRRRRRR^%%','%%^^^^^^^^^--^^^^^^^^^%%','%%^^RRR^^^^--^^^^RRR^^%%',
  '%%^^RRR^^^^--^^^^RRR^^%%','%%^^^^^^^^^^--^^^^^^^^^^%%','%%%%%%%%%%%--%%%%%%%%%%%'],
 objects:[
  {kind:'building',style:'center',x:2,y:4,w:5,h:4,door:4},{kind:'building',style:'shop',x:17,y:4,w:5,h:4,door:19},
  {kind:'building',style:'gym',x:2,y:11,w:5,h:4,door:4},{kind:'building',style:'lab',x:17,y:11,w:5,h:4,door:19},
  {kind:'sign',x:10,y:3,solid:true,text:['균열성채 · 경계요새','고대 석벽과 연구시설이 합쳐진 최전방 요새. 뇌광마을의 전기 도시와는 전혀 다른 성채 구조다.']},
  {kind:'sign',x:14,y:12,solid:true,text:['차원 관측소 →','마지막 사냥터의 공간 좌표는 약 5분마다 다시 계산된다.']},
  {kind:'shrine_pillar',x:8,y:15,w:1,h:2,solid:true},{kind:'shrine_pillar',x:15,y:15,w:1,h:2,solid:true}
 ],
 npcs:[
  {id:'rift_ice_research',name:'빙결 관측원',x:8,y:6,dir:'right',palette:'researcher',quest:'q_rift_ice',lines:['균열 주변 온도가 순간적으로 영하 수십 도까지 떨어져.','프리오의 결정과 비슷한 파형이야.']},
  {id:'rift_electric_tech',name:'전격 기술자',x:14,y:6,dir:'left',palette:'villagerA',quest:'q_rift_electric',lines:['번개가 치는 게 아니라 좌표 자체가 방전하고 있어.','스파키의 전류와 비교해 보면 답이 나올 거야.']},
  {id:'rift_scientist',name:'차원 연구원',x:8,y:12,dir:'right',palette:'prof',quest:'q_rift_keys',lines:['세 봉인의 열쇠가 동시에 있어야 문이 안정돼.','문 자체는 열쇠가 없어도 발견할 수 있어. 들어갈 수 없을 뿐이지.']},
  {id:'rift_soldier',name:'성채 경비병',x:14,y:12,dir:'left',palette:'ranger',lines:['북쪽은 민간인이 오래 머물 곳이 아니야.','그래도 네가 열 개 증표를 노린다면 관장부터 만나 봐.']},
  {id:'rift_archivist',name:'기록 보관관',x:10,y:16,dir:'down',palette:'villagerB',lines:['이 성채는 번개를 숭배하지 않아.','공간이 찢어지는 현상을 막기 위해 세워졌지.']},
  {id:'rift_scout',name:'균열 정찰대',x:18,y:16,dir:'left',palette:'hiker',lines:['차원의 문 위치를 외워 두지 마. 5분이면 다른 곳으로 가 버리니까.']}
 ],
 warps:[{x:11,y:18,to:'route09b',tx:8,ty:1,dir:'down'},{x:12,y:18,to:'route09b',tx:9,ty:1,dir:'down'},{x:11,y:0,to:'route10a',tx:8,ty:18,dir:'up'},{x:12,y:0,to:'route10a',tx:9,ty:18,dir:'up'},
  {x:4,y:7,to:'center10',tx:5,ty:6,dir:'up'},{x:19,y:7,to:'shop10',tx:4,ty:6,dir:'up'},{x:4,y:14,to:'gym10',tx:5,ty:6,dir:'up'},{x:19,y:14,to:'research10',tx:5,ty:6,dir:'up'}]};

