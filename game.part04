MAPS.town10={areaType:'town',bgColor:'#24252a',name:'균열성채',
 grid:[
  '%%%%%%%%%%%--%%%%%%%%%%%','%%^^^^^^^^^--^^^^^^^^^%%','%%^RRRRRRR^--^RRRRRRR^%%','%%^R-----R^--^R-----R^%%',
