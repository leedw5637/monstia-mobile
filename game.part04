const V100_GYM_GRID=['XXXXXXXXXXX','XgggggggggX','XggaaaaaggX','XggaaaaaggX','XggaaaaaggX','XggggaggggX','XggggaggggX','XggggDDgggX','XXXXXXXXXXX'];
