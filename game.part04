 {id:'gym10_trainer',name:'성채 수련생',x:3,y:4,dir:'down',palette:'ranger',trainer:{party:[{id:77,level:96},{id:92,level:96},{id:98,level:97},{id:78,level:98}],reward:32000,before:['성채의 마지막 관문은 쉽게 못 지나가!'],lose:['좋아. 관장에게 가도 되겠어.']}},
 {id:'gym10_leader',name:'관장 오르딘',x:5,y:2,dir:'down',palette:'trainer',trainer:{gym:true,badge:'rift',party:[{id:78,level:97},{id:93,level:97},{id:99,level:98},{id:90,level:98},{id:96,level:99}],reward:55000,before:['전설의 힘을 빌리지 않겠다. 일반 몬스터가 어디까지 강해질 수 있는지 보여주지.'],lose:['열 번째 증표다. 균열의 증표를 받아라.']}}],warps:[{x:5,y:7,to:'town10',tx:4,ty:15,dir:'down'},{x:6,y:7,to:'town10',tx:4,ty:15,dir:'down'}]};

// 은행/카지노/연구소 내부 반환 좌표를 새 마을 배치에 맞춘다.
MAPS.bank8={name:'MONSTIA BANK',indoor:true,grid:V100_RESEARCH_GRID,objects:[{kind:'counter',x:2,y:3,w:6,h:1,solid:true},{kind:'machine',x:8,y:2,w:1,h:2,solid:true}],npcs:[{id:'banker8',name:'은행원',x:5,y:2,dir:'down',palette:'villagerA',role:'bank'}],warps:[{x:5,y:7,to:'town08',tx:19,ty:15,dir:'down'},{x:6,y:7,to:'town08',tx:19,ty:15,dir:'down'}]};
MAPS.casino9={name:'흑월 카지노',indoor:true,grid:['XXXXXXXXXXX','XcccccccccX','Xcc:::::ccX','Xcc:::::ccX','Xcc:::::ccX','XcccccccccX','X::::DD:::X','XXXXXXXXXXX'],objects:[{kind:'counter',x:2,y:2,w:7,h:1,solid:true},{kind:'machine',x:2,y:4,w:1,h:1,solid:true},{kind:'machine',x:8,y:4,w:1,h:1,solid:true}],npcs:[{id:'dealer9',name:'카지노 딜러',x:5,y:2,dir:'down',palette:'villagerB',role:'casino'},{id:'casino_guest',name:'큰손 손님',x:3,y:5,dir:'right',palette:'villagerA',lines:['슬롯은 운, 홀짝은 선택. 둘 다 돈은 소지금에서만 나가.']}],warps:[{x:5,y:6,to:'town09',tx:19,ty:15,dir:'down'},{x:6,y:6,to:'town09',tx:19,ty:15,dir:'down'}]};
MAPS.research10={name:'차원 관측소',indoor:true,grid:V100_RESEARCH_GRID,objects:[{kind:'counter',x:2,y:3,w:6,h:1,solid:true},{kind:'machine',x:8,y:2,w:1,h:2,solid:true},{kind:'sign',x:2,y:5,solid:true,text:['관측 기록','차원의 문 위치는 서버 시간이 아니라 현재 기기 시간 기준 5분 구간마다 다시 정해진다.']}],npcs:[{id:'rift_lab_staff',name:'관측소 연구원',x:5,y:2,dir:'down',palette:'researcher',lines:['제르카온의 파장은 기존 전설보다 강해.','마스터캡슐 외에는 차원 장벽을 뚫기 어려울 거야.']}],warps:[{x:5,y:7,to:'town10',tx:19,ty:15,dir:'down'},{x:6,y:7,to:'town10',tx:19,ty:15,dir:'down'}]};

// 신규 필드에 NPC/단서와 봉인의 열쇠를 유지한다. 열쇠는 전용 그림, 일반 랜덤 드랍은 계속 미확인 캡슐 그림이다.
MAPS.route08a.npcs=[{id:'r8a_ranger',name:'청록 순찰자',x:13,y:13,dir:'left',palette:'ranger',lines:['1단계 몬스터는 진화 레벨을 넘겨서 나타나지 않아.','성장 단계에 맞는 야생 개체가 나오는 게 이 지역 생태의 특징이지.']}];
MAPS.route08b.npcs=[{id:'r8b_miner',name:'협곡 채굴꾼',x:5,y:12,dir:'right',palette:'hiker',lines:['막다른 돌벽 뒤까지 잘 봐.','누군가 금빛 열쇠를 숨겼다는 소문이 있어.']}];
MAPS.route09a.npcs=[{id:'r9a_watch',name:'도시 외곽 경비',x:12,y:14,dir:'left',palette:'ranger',lines:['흑월숲은 성운의 별안개와 달라.','여긴 실제 그림자와 망령이 길을 가로막지.']}];
MAPS.route09b.npcs=[{id:'r9b_medium',name:'늪지 영매',x:4,y:12,dir:'right',palette:'villagerB',lines:['보랏빛 불꽃이 한곳에서 멎으면 주변을 살펴봐.','두 번째 봉인이 가까울지도 몰라.']}];
MAPS.route10a.npcs=[{id:'r10a_scout',name:'성채 정찰대',x:13,y:13,dir:'left',palette:'ranger',lines:['얼음과 번개가 섞인 것처럼 보여도 이곳은 뇌광고원이 아니야.','균열에서 새는 에너지가 두 현상을 동시에 만들고 있어.']}];
MAPS.route10b.npcs=[{id:'r10b_observer',name:'균열 감시병',x:4,y:15,dir:'right',palette:'ranger',lines:['문은 열쇠가 없어도 눈에 보여.','하지만 열쇠가 3개 없으면 차원 장벽이 절대 열리지 않아.']}];

// 마을별 전용 테마. 기존 grass/astral/thunder 등을 그대로 반환하지 않고 v1.0.0 전용 팔레트를 사용한다.
Object.assign(THEME_TINT,{
  basin:{tint:'#2a8c86',alpha:0.18,accent:'#a7f3dc'},
  eclipse:{tint:'#3b263f',alpha:0.32,accent:'#e5a0ff'},
  rift:{tint:'#53606c',alpha:0.26,accent:'#8de8ff'},
});
const _v100PaintTile=paintTile;
paintTile=function(key,variant,theme='grass'){
  const baseTheme = theme==='basin' ? 'grass' : theme==='eclipse' ? 'rock' : theme==='rift' ? 'rock' : theme;
  const c=_v100PaintTile(key,variant,baseTheme), ctx=c.getContext('2d');
  if(theme==='basin'){
    ctx.save();ctx.globalCompositeOperation='source-atop';ctx.globalAlpha=.18;ctx.fillStyle='#35a99a';ctx.fillRect(0,0,TILE,TILE);ctx.restore();
    if(['grass','path','water','flower'].includes(key)){px(ctx,2+(variant%3)*5,12,3,1,'#86dbc9');px(ctx,11,3+(variant%2)*7,1,3,'#d6fff4');}
  } else if(theme==='eclipse'){
    ctx.save();ctx.globalCompositeOperation='source-atop';ctx.globalAlpha=.34;ctx.fillStyle='#291b33';ctx.fillRect(0,0,TILE,TILE);ctx.restore();
    if(['grass','path','rockground','stormglass'].includes(key)){px(ctx,3+(variant%4)*3,4+(variant%2)*7,1,2,'#b76ae6');px(ctx,11,10-(variant%3)*2,2,1,'#e2a85f');}
  } else if(theme==='rift'){
    ctx.save();ctx.globalCompositeOperation='source-atop';ctx.globalAlpha=.28;ctx.fillStyle='#586673';ctx.fillRect(0,0,TILE,TILE);ctx.restore();
    if(['grass','path','rockground','cavefloor','icecrystal','stormglass'].includes(key)){px(ctx,2,13-(variant%3)*3,5,1,'#7ee5ef');px(ctx,6,12-(variant%3)*3,1,3,'#c5f7ff');px(ctx,11,4+(variant%2)*6,3,1,'#9c78d8');}
  }
  return c;
};
const _v100FinalTheme=mapThemeFor;
mapThemeFor=function(mapId,map){
 if(['town08','route08a','route08b','center8','shop8','gym8','bank8'].includes(mapId)) return 'basin';
 if(['town09','route09a','route09b','center9','shop9','gym9','casino9'].includes(mapId)) return 'eclipse';
 if(['town10','route10a','route10b','center10','shop10','gym10','research10'].includes(mapId)) return 'rift';
 if(mapId==='hidden_void_v100') return 'eclipse';
 return _v100FinalTheme(mapId,map);
};

// 귀환 목록 및 진행 메타데이터의 신규 마을 명칭 유지
Object.assign(RETURN_POINTS,{town08:{name:'청록마을',x:12,y:9,dir:'down'},town09:{name:'흑월도시',x:12,y:9,dir:'down'},town10:{name:'균열성채',x:12,y:9,dir:'down'}});



/* ==================================================================
   v1.0.0 VISUAL / TOWN POLISH PATCH
   - 신규 3마을 건물 외형을 기존 마을과 분리
   - 은행 / 카지노 / 차원관측소 전용 외관
   - 신규 체육관 관장 3명 전용 색상
   ================================================================== */
Object.assign(BUILDING_STYLES,{
  bank:{roof:'#1f756f',roofDark:'#124944',wall:'#e8f1e8',wallDark:'#9db8ac',sign:'BANK'},
  casino:{roof:'#5c245f',roofDark:'#321438',wall:'#eee0cf',wallDark:'#b89278',sign:'CASINO'},
  research:{roof:'#414953',roofDark:'#252c34',wall:'#d5d9d7',wallDark:'#929b9d',sign:'RIFT LAB'},
});
for(const o of MAPS.town08.objects||[]) if(o.kind==='building'&&o.x===17&&o.y===11) o.style='bank';
for(const o of MAPS.town09.objects||[]) if(o.kind==='building'&&o.x===17&&o.y===11) o.style='casino';
for(const o of MAPS.town10.objects||[]) if(o.kind==='building'&&o.x===17&&o.y===11) o.style='research';

const _v100PaintBuildingPolish=paintBuilding;
paintBuilding=function(style,wTiles,hTiles,doorCol,theme='grass'){
  const mapped=theme==='basin'?'harbor':theme==='eclipse'?'astral':theme==='rift'?'rock':theme;
  const c=_v100PaintBuildingPolish(style,wTiles,hTiles,doorCol,mapped);
  if(!['basin','eclipse','rift'].includes(theme)) return c;
  const ctx=c.getContext('2d'),W=c.width,H=c.height;
  if(theme==='basin'){
    // 수향마을: 청록 수로 띠와 흰 물결 문양
    px(ctx,2,2,W-4,2,'#267f7a');
    for(let x=5;x<W-5;x+=12){px(ctx,x,5,5,1,'#8ee5d8');px(ctx,x+3,6,5,1,'#d8fff5');}
    px(ctx,2,H-4,W-4,1,'#66c9bb');
  }else if(theme==='eclipse'){
    // 흑월도시: 어두운 처마 + 금빛 야시장 등불
    px(ctx,1,2,W-2,2,'#28152f');
    for(let x=5;x<W-5;x+=10){px(ctx,x,6,3,3,'#e7a34c');px(ctx,x+1,7,1,1,'#fff0a6');px(ctx,x+1,9,1,2,'#7b3e85');}
    px(ctx,1,H-4,W-2,1,'#6d3a72');
  }else if(theme==='rift'){
    // 균열성채: 성벽 톱니 + 청록/보라 차원 균열
    for(let x=1;x<W-1;x+=8){px(ctx,x,1,5,3,'#353e48');px(ctx,x+2,4,1,2,'#8de8ff');}
    px(ctx,W-8,Math.max(8,H-20),1,8,'#81e7f2');px(ctx,W-11,Math.max(11,H-17),4,1,'#81e7f2');
    px(ctx,5,Math.max(9,H-18),1,5,'#a482df');px(ctx,5,Math.max(13,H-14),4,1,'#a482df');
  }
  return c;
};

Object.assign(HUMAN_PALETTES,{
  gym_serna:{o:'#1c2730',h:'#2c8e87',c:'#43b6aa',f:'#f1c79e',k:'#182329',s:'#d8fff5',p:'#356b78',b:'#263c43'},
  gym_belka:{o:'#211829',h:'#4b245e',c:'#783d89',f:'#e8b98f',k:'#1a1421',s:'#e9a24c',p:'#34233f',b:'#241b2d'},
  gym_ordin:{o:'#1e2329',h:'#5c6670',c:'#4a5661',f:'#d8b28e',k:'#171b20',s:'#81e7f2',p:'#5b4778',b:'#2d343a'},
});
for(const n of MAPS.gym8.npcs||[]) if(n.id==='gym8_leader') n.palette='gym_serna';
for(const n of MAPS.gym9.npcs||[]) if(n.id==='gym9_leader') n.palette='gym_belka';
for(const n of MAPS.gym10.npcs||[]) if(n.id==='gym10_leader') n.palette='gym_ordin';
const _v100NpcSpriteKeyPolish=npcSpriteKey;
npcSpriteKey=function(n,mapId){
  if(n?.id==='gym8_leader') return 'gym_serna';
  if(n?.id==='gym9_leader') return 'gym_belka';
  if(n?.id==='gym10_leader') return 'gym_ordin';
  return _v100NpcSpriteKeyPolish(n,mapId);
};

/* ================== v1.0.0 VISUAL / TOWN POLISH END ================== */

/* ======================== v1.0.0 FINAL PATCH END ======================== */


const game = new Game(root);

input.attach(root);

const chat = new CheatConsole(game);
chat.attach(root);
game.chat = chat;
game.fit();
game.start();
// v1.0.0: 클라우드 세션만 초기화한다. 자동 저장/자동 불러오기는 하지 않는다.
cloud.init(game);

const refit = () => game.fit();
window.addEventListener('resize', refit);
window.addEventListener('orientationchange', () => setTimeout(refit, 120));
if (window.visualViewport) window.visualViewport.addEventListener('resize', refit);

// 오디오는 첫 사용자 입력에서 깨어난다 (모바일 브라우저 정책)
const wake = () => { sfx.ensure(); };
window.addEventListener('pointerdown', wake, { once: true });
window.addEventListener('keydown', wake, { once: true });

// 디버그용
window.MONSTIA = game;
window.CHAT = chat;

</script>
</body>
</html>
