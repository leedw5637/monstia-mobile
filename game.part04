  {kind:'building',style:'center',x:2,y:4,w:5,h:4,door:4},{kind:'building',style:'shop',x:17,y:4,w:5,h:4,door:19},
  {kind:'building',style:'gym',x:2,y:11,w:5,h:4,door:4},{kind:'building',style:'lab',x:17,y:11,w:5,h:4,door:19},
  {kind:'sign',x:10,y:3,solid:true,text:['흑월도시 · 야시장구','검은 석재 골목과 밤시장이 이어진 불야성이다. 성운마을의 별빛 마을과는 다른 상업도시다.']},
  {kind:'sign',x:15,y:13,solid:true,text:['흑월 카지노 →','슬롯머신 · 주사위 홀짝 / MONSTIA 게임머니 전용']},
  {kind:'market_stall',x:8,y:15,w:3,h:2,solid:true,text:['밤시장 향신료와 기념품을 파는 노점이다.']},{kind:'market_stall',x:13,y:15,w:3,h:2,solid:true,text:['보랏빛 등불 아래 작은 경매가 열리고 있다.']}
 ],
 npcs:[
  {id:'eclipse_guard',name:'야경 순찰대',x:8,y:6,dir:'right',palette:'ranger',quest:'q_eclipse_shadow',lines:['도시 외곽 그림자가 요즘 제멋대로 움직여.','흑월숲길을 조사해 줘.']},
  {id:'eclipse_soul',name:'영혼 연구원',x:14,y:6,dir:'left',palette:'researcher',quest:'q_eclipse_ghost',lines:['망령습지의 영혼불은 단순한 불꽃이 아니야.','생체 파장과 거의 비슷해.']},
  {id:'eclipse_info',name:'밤시장 정보상',x:8,y:12,dir:'right',palette:'villagerB',quest:'q_eclipse_key',lines:['쉿. 첫 지역에서 이상한 열쇠를 봤다면 여기서도 눈을 크게 떠.','두 번째 봉인은 늪 가까이에 있다는 소문이야.']},
  {id:'eclipse_gambler',name:'카지노 단골',x:14,y:12,dir:'left',palette:'villagerA',lines:['오늘은 천만 원 판으로 간다!','은행 돈은 손 안 대고 소지금만 가지고 노는 게 내 원칙이지.']},
  {id:'eclipse_vendor',name:'야시장 상인',x:10,y:16,dir:'down',palette:'clerk',lines:['낮엔 문 닫고 밤에만 장사하는 기분으로 살지.','여행자 물건은 상점 쪽이 더 싸.']},
  {id:'eclipse_artist',name:'거리 악사',x:18,y:16,dir:'left',palette:'villagerB',lines:['흑월도시는 별을 보는 곳이 아니라 밤을 즐기는 곳이야.']}
 ],
 warps:[{x:11,y:18,to:'route08b',tx:8,ty:1,dir:'down'},{x:12,y:18,to:'route08b',tx:9,ty:1,dir:'down'},{x:11,y:0,to:'route09a',tx:8,ty:18,dir:'up'},{x:12,y:0,to:'route09a',tx:9,ty:18,dir:'up'},
