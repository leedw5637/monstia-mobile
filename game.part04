];

for (const [id,name,type,shape,stage,start,hp,atk,def,catchRate,expYield,to,level,desc] of V100_MONSTER_SPECS) {
  MONSTERS[id] = mon({
    id,name,type,shape,stage,start,
    deco: stage===3 ? ['mane','spikes','aura'] : stage===2 ? ['spikes'] : [],
    palette:{a:'#667788',b:'#334455',c:'#aaccdd',d:'#e6bb55',e:'#ffffff'},
    base:{hp,atk,def},catchRate,expYield,
    ...(to ? {evolution:{to,level}} : {}), desc,
  });
}
MONSTERS[100] = mon({
  id:100,name:'제르카온',type:'악',secondaryType:'에스퍼',shape:'serpent',stage:3,start:'abyss',
  legendary:true,superLegendary:true,deco:['hornsBig','wingsBig','crown','aura'],
  palette:{a:'#31214f',b:'#120d1e',c:'#7960ae',d:'#a638ff',e:'#f4eaff'},
  base:{hp:172,atk:184,def:164},catchRate:2,expYield:1350,
  desc:'차원을 지배하는 자. 어둠과 정신의 힘으로 현실의 방향과 거리를 뒤틀며, 기존 전설보다 한 단계 강한 기운을 품고 있다.',
});
for (let id=70; id<=100; id++) if (!DEX_ORDER.includes(id)) DEX_ORDER.push(id);
DEX_ORDER.sort((a,b)=>a-b);

// 전투 화면에서는 사용자가 제공한 대형 전투 원화를 우선 사용한다.
const _v100BattleMonster = AssetManager.prototype.battleMonster;
AssetManager.prototype.battleMonster = function(species) {
  if (Number(species?.id) >= 70) {
    const num=String(species.id).padStart(3,'0');
    return this._get(`monbattle:${species.id}`, `assets/monsters/battle_${num}.png`, () => paintMonster(species));
  }
  return _v100BattleMonster.call(this,species);
};

// 제르카온은 마스터캡슐로만 포획 가능.
const _v100ThrowBall = Battle.prototype.throwBall;
Battle.prototype.throwBall = function(itemId) {
  const sp=MONSTERS[this.enemy?.id];
  if (sp?.superLegendary && itemId!=='capsule_master') {
    this.mode='script'; sfx.deny();
    this.say('제르카온의 차원 장벽이 일반 캡슐을 튕겨 냈다!');
    this.say('제르카온은 마스터캡슐로만 포획할 수 있다.');
    this.push({do:()=>{this.mode='menu';}});
    return;
  }
  return _v100ThrowBall.call(this,itemId);
};

// ---------- 봉인의 열쇠 -------------------------------------------------
ITEMS.sealed_key = {
  id:'sealed_key',name:'봉인의 열쇠',category:'기타',price:0,unsellable:true,keyItem:true,
  desc:'세 신규 지역에 하나씩 숨겨진 봉인의 열쇠. 3개를 모두 보유하면 차원의 문을 열 수 있다.',
};
const _v100BagActions = BagMenu.prototype.actionItems;
BagMenu.prototype.actionItems = function(entry) {
  if (entry?.id==='sealed_key' || entry?.item?.keyItem) return [{label:'확인',key:'use'},{label:'취소',key:'cancel'}];
  return _v100BagActions.call(this,entry);
};
const _v100UseItem = Game.prototype.useItemInField;
Game.prototype.useItemInField = function(id) {
  if (id==='sealed_key') {
    const n=this.countItem('sealed_key');
    this.say([`봉인의 열쇠를 ${n}/3개 보유하고 있다.`, n>=3?'세 개의 열쇠가 서로 공명하고 있다… 차원의 문을 열 수 있을 것 같다.':'아직 봉인의 열쇠가 더 필요하다.']);
    return;
  }
  return _v100UseItem.call(this,id);
};

