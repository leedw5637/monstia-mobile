];
for (const v of V100_PROGRESS) {
  if (!WORLD_PROGRESS.some(x=>x.id===v.id)) WORLD_PROGRESS.push(v);
  WORLD_PROGRESS_INDEX[v.id]=WORLD_PROGRESS.findIndex(x=>x.id===v.id);
  WORLD_PROGRESS_MIN[v.id]=v.min;
}

// 신규 지역은 기존 테마를 재조합해 서로 다른 분위기를 유지한다.
const _v100MapThemeFor=mapThemeFor;
mapThemeFor=function(mapId,map){
  if(['town08','route08a','route08b','center8','shop8','bank8'].includes(mapId)) return 'grass';
  if(['town09','route09a','route09b','center9','shop9','casino9'].includes(mapId)) return 'astral';
  if(['town10','route10a','route10b','center10','shop10'].includes(mapId)) return 'thunder';
  if(mapId==='hidden_void_v100') return 'astral';
  return _v100MapThemeFor(mapId,map);
};

// ---------- 5분마다 이동하는 차원의 문 --------------------------------
const V100_RIFT_POSITIONS=[{x:3,y:4},{x:14,y:4},{x:4,y:9},{x:13,y:10},{x:3,y:15},{x:14,y:15},{x:8,y:12}];
const V100_RIFT_MS=5*60*1000;
function v100RiftBucket(){ return Math.floor(Date.now()/V100_RIFT_MS); }
function v100EnsureRiftState(game, world) {
  game.state.riftGate ||= {bucket:null,index:0};
  const st=game.state.riftGate, bucket=v100RiftBucket();
  if(st.bucket!==bucket){
    const old=Number(st.index)||0;
    let next=Math.floor(Math.random()*V100_RIFT_POSITIONS.length);
    if(next===old) next=(next+1)%V100_RIFT_POSITIONS.length;
    st.bucket=bucket; st.index=next;
  }
  let idx=Math.max(0,Math.min(V100_RIFT_POSITIONS.length-1,Number(st.index)||0));
  let p=V100_RIFT_POSITIONS[idx];
  if(world?.player && p.x===world.player.tx && p.y===world.player.ty) {
    idx=(idx+1)%V100_RIFT_POSITIONS.length; st.index=idx; p=V100_RIFT_POSITIONS[idx];
  }
  return p;
}
const _v100BuildSolids=World.prototype.buildSolids;
World.prototype.buildSolids=function(){
  _v100BuildSolids.call(this);
  if(this.mapId==='route10b'){
    const p=v100EnsureRiftState(this.game,this);
    const gate={kind:'rift_gate',x:p.x,y:p.y,w:1,h:1,solid:true};
    this.objects.push(gate); this.solids.add(`${p.x},${p.y}`); this._v100RiftBucket=this.game.state.riftGate.bucket;
  }
};
const _v100WorldUpdate=World.prototype.update;
World.prototype.update=function(dt,allowInput){
  if(this.mapId==='route10b' && this._v100RiftBucket!==v100RiftBucket()) this.buildSolids();
  return _v100WorldUpdate.call(this,dt,allowInput);
};
const _v100Object=AssetManager.prototype.object;
AssetManager.prototype.object=function(kind,w,h,theme='grass',skin=null){
  if(kind==='rift_gate') return this._get('obj:v100:rift_gate','assets/world/objects/v100_rift_gate.png',()=>{
    const c=makeCanvas(16,28),x=c.getContext('2d'); x.imageSmoothingEnabled=false;
    x.fillStyle='#13071f'; x.fillRect(5,2,6,24); x.fillRect(3,5,10,18);
    x.fillStyle='#5b25a8'; x.fillRect(4,5,8,18); x.fillRect(2,9,12,10);
    x.fillStyle='#a94cff'; x.fillRect(5,6,6,16); x.fillRect(3,10,10,8);
    x.fillStyle='#31104f'; x.fillRect(6,6,4,16); x.fillRect(4,11,8,6);
    x.fillStyle='#e7c7ff'; x.fillRect(7,8,2,12); x.fillRect(6,12,4,4);
    x.fillStyle='#7ff1ff'; x.fillRect(7,13,2,2); x.fillRect(3,4,2,2); x.fillRect(12,7,2,2);
    return c;
  });
  return _v100Object.call(this,kind,w,h,theme,skin);
};
const _v100UseObject=Game.prototype.useObject;
Game.prototype.useObject=function(obj){
  if(obj?.kind==='rift_gate'){
    const n=this.countItem('sealed_key');
    if(n<3){ sfx.deny(); this.say(['차원의 문이 불안정하게 흔들리고 있다…','봉인의 열쇠 3개가 있어야 입장할 수 있다.',`현재 보유: ${n} / 3`]); return; }
    sfx.confirm();
    this.say(['세 개의 봉인의 열쇠가 동시에 빛난다!','차원의 문이 잠시 안정되었다. 봉인의 심층으로 진입한다.'],{onDone:()=>this.doWarp({to:'hidden_void_v100',tx:8,ty:12,dir:'up'})});
    return;
  }
  return _v100UseObject.call(this,obj);
};

// ---------- 은행: 시간당 이자 ------------------------------------------
function v100EnsureFinance(game){
  game.state.bank ||= {balance:0,lastInterestAt:Date.now(),totalInterest:0};
  game.state.casinoStats ||= {plays:0,wagered:0,won:0,biggestWin:0};
  if(!Number.isFinite(game.state.bank.balance)) game.state.bank.balance=0;
  if(!Number.isFinite(game.state.bank.lastInterestAt)) game.state.bank.lastInterestAt=Date.now();
  return game.state.bank;
}
function v100SettleInterest(game){
  const b=v100EnsureFinance(game), now=Date.now(), H=3600000;
  const hours=Math.min(72,Math.floor(Math.max(0,now-b.lastInterestAt)/H));
  if(hours<=0) return {hours:0,interest:0};
  const perHour=Math.min(Math.floor(b.balance*0.005),250000); // 시간당 0.5%, 시간당 최대 25만원
  const interest=Math.max(0,perHour*hours);
  b.balance+=interest; b.totalInterest=(b.totalInterest||0)+interest; b.lastInterestAt+=hours*H;
  return {hours,interest};
}
function v100Money(n){return Math.max(0,Math.floor(Number(n)||0)).toLocaleString()+'원';}
function v100BankAmountMenu(game,mode){
  const b=v100EnsureFinance(game), source=mode==='deposit'?game.state.money:b.balance;
  const presets=[10000,100000,500000,1000000,'all'];
  const labels=['1만원','10만원','50만원','100만원','전액'];
  game.push(new Dialogue(mode==='deposit'?'얼마를 입금할까요?':'얼마를 출금할까요?',{
    choices:presets.map((v,i)=>({label:labels[i],value:v})),
    onChoose:(v)=>{
      let amount=v==='all'?Math.floor(source):Math.floor(v);
      amount=Math.min(amount,Math.floor(source));
      if(amount<=0){sfx.deny();game.say(mode==='deposit'?'입금할 소지금이 없다.':'출금할 예금이 없다.');return;}
      if(mode==='deposit'){game.state.money-=amount;b.balance+=amount;} else {b.balance-=amount;game.state.money+=amount;}
      b.lastInterestAt=Date.now(); // 거래 후부터 새 이자 시간 계산
      sfx.buy(); game.autoSave(`은행 ${mode==='deposit'?'입금':'출금'} · 자동 저장`);
      game.say([`${v100Money(amount)} ${mode==='deposit'?'입금':'출금'} 완료.`,`소지금 ${v100Money(game.state.money)} · 예금 ${v100Money(b.balance)}`]);
    }
  }));
}
function v100BankMenu(game){
  const b=v100EnsureFinance(game), earned=v100SettleInterest(game);
  if(earned.interest>0) game.autoSave('은행 시간당 이자 반영 · 자동 저장');
  const intro=[`소지금 ${v100Money(game.state.money)} · 예금 ${v100Money(b.balance)}`,
    earned.interest>0?`${earned.hours}시간 이자 ${v100Money(earned.interest)}가 지급되었습니다.`:'시간당 이자: 예금의 0.5% · 시간당 최대 25만원',
    '오프라인 이자는 최대 72시간까지 정산됩니다.'];
  game.push(new Dialogue(intro,{choices:[{label:'입금',value:'deposit'},{label:'출금',value:'withdraw'},{label:'이자 설명',value:'info'},{label:'나가기',value:'exit'}],onChoose:(v)=>{
    if(v==='deposit')v100BankAmountMenu(game,'deposit');
    else if(v==='withdraw')v100BankAmountMenu(game,'withdraw');
    else if(v==='info')game.say(['시간당 예금액의 0.5%가 이자로 붙습니다.','한 시간 이자는 최대 250,000원이며, 오프라인 정산은 최대 72시간입니다.','카지노에서는 은행 예금이 아니라 현재 소지금만 사용할 수 있습니다.']);
  }}));
}

// ---------- 카지노: 슬롯 + 주사위 홀짝, 고액 베팅 ----------------------
const V100_BETS=[50000,250000,1000000,5000000,10000000];
function v100BetChoices(){return V100_BETS.map(v=>({label:v100Money(v),value:v}));}
function v100CanBet(game,bet){if(game.state.money<bet){sfx.deny();game.say(`소지금이 부족하다. 현재 ${v100Money(game.state.money)}`);return false;}return true;}
function v100CasinoRecord(game,bet,payout){
  const s=v100EnsureFinance(game)&&game.state.casinoStats; s.plays++;s.wagered+=bet;s.won+=payout;s.biggestWin=Math.max(s.biggestWin||0,payout);
  game.autoSave('카지노 결과 · 자동 저장');
}
function v100Slot(game,bet){
  if(!v100CanBet(game,bet))return;
  const symbols=[['🍀',32,3],['💧',27,4],['⚡',20,7],['💎',14,15],['👑',7,50]];
  const spin=()=>{let r=Math.random()*100;for(const s of symbols){r-=s[1];if(r<=0)return s;}return symbols[0];};
  const a=spin(),b=spin(),c=spin(); game.state.money-=bet;
  let mult=0, result='꽝';
  if(a[0]===b[0]&&b[0]===c[0]){mult=a[2];result=a[0]==='👑'?'초대형 잭팟!':'트리플!';}
  else if(a[0]===b[0]||a[0]===c[0]||b[0]===c[0]){mult=2;result='페어 당첨!';}
  const payout=Math.floor(bet*mult);game.state.money+=payout;v100CasinoRecord(game,bet,payout);
  const net=payout-bet;
  game.say([`[ ${a[0]} | ${b[0]} | ${c[0]} ]`,mult?`${result} 배당 x${mult} · ${v100Money(payout)} 획득!`:'아쉽다! 이번에는 당첨되지 않았다.',`손익 ${net>=0?'+':''}${v100Money(Math.abs(net)).replace('원','')}원${net<0?' 손실':''} · 소지금 ${v100Money(game.state.money)}`]);
}
function v100SlotBet(game){game.push(new Dialogue('슬롯머신 베팅 금액을 선택하세요.',{choices:v100BetChoices(),onChoose:(bet)=>v100Slot(game,bet)}));}
function v100Dice(game,bet,choice){
  if(!v100CanBet(game,bet))return;
  game.state.money-=bet;const d1=1+Math.floor(Math.random()*6),d2=1+Math.floor(Math.random()*6),sum=d1+d2,parity=sum%2?'odd':'even';
  const win=choice===parity, double=d1===d2;const mult=win?(double?3:2):0,payout=bet*mult;game.state.money+=payout;v100CasinoRecord(game,bet,payout);
  game.say([`주사위: ${d1} + ${d2} = ${sum} (${parity==='odd'?'홀':'짝'})`,win?`${double?'더블 보너스! ':''}적중! 배당 x${mult} · ${v100Money(payout)} 획득!`:'예측 실패! 다음 판을 노려보자.',`소지금 ${v100Money(game.state.money)}`]);
}
function v100DiceBet(game){
  game.push(new Dialogue('주사위 홀짝 베팅 금액을 선택하세요.',{choices:v100BetChoices(),onChoose:(bet)=>{
    if(!v100CanBet(game,bet))return;
    game.push(new Dialogue(`${v100Money(bet)} 베팅 · 주사위 두 개의 합은 홀일까, 짝일까?`,{choices:[{label:'홀',value:'odd'},{label:'짝',value:'even'},{label:'취소',value:'cancel'}],onChoose:(v)=>{if(v!=='cancel')v100Dice(game,bet,v);}}));
  }}));
}
function v100CasinoMenu(game){
  v100EnsureFinance(game);const s=game.state.casinoStats;
  game.push(new Dialogue([`흑월 카지노에 오신 것을 환영합니다. 소지금: ${v100Money(game.state.money)}`,'실제 현금과 무관한 MONSTIA 게임머니 전용 카지노입니다.'],{
    choices:[{label:'슬롯머신',value:'slot'},{label:'주사위 홀짝',value:'dice'},{label:'전적',value:'stats'},{label:'나가기',value:'exit'}],onChoose:(v)=>{
      if(v==='slot')v100SlotBet(game);else if(v==='dice')v100DiceBet(game);else if(v==='stats')game.say([`총 ${s.plays}판 · 누적 베팅 ${v100Money(s.wagered)}`,`누적 지급 ${v100Money(s.won)} · 최고 당첨 ${v100Money(s.biggestWin||0)}`]);
    }}));
}
const _v100TalkTo=Game.prototype.talkTo;
Game.prototype.talkTo=function(npc){
  if(npc?.role==='bank'){sfx.confirm();v100BankMenu(this);return;}
  if(npc?.role==='casino'){sfx.confirm();v100CasinoMenu(this);return;}
  return _v100TalkTo.call(this,npc);
};

// 새 게임에도 금융/차원의 문 상태를 명시적으로 포함한다.
const _v100FreshState=Game.prototype.freshState;
Game.prototype.freshState=function(){const st=_v100FreshState.call(this);st.bank={balance:0,lastInterestAt:Date.now(),totalInterest:0};st.casinoStats={plays:0,wagered:0,won:0,biggestWin:0};st.riftGate={bucket:null,index:0};return st;};

