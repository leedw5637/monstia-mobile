// ------------------------------------------------------------------
// 1) 신규 야생 출현 레벨: 각 종의 실제 진화 레벨을 기준으로 계산.
//    1단계 = 2단계 진화 직전까지
//    2단계 = 최종 진화 직전까지
//    3단계 = 최종 진화 레벨부터 Lv.79까지 (기존 전설 Lv.80 미만)
// ------------------------------------------------------------------
function v100PrevEvolutionLevel(id){
  for(const sp of Object.values(MONSTERS)) if(sp?.evolution?.to===id) return Number(sp.evolution.level)||1;
  return 1;
}
function v100WildEntry(id,weight){
  const sp=MONSTERS[id];
  if(!sp) return {id,weight,min:1,max:1};
  if(sp.stage===1){
    const evo=Math.max(2,Number(sp.evolution?.level)||2);
    return {id,weight,min:Math.max(1,evo-8),max:evo-1};
  }
  if(sp.stage===2){
    const prev=v100PrevEvolutionLevel(id);
    const evo=Math.max(prev+1,Number(sp.evolution?.level)||prev+1);
    return {id,weight,min:prev,max:evo-1};
  }
  const prev=v100PrevEvolutionLevel(id);
  return {id,weight,min:prev,max:79};
}
// 신규 10계통도 기존 MONSTIA처럼 계통별 진화 레벨을 서로 다르게 둔다.
// 1단계는 2단계 진화 레벨 미만, 2단계는 최종 진화 레벨 미만, 최종형 야생은 기존 전설 Lv.80 미만까지만 출현한다.
const V100_EVOLUTION_LEVELS={
  70:66,71:72, 73:67,74:73, 76:68,77:74, 79:68,80:74, 82:66,83:72,
  85:67,86:73, 88:68,89:74, 91:69,92:75, 94:69,95:75, 97:70,98:76,
};
for(const [id,lv] of Object.entries(V100_EVOLUTION_LEVELS)){ if(MONSTERS[id]?.evolution) MONSTERS[id].evolution.level=lv; }

// v0.9.3의 전진 레벨 게이트 체계를 신규 지역까지 이어 붙인다.
const V100_WORLD_PROGRESS=[
  ['town08',78],['route08a',78],['route08b',79],
  ['town09',80],['route09a',82],['route09b',84],
  ['town10',86],['route10a',88],['route10b',90],
];
for(const [id,min] of V100_WORLD_PROGRESS){
  if(WORLD_PROGRESS_INDEX[id]===undefined){
    WORLD_PROGRESS.push({id,min});
    WORLD_PROGRESS_INDEX[id]=WORLD_PROGRESS.length-1;
    WORLD_PROGRESS_MIN[id]=min;
  }
}

