 {id:'gym8_trainer',name:'수로 수련생',x:3,y:4,dir:'down',palette:'villagerA',trainer:{party:[{id:71,level:84},{id:74,level:85},{id:83,level:86},{id:86,level:87}],reward:18000,before:['물길처럼 공격 방향을 바꿔 보지!'],lose:['흐름을 읽었구나!']}},
 {id:'gym8_leader',name:'관장 세르나',x:5,y:2,dir:'down',palette:'trainer',trainer:{gym:true,badge:'basin',party:[{id:71,level:86},{id:74,level:87},{id:83,level:88},{id:86,level:89},{id:75,level:90}],reward:30000,before:['청록의 힘은 한 속성에 갇히지 않아. 물과 대지가 만나는 흐름을 견뎌 봐.'],lose:['좋은 흐름이었어. 수향의 증표를 받아.']}}],warps:[{x:5,y:7,to:'town08',tx:4,ty:15,dir:'down'},{x:6,y:7,to:'town08',tx:4,ty:15,dir:'down'}]};
MAPS.gym9={name:'흑월 체육관',indoor:true,areaType:'gym',grid:V100_GYM_GRID,objects:[{kind:'gym_scoreboard',x:4,y:1,w:3,h:1,solid:true},{kind:'gym_banner',x:1,y:2,w:1,h:2,solid:true},{kind:'gym_banner',x:9,y:2,w:1,h:2,solid:true},{kind:'gym_trophy',x:9,y:5,w:1,h:1,solid:true,text:['검은 유리로 만든 달 모양 트로피다.']}],npcs:[
 {id:'gym9_trainer',name:'야시장 수련생',x:3,y:4,dir:'down',palette:'villagerB',trainer:{party:[{id:80,level:91},{id:89,level:92},{id:95,level:92},{id:81,level:93}],reward:24000,before:['보이는 것만 믿으면 흑월에선 져!'],lose:['그림자까지 읽었네.']}},
 {id:'gym9_leader',name:'관장 벨카',x:5,y:2,dir:'down',palette:'trainer',trainer:{gym:true,badge:'eclipse',party:[{id:80,level:92},{id:89,level:93},{id:95,level:94},{id:81,level:95},{id:96,level:95}],reward:40000,before:['도시는 밝지만 승부는 어둡지. 네 판단이 흔들리는지 보겠어.'],lose:['흑월의 증표는 네 것이야.']}}],warps:[{x:5,y:7,to:'town09',tx:4,ty:15,dir:'down'},{x:6,y:7,to:'town09',tx:4,ty:15,dir:'down'}]};
