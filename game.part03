    test:(game)=>DEX_ORDER.some((id)=>MONSTERS[id]?.legendary && (game.state.dex?.[id]||0)===2),
    progress:(game)=>DEX_ORDER.some((id)=>MONSTERS[id]?.legendary && (game.state.dex?.[id]||0)===2) ? '달성 완료' : '전설 포획 0/1',
  },
