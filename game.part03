      { kind:'statue_thunder', x:2, y:3, w:2, h:3, solid:true, text:['번개를 움켜쥔 고대 수호상이다.', '돌로 만들어졌는데도 손끝에서 정전기가 느껴진다.'] },
      { kind:'statue_thunder', x:14, y:3, w:2, h:3, solid:true, text:['하늘을 향해 뿔을 세운 수호상이다.', '머리 위에서 희미한 전광이 원을 그린다.'] },
      { kind:'coil_tower', x:5, y:7, w:1, h:2, solid:true },
