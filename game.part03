/* ===== js/data/gamedata.js ===== */
// gamedata.js — 게임의 모든 "내용물"
// ------------------------------------------------------------
// 이 파일만 고치면 몬스터/기술/아이템/출현표를 얼마든지 늘릴 수 있다.
// 시스템 코드는 이 파일의 형식만 알 뿐 내용은 모른다.
// ============================================================

const TYPES = ['노말', '풀', '불', '물', '전기', '벌레', '비행', '바위', '독', '얼음', '강철', '고스트', '드래곤', '에스퍼', '페어리', '악', '빛'];

const TYPE_COLORS = {
  노말: '#a8a878', 풀: '#5cb85c', 불: '#e8703a', 물: '#4a90d9', 전기: '#e8c020',
  벌레: '#8cb82c', 비행: '#8ea8e0', 바위: '#b0a060', 독: '#9c5cb0',
  얼음: '#78cfe8', 강철: '#8a98a8', 고스트: '#6c5aa8', 드래곤: '#626ee8',
  에스퍼: '#d868b0', 페어리: '#ed91c8', 악: '#55505e', 빛: '#e6c64a',
};

// 공격타입 -> { 방어타입: 배율 }. 명시되지 않으면 1배.
// SUPER/WEAK 를 상수로 뺀 이유: 배율이 2.0이면 상성 하나로 전투가 결정돼 버린다.
const SUPER = 1.6;
const WEAK = 0.6;
const TC_S = SUPER, TC_W = WEAK;

const TYPE_CHART = {
  풀:   { 물: TC_S, 바위: TC_S, 불: TC_W, 풀: TC_W, 벌레: TC_W, 비행: TC_W, 독: TC_W },
  불:   { 풀: TC_S, 벌레: TC_S, 불: TC_W, 물: TC_W, 바위: TC_W },
  물:   { 불: TC_S, 바위: TC_S, 물: TC_W, 풀: TC_W },
  전기: { 물: TC_S, 비행: TC_S, 전기: TC_W, 풀: TC_W },
  벌레: { 풀: TC_S, 불: TC_W, 비행: TC_W, 바위: TC_W, 독: TC_W },
  비행: { 풀: TC_S, 벌레: TC_S, 전기: TC_W, 바위: TC_W },
  바위: { 불: TC_S, 벌레: TC_S, 비행: TC_S },
  독:   { 풀: TC_S, 독: TC_W, 바위: TC_W },
  얼음: { 풀: TC_S, 비행: TC_S, 드래곤: TC_S, 불: TC_W, 물: TC_W, 얼음: TC_W, 강철: TC_W },
  강철: { 바위: TC_S, 얼음: TC_S, 페어리: TC_S, 불: TC_W, 물: TC_W, 전기: TC_W, 강철: TC_W },
  고스트: { 고스트: TC_S, 에스퍼: TC_S, 악: TC_W },
  드래곤: { 드래곤: TC_S, 강철: TC_W, 페어리: TC_W },
  에스퍼: { 독: TC_S, 에스퍼: TC_W, 강철: TC_W, 악: TC_W },
  페어리: { 드래곤: TC_S, 악: TC_S, 불: TC_W, 독: TC_W, 강철: TC_W },
  악: { 고스트: TC_S, 에스퍼: TC_S, 악: TC_W, 페어리: TC_W },
  빛: { 고스트: TC_S, 악: TC_S, 빛: TC_W },
  노말: {},
};

function typeMultiplier(atkType, defType) {
  const row = TYPE_CHART[atkType];
  if (!row) return 1;
  return row[defType] ?? 1;
}

