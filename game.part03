// 레벨이 오를수록 최대 SP도 함께 상승한다.
// 전설/환상은 기술 소모가 큰 편이라 약간 더 넓은 SP 풀을 가진다.
function maxSpFor(id, level, traits = null) {
  const species = MONSTERS[id];
  const stage = Math.max(1, Math.min(3, Number(species?.stage || 1)));
  const bonus = species?.legendary ? 14 : species?.mythical ? 10 : 0;
  const equip = ITEMS[traits?.equipment]?.equip || {};
  return 28 + Math.max(1, Number(level || 1)) * 2 + (stage - 1) * 6 + bonus + Number(equip.spFlat || 0);
}

function normalizeSp(inst) {
  const oldMax = Math.max(1, Number(inst.maxSp || maxSpFor(inst.id, inst.level, inst)));
  const old = Number.isFinite(inst.sp) ? inst.sp : oldMax;
  const cap = maxSpFor(inst.id, inst.level, inst);
  inst.maxSp = cap;
  inst.sp = Math.max(0, Math.min(cap, Math.round(old)));
  return inst;
}

