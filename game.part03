        lines: ['노을항구는 해가 질 때 가장 예뻐요.', '북쪽 노을곶에선 바다가 한눈에 보여요.'] },
      { id: 'town03_sailor', name: '선원', x: 8, y: 13, dir: 'right', palette: 'villagerA', quest:'q_sunset_shell',
        lines: ['노을곶 서쪽은 조류가 이상해.', '썰물 때만 나타나는 흔적을 봤다는 선원도 있지.'] },
      { id: 'town03_kid', name: '항구 아이', x: 7, y: 6, dir: 'down', palette: 'kid',
        lines: ['센터는 왼쪽, 상점은 오른쪽!', '체육관은 아래쪽 서편에 있어!'] },
      { id: 'fishmonger', name: '생선장수', x: 14, y: 15, dir: 'left', palette: 'clerk',
        lines: ['노을 질 무렵엔 항구가 제일 북적이지.', '노을곶으로 가면 바다 몬스터도 많이 볼 수 있어.'] },
      { id: 'town03_tourist', name: '여행객', x: 13, y: 6, dir: 'left', palette: 'villagerB',
        lines: ['여기 석양을 보려고 먼 곳에서 왔어요.', '체육관도 바다처럼 거칠다던데요?'] },
      { id: 'dockworker', name: '부두 일꾼', x: 20, y: 12, dir: 'left', palette: 'villagerA',
        lines: ['오늘은 파도가 잠잠해서 다행이야.', '가끔 노을곶 쪽 바다가 이상하게 갈라질 때가 있어.'] },
      { id: 'sand_researcher', name: '모래 연구원', x: 5, y: 16, dir: 'right', palette: 'prof', quest:'q_sand_sample',
        lines: ['항구 모래와 2번도로 모래의 성분이 묘하게 달라.', '몬스터에게 붙은 모래를 비교하면 이유를 알 수 있을지도 몰라.'] },
      { id: 'tide_observer', name: '해양 관측원', x: 13, y: 16, dir: 'up', palette: 'villagerB', quest:'q_tide_trace',
