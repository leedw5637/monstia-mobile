// ------------------------------------------------------------
// v0.9.0 업적 / 칭호
// 업적은 조건을 만족하면 자동 해금되고, 해금한 칭호 중 하나를 장착할 수 있다.
// ------------------------------------------------------------
function ownedMonsters(game) {
  return [...(game.state.party || []), ...((game.state.box || []).flat())];
}
function caughtSpeciesCount(game) {
  return DEX_ORDER.filter((id) => (game.state.dex?.[id] || 0) === 2).length;
}
function completedQuestCount(game) {
  return Object.keys(QUESTS).filter((id) => game.state.quests?.[id]?.status === 'done').length;
}
function badgeCount(game) {
  return Object.keys(BADGES).filter((id) => !!game.state.badges?.[id]).length;
}

