/* ===== js/data/maps.js ===== */
// maps.js — 지역 데이터
// ------------------------------------------------------------
// 맵은 문자 그리드다. 한 글자가 한 타일이고, TILES 표가 그 성질을 정한다.
// 새 지역을 추가하려면 MAPS 에 항목 하나만 더 쓰면 된다.
// ============================================================

const TILES = {
  '.': { key: 'grass',     walkable: true },
  ',': { key: 'flower',    walkable: true },
  '"': { key: 'tallgrass', walkable: true, encounter: true },
  '-': { key: 'path',      walkable: true },
  'S': { key: 'sand',      walkable: true },
  '=': { key: 'bridge',    walkable: true },
  '#': { key: 'tree',      walkable: false },
  '~': { key: 'water',     walkable: false },
  'o': { key: 'rock',      walkable: false },
  '|': { key: 'fence',     walkable: false },
  '_': { key: 'wood',      walkable: true },
  ':': { key: 'floor',     walkable: true },
  'c': { key: 'carpet',    walkable: true },
  'X': { key: 'wall',      walkable: false },
  'D': { key: 'doormat',   walkable: true },
  'g': { key: 'gymfloor',  walkable: true },
  'a': { key: 'arena',     walkable: true },
  '^': { key: 'cavefloor', walkable: true, encounter: true },
  'N': { key: 'snow',      walkable: true, encounter: true },
  'R': { key: 'rockground', walkable: true },
