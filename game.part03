// 레벨업 시 랜덤으로 배울 수 있는 후보 (속성 사다리 + 노말 사다리)
function randomMovePool(sp) {
  return [...new Set([...(TYPE_LADDER[sp.type] || []), ...TYPE_LADDER['노말']])];
}

