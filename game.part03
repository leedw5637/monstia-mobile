        '성운령: 전용 지역 조우 시 약 3.09%   ·   여명조: 전용 지역 조우 시 약 3.26%',
        '공명 개체 출현 확률: 1 / 777 (약 0.129%)',
        '도망 확률: 기본 50% + 재시도당 15% + 레벨 차 보정, 최종 최대 95%',
        '전설 몬스터: 격파 후 10분 / 포획 후 24시간 뒤 현실 시간 기준 재등장',
        '필드 우두머리: 격파 또는 포획 후 30분 뒤 재등장'
      ]},
      {title:'11. 최근 업데이트', lines:[
        'v7.7 미발견 도감 전체 열람 + SP 물약 3종 추가',
        'v7.8 버프/디버프 잔여턴 표시 + 야생 진화단계 레벨 보정 + 자동줍기권 추가',
        'v0.8.0 이메일 계정 로그인 + PC/모바일 공용 클라우드 세이브 추가',
        'v0.9.3 클라우드 수동 동기화 단일 버튼 적용 + APK 업데이트 버전 승격',
        'v0.9.2 클라우드 자동 동기화 제거 + 수동 동기화 버튼 1개로 통합',
        'v0.8.1 모바일 클라우드 창이 배경 터치로 닫히는 현상 수정',
        'v0.9.0 퀘스트 추적 + 업적/칭호 + 몬스터 장비 + 클라우드 동기화 상태 표시 추가',
        'v0.9.2 아이템 버리기·마스터캡슐 판매·클라우드 인증 UI 개선·SP 표시 동기화·여신의 눈물 추가',
        'v0.9.1 몬스터 장비 전용 이미지 적용 + 클라우드 상태 표시 크기 축소',
        '게임 수정 후에도 동일 계정의 세이브 데이터를 계속 이어서 사용할 수 있도록 구성되어 있습니다.'
      ]},
    ];
  }
  update(dt,game) {
    const d=game.input.freshDirection();
    if (d==='left'||d==='up') { this.page=(this.page-1+this.pages.length)%this.pages.length; sfx.blip(); }
    if (d==='right'||d==='down') { this.page=(this.page+1)%this.pages.length; sfx.blip(); }
    if (game.input.pressed('b')||game.input.pressed('a')) { if(game.input.pressed('b')){sfx.cancel();game.pop();} }
  }
  drawUI(sc) {
    const p=this.pages[this.page];
    sc.fill(0,0,160,224,'rgba(5,8,18,0.66)');
    sc.box(5,8,150,208,{paper:'#f7f3e8'});
    sc.text('MONSTIA 게임 설명서',80,15,{size:10,weight:'800',align:'center',color:COL.accent});
    sc.text(p.title,12,34,{size:9,weight:'700',maxW:136,minSize:7});
    let y=52;
    for (const para of p.lines) {
      const lines=sc.wrap(para,132,7);
      lines.forEach(line=>{ if(y<190){sc.text(line,14,y,{size:7,maxW:132,minSize:5,ellipsis:false});y+=9;} });
      y+=4;
    }
    sc.text(`◀  ${this.page+1} / ${this.pages.length}  ▶`,80,193,{size:7,align:'center',weight:'700'});
    sc.text('방향키 페이지 이동   B 뒤로',80,205,{size:6,align:'center',color:COL.dim});
  }
}

class AttendanceRewardScene {
  constructor(info) { this.info=info; this.t=0; }
  update(dt,game) {
    this.t+=dt;
    if (this.t>0.35 && (game.input.pressed('a')||game.input.pressed('b'))) { sfx.confirm(); game.pop(); }
  }
  drawUI(sc) {
    sc.fill(0,0,160,224,'rgba(5,8,18,0.68)');
    sc.box(17,61,126,126,{paper:'#fff9e8'});
    sc.text('DAILY ATTENDANCE',80,70,{size:7,weight:'800',align:'center',color:'#b47a18'});
    sc.text('출석 보상',80,84,{size:13,weight:'800',align:'center',color:COL.accent});
    sc.text(`누적 출석 ${this.info.totalDays}일`,80,103,{size:7,align:'center',color:COL.dim});
    sc.panel(29,116,102,30,'#f2ead4');
    sc.text('+ 100,000원',80,120,{size:9,weight:'800',align:'center',color:'#775316'});
    sc.hqFit(assets.itemIcon('capsule_master'),43,132,13,13,{ay:0.5});
    sc.text('마스터캡슐 × 1',64,134,{size:7,weight:'700',maxW:65,minSize:5});
    sc.text('오늘의 보상을 받았습니다!',80,151,{size:6.5,align:'center',color:COL.dim});
    sc.text('A/B 확인',80,174,{size:6,align:'center',color:COL.dim});
  }
}

class TitleScene {
  constructor(game) {
    this.hasSave = game.hasSave();
    this.items = [
      { label: '게임 시작', key: 'start', on: true },
      { label: '저장 파일 불러오기', key: 'import', on: true },
      { label: '백업 데이터 불러오기', key: 'backup', on: true },
      { label: '환경 설정', key: 'settings', on: true },
      { label: '클라우드 계정', key: 'cloud', on: true },
      { label: '게임 설명서', key: 'manual', on: true },
    ];
    this.cursor = new MenuCursor(this.items.length);
    this.t = 0;
    this.bg = assets.uiImage('title_v070');
  }
  update(dt, game) {
    this.t += dt;
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (!game.input.pressed('a')) return;
    const it = this.items[this.cursor.i];
    sfx.confirm();
    if (it.key === 'start') {
      if (!game.hasSave()) { game.startNewGame(); return; }
      game.push(new Dialogue('저장된 데이터를 불러오시겠습니까?\n불러오기를 취소하실 경우 새 게임으로 시작합니다.', {
        choices:[{label:'동의',value:true},{label:'취소',value:false}],
        onChoose:(v)=>{ if(v) game.continueGame(); else game.startNewGame(); },
      }));
    } else if (it.key === 'import') game.importSaveFile(true);
    else if (it.key === 'backup') {
      if (!game.hasBackupSave()) { game.push(new Dialogue('불러올 이전 백업 데이터가 없습니다.')); return; }
      game.push(new BackupLoadScene());
    } else if (it.key === 'settings') game.push(new SettingsMenu({ fromTitle:true }));
    else if (it.key === 'cloud') cloud.open(game);
    else if (it.key === 'manual') game.push(new GameManualScene());
  }
  drawWorld(sc) {
    const ctx=sc.wctx;
    ctx.fillStyle='#13243a'; ctx.fillRect(0,0,160,224);
    drawCoverImage(ctx,this.bg,0,0,160,224);
    // 버튼 가독성을 위한 중앙 하단 소프트 베일
    const g=ctx.createLinearGradient(0,108,0,222);
    g.addColorStop(0,'rgba(5,12,25,0.02)'); g.addColorStop(0.58,'rgba(5,12,25,0.20)'); g.addColorStop(1,'rgba(5,12,25,0.50)');
    ctx.fillStyle=g; ctx.fillRect(0,105,160,119);
  }
  drawUI(sc) {
    const baseY=119, gap=14;
    this.items.forEach((it,i)=>{
      const selected=this.cursor.i===i, y=baseY+i*gap;
      const x=selected?28:32, w=selected?104:96;
      sc.fill(x-1,y-1,w+2,13,selected?'#f0c35a':'rgba(18,26,48,0.86)');
      sc.fill(x,y,w,11,selected?'rgba(24,45,82,0.96)':'rgba(24,36,64,0.88)');
      sc.fill(x+1,y+1,w-2,1,selected?'#86d9ff':'rgba(255,255,255,0.18)');
      if(selected){sc.fill(x-3,y+4,2,4,'#ffe078');sc.fill(x+w+1,y+4,2,4,'#ffe078');}
      sc.text(it.label,80,y+2,{size:selected?7.3:6.8,weight:selected?'800':'600',align:'center',color:'#fffaf0',shadow:'#111a2c'});
    });
    sc.text(`V${GAME_VERSION}`,153,211,{size:7,weight:'800',align:'right',color:'#ffffff',shadow:'#111827'});
  }
}


/* ===== js/systems/battle.js ===== */
// ============================================================


/* ===== js/systems/battle.js ===== */
// battle.js — 야생 몬스터와의 턴제 전투
// ------------------------------------------------------------
// 기본 공격 1개로 굴러가지만, 기술 배열을 넣을 자리를 미리 비워 뒀다.
// (species.moves 를 추가하면 MOVE 선택 화면만 붙이면 된다)
// ============================================================









function calcDamage(atk, def, move, atkStat = atk.atk, defStat = def.def) {
  if (!move || !move.power) return { dmg:0, mult:1 };
  const lvl = atk.level;
  const base = Math.floor(((2 * lvl / 5 + 2) * move.power * atkStat / Math.max(1, defStat)) / 25) + 2;
  const mult = typeMultiplier(move.type, MONSTERS[def.id].type);
  const stab = MONSTERS[atk.id].type === move.type ? 1.15 : 1;
  const rand = 0.85 + Math.random() * 0.15;
  return { dmg: Math.max(1, Math.floor(base * mult * stab * rand)), mult };
}

// 개체가 쓸 수 있는 기술 목록 (구버전 세이브 방어)
function movesOf(inst) {
  if (!inst.moves || !inst.moves.length) inst.moves = movesAtLevel(inst.id, inst.level);
  return inst.moves;
}

class Battle {
  constructor(game, enemy, opts = {}) {
    this.game = game;
    this.enemy = enemy;
    this.trainer = opts.trainer || null;
    this.legendary = opts.legendary || null;
    this.fieldBoss = opts.fieldBoss || null;
    this.stages = new Map();
    this.stageTurns = new Map(); // v7.8 버프/디버프 남은 턴
    this.stageFresh = new Map(); // 적용 직후 같은 라운드에서 지속시간이 차감되지 않게 표시
    this.active = game.state.party.find((m) => m.hp > 0);
    if (this.active) normalizeInstance(this.active);
    if (this.enemy) normalizeInstance(this.enemy);
    this.mode = 'script';           // script | menu | bag | party
    this.menu = new MenuCursor(4, 2);
    this.moveMenu = new MenuCursor(MOVE_MAX, 2);
    this.bagCursor = new MenuCursor(1);
    this.partyCursor = new MenuCursor(game.state.party.length);
    this.queue = [];
    this.current = null;
    this.textT = 0;
    this.lunge = null;
    this.flash = null;
    this.attackFx = null;
    this.ball = null;
    this.hideEnemy = false;
    this.enemyScale = 1;
    this.evoAnim = null;
    this.result = null;
    this.runAttempts = 0;
    // 같은 야생 전투에서 포획에 실패할수록 다음 시도의 성공률이 조금씩 오른다.
    // 전투가 끝나면 초기화되며, 5회 실패 이후에는 최대 +7.5%p에서 멈춘다.
    this.captureFailures = 0;
    this.disp = { p: this.active.hp, e: enemy.hp };
    this.intro = 0;

    if (!game.state.dex[enemy.id]) game.state.dex[enemy.id] = 1;
    if (this.trainer) {
      for (const line of (this.trainer.before || [])) this.push({ text: line });
      this.push({ text: `${this.trainer.name}이(가) ${MONSTERS[enemy.id].name} Lv.${enemy.level}을(를) 내보냈다!` });
    } else {
      this.push({ text: `앗! 야생 ${MONSTERS[enemy.id].name} Lv.${enemy.level}이(가) 튀어나왔다!` });
      if ((game.state.dex[enemy.id] || 0) < 2) this.push({ text: '도감에 새로운 몬스터가 기록되었다!' });
    }
    this.push({ text: `가라, ${displayName(this.active)}!` });
    this.push({ do: () => { this.mode = 'menu'; } });
    sfx.encounter();
  }

  // ---------------------------------------------------------- 스크립트 큐
  push(step) { this.queue.push(step); }
  pushAll(steps) { steps.forEach((s) => this.queue.push(s)); }

  say(text) { this.push({ text }); }

  // ---------------------------------------------------------- 턴 처리
  modsFor(inst) {
    if (!inst) return { atk:0, def:0, spd:0 };
    if (!this.stages.has(inst.sid)) this.stages.set(inst.sid, { atk:0, def:0, spd:0 });
    return this.stages.get(inst.sid);
  }

  turnsFor(inst) {
    if (!inst) return { atk:0, def:0, spd:0 };
    if (!this.stageTurns.has(inst.sid)) this.stageTurns.set(inst.sid, { atk:0, def:0, spd:0 });
    return this.stageTurns.get(inst.sid);
  }

  freshTurnsFor(inst) {
    if (!inst) return { atk:0, def:0, spd:0 };
    if (!this.stageFresh.has(inst.sid)) this.stageFresh.set(inst.sid, { atk:0, def:0, spd:0 });
    return this.stageFresh.get(inst.sid);
  }

  timedStatLabel(inst) {
    if (!inst) return '';
    const mods = this.modsFor(inst), turns = this.turnsFor(inst);
    const keys = [['atk','공'],['def','방'],['spd','속']];
    return keys.filter(([k]) => (mods[k] || 0) !== 0 && (turns[k] || 0) > 0)
      .map(([k,n]) => `${n}${mods[k] > 0 ? '↑' : '↓'}${turns[k]}T`).join(' ');
  }

  tickTimedStats(inst) {
    if (!inst) return [];
    const mods = this.modsFor(inst), turns = this.turnsFor(inst), fresh = this.freshTurnsFor(inst), expired = [];
    const names = { atk:'공격', def:'방어', spd:'속도' };
    for (const key of ['atk','def','spd']) {
      if ((mods[key] || 0) === 0 || (turns[key] || 0) <= 0) continue;
      // 버프/디버프를 사용한 바로 그 라운드는 3턴 중 1턴으로 소모하지 않는다.
      if ((fresh[key] || 0) > 0) { fresh[key]--; continue; }
      turns[key]--;
      if (turns[key] <= 0) {
        const wasUp = mods[key] > 0;
        mods[key] = 0;
        turns[key] = 0;
        fresh[key] = 0;
        expired.push(`${displayName(inst)}의 ${names[key]} ${wasUp ? '상승' : '감소'} 효과가 끝났다!`);
      }
    }
    return expired;
  }

  stageMult(stage) {
    const s = Math.max(-3, Math.min(3, stage || 0));
    return s >= 0 ? 1 + s * 0.28 : 1 / (1 + (-s) * 0.28);
  }

  effectiveStat(inst, key) {
    const mod = this.modsFor(inst)[key] || 0;
    let v = (inst[key] || 1) * this.stageMult(mod);
    if (key === 'spd' && inst.status === 'paralysis') v *= 0.55;
    if (key === 'atk' && inst.status === 'burn') v *= 0.86;
    return Math.max(1, v);
  }

  actionGate(inst) {
    if (inst.status === 'sleep') {
      if ((inst.statusTurns || 0) <= 0) {
        inst.status = null; inst.statusTurns = 0;
        return { ok:true, text:`${displayName(inst)}이(가) 잠에서 깨어났다!` };
      }
      inst.statusTurns--;
      return { ok:false, text:`${displayName(inst)}은(는) 깊이 잠들어 있다…` };
    }
    if (inst.status === 'paralysis' && Math.random() < 0.25) {
      return { ok:false, text:`${displayName(inst)}은(는) 몸이 저려 움직일 수 없다!` };
    }
    return { ok:true, text:null };
  }

  effectPlan(attacker, defender, move) {
    const e = move?.effect;
    if (!e || Math.random() > (e.chance ?? 1)) return null;
    if (e.status) {
      if (defender.status) return null;
      return { type:'status', target:defender, status:e.status,
        turns:e.status === 'sleep' ? 2 + Math.floor(Math.random() * 2) : 0,
        text:`${displayName(defender)}은(는) ${STATUS_NAMES[e.status] || e.status} 상태가 되었다!` };
    }
    if (e.stat) {
      const target = e.target === 'self' ? attacker : defender;
      const mods = this.modsFor(target);
      const before = mods[e.stat] || 0;
      const after = Math.max(-3, Math.min(3, before + (e.stages || 0)));
      if (before === after) return null;
      const name = e.stat === 'atk' ? '공격' : e.stat === 'def' ? '방어' : '속도';
      const up = after > before;
      const turns = Math.max(1, Number(e.turns || 3));
      return { type:'stat', target, stat:e.stat, after, turns,
        text:`${displayName(target)}의 ${name}이(가) ${up ? '올랐다!' : '떨어졌다!'} (${turns}턴)` };
    }
    return null;
  }

  applyEffect(plan) {
    if (!plan) return;
    if (plan.type === 'status') {
      plan.target.status = plan.status;
      plan.target.statusTurns = plan.turns || 0;
    } else if (plan.type === 'stat') {
      this.modsFor(plan.target)[plan.stat] = plan.after;
      this.turnsFor(plan.target)[plan.stat] = Math.max(1, plan.turns || 3);
      this.freshTurnsFor(plan.target)[plan.stat] = 1;
    }
  }

  effectKeyFor(attacker, move) {
    if (move?.id === 'focus' && MONSTERS[attacker?.id]?.type === '에스퍼') return 'focus_psychic';
    return move?.id || 'tackle';
  }

  startMoveFx(attacker, defender, move, who) {
    const selfTarget = !!move?.heal || move?.effect?.target === 'self';
    const targetWho = selfTarget ? who : (who === 'p' ? 'e' : 'p');
    this.attackFx = {
      type: move?.type || '노말',
      moveId: move?.id || 'tackle',
      effectKey: this.effectKeyFor(attacker, move),
      who, targetWho, t: 0, duration: 0.64, power: move?.power || 0,
    };
  }

  affordableMoves(inst) {
    normalizeSp(inst);
    return movesOf(inst).map(id => MOVES[id]).filter(mv => mv && inst.sp >= moveSpCost(mv));
  }

  chooseEnemyMove(inst) {
    const pool = this.affordableMoves(inst);
    return pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
  }

  queueSpRecovery(inst, who, next) {
    const gain = Math.max(1, Math.ceil(inst.maxSp * 0.28));
    const before = inst.sp;
    this.say(`${displayName(inst)}은(는) 호흡을 가다듬어 SP를 회복했다!`);
    this.push({ do: () => { inst.sp = Math.min(inst.maxSp, inst.sp + gain); sfx.blip(); } });
    this.say(`SP ${before} → ${Math.min(inst.maxSp, before + gain)}`);
    this.push({ do: () => { if (next) next(); } });
    void who;
  }

  queueAction(attacker, defender, move, who, next) {
    if (!attacker || attacker.hp <= 0 || !defender || defender.hp <= 0) { if (next) next(); return; }
    const gate = this.actionGate(attacker);
    if (gate.text) this.say(gate.text);
    if (!gate.ok) { this.push({ do: () => { if (next) next(); } }); return; }

    normalizeSp(attacker);
    const spCost = moveSpCost(move);
    if (attacker.sp < spCost) {
      this.say(`${displayName(attacker)}은(는) SP가 부족해 ${move.name}을(를) 사용할 수 없다!`);
      this.push({ do: () => { if (next) next(); } });
      return;
    }
    attacker.sp = Math.max(0, attacker.sp - spCost);

    const label = who === 'p' ? displayName(attacker)
      : this.trainer ? `${this.trainer.name}의 ${MONSTERS[attacker.id].name}`
      : this.fieldBoss ? `우두머리 ${MONSTERS[attacker.id].name}`
      : `야생 ${MONSTERS[attacker.id].name}`;
    this.say(`${label}의 ${move.name}!`);

    if (move.heal) {
      const amount = Math.max(1, Math.floor(attacker.maxHp * move.heal));
      const healed = Math.min(amount, attacker.maxHp - attacker.hp);
      this.push({ do: () => { this.startMoveFx(attacker, defender, move, who); sfx.blip(); } });
      this.push({ wait:0.34 });
      this.push({ do: () => { attacker.hp = Math.min(attacker.maxHp, attacker.hp + amount); sfx.heal(); } });
      this.push({ waitHp:true });
      this.say(healed > 0 ? `${displayName(attacker)}의 HP가 ${healed} 회복되었다!` : '하지만 HP는 이미 가득하다!');
    } else if (move.power > 0) {
      const { dmg, mult } = calcDamage(attacker, defender, move, this.effectiveStat(attacker,'atk'), this.effectiveStat(defender,'def'));
      this.push({ do: () => { this.lunge = { who, t:0 }; this.startMoveFx(attacker, defender, move, who); sfx.hit(); } });
      this.push({ wait:0.35 });
      this.push({ do: () => {
        defender.hp = Math.max(0, defender.hp - dmg);
        this.flash = { who: who === 'p' ? 'e' : 'p', t:0 };
        if (mult > 1) sfx.superHit();
      } });
      this.push({ waitHp:true });
      if (mult > 1) this.say('효과가 굉장했다!');
      else if (mult < 1) this.say('효과가 별로인 듯하다…');
    } else {
      this.push({ do: () => { this.startMoveFx(attacker, defender, move, who); sfx.blip(); } });
      this.push({ wait:0.34 });
    }

    const plan = defender.hp > 0 || move.power === 0 ? this.effectPlan(attacker, defender, move) : null;
    if (plan) {
      this.push({ do: () => this.applyEffect(plan) });
      this.say(plan.text);
    }
    this.push({ do: () => { if (next) next(); } });
  }

  playerAttack(moveId) {
    this.mode = 'script';
    const p = this.active, e = this.enemy;
    normalizeSp(p); normalizeSp(e);
    const pMove = MOVES[moveId] || MOVES[movesOf(p)[0]];
    const eMove = this.chooseEnemyMove(e);
    const pFirst = this.effectiveStat(p, 'spd') >= this.effectiveStat(e, 'spd');

    const enemyAction = (next) => {
      if (eMove) this.queueAction(e, p, eMove, 'e', next);
      else this.queueSpRecovery(e, 'e', next);
    };

    if (pFirst) {
      this.queueAction(p, e, pMove, 'p', () => {
        if (e.hp <= 0 || p.hp <= 0) { this.afterRound(); return; }
        enemyAction(() => this.afterRound());
      });
    } else {
      enemyAction(() => {
        if (p.hp <= 0 || e.hp <= 0) { this.afterRound(); return; }
        this.queueAction(p, e, pMove, 'p', () => this.afterRound());
      });
    }
  }

  queueResidual(inst) {
    if (!inst || inst.hp <= 0) return;
    if (inst.status !== 'poison' && inst.status !== 'burn') return;
    const dmg = Math.max(1, Math.floor(inst.maxHp / (inst.status === 'poison' ? 10 : 12)));
    const name = STATUS_NAMES[inst.status];
    this.say(`${displayName(inst)}은(는) ${name}의 피해를 입고 있다!`);
    this.push({ do: () => { inst.hp = Math.max(0, inst.hp - dmg); } });
    this.push({ waitHp:true });
  }

  afterRound() {
    // v7.8: 버프/디버프는 실제 턴 단위로 감소하고 만료 시 원상복구한다.
    const expired = [
      ...this.tickTimedStats(this.active),
      ...this.tickTimedStats(this.enemy),
    ];
    expired.forEach((text) => this.say(text));
    this.queueResidual(this.active);
    this.queueResidual(this.enemy);
    this.push({ do: () => this.resolveFaints() });
  }

  resolveFaints() {
    if (this.enemy.hp <= 0) { this.enemyDefeated(); return; }
    if (this.active.hp <= 0) {
      sfx.faint();
      this.say(`${displayName(this.active)}은(는) 쓰러졌다!`);
      this.push({ do: () => {
        const next = this.game.state.party.find((m) => m.hp > 0);
        if (!next) {
          this.say('눈앞이 캄캄해졌다…');
          this.push({ do: () => this.finish('whiteout') });
        } else {
          this.say('다음 몬스터를 선택하세요.');
          this.push({ do: () => { this.mode = 'party'; this.forcedSwitch = true; this.partyCursor.set(this.game.state.party.length); } });
        }
      } });
      return;
    }
    this.mode = 'menu';
  }

  enemyTurn() {
    if (!this.enemy || this.enemy.hp <= 0) { this.resolveFaints(); return; }
    normalizeSp(this.enemy);
    const move = this.chooseEnemyMove(this.enemy);
    if (move) this.queueAction(this.enemy, this.active, move, 'e', () => this.afterRound());
    else this.queueSpRecovery(this.enemy, 'e', () => this.afterRound());
  }

  queueExpEvents(inst, events, shared = false) {
    for (const ev of events) {
      if (ev.type === 'levelup') {
        const lv = ev.level, g = ev.gained;
        this.push({ do: () => sfx.levelup() });
        this.say(`${displayName(inst)}은(는) Lv.${lv}이(가) 되었다!${shared ? ' (공유 경험치)' : ''}`);
        this.say(`최대HP +${g.hp}  최대SP +${g.sp || 0}  공격 +${g.atk}  방어 +${g.def}  속도 +${g.spd}`);
      } else if (ev.type === 'learn') {
        this.queueLearn(inst, ev.move);
      } else if (ev.type === 'evolve') {
        this.queueEvolution(inst, ev.to);
      }
    }
  }

  enemyDefeated() {
    sfx.faint();
    this.push({ do: () => { this.hideEnemy = true; } });
    this.say(`${this.trainer ? '상대' : this.fieldBoss ? '우두머리' : '야생'} ${MONSTERS[this.enemy.id].name}을(를) 쓰러뜨렸다!`);
    const species = MONSTERS[this.enemy.id];
    const exp = Math.max(1, Math.floor(species.expYield * this.enemy.level / 2));
    const money = this.trainer ? 0 : 20 + this.enemy.level * 8;
    this.push({ do: () => {
      this.game.state.money += money;

      this.say(`${displayName(this.active)}은(는) 경험치 ${exp}를 얻었다!`);
      const activeEvents = gainExp(this.active, exp);
      this.queueExpEvents(this.active, activeEvents, false);

      // v7.4: 야생전 승리 시 파티의 나머지 몬스터가 25% 경험치를 공유한다.
      if (!this.trainer) {
        const companions = (this.game.state.party || []).filter(m => m && m !== this.active);
        if (companions.length) {
          const shareExp = Math.max(1, Math.floor(exp * 0.25));
          this.say(`파티 동료들도 경험치 ${shareExp}씩 나누어 받았다!`);
          for (const mate of companions) {
            normalizeInstance(mate);
            const events = gainExp(mate, shareExp);
            this.queueExpEvents(mate, events, true);
          }
        }
      }

      if (money) this.say(`상금 ${money}원을 손에 넣었다!`);
      this.push({ do: () => this.sendNextOrWin() });
    } });
  }

  // 트레이너전이면 다음 몬스터를 내보내고, 아니면 전투를 끝낸다
  sendNextOrWin() {
    const t = this.trainer;
    if (t && t.index + 1 < t.roster.length) {
      t.index++;
      const next = t.roster[t.index];
      this.enemy = next;
      this.disp.e = next.hp;
      this.hideEnemy = false;
      this.enemyScale = 1;
      this.intro = 0;
      if (!this.game.state.dex[next.id]) this.game.state.dex[next.id] = 1;
      this.say(`${t.name}은(는) ${MONSTERS[next.id].name}을(를) 내보냈다!`);
      this.push({ do: () => { this.mode = 'menu'; } });
      return;
    }
    if (t) {
      this.say(`${t.name}과(와)의 승부에서 이겼다!`);
      for (const line of (t.lose || [])) this.say(line);
      this.push({ do: () => {
        this.game.state.money += t.reward;
        this.game.state.flags[`trainer_${t.id}`] = true;
        if (t.rematch) this.game.state.trainerRematch[t.id] = Date.now() + (t.rematchMinutes || 5) * 60 * 1000;
        sfx.buy();
        this.say(`상금 ${t.reward}원을 받았다!`);
        if (t.badge) this.push({ do: () => this.game.awardBadge(t.badge, t.name) });
        this.push({ do: () => this.finish('win') });
      } });
      return;
    }
    this.finish('win');
  }

  // 기술 습득: 자리가 있으면 바로, 꽉 찼으면 교체 화면을 띄운다
  queueLearn(inst, mid) {
    const mv = MOVES[mid];
    if (!mv) return;
    this.push({ do: () => {
      if (tryLearn(inst, mid)) {
        sfx.levelup();
        this.say(`${displayName(inst)}은(는) 새로 ${mv.name}을(를) 익혔다!`);
        return;
      }
      this.say(`${displayName(inst)}은(는) ${mv.name}을(를) 배우고 싶어 한다!`);
      this.say('하지만 기술은 4개까지만 익힐 수 있다…');
      this.push({ learn: { inst, move: mid } });
    } });
  }

  queueEvolution(inst, toId) {
    const fromName = displayName(inst);
    this.say(`어라…? ${fromName}의 모습이…!`);
    this.push({ do: () => { this.evoAnim = { t: 0, from: inst.id, to: toId }; sfx.evolve(); } });
    this.push({ waitEvo: true });
    this.push({ do: () => {
      evolveInstance(inst, toId);
      this.game.state.dex[toId] = 2;
      this.evoAnim = null;
      this.flashWhite = 0.8;
      this.say(`축하합니다! ${fromName}은(는) ${MONSTERS[toId].name}(으)로 진화했다!`);
      const st = MONSTERS[toId];
      this.say(`최대HP ${inst.maxHp}  최대SP ${inst.maxSp}  공격 ${inst.atk}  방어 ${inst.def}  속도 ${inst.spd}로 성장했다!`);
      for (const mid of evolutionMoveCandidates(inst)) this.queueLearn(inst, mid);
      void st;
    } });
  }

  // ---------------------------------------------------------- 포획
  throwBall(itemId) {
    this.mode = 'script';
    if (this.trainer) {
      sfx.deny();
      this.say('다른 사람의 몬스터에게 캡슐을 던질 수는 없다!');
      this.push({ do: () => { this.mode = 'menu'; } });
      return;
    }
    const item = ITEMS[itemId];
    this.game.removeItem(itemId, 1);
    this.say(`${item.name}을(를) 던졌다!`);
    this.push({ do: () => { this.ball = { t: 0, phase: 'throw', shakes: 0, shown: 0, itemId }; sfx.ball(); } });
    this.push({ wait: 0.5 });

    const guaranteed = !!item.guaranteed;
    const p = guaranteed ? 1 : catchChance(this.enemy, item.ballBonus, this.captureFailures);
    const shakes = guaranteed ? 3 : shakeCount(p);
    const caught = guaranteed ? true : shakes >= 3;

    this.push({ do: () => { this.ball.phase = 'suck'; } });
    this.push({ wait: 0.45 });
    for (let i = 0; i < Math.max(1, shakes); i++) {
      this.push({ do: () => { this.ball.phase = 'shake'; this.ball.t = 0; sfx.wobble(); } });
      this.push({ wait: 0.55 });
    }

    if (caught) {
      this.push({ do: () => { this.ball.phase = 'caught'; sfx.caught(); } });
      this.push({ wait: 0.5 });
      this.say(`앗! ${MONSTERS[this.enemy.id].name} Lv.${this.enemy.level}을(를) 포획했다!`);
      this.push({ do: () => {
        this.game.state.dex[this.enemy.id] = 2;
        this.game.claimCollectionRewards();
        const st = this.game.state;
        this.enemy.met = this.game.world.map.name;
        this.enemy.capturedWith = itemId;
        if (st.party.length < PARTY_MAX) {
          st.party.push(this.enemy);
          this.say(`${MONSTERS[this.enemy.id].name}이(가) 파티에 합류했다!`);
        } else {
          const box = st.box.find((b) => b.length < 20) || st.box[st.box.length - 1];
          box.push(this.enemy);
          this.say(`파티가 가득 차서 BOX로 보냈다.`);
        }
        this.say('도감이 갱신되었다!');
        this.push({ nickAsk: this.enemy });
        this.push({ do: () => this.finish('caught') });
      } });
    } else {
      this.push({ do: () => { this.ball.phase = 'break'; sfx.escape(); } });
      this.push({ wait: 0.4 });
      this.push({ do: () => { this.ball = null; } });
      const msg = shakes === 0 ? '앗! 캡슐에서 바로 빠져나왔다!'
        : shakes === 1 ? '아깝다! 조금만 더였는데!'
        : '아아! 거의 잡을 뻔했는데!';
      this.say(msg);
      this.captureFailures = Math.min(5, this.captureFailures + 1);
      this.say('포획 감응이 쌓였다. 다음 시도는 조금 더 유리하다!');
      this.push({ do: () => this.enemyTurn() });
    }
  }

  // ---------------------------------------------------------- 도망
  tryRun() {
    this.mode = 'script';
    if (this.trainer) {
      sfx.deny();
      this.say('상대에게서 등을 돌릴 수는 없다!');
      this.push({ do: () => { this.mode = 'menu'; } });
      return;
    }
    this.runAttempts++;
    const chance = Math.min(0.95, 0.5 + this.runAttempts * 0.15
      + (this.active.level - this.enemy.level) * 0.05);
    if (Math.random() < chance) {
      sfx.escape();
      this.say('무사히 도망쳤다!');
      this.push({ do: () => this.finish('run') });
    } else {
      sfx.deny();
      this.say('도망칠 수 없었다!');
      this.push({ do: () => this.enemyTurn() });
    }
  }

  useItem(itemId) {
    const item = ITEMS[itemId];
    if (item.returnHome) {
      this.mode = 'script';
      sfx.deny();
      this.say('전투 중에는 쓸 수 없다!');
      this.push({ do: () => { this.mode = 'menu'; } });
      return;
    }
    if (item.category === '포획') { this.throwBall(itemId); return; }
    if (item.revive || item.levelUp || item.teachMove) {
      this.mode = 'script';
      sfx.deny();
      this.say('전투 중에는 쓸 수 없다!');
      this.push({ do: () => { this.mode = 'menu'; } });
      return;
    }
    if (item.heal) {
      this.mode = 'script';
      if (this.active.hp >= this.active.maxHp) {
        this.say('HP가 이미 가득하다!');
        this.push({ do: () => { this.mode = 'menu'; } });
        return;
      }
      this.game.removeItem(itemId, 1);
      sfx.heal();
      this.active.hp = Math.min(this.active.maxHp, this.active.hp + item.heal);
      this.say(`${displayName(this.active)}의 HP가 회복되었다!`);
      this.push({ waitHp: true });
      this.push({ do: () => this.enemyTurn() });
      return;
    }
    if (item.spHeal || item.spFull) {
      this.mode = 'script';
      normalizeSp(this.active);
      if (this.active.sp >= this.active.maxSp) {
        this.say('SP가 이미 가득하다!');
        this.push({ do: () => { this.mode = 'menu'; } });
        return;
      }
      this.game.removeItem(itemId, 1);
      sfx.heal();
      const beforeSp = this.active.sp;
      this.active.sp = item.spFull
        ? this.active.maxSp
        : Math.min(this.active.maxSp, this.active.sp + item.spHeal);
      normalizeSp(this.active);
      this.say(`${displayName(this.active)}의 SP가 ${beforeSp} → ${this.active.sp}로 회복되었다!`);
      this.push({ wait: 0.25 });
      this.push({ do: () => this.enemyTurn() });
      return;
    }
    if (item.friendship) {
      this.mode = 'script';
      this.game.removeItem(itemId, 1);
      this.active.friendship = Math.min(255, this.active.friendship + item.friendship);
      this.say(`${displayName(this.active)}이(가) ${item.name}을(를) 맛있게 먹었다!`);
      this.push({ do: () => this.enemyTurn() });
    }
  }

  switchTo(inst) {
    const forced = this.forcedSwitch;
    this.forcedSwitch = false;
    this.mode = 'script';
    normalizeInstance(inst);
    this.active = inst;
    this.disp.p = inst.hp;
    this.say(`가라, ${displayName(inst)}!`);
    this.push({ do: () => { if (forced) this.mode = 'menu'; else this.enemyTurn(); } });
  }

  finish(result) {
    this.result = result;
    this.queue.length = 0;
    this.current = null;
    this.game.endBattle(result, this);
  }

  // ---------------------------------------------------------- 업데이트
  update(dt, input) {
    this.intro = Math.min(1, this.intro + dt * 3);
    if (this.lunge) { this.lunge.t += dt; if (this.lunge.t > 0.35) this.lunge = null; }
    if (this.flash) { this.flash.t += dt; if (this.flash.t > 0.35) this.flash = null; }
    if (this.attackFx) { this.attackFx.t += dt; if (this.attackFx.t > (this.attackFx.duration || 0.64)) this.attackFx = null; }
    if (this.ball) this.ball.t += dt;
    if (this.evoAnim) this.evoAnim.t += dt;
    if (this.flashWhite > 0) this.flashWhite = Math.max(0, this.flashWhite - dt * 2);

    // HP 바 애니메이션
    const ease = (cur, target, max) => {
      const speed = Math.max(6, max / 0.9) * dt;
      if (cur < target) return Math.min(target, cur + speed);
      if (cur > target) return Math.max(target, cur - speed);
      return target;
    };
    if (this.active) this.disp.p = ease(this.disp.p, this.active.hp, this.active.maxHp);
    this.disp.e = ease(this.disp.e, this.enemy.hp, this.enemy.maxHp);

    if (this.mode === 'script') { this.updateScript(dt, input); return; }
    if (this.mode === 'menu') { this.updateMenu(input); return; }
    if (this.mode === 'move') { this.updateMove(input); return; }
    if (this.mode === 'bag') { this.updateBag(input); return; }
    if (this.mode === 'party') { this.updateParty(input); return; }
  }

  updateMove(input) {
    const list = movesOf(this.active);
    this.moveMenu.set(list.length);
    const d = input.freshDirection();
    if (d && this.moveMenu.move(d)) sfx.blip();
    if (input.pressed('b')) { sfx.cancel(); this.mode = 'menu'; return; }
    if (input.pressed('a')) {
      const mv = MOVES[list[this.moveMenu.i]];
      normalizeSp(this.active);
      if (!mv || this.active.sp < moveSpCost(mv)) {
        const anyUsable = list.some(mid => this.active.sp >= moveSpCost(MOVES[mid]));
        if (!anyUsable) {
          sfx.confirm();
          this.mode = 'script';
          this.queueSpRecovery(this.active, 'p', () => this.enemyTurn());
          return;
        }
        sfx.deny();
        this.mode = 'script';
        this.say(`SP가 부족하다! ${mv?.name || '이 기술'}에는 SP ${moveSpCost(mv)}이 필요하다.`);
        this.push({ do: () => { this.mode = 'move'; } });
        return;
      }
      sfx.confirm();
      this.playerAttack(list[this.moveMenu.i]);
    }
  }

  // do 콜백이 새로 넣은 단계는 남은 큐보다 "앞"에 끼워 넣는다.
  // 그래야 "효과가 굉장했다!" 같은 후속 대사가 제 순서에 나온다.
  runDo(f) {
    const rest = this.queue;
    this.queue = [];
    f();
    this.queue = this.result ? [] : this.queue.concat(rest);
  }

  updateScript(dt, input) {
    if (!this.current) {
      if (!this.queue.length) return;
      this.current = this.queue.shift();
      this.textT = 0;
      if (this.current.do) { const f = this.current.do; this.current = null; this.runDo(f); return; }
      if (this.current.wait !== undefined) { this.current.left = this.current.wait; return; }
    }
    const c = this.current;
    if (!c) return;
    if (c.text !== undefined) {
      this.textT += dt;
      if (this.textT > 0.25 && (input.pressed('a') || input.pressed('b'))) {
        sfx.blip(); this.current = null;
      }
      return;
    }
    if (c.left !== undefined) {
      c.left -= dt;
      if (c.left <= 0) this.current = null;
      return;
    }
    if (c.waitHp) {
      if (Math.abs(this.disp.p - this.active.hp) < 0.5 && Math.abs(this.disp.e - this.enemy.hp) < 0.5) {
        this.disp.p = this.active.hp; this.disp.e = this.enemy.hp;
        this.current = null;
      }
      return;
    }
    if (c.waitEvo) {
      if (this.evoAnim && this.evoAnim.t > 3.0) this.current = null;
      return;
    }
    if (c.nickAsk) {
      if (!c.opened) {
        c.opened = true;
        const inst = c.nickAsk;
        const base = MONSTERS[inst.id].name;
        this.game.push(new Dialogue(`${base}에게 별명을 붙일까?`, {
          choices: [{ label: '아니오', value: false }, { label: '예', value: true }],
          onChoose: (v) => {
            if (!v) { c.done = true; return; }
            this.game.askName(inst, () => { c.done = true; });
          },
        }));
        return;
      }
      if (!c.done) return;
      this.current = null;
      return;
    }
    if (c.learn) {
      if (!c.opened) {
        c.opened = true;
        const { inst, move } = c.learn;
        this.game.push(new LearnMoveScene(inst, move, (slot) => { c.slot = slot; c.done = true; }));
        return;
      }
      if (!c.done) return;
      const { inst, move } = c.learn;
      const slot = c.slot;
      this.current = null;
      this.runDo(() => {
        if (slot === null || slot === undefined) {
          this.say(`${displayName(inst)}은(는) ${MOVES[move].name} 배우기를 포기했다.`);
        } else {
          const old = MOVES[inst.moves[slot]].name;
          replaceMove(inst, slot, move);
          sfx.levelup();
          this.say(`${displayName(inst)}은(는) ${old}을(를) 잊고`);
          this.say(`새로 ${MOVES[move].name}을(를) 익혔다!`);
        }
      });
      return;
    }
    this.current = null;
  }

  updateMenu(input) {
    const d = input.freshDirection();
    if (d && this.menu.move(d)) sfx.blip();
    if (input.pressed('a')) {
      sfx.confirm();
      const i = this.menu.i;
      if (i === 0) { this.mode = 'move'; this.moveMenu.set(movesOf(this.active).length); }
      else if (i === 1) { this.mode = 'bag'; this.bagCursor.set(this.bagList().length); }
      else if (i === 2) { this.mode = 'party'; this.partyCursor.set(this.game.state.party.length); }
      else this.tryRun();
    }
  }

  bagList() {
    return Object.entries(this.game.state.bag)
      .filter(([, n]) => n > 0)
      .map(([id, n]) => ({ id, n, item: ITEMS[id] }))
      .filter((e) => e.item);
  }

  updateBag(input) {
    const list = this.bagList();
    this.bagCursor.set(list.length);
    const d = input.freshDirection();
    if (d && this.bagCursor.move(d)) sfx.blip();
    if (input.pressed('b')) { sfx.cancel(); this.mode = 'menu'; return; }
    if (input.pressed('a') && list.length) {
      sfx.confirm();
      this.useItem(list[this.bagCursor.i].id);
    }
  }

  updateParty(input) {
    const party = this.game.state.party;
    this.partyCursor.set(party.length);
    const d = input.freshDirection();
    if (d && this.partyCursor.move(d)) sfx.blip();
    if (input.pressed('b') && !this.forcedSwitch) { sfx.cancel(); this.mode = 'menu'; return; }
    if (input.pressed('a')) {
      const target = party[this.partyCursor.i];
      if (!target || target.hp <= 0) { sfx.deny(); return; }
      if (target === this.active && !this.forcedSwitch) { sfx.deny(); return; }
      sfx.confirm();
      this.switchTo(target);
    }
  }

  // ---------------------------------------------------------- 렌더 (저해상도)
  drawWorld(sc) {
    const ctx = sc.wctx;
    // 배경
    const grd = ctx.createLinearGradient(0, 0, 0, 160);
    grd.addColorStop(0, '#8fd0f0');
    grd.addColorStop(1, '#d8eefa');
    ctx.fillStyle = grd; ctx.fillRect(0, 0, 160, 160);
    ctx.fillStyle = '#7ec25a'; ctx.fillRect(0, 96, 160, 64);
    ctx.fillStyle = '#68ab4c'; ctx.fillRect(0, 96, 160, 3);
    ctx.fillStyle = '#5f9c44'; ctx.fillRect(0, 140, 160, 20);
    ctx.fillStyle = '#20202e'; ctx.fillRect(0, 160, 160, 64);

    const drawPlatform = (cx, cy, rw) => {
      ctx.fillStyle = 'rgba(0,0,0,0.13)';
      ctx.beginPath(); ctx.ellipse(cx, cy, rw, rw * 0.28, 0, 0, Math.PI * 2); ctx.fill();
    };

    const shakeOf = (who) => {
      if (this.lunge && this.lunge.who === who) {
        const k = Math.sin(this.lunge.t / 0.35 * Math.PI);
        return who === 'p' ? { x: k * 8, y: -k * 5 } : { x: -k * 8, y: k * 5 };
      }
      if (this.flash && this.flash.who === who) {
        return { x: Math.sin(this.flash.t * 60) * 2, y: 0 };
      }
      return { x: 0, y: 0 };
    };

    // 적
    const ex = 96, ey = 26;
    drawPlatform(ex + 24, ey + 52, 30);
    if (!this.hideEnemy && !this.ball?.hidden) {
      const s = shakeOf('e');
      const sp = MONSTERS[this.enemy.id];
      const img = assets.battleMonster(sp);
      const maxDim = Math.min(74, battleMonsterSize(sp) * this.enemyScale);
      const sz = fitSpriteSize(img, maxDim, maxDim);
      const slide = (1 - this.intro) * 60;
      ctx.save();
      if (this.flash && this.flash.who === 'e' && Math.floor(this.flash.t * 24) % 2) ctx.globalAlpha = 0.25;
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(img, Math.round(ex + s.x + slide + 24 - sz.w / 2), Math.round(ey + s.y + 52 - sz.h), sz.w, sz.h);
      ctx.imageSmoothingEnabled = false;
      if (this.enemy.resonant) {
        ctx.fillStyle = '#fff4a0';
        for (let i=0;i<6;i++) { const a=this.intro*4+i; ctx.fillRect(Math.round(ex+24+Math.cos(a)*30), Math.round(ey+24+Math.sin(a)*25), 2, 2); }
      }
      ctx.restore();
    }

    // 아군
    const px0 = 14, py0 = 92;
    drawPlatform(px0 + 24, py0 + 52, 32);
    if (this.active && this.active.hp >= 0) {
      const s = shakeOf('p');
      const psp = MONSTERS[this.active.id];
      const img = assets.battleMonsterBack(psp);
      const slide = -(1 - this.intro) * 60;
      const maxDim = Math.min(72, battleMonsterSize(psp));
      const sz = fitSpriteSize(img, maxDim, maxDim);
      ctx.save();
      if (this.flash && this.flash.who === 'p' && Math.floor(this.flash.t * 24) % 2) ctx.globalAlpha = 0.25;
      if (this.active.hp <= 0) ctx.globalAlpha = 0.35;
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(img, Math.round(px0 + s.x + slide + 24 - sz.w / 2),
        Math.round(py0 + s.y + 52 - sz.h), sz.w, sz.h);
      ctx.imageSmoothingEnabled = false;
      if (this.active.resonant) {
        ctx.fillStyle = '#fff4a0';
        for (let i=0;i<6;i++) { const a=this.intro*4+i; ctx.fillRect(Math.round(px0+24+Math.cos(a)*28), Math.round(py0+24+Math.sin(a)*23), 2, 2); }
      }
      ctx.restore();
    }

    this.drawAttackFx(ctx);
    if (this.ball) this.drawBall(ctx, ex + 24, ey + 24);
    if (this.evoAnim) this.drawEvolution(ctx);
    if (this.flashWhite > 0) {
      ctx.fillStyle = `rgba(255,255,255,${Math.min(1, this.flashWhite)})`;
      ctx.fillRect(0, 0, 160, 160);
    }
  }

  drawAttackFx(ctx) {
    const fx = this.attackFx;
    if (!fx) return;
    const duration = fx.duration || 0.64;
    const t = Math.min(1, fx.t / duration);
    const target = fx.targetWho === 'p' ? {x:38,y:118} : {x:120,y:50};
    const img = assets.moveEffect(fx.effectKey || fx.moveId);
    if (img && img.width >= 1024 && img.height >= 128) {
      const ff = Math.min(7, t * 7);
      const frame = Math.floor(ff), next = Math.min(7, frame + 1), mix = ff - frame;
      let size = fx.power <= 0 ? 76 : fx.power >= 60 ? 96 : fx.power >= 50 ? 90 : 84;
      if (['heavenbolt','dragonstorm','phantom','abyss','solarflare'].includes(fx.moveId)) size = 100;
      const fade = t > 0.88 ? Math.max(0, (1 - t) / 0.12) : 1;
      ctx.save();
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.translate(Math.round(target.x), Math.round(target.y));
      if (fx.who === 'e') ctx.scale(-1, 1);
      ctx.globalAlpha = fade * (1 - mix);
      ctx.drawImage(img, frame * 128, 0, 128, 128, -size/2, -size/2, size, size);
      if (next !== frame && mix > 0.001) {
        ctx.globalAlpha = fade * mix;
        ctx.drawImage(img, next * 128, 0, 128, 128, -size/2, -size/2, size, size);
      }
      ctx.restore();
      return;
    }

    // PNG가 아직 첫 프레임에서 로딩 중일 때만 쓰는 구버전 폴백.
    const from = fx.who === 'p' ? {x:38,y:118} : {x:120,y:50};
    const to   = fx.who === 'p' ? {x:120,y:50} : {x:38,y:118};
    const x = from.x + (to.x - from.x) * t;
    const y = from.y + (to.y - from.y) * t;
    const col = TYPE_COLORS[fx.type] || '#ffffff';
    ctx.save(); ctx.globalAlpha = 0.92 * (1 - Math.max(0, t - 0.72) / 0.28);
    ctx.fillStyle = col; ctx.strokeStyle = col;
    const burst = (cx,cy,n=7,len=10) => { for(let i=0;i<n;i++){const a=i/n*Math.PI*2+fx.t*8;ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+Math.cos(a)*len*(0.5+t),cy+Math.sin(a)*len*(0.5+t));ctx.stroke();} };
    if (fx.type === '불') {
      for(let i=0;i<4;i++){const oy=i*2;ctx.beginPath();ctx.arc(x-i*4,y+oy,5-i,0,Math.PI*2);ctx.fill();}
      ctx.fillStyle='#fff09a';ctx.fillRect(Math.round(x-2),Math.round(y-2),4,4);
    } else if (fx.type === '물') {
      ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(from.x,from.y);ctx.quadraticCurveTo((from.x+to.x)/2,from.y-28,to.x,to.y);ctx.stroke();
      ctx.fillStyle='#d9f7ff';ctx.fillRect(Math.round(x-2),Math.round(y-2),4,4);
    } else if (fx.type === '전기') {
      ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(from.x,from.y);ctx.lineTo((from.x+x)/2+5,(from.y+y)/2-4);ctx.lineTo((from.x+x)/2-3,(from.y+y)/2+4);ctx.lineTo(x,y);ctx.stroke();burst(x,y,6,9);
    } else if (fx.type === '풀' || fx.type === '페어리') {
      for(let i=0;i<7;i++){const a=i*2.3+fx.t*10;const r=4+i*1.2;ctx.fillRect(Math.round(x+Math.cos(a)*r),Math.round(y+Math.sin(a)*r),2,1);}
    } else if (fx.type === '얼음') {
      for(let i=0;i<5;i++){const a=i/5*Math.PI*2;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+Math.cos(a)*12,y+Math.sin(a)*12);ctx.stroke();} ctx.fillStyle='#ffffff';ctx.fillRect(Math.round(x-2),Math.round(y-2),4,4);
    } else if (fx.type === '고스트' || fx.type === '악' || fx.type === '에스퍼') {
      ctx.beginPath();ctx.arc(x,y,8+Math.sin(fx.t*20)*3,0,Math.PI*2);ctx.stroke();ctx.beginPath();ctx.arc(x,y,3,0,Math.PI*2);ctx.fill();
    } else if (fx.type === '바위' || fx.type === '강철' || fx.type === '드래곤') {
      burst(x,y,8,12);ctx.fillRect(Math.round(x-4),Math.round(y-4),8,8);
    } else {
      burst(x,y,7,10);ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fill();
    }
    ctx.restore();
  }

  drawBall(ctx, targetX, targetY) {
    const b = this.ball;
    let x = 40, y = 120;
    if (b.phase === 'throw') {
      const t = Math.min(1, b.t / 0.5);
      x = 40 + (targetX - 40) * t;
      y = 120 + (targetY - 120) * t - Math.sin(t * Math.PI) * 40;
    } else if (b.phase === 'suck') {
      x = targetX; y = targetY;
      const t = Math.min(1, b.t / 0.45);
      this.enemyScale = 1 - t;
      if (t >= 1) { this.hideEnemy = true; this.enemyScale = 1; }
    } else {
      x = targetX; y = targetY + 26;
      if (b.phase === 'shake') {
        const k = Math.sin(Math.min(1, b.t / 0.55) * Math.PI * 2);
        x += k * 5;
      }
      if (b.phase === 'break') { this.hideEnemy = false; }
      if (b.phase === 'caught') {
        ctx.fillStyle = 'rgba(255,245,170,0.22)';
        ctx.fillRect(0, 0, 160, 160);
      }
    }
    // 포켓볼 도형을 그리지 않는다. 실제 사용한 몬스티아 캡슐 이미지를 그대로 날린다.
    const img = assets.itemIcon(b.itemId || 'capsule');
    const iw = Math.max(1, img.naturalWidth || img.width || 1);
    const ih = Math.max(1, img.naturalHeight || img.height || 1);
    const max = b.phase === 'caught' ? 14 : 12;
    const k = Math.min(max / iw, max / ih);
    const w = Math.max(8, iw * k), h = Math.max(8, ih * k);
    ctx.save();
    ctx.imageSmoothingEnabled = false;
    if (b.phase === 'throw') {
      ctx.translate(x, y); ctx.rotate(b.t * 11);
      ctx.drawImage(img, -w/2, -h/2, w, h);
    } else {
      ctx.drawImage(img, x-w/2, y-h/2, w, h);
    }
    ctx.restore();
  }

  drawEvolution(ctx) {
    const e = this.evoAnim;
    const t = e.t;
    const CX = 80, CY = 74;

    ctx.fillStyle = '#0d0d16';
    ctx.fillRect(0, 0, 160, 160);

    // 회전하는 빛줄기
    ctx.save();
    ctx.translate(CX, CY);
    const rays = 14;
    for (let i = 0; i < rays; i++) {
      const a = (i / rays) * Math.PI * 2 + t * 1.1;
      ctx.fillStyle = i % 2 ? 'rgba(255,242,180,0.13)' : 'rgba(150,200,255,0.09)';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(a - 0.12) * 170, Math.sin(a - 0.12) * 170);
      ctx.lineTo(Math.cos(a + 0.12) * 170, Math.sin(a + 0.12) * 170);
      ctx.fill();
    }
    ctx.restore();

    // 안쪽으로 수축하는 링 3겹
    for (let i = 0; i < 3; i++) {
      const r = 78 - ((t * 70 + i * 26) % 78);
      ctx.strokeStyle = `rgba(255,255,255,${(r / 78) * 0.55})`;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(CX, CY, Math.max(1, r), 0, Math.PI * 2);
      ctx.stroke();
    }

    // 형태 교차 — 시간이 갈수록 빨라진다
    const freq = 1.6 + t * t * 2.2;
    const showNew = t > 2.5 ? true : Math.floor(t * freq) % 2 === 1;
    const sp = MONSTERS[showNew ? e.to : e.from];
    const img = assets.battleMonster(sp);
    const pulse = 1 + Math.sin(t * 6) * 0.05;
    const grow = t > 2.5 ? 1.12 : 1;
    const maxDim = Math.min(86, (battleMonsterSize(sp) + 8) * pulse * grow);
    const sz = fitSpriteSize(img, maxDim, maxDim);
    ctx.save();
    if (t < 2.2) ctx.globalAlpha = 0.92;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(img, CX - sz.w / 2, CY - sz.h / 2, sz.w, sz.h);
    ctx.restore();

    // 실루엣 느낌을 주는 흰 베일 (교차 구간에서만)
    if (t < 2.2) {
      ctx.fillStyle = `rgba(255,255,255,${0.16 + Math.abs(Math.sin(t * freq * Math.PI)) * 0.2})`;
      ctx.fillRect(0, 0, 160, 160);
    }

    // 완성 순간의 플래시
    if (t >= 2.2 && t < 2.6) {
      ctx.fillStyle = `rgba(255,255,255,${1 - (t - 2.2) / 0.4})`;
      ctx.fillRect(0, 0, 160, 160);
    }

    // 흩날리는 반짝임
    const sparks = t > 2.5 ? 22 : 12;
    for (let i = 0; i < sparks; i++) {
      const a = (i / sparks) * Math.PI * 2 + t * (i % 2 ? 2.2 : -1.6);
      const rad = t > 2.5 ? 20 + ((t - 2.5) * 120 + i * 7) % 70 : 30 + Math.sin(t * 4 + i) * 16;
      const size = i % 3 === 0 ? 2 : 1;
      ctx.fillStyle = i % 2 ? '#fff6a0' : '#ffffff';
      ctx.fillRect(Math.round(CX + Math.cos(a) * rad), Math.round(CY + Math.sin(a) * rad), size, size);
    }

    // 진화 중 문구
    if (t > 2.6) {
      ctx.fillStyle = 'rgba(0,0,0,0.35)';
      ctx.fillRect(0, 138, 160, 22);
    }
  }

  // ---------------------------------------------------------- 렌더 (UI)
  drawUI(sc) {
    const enemySp = MONSTERS[this.enemy.id];
    // v6.7: 몬스터 이름을 줄임표로 자르지 않는다. 이름 전체를 유지하고 폰트만 줄인다.
    sc.box(4, 8, 88, 27);
    const enemyLv = `Lv.${this.enemy.level}`;
    sc.text(enemySp.name, 9, 12, { size: 8, minSize: 3.0, maxW: 36, ellipsis: false, weight: '700' });
    sc.text(enemyLv, 64, 13, { size: 6, align: 'right', color: COL.dim, weight: '700' });
    sc.text('HP', 9, 24, { size: 7, color: COL.accent, weight: '700' });
    const er = this.disp.e / this.enemy.maxHp;
    sc.bar(21, 25, 64, 5, er, sc.hpColor(er));
    // 타입 뱃지
    sc.panel(66, 11, 22, 8, TYPE_COLORS[enemySp.type] || '#888');
    sc.text(enemySp.type, 77, 12, { size: 6, align: 'center', color: '#fff' });
    if (this.enemy.status) sc.text(STATUS_NAMES[this.enemy.status] || this.enemy.status, 88, 25, { size:6, align:'right', color:COL.hpLow });
    const enemyTimed = this.timedStatLabel(this.enemy);
    if (enemyTimed) sc.text(enemyTimed, 8, 37, { size:5.5, color:'#8a50b8', weight:'700', maxW:82, minSize:4.2 });

    // 아군 정보
    if (this.active) {
      const a = this.active, asp = MONSTERS[a.id];
      // v7.6.1: HP/SP 잔량 숫자를 같은 행의 우측에 배치해 서로 겹치지 않도록 재구성.
      sc.box(68, 96, 88, 56);
      const activeNameFull = displayName(a);
      const activeLv = `Lv.${a.level}`;
      sc.text(activeNameFull, 73, 100, { size: 8, minSize: 3.0, maxW: 34, ellipsis: false, weight: '700' });
      sc.text(activeLv, 127, 101, { size: 6, align: 'right', color: COL.dim, weight: '700' });
      sc.panel(129, 100, 22, 8, TYPE_COLORS[asp.type] || '#888');
      sc.text(asp.type, 140, 101, { size: 6, align: 'center', color: '#fff' });

      const pr = this.disp.p / a.maxHp;
      sc.text('HP', 73, 113, { size: 6.3, color: COL.accent, weight: '700' });
      sc.text(`${Math.ceil(this.disp.p)}/${a.maxHp}`, 152, 113, { size: 5.9, align: 'right', color: COL.dim, weight:'700' });
      sc.bar(85, 120, 64, 4, pr, sc.hpColor(pr));

      normalizeSp(a);
      sc.text('SP', 73, 128, { size: 6.1, color:'#3974b8', weight:'700' });
      sc.text(`${a.sp}/${a.maxSp}`, 152, 128, { size:5.7, align:'right', color:'#3974b8', weight:'700' });
      sc.bar(85, 135, 64, 4, a.sp / Math.max(1,a.maxSp), '#3974b8');

      sc.text('EXP', 73, 143, { size: 5.5, color: COL.dim });
      sc.bar(94, 145, 55, 3, a.exp / a.expToNext, COL.exp);
      if (a.status) sc.text(STATUS_NAMES[a.status] || a.status, 152, 143, { size:5.2, align:'right', color:COL.hpLow });
      const activeTimed = this.timedStatLabel(a);
      if (activeTimed) sc.text(activeTimed, 151, 155, { size:5.5, align:'right', color:'#8a50b8', weight:'700', maxW:82, minSize:4.2 });
    }

    // 하단
    if (this.mode === 'menu') {
      sc.box(3, 164, 84, 57);
      sc.text('무엇을 할까?', 10, 186, { size: 9 });
      sc.box(88, 164, 69, 57);
      const items = ['싸운다', '가방', '몬스터', '도망'];
      for (let i = 0; i < 4; i++) {
        const cx = 96 + (i % 2) * 32, cy = 176 + Math.floor(i / 2) * 22;
        if (this.menu.i === i) sc.cursor(cx - 6, cy + 2);
        sc.text(items[i], cx, cy, { size: 9 });
      }
      return;
    }

    if (this.mode === 'move') { this.drawMovePicker(sc); return; }
    if (this.mode === 'bag') { this.drawBag(sc); return; }
    if (this.mode === 'party') { this.drawPartyPicker(sc); return; }

    // 메시지
    sc.box(3, 164, 154, 57);
    const c = this.current;
    if (c && c.text !== undefined) {
      const lines = sc.wrap(c.text, 140, 9).slice(0, 3);
      lines.forEach((l, i) => sc.text(l, 11, 174 + i * 13, { size: 9 }));
      if (this.textT > 0.25) sc.arrow(146, 210);
    }
  }

  drawMovePicker(sc) {
    const list = movesOf(this.active);
    normalizeSp(this.active);
    sc.box(3, 164, 108, 57);
    for (let i = 0; i < list.length; i++) {
      const mv = MOVES[list[i]];
      const x = 12 + (i % 2) * 50, y = 170 + Math.floor(i / 2) * 24;
      const cost = moveSpCost(mv);
      const usable = this.active.sp >= cost;
      if (this.moveMenu.i === i) sc.cursor(x - 7, y + 4);
      sc.text(mv.name, x, y, { size: 7.4, maxW: 42, minSize:5.5, color:usable?COL.ink:COL.shade });
      sc.text(`SP ${cost}`, x, y + 9, { size:5.2, color:usable?'#3974b8':COL.hpLow, weight:'700' });
    }
    const sel = MOVES[list[this.moveMenu.i]] || MOVES[list[0]];
    const cost = moveSpCost(sel);
    sc.box(113, 164, 44, 57);
    sc.panel(118, 170, 34, 9, TYPE_COLORS[sel.type] || '#888');
    sc.text(sel.type, 135, 171, { size: 6.5, align: 'center', color: '#fff' });
    sc.text(sel.power ? `위력 ${sel.power}` : (sel.effect?.stat ? `보조 ${sel.effect.turns || 3}턴` : '보조 기술'), 135, 184, { size:6.3, align:'center', color:COL.dim, maxW:36, minSize:5 });
    sc.text(`SP ${cost}`, 135, 195, { size:8, align:'center', weight:'800', color:this.active.sp>=cost?'#3974b8':COL.hpLow });
    sc.text(`보유 ${this.active.sp}`, 135, 205, { size:5.5, align:'center', color:COL.dim });
    sc.text('B 뒤로', 135, 213, { size: 5.5, align: 'center', color: COL.dim });
  }

  drawBag(sc) {
    const list = this.bagList();
    sc.box(3, 132, 154, 89);
    sc.text('가방', 11, 137, { size: 9, weight: '700', color: COL.accent });
    if (!list.length) { sc.text('아무것도 없다.', 11, 156, { size: 9 }); return; }
    const start = Math.max(0, Math.min(this.bagCursor.i - 2, list.length - 4));
    for (let k = 0; k < Math.min(4, list.length); k++) {
      const idx = start + k, e = list[idx];
      if (!e) break;
      const y = 154 + k * 15;
      if (this.bagCursor.i === idx) sc.cursor(8, y + 2);
      sc.hqFit(assets.itemIcon(e.id), 13, y - 3, 16, 16, {ay:0.5});
      sc.text(e.item.name, 32, y, { size: 8, maxW: 92, minSize:5 });
      sc.text(`×${e.n}`, 150, y, { size: 8, align: 'right', color: COL.dim });
    }
    sc.text('B 취소', 150, 137, { size: 7, align: 'right', color: COL.dim });
  }

  drawPartyPicker(sc) {
    const party = this.game.state.party;
    sc.box(3, 120, 154, 101);
    sc.text(this.forcedSwitch ? '몬스터를 선택하세요' : '교체할 몬스터는?', 11, 125, { size: 9, weight: '700', color: COL.accent });
    party.forEach((m, i) => {
      const y = 140 + i * 13;
      if (y > 208) return;
      const sp = MONSTERS[m.id];
      if (this.partyCursor.i === i) sc.cursor(8, y + 2);
      const label = m === this.active ? '▸' : ' ';
      sc.text(`${label}${displayName(m)}`, 15, y, {
        size: 8, color: m.hp > 0 ? COL.ink : COL.hpLow, maxW: 72, minSize:3.5, ellipsis:false,
      });
      sc.text(`Lv.${m.level}`, 92, y, { size: 7, color: COL.dim });
      const r = m.hp / m.maxHp;
      sc.bar(112, y + 2, 34, 4, r, sc.hpColor(r));
      sc.hqFit(assets.battleMonster(sp), 145, y - 2, 12, 12, { ay:0.5 });
    });
  }
}


/* ===== js/core/game.js ===== */
// ============================================================


/* ===== js/core/game.js ===== */
// game.js — 게임 본체
// ------------------------------------------------------------
// mode : 'title' | 'field' | 'battle'
// overlays : 메뉴/대화창 스택. 맨 위 씬만 입력을 받는다.
// ============================================================














// ------------------------------------------------------------
// 월드 진행 레벨 제한
// - v6.1 아트/크기/UI 리워크에서도 기존 진행 제한과 세이브 호환을 그대로 유지한다.
// - 전진할 때만 검사하며, 이미 지나온 지역으로 되돌아가는 것은 자유롭다.
// - 기준은 파티 내 최고 레벨이다.
// ------------------------------------------------------------
const WORLD_PROGRESS = [
  { id:'town',      min:0  },
  { id:'route01',   min:5  },
  { id:'forest01',  min:8  },
  { id:'town02',    min:12 },
  { id:'cave01',    min:15 },
  { id:'route02',   min:20 },
  { id:'town03',    min:25 },
  { id:'route03b',  min:28 },
  { id:'route03c',  min:32 },
  { id:'town04',    min:36 },
  { id:'route04b',  min:39 },
  { id:'route04c',  min:42 },
  { id:'town05',    min:45 },
  { id:'route05a',  min:48 },
  { id:'route05b',  min:52 },
  { id:'town06',    min:56 },
  { id:'route06a',  min:60 },
  { id:'route06b',  min:64 },
  { id:'town07',    min:68 },
  { id:'route07a',  min:72 },
  { id:'route07b',  min:76 },
];
const WORLD_PROGRESS_INDEX = Object.fromEntries(WORLD_PROGRESS.map((v,i)=>[v.id,i]));
const WORLD_PROGRESS_MIN = Object.fromEntries(WORLD_PROGRESS.map(v=>[v.id,v.min]));

class Game {
  constructor(root) {
    this.root = root;
    const canvas = root.querySelector('#screen');
    const worldCanvas = document.createElement('canvas');
    worldCanvas.width = VW; worldCanvas.height = VH;
    this.screen = new Screen(canvas, worldCanvas);
    this.input = input;
    this.world = new World(this);
    this.overlays = [];
    this.mode = 'loading';
    this.battle = null;
    this.transition = null;
    this.flash = 0;
    this.areaTitle = null;
    this.rewardNotices = [];
    this.cheats = { noclip: false, encounterMul: 1 };
    this.state = this.freshState();
    this.title = new TitleScene(this);
    this.loading = new LoadingScene(this);
    this.last = 0;
  }

  // ---------------------------------------------------------- 상태
  freshState() {
    return {
      saveVersion: SAVE_VERSION,
      map: START_MAP, x: START_POS.x, y: START_POS.y, dir: START_POS.dir,
      money: 1500,
      party: [],
      box: Array.from({ length: BOX_COUNT }, () => []),
      dex: {},
      bag: { capsule: 5, potion: 2, scroll: 1 },
      flags: {},
      visited: {},
      legendaryRespawn: {},
      fieldBossRespawn: {},
      trainerRematch: {},
      discoveredMaps: {},
      fieldDrops: {},
      attendance: { lastClaimDate:null, totalDays:0 },
      mount: null,
      upgrades: { autoPickup:false },
      quests: {},
      trackedQuest: null,
      achievements: {},
      activeTitle: '신입 모험가',
      badges: {},
      collectionRewards: { dexComplete: false, badgeComplete: false, dexMilestones: {} },
      progress: { starter: false, visitedLab: false },
      settings: { textSpeed: 1, sound: true },
      playtime: 0,
      sidNext: 1,
    };
  }

  hasSave() { return save.has(); }

  mountedMonster() {
    const sid=this.state.mount?.sid;
    if (!sid) return null;
    const m=(this.state.party||[]).find(v=>v.sid===sid && v.hp>0) || null;
    if (!m) {
      this.state.mount=null;
      if (this.world?.follower) this.world.follower.visible=!!(this.state.party||[]).length;
    }
    return m;
  }

  isMounted() { return !!this.mountedMonster(); }

  mountMonster(inst, mode='land', announce=true) {
    if (!inst || inst.hp<=0 || !(this.state.party||[]).includes(inst)) return false;
    const sp=MONSTERS[inst.id];
    if (mode==='land' && !sp?.legendary) {
      if (announce) this.say('필드에서 탈 수 있는 육상 몬스터는 전설 몬스터뿐이다.');
      return false;
    }
    if (mode==='water' && sp?.type!=='물') {
      if (announce) this.say('물 위에서는 물 타입 몬스터만 탈 수 있다.');
      return false;
    }
    this.state.mount={sid:inst.sid,mode};
    const p=this.world.player, f=this.world.follower;
    if (f) { f.visible=false; f.moving=false; f.tx=p.tx; f.ty=p.ty; f.px=p.px; f.py=p.py; }
    if (announce) this.toast(`${displayName(inst)} 탑승 · 이동 속도 증가`);
    return true;
  }

  dismount(force=false, announce=true) {
    const m=this.mountedMonster();
    if (!m) { this.state.mount=null; return true; }
    if (!force && this.state.mount?.mode==='water') {
      const p=this.world.player;
      if (this.world.tileProps(p.tx,p.ty).key==='water') {
        if (announce) this.say('물 위에서는 내릴 수 없다. 육지로 이동하자.');
        return false;
      }
    }
    this.state.mount=null;
    const p=this.world.player, f=this.world.follower;
    if (f) {
      f.visible=!!this.state.party.length;
      f.moving=false; f.tx=p.tx; f.ty=p.ty; f.px=p.px; f.py=p.py; f.dir=p.dir;
    }
    if (announce) this.toast(`${displayName(m)}에게서 내렸다.`);
    return true;
  }

  startNewGame() {
    this.rewardNotices = [];
    this.state = this.freshState();
    resetSid(1);
    sfx.on = this.state.settings.sound;
    this.beginPlay(START_MAP, START_POS.x, START_POS.y, START_POS.dir, true);
  }

  continueGame() {
    const data = save.read();
    if (!data) { this.push(new Dialogue('저장 데이터를 찾을 수 없습니다.')); return; }
    this.state = { ...this.freshState(), ...data };
    if (!this.state.box || !this.state.box.length) this.state.box = Array.from({ length: BOX_COUNT }, () => []);
    if (!this.state.collectionRewards) this.state.collectionRewards = { dexComplete: false, badgeComplete: false, dexMilestones: {} };
    if (!this.state.collectionRewards.dexMilestones) this.state.collectionRewards.dexMilestones = {};
    if (!this.state.quests) this.state.quests = {};
    if (this.state.trackedQuest === undefined) this.state.trackedQuest = null;
    if (!this.state.achievements) this.state.achievements = {};
    if (!this.state.activeTitle) this.state.activeTitle = '신입 모험가';
    if (!this.state.trainerRematch) this.state.trainerRematch = {};
    if (!this.state.fieldBossRespawn) this.state.fieldBossRespawn = {};
    if (!this.state.discoveredMaps) this.state.discoveredMaps = {};
    if (!this.state.fieldDrops) this.state.fieldDrops = {};
    if (!this.state.attendance) this.state.attendance = { lastClaimDate:null, totalDays:0 };
    const recovered = !!this.state._recoveredFromBackup;
    delete this.state._recoveredFromBackup;
    if (!MAPS[this.state.map]) this.state.map = START_MAP;
    let maxSid = 0;
    for (const m of [...this.state.party, ...this.state.box.flat()]) {
      maxSid = Math.max(maxSid, m.sid || 0);
      if (!Array.isArray(m.moves) || !m.moves.length) m.moves = movesAtLevel(m.id, m.level);
      normalizeInstance(m);
    }
    resetSid(maxSid + 1);
    const loadedMap = MAPS[this.state.map];
    if (!this.state.party.length && loadedMap && (loadedMap.areaType === 'hunt' || loadedMap.areaType === 'hidden')) {
      this.state.map = 'town'; this.state.x = 11; this.state.y = 10; this.state.dir = 'down';
      this.rewardNotices.push(['몬스터가 없는 상태로 위험지역에 저장된 데이터를 발견했습니다.', '안전을 위해 태초마을로 이동했습니다.']);
    }
    sfx.on = this.state.settings.sound;
    this.rewardNotices = [];
    if (recovered) this.rewardNotices.push(['주 저장 데이터가 손상되어 자동 백업에서 복구했습니다.', '최근 정상 저장 시점부터 계속 플레이할 수 있습니다.']);
    this.claimCollectionRewards();
    this.beginPlay(this.state.map, this.state.x, this.state.y, this.state.dir, true);
  }

  beginPlay(map, x, y, dir, fade) {
    const go = () => {
      this.overlays.length = 0;
      this.mode = 'field';
      this.world.load(map, x, y, dir);
      const daily=this.claimDailyAttendance();
      if (daily) this.push(new AttendanceRewardScene(daily));
    };
    if (fade) this.startTransition(go, 0.3);
    else go();
  }

  returnToTitle() {
    try { this.syncPosition(); this.saveNow(); } catch {}
    this.overlays.length=0;
    this.battle=null;
    this.mode='title';
    this.title=new TitleScene(this);
    if (this.chat && this.chat.lock) this.chat.lock(true);
  }

  localDayKey() {
    const d=new Date(), p=n=>String(n).padStart(2,'0');
    return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`;
  }

  claimDailyAttendance() {
    const key='monstia.attendance.v1', today=this.localDayKey();
    let rec={lastClaimDate:null,totalDays:0,...(this.state.attendance||{})};
    try { const raw=localStorage.getItem(key); if(raw) rec={...rec,...JSON.parse(raw)}; } catch {}
    if (rec.lastClaimDate===today) return null;
    rec.lastClaimDate=today; rec.totalDays=Math.max(0,Number(rec.totalDays)||0)+1;
    this.state.attendance={...rec};
    try { localStorage.setItem(key,JSON.stringify(rec)); } catch {}
    this.state.money=(Number(this.state.money)||0)+100000;
    this.addItem('capsule_master',1);
    try { this.syncPosition(); save.write(this.state); } catch {}
    return rec;
  }

  // ---------------------------------------------------------- 씬 스택
  push(scene) { this.overlays.push(scene); }
  pop() { this.overlays.pop(); }
  get top() { return this.overlays[this.overlays.length - 1] || null; }

  say(pages, opts) { this.push(new Dialogue(pages, opts)); }

  // ---------------------------------------------------------- 전환 연출
  startTransition(midFn, dur = 0.24) {
    this.transition = { t: 0, dur, mid: midFn, fired: false };
  }

  updateTransition(dt) {
    const tr = this.transition;
    tr.t += dt;
    if (!tr.fired && tr.t >= tr.dur / 2) { tr.fired = true; if (tr.mid) tr.mid(); }
    if (tr.t >= tr.dur) this.transition = null;
  }

  // ---------------------------------------------------------- 루프
  start() {
    const step = (ts) => {
      const dt = Math.min(0.05, (ts - this.last) / 1000 || 0);
      this.last = ts;
      this.update(dt);
      this.draw();
      this.input.endFrame();
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  update(dt) {
    this.screen.blink += dt;
    if (this.flash > 0) this.flash = Math.max(0, this.flash - dt * 2.5);
    if (this.toastMsg && this.toastMsg.t > 0) this.toastMsg.t -= dt;
    if (this.areaTitle && this.areaTitle.t > 0) this.areaTitle.t -= dt;

    if (this.transition) { this.updateTransition(dt); return; }

    if (this.mode === 'loading') { this.loading.update(dt, this); return; }
    if (this.mode !== 'title') this.state.playtime += dt;

    const top = this.top;
    if (top) { top.update(dt, this); return; }

    if (this.mode === 'title') { this.title.update(dt, this); return; }
    if (this.mode === 'battle') { this.battle.update(dt, this.input); return; }

    if (this.mode === 'field' && this.rewardNotices.length) {
      this.say(this.rewardNotices.shift());
      return;
    }

    // 필드
    this.world.update(dt, true);
    if (this.world.player.moving) return;
    if (this.input.pressed('a')) this.interact();
    else if (this.input.pressed('b')) { sfx.confirm(); this.push(new MainMenu()); }
  }

  draw() {
    const sc = this.screen;
    const wctx = sc.wctx;
    wctx.imageSmoothingEnabled = false;

    if (this.mode === 'loading') this.loading.drawWorld(sc);
    else if (this.mode === 'title') this.title.drawWorld(sc);
    else if (this.mode === 'battle') this.battle.drawWorld(sc);
    else this.world.draw(wctx);

    sc.clear('#0c0c12');
    sc.blitWorld();

    if (this.mode === 'loading') this.loading.drawUI(sc, this);
    else if (this.mode === 'title') this.title.drawUI(sc, this);
    else if (this.mode === 'battle' && !this.overlays.length) this.battle.drawUI(sc, this);
    else if (this.mode === 'battle') this.battle.drawUI(sc, this);

    for (const s of this.overlays) if (s.drawUI) s.drawUI(sc, this);

    if (this.mode === 'field' && this.areaTitle && this.areaTitle.t > 0) {
      const a = Math.min(1, this.areaTitle.t < 0.35 ? this.areaTitle.t / 0.35 : 1);
      const title = this.areaTitle.text;
      const sub = this.areaTitle.sub;
      const w = Math.min(146, Math.max(78, sc.textWidth(title, 11) + 24));
      sc.panel(80 - w / 2, 28, w, sub ? 31 : 23, `rgba(18,18,30,${0.88 * a})`);
      sc.text(title, 80, 34, { size: 11, weight: '700', align: 'center', color: '#f7f3e7' });
      if (sub) sc.text(sub, 80, 48, { size: 7, align: 'center', color: '#bfc3d8' });
    }
    if (this.mode === 'field' && !this.overlays.length) {
      const qid = this.state.trackedQuest;
      const q = qid ? QUESTS[qid] : null;
      const st = qid ? this.state.quests?.[qid]?.status : null;
      if (q && st === 'active') {
        const done = this.questComplete(q);
        const prog = done ? '목표 완료 · 의뢰인에게 돌아가기' : this.questProgressText(q);
        sc.panel(4,174,152,27,'rgba(18,18,30,0.84)');
        sc.text(`★ ${q.name}`,9,178,{size:6.5,weight:'700',color:'#f1d46a',maxW:142,minSize:5});
        sc.text(prog,9,189,{size:6,color:done?COL.hp:'#d8dbe8',maxW:142,minSize:4.6});
      }
      const ct = cloud.hudText();
      const cw = Math.min(58, Math.max(36, sc.textWidth(ct, 4.5) + 7));
      sc.panel(156-cw,207,cw,9,'rgba(18,18,30,0.72)');
      sc.text(ct,152,209,{size:4.5,align:'right',color:/오류/.test(ct)?COL.hpLow:/완료/.test(ct)?COL.hp:COL.dim,maxW:cw-5,minSize:3.8});
    }
    if (this.toastMsg && this.toastMsg.t > 0) {
      const w = Math.min(150, sc.textWidth(this.toastMsg.text, 8) + 16);
      sc.panel(80 - w / 2, 6, w, 14, 'rgba(20,20,32,0.88)');
      sc.text(this.toastMsg.text, 80, 10, { size: 8, align: 'center', color: '#f4f0e2' });
    }
    if (this.flash > 0) {
      sc.ctx.fillStyle = `rgba(255,255,255,${Math.min(1, this.flash)})`;
      sc.ctx.fillRect(0, 0, sc.canvas.width, sc.canvas.height);
    }
    if (this.transition) {
      const tr = this.transition;
      const k = tr.t / tr.dur;
      const a = k < 0.5 ? k * 2 : (1 - k) * 2;
      sc.ctx.fillStyle = `rgba(8,8,14,${Math.min(1, a)})`;
      sc.ctx.fillRect(0, 0, sc.canvas.width, sc.canvas.height);
    }
  }

  // ---------------------------------------------------------- 지역 이름 안내
  announceArea(mapId) {
    const m = MAPS[mapId];
    if (!m || (m.indoor && m.areaType !== 'hunt')) { this.areaTitle = null; return; }
    const reqLv = WORLD_PROGRESS_MIN[mapId] || 0;
    const sub = m.areaType === 'hunt' ? `사냥터${reqLv ? ` · 권장 Lv.${reqLv}` : ''}`
      : m.areaType === 'hidden' ? '숨겨진 지역'
      : m.areaType === 'town' ? '마을'
      : '';
    this.areaTitle = { text: m.name || mapId, sub, t: 2.15 };
  }

  // ---------------------------------------------------------- 워프
  warpRequirement(warp) {
    const target = MAPS[warp.to];
    if (!target) return { ok:false, lines:['이동할 수 없는 지역이다.'] };

    const party = this.state.party || [];
    const targetIsDanger = target.areaType === 'hunt' || target.areaType === 'hidden';
    if (targetIsDanger && party.length === 0) {
      return { ok:false, lines:['몬스터 없이 사냥터로 갈 수 없다.', '연구소에서 첫 파트너를 선택하자.'] };
    }

    const fromId = this.world.mapId;
    const fromIdx = WORLD_PROGRESS_INDEX[fromId];
    const toIdx = WORLD_PROGRESS_INDEX[warp.to];
    // 순수 전진 동선만 적정 레벨을 검사한다. 역주행/건물 출입/히든 입장은 막지 않는다.
    if (fromIdx !== undefined && toIdx !== undefined && toIdx > fromIdx) {
      if (!party.length) {
        return { ok:false, lines:['아직 함께 여행할 몬스터가 없다.', '첫 파트너를 얻은 뒤 다시 오자.'] };
      }
      const min = WORLD_PROGRESS_MIN[warp.to] || 0;
      const highest = party.reduce((v,m)=>Math.max(v, Number(m.level)||0),0);
      if (highest < min) {
        const name = target.name || warp.to;
        return { ok:false, lines:[`${name} 진입 권장 조건: Lv.${min} 이상`, `현재 파티 최고 레벨은 Lv.${highest}이다.`, '조금 더 성장한 뒤 다시 오자.'] };
      }
    }
    return { ok:true };
  }

  doWarp(warp) {
    const req = this.warpRequirement(warp);
    if (!req.ok) {
      sfx.deny();
      this.say(req.lines);
      return;
    }
    sfx.confirm();
    this.startTransition(() => {
      this.state.map = warp.to;
      this.world.load(warp.to, warp.tx, warp.ty, warp.dir);
      this.announceArea(warp.to);
      this.syncPosition();
      if (RETURN_POINTS[warp.to]) this.autoSave(`${MAPS[warp.to].name} 도착 · 자동 저장`);
    }, 0.34);
  }

  syncPosition() {
    this.state.map = this.world.mapId;
    this.state.x = this.world.player.tx;
    this.state.y = this.world.player.ty;
    this.state.dir = this.world.player.dir;
  }

  // ---------------------------------------------------------- 상호작용
  interact() {
    const w = this.world;
    const { x, y, dx, dy } = w.facingTile();

    let npc = w.npcAt(x, y);
    if (!npc) {
      const front = w.objectAt(x, y);
      if (front && (front.kind === 'counter' || front.kind === 'table')) {
        npc = w.npcAt(x + dx, y + dy);
      }
    }
    if (npc) { this.talkTo(npc); return; }

    const obj = w.objectAt(x, y);
    if (obj) { this.useObject(obj); return; }

    const f = w.follower;
    if (f.visible && f.tx === x && f.ty === y && this.state.party[0]) {
      this.petFollower();
      return;
    }

    const props = w.tileProps(x, y);
    if (props.key === 'water') {
      sfx.blip();
      if (this.state.mount?.mode==='water' && this.mountedMonster()) {
        w.tryMove(w.player.dir);
        return;
      }
      const waterMon=(this.state.party||[]).find(m=>m.hp>0 && MONSTERS[m.id]?.type==='물');
      if (!waterMon) {
        this.say(['맑은 물이다. 수면이 잔잔하다.','파티에 물 위를 함께 건널 물 타입 몬스터가 없다.']);
        return;
      }
      this.push(new Dialogue(`${displayName(waterMon)}을(를) 타고 물로 들어가시겠습니까?`,{
        choices:[{label:'아니요',value:false},{label:'예',value:true}],
        onChoose:(v)=>{
          if(!v) return;
          if(this.mountMonster(waterMon,'water')) {
            // 선택창이 닫힌 직후 현재 바라보는 물 칸으로 진입한다.
            setTimeout(()=>{ if(this.mode==='field'&&!this.top) w.tryMove(w.player.dir); },0);
          }
        },
      }));
    }
    else if (props.key === 'tree') { sfx.blip(); this.say('빽빽한 나무다. 지나갈 수 없다.'); }
  }

  talkTo(npc) {
    sfx.confirm();
    // 플레이어 쪽을 바라보게
    const p = this.world.player;
    if (npc.y > p.ty) npc.dir = 'up';
    else if (npc.y < p.ty) npc.dir = 'down';
    else if (npc.x > p.tx) npc.dir = 'left';
    else npc.dir = 'right';

    if (npc.role === 'professor') { this.professorTalk(npc); return; }
    if (npc.role === 'heal') { this.nurseTalk(npc); return; }
    if (npc.quest) { this.questTalk(npc); return; }
    if (npc.trainer) {
      const cleared = !!this.state.flags[`trainer_${npc.id}`];
      if (!cleared) { this.startTrainerBattle(npc); return; }
      if (npc.trainer.rematch) {
        const until = this.state.trainerRematch?.[npc.id] || 0;
        if (Date.now() >= until) { this.startTrainerBattle(npc, true); return; }
        const sec = Math.max(1, Math.ceil((until - Date.now()) / 1000));
        this.say([`재대결 준비까지 ${Math.ceil(sec / 60)}분 정도 남았어.`, '조금 뒤에 다시 도전해 줘!'], { speaker:npc.name });
        return;
      }
    }
    if (npc.role === 'shop') {
      this.say(['어서 오세요! 무엇을 찾으시나요?'], {
        speaker: npc.name,
        onDone: () => this.push(new ShopMenu()),
      });
      return;
    }
    this.say(npc.lines || ['…'], { speaker: npc.name });
  }

  questComplete(q) {
    if (!q?.objective) return false;
    const o = q.objective;
    if (o.kind === 'caught') return (this.state.dex?.[o.monster] || 0) === 2;
    if (o.kind === 'dex_count') {
      const n = DEX_ORDER.filter((id) => (this.state.dex?.[id] || 0) === 2).length;
      return n >= (o.count || 1);
    }
    if (o.kind === 'item') return this.countItem(o.item) >= (o.count || 1);
    if (o.kind === 'visit') return !!(this.state.visited?.[o.map] || this.state.discoveredMaps?.[o.map]);
    if (o.kind === 'flag') return !!this.state.flags?.[o.flag];
    return false;
  }

  questProgressText(q) {
    if (!q?.objective) return '진행 조건을 확인할 수 없다.';
    const o = q.objective;
    if (o.kind === 'caught') {
      const name = MONSTERS[o.monster]?.name || '대상 몬스터';
      return (this.state.dex?.[o.monster] || 0) === 2 ? `${name} 포획 완료` : `${name} 포획이 아직 필요해.`;
    }
    if (o.kind === 'dex_count') {
      const n = DEX_ORDER.filter((id) => (this.state.dex?.[id] || 0) === 2).length;
      return `도감 포획 기록 ${n}/${o.count}`;
    }
    if (o.kind === 'item') {
      const name = ITEMS[o.item]?.name || o.item;
      return `${name} ${this.countItem(o.item)}/${o.count}개`;
    }
    if (o.kind === 'visit') {
      const name = MAPS[o.map]?.name || '목표 지역';
      return this.questComplete(q) ? `${name} 조사 완료` : `${name}을(를) 아직 발견하지 못했어.`;
    }
    if (o.kind === 'flag') return this.questComplete(q) ? '조건 달성 완료' : '아직 조건을 달성하지 못했어.';
    return q.desc;
  }

  consumeQuestObjective(q) {
    const o = q?.objective;
    if (o?.kind === 'item' && o.consume) this.removeItem(o.item, o.count || 1);
  }

  questTalk(npc) {
    const q = QUESTS[npc.quest];
    if (!q) { this.say(npc.lines || ['…'], { speaker:npc.name }); return; }
    const st = this.state.quests[q.id] || { status:'none' };
    if (st.status === 'done') {
      this.say([`${q.name}은(는) 덕분에 잘 마무리됐어.`, '고마워!'], { speaker:npc.name });
      return;
    }
    if (st.status === 'active') {
      if (!this.questComplete(q)) {
        this.say([q.desc, this.questProgressText(q)], { speaker:npc.name });
        return;
      }
      const completionText = this.questProgressText(q);
      this.consumeQuestObjective(q);
      const reward = q.reward || {};
      this.state.money += reward.money || 0;
      for (const [id, n] of Object.entries(reward.items || {})) this.addItem(id, n);
      this.state.quests[q.id] = { status:'done', completedAt:Date.now() };
      if (this.state.trackedQuest === q.id) {
        const next = Object.keys(QUESTS).find((id)=>this.state.quests?.[id]?.status==='active');
        this.state.trackedQuest = next || null;
      }
      refreshAchievements(this);
      sfx.caught();
      const parts = [];
      if (reward.money) parts.push(`${reward.money.toLocaleString()}원`);
      for (const [id,n] of Object.entries(reward.items || {})) parts.push(`${ITEMS[id].name}×${n}`);
      this.say([`${q.name} 완료!`, completionText, `보상: ${parts.join(' + ')}`], { speaker:npc.name });
      return;
    }
    this.say([q.name, q.desc, '이 부탁을 받아줄래?'], {
      speaker:npc.name,
      choices:[{label:'수락',value:true},{label:'나중에',value:false}],
      onChoose:(v)=>{
        if (!v) return;
        this.state.quests[q.id] = { status:'active', acceptedAt:Date.now() };
        if (!this.state.trackedQuest) this.state.trackedQuest = q.id;
        this.say(['퀘스트가 등록되었다!', `추적 시작: ${q.name}`]);
      },
    });
  }

  professorTalk(npc) {
    if (!this.state.progress.starter) {
      this.say([
        '오, 왔구나! 기다리고 있었단다.',
        '저 받침대 위에 캡슐이 세 개 있지? 그 안에 어린 몬스터가 한 마리씩 들어 있어.',
        '한 마리를 골라 네 첫 파트너로 삼으렴.',
      ], { speaker: npc.name, onDone: () => this.push(new StarterMenu()) });
    } else {
      this.say([
        '풀숲을 걸으면 야생 몬스터가 튀어나온단다.',
        'HP를 깎은 뒤에 캡슐을 던지면 포획 확률이 훨씬 올라가지.',
        '도감을 채우는 게 네 여행의 목표란다!',
      ], { speaker: npc.name });
    }
  }

  nurseTalk(npc) {
    if (!this.state.party.length) {
      this.say(['어서 오세요, 몬스터센터입니다.', '아직 몬스터를 데리고 계시지 않네요!'], { speaker: npc.name });
      return;
    }
    this.say(['어서 오세요, 몬스터센터입니다.', '몬스터를 회복하시겠습니까?'], {
      speaker: npc.name,
      choices: [{ label: '예', value: true }, { label: '아니오', value: false }],
      onChoose: (v) => {
        if (!v) { this.say(['알겠습니다. 또 들러 주세요!'], { speaker: npc.name }); return; }
        healParty(this.state.party);
        this.flash = 0.9;
        sfx.heal();
        this.autoSave('회복 완료 · 자동 저장');
        this.say(['몬스터의 상태가 모두 회복되었습니다!', '다녀오세요!'], { speaker: npc.name });
      },
    });
  }

  useObject(obj) {
    if (obj.kind === 'item') {
      sfx.buy();
      this.addItem(obj.item, obj.count || 1);
      if (obj.dynamic && obj.dropId) {
        const list=this.state.fieldDrops?.[this.world.mapId] || [];
        this.state.fieldDrops[this.world.mapId]=list.filter(d=>d.dropId!==obj.dropId);
        // 주운 뒤 다음 랜덤 드랍이 너무 오래 비지 않도록 재등장 타이머를 앞당긴다.
        this.world.nextRandomDropAt=Math.max(this.world.nextRandomDropAt,Date.now()+180000+Math.random()*120000);
      } else if (obj.flag) this.state.flags[obj.flag] = true;
      this.world.refreshObjects();
      const it = ITEMS[obj.item];
      this.say(`${it.name}${obj.count > 1 ? ` ${obj.count}개` : ''}을(를) 발견했다!`);
      return;
    }
    if (obj.kind === 'starter') {
      const sp = MONSTERS[obj.monster];
      if (this.state.progress.starter) { sfx.blip(); this.say('빈 받침대다.'); return; }
      sfx.confirm();
      this.say([`캡슐 안에는 ${sp.name}이(가) 들어 있다.`, sp.desc, `${sp.name}(으)로 정하겠습니까?`], {
        choices: [{ label: '예', value: true }, { label: '아니오', value: false }],
        onChoose: (v) => { if (v) this.giveStarter(obj.monster); },
      });
      return;
    }
    if (obj.kind === 'legendary') {
      if (!this.state.party.some((m) => m.hp > 0)) { this.say('싸울 수 있는 몬스터가 없다…'); return; }
      this.push(new LegendaryIntroScene(obj.monster, () => {
        this.state.flags[obj.flag] = true;
        this.world.refreshObjects();
        this.startWildBattle(
          [{ id: obj.monster, weight: 1, min: obj.level, max: obj.level }],
          { legendary: { flag: obj.flag } },
        );
      }));
      return;
    }
    if (obj.kind === 'fieldboss') {
      if (!this.state.party.some((m) => m.hp > 0)) { this.say('싸울 수 있는 몬스터가 없다…'); return; }
      this.state.flags[obj.flag] = true;
      this.world.refreshObjects();
      this.say([`지역 우두머리 ${MONSTERS[obj.monster].name}이(가) 길을 막고 있다!`, '강한 기운이 주변을 짓누른다…'], {
        onDone: () => this.startWildBattle(
          [{ id:obj.monster, weight:1, min:obj.level, max:obj.level }],
          { fieldBoss:{ flag:obj.flag } },
        ),
      });
      return;
    }
    if (obj.text) { sfx.blip(); this.say(obj.text); return; }
    sfx.blip();
  }

  petFollower() {
    const m = this.state.party[0];
    const sp = MONSTERS[m.id];
    m.friendship = Math.min(255, m.friendship + 1);
    const lines = [
      `${displayName(m)}이(가) 기분 좋아 보인다!`,
      `${displayName(m)}이(가) 이쪽을 빤히 바라보고 있다.`,
      `${displayName(m)}이(가) 발밑을 맴돌고 있다.`,
      `${displayName(m)}이(가) 작게 울었다.`,
    ];
    if (m.friendship > 120) lines.push(`${displayName(m)}이(가) 몸을 부비며 따라붙는다!`);
    if (m.hp < m.maxHp * 0.35) lines.push(`${displayName(m)}이(가) 조금 지쳐 보인다…`);
    sfx.blip();
    this.say(lines[Math.floor(Math.random() * lines.length)]);
    void sp;
  }

  // ---------------------------------------------------------- 스타팅
  giveStarter(id) {
    const inst = createInstance(id, 5, { met: '몬스터 연구소', capturedWith: 'starter' });
    this.state.party.push(inst);
    this.state.dex[id] = 2;
    this.claimCollectionRewards();
    this.state.progress.starter = true;
    this.world.follower.visible = true;
    this.world.follower.tx = this.world.player.tx;
    this.world.follower.ty = this.world.player.ty;
    this.world.follower.px = this.world.player.px;
    this.world.follower.py = this.world.player.py;
    this.flash = 0.9;
    sfx.caught();
    const sp = MONSTERS[id];
    this.say([
      `${sp.name}을(를) 손에 넣었다!`,
      `${sp.name}은(는) 이제 네 뒤를 따라다닌다. A 버튼으로 말을 걸 수 있어.`,
      '북쪽 1번도로의 풀숲에서 야생 몬스터를 만날 수 있단다. 조심하렴!',
    ]);
  }

  // ---------------------------------------------------------- 아이템
  countItem(id) { return this.state.bag[id] || 0; }
  addItem(id, n = 1) { this.state.bag[id] = (this.state.bag[id] || 0) + n; }
  removeItem(id, n = 1) {
    this.state.bag[id] = Math.max(0, (this.state.bag[id] || 0) - n);
    if (this.state.bag[id] === 0) delete this.state.bag[id];
  }

  equipItem(inst, id) {
    const item = ITEMS[id];
    if (!inst || !item?.equip || this.countItem(id) <= 0) return false;
    const old = inst.equipment || null;
    if (old === id) return false;
    if (old) this.addItem(old, 1);
    this.removeItem(id, 1);
    inst.equipment = id;
    normalizeInstance(inst);
    this.autoSave(`${displayName(inst)} · ${item.name} 장착`);
    return true;
  }

  unequipItem(inst) {
    if (!inst?.equipment) return false;
    const old = inst.equipment;
    this.addItem(old, 1);
    inst.equipment = null;
    normalizeInstance(inst);
    this.autoSave(`${displayName(inst)} · 장비 해제`);
    return true;
  }

  autoPickupFieldItems(radius = 2) {
    if (!this.state.upgrades?.autoPickup || this.mode !== 'field' || !this.world) return 0;
    const p = this.world.player;
    const picks = (this.world.objects || []).filter((o) => o.kind === 'item' && o.dynamic && o.dropId
      && Math.abs(o.x - p.tx) + Math.abs(o.y - p.ty) <= radius);
    if (!picks.length) return 0;

    const totals = new Map();
    const list = this.state.fieldDrops?.[this.world.mapId] || [];
    const ids = new Set(picks.map((o) => o.dropId));
    this.state.fieldDrops[this.world.mapId] = list.filter((d) => !ids.has(d.dropId));
    for (const obj of picks) {
      const n = obj.count || 1;
      this.addItem(obj.item, n);
      totals.set(obj.item, (totals.get(obj.item) || 0) + n);
    }
    this.world.nextRandomDropAt = Math.max(this.world.nextRandomDropAt, Date.now() + 180000 + Math.random() * 120000);
    this.world.refreshObjects();
    sfx.buy();
    const label = [...totals.entries()].map(([id,n]) => `${ITEMS[id]?.name || id}${n > 1 ? `×${n}` : ''}`).join(', ');
    this.toast(`자동줍기: ${label}`);
    return picks.length;
  }

  useCandy(id, inst) {
    const need = Math.max(1, inst.expToNext - inst.exp);
    const events = gainExp(inst, need);
    this.removeItem(id, 1);
    sfx.levelup();
    this.toast(`${displayName(inst)} → Lv.${inst.level}!`);
    this.applyLevelEvents(inst, events);
  }

  useMoveCD(id, inst) {
    const sp = MONSTERS[inst.id];
    const pool = randomMovePool(sp)
      .filter((mid) => MOVES[mid] && MOVES[mid].minLv <= inst.level && !knowsMove(inst, mid))
      .sort((a, b) => MOVES[b].power - MOVES[a].power);
    if (!pool.length) {
      sfx.deny();
      this.say(`${displayName(inst)}은(는) 현재 배울 수 있는 기술을 모두 익혔다.`);
      return;
    }
    const mid = pool[0];
    if (tryLearn(inst, mid)) {
      this.removeItem(id, 1);
      sfx.levelup();
      this.say(`${displayName(inst)}은(는) ${MOVES[mid].name}을(를) 익혔다!`);
      return;
    }
    // 기술칸이 가득 찬 경우 실제로 교체가 확정된 뒤에만 CD를 소비한다.
    this.push(new LearnMoveScene(inst, mid, (slot) => {
      if (slot === null || slot === undefined) {
        this.say('기술 습득을 취소했다. 기술CD는 소비되지 않았다.');
        return;
      }
      replaceMove(inst, slot, mid);
      this.removeItem(id, 1);
      sfx.levelup();
      this.say(`${displayName(inst)}은(는) ${MOVES[mid].name}을(를) 익혔다!`);
    }));
  }

  // gainExp() 이벤트를 순서대로 처리한다. 기술 교체 UI가 필요한 경우에도
  // 다음 이벤트(추가 기술/진화)가 먼저 실행되지 않도록 직렬화한다.
  applyLevelEvents(inst, events, index = 0) {
    if (!events || index >= events.length) return;
    const ev = events[index];
    const next = () => this.applyLevelEvents(inst, events, index + 1);

    if (ev.type === 'levelup') { next(); return; }
    if (ev.type === 'learn') {
      if (!MOVES[ev.move] || knowsMove(inst, ev.move)) { next(); return; }
      if (tryLearn(inst, ev.move)) {
        this.toast(`${MOVES[ev.move].name} 습득!`);
        next();
      } else {
        this.push(new LearnMoveScene(inst, ev.move, (slot) => {
          if (slot !== null && slot !== undefined) {
            replaceMove(inst, slot, ev.move);
            this.toast(`${MOVES[ev.move].name} 습득!`);
          }
          next();
        }));
      }
      return;
    }
    if (ev.type === 'evolve') {
      const beforeId = inst.id;
      const before = MONSTERS[beforeId].name;
      // 레벨업사탕처럼 필드에서 발생한 진화도 전투 진화와 같은 별도 연출을 거친다.
      // 연출이 끝날 때 실제 종족 ID를 바꿔 중간 저장/메뉴 갱신으로 상태가 꼬이지 않게 한다.
      this.push(new EvolutionScene(inst, ev.to, {
        onComplete: () => {
          evolveInstance(inst, ev.to);
          this.state.dex[inst.id] = 2;
          this.claimCollectionRewards();
          this.flash = 0.7;
          this.toast(`${before} → ${MONSTERS[inst.id].name} 진화!`);
          const mids = evolutionMoveCandidates(inst);
          if (!mids.length) { next(); return; }
          // 진화 기술도 같은 직렬 처리 루틴을 통과시킨다.
          const injected = mids.map((move) => ({ type:'learn', move }));
          this.applyLevelEvents(inst, [...injected, ...events.slice(index + 1)], 0);
        },
      }));
      return;
    }
    next();
  }

  claimCollectionRewards() {
    if (!this.state.collectionRewards) {
      this.state.collectionRewards = { dexComplete: false, badgeComplete: false, dexMilestones: {} };
    }
    const rewards = this.state.collectionRewards;
    if (!rewards.dexMilestones) rewards.dexMilestones = {};
    const caughtCount = DEX_ORDER.filter((id) => (this.state.dex?.[id] || 0) === 2).length;
    for (const milestone of DEX_MILESTONES) {
      if (caughtCount < milestone.count || rewards.dexMilestones[milestone.count]) continue;
      rewards.dexMilestones[milestone.count] = true;
      this.state.money += milestone.money || 0;
      for (const [id,n] of Object.entries(milestone.items || {})) this.addItem(id,n);
      const parts = [];
      if (milestone.money) parts.push(`${milestone.money.toLocaleString()}원`);
      for (const [id,n] of Object.entries(milestone.items || {})) parts.push(`${ITEMS[id].name}×${n}`);
      this.rewardNotices.push([`도감 ${milestone.count}종 포획 달성!`, `단계 보상: ${parts.join(' + ')}`]);
    }

    const dexComplete = DEX_ORDER.length > 0
      && DEX_ORDER.every((id) => (this.state.dex?.[id] || 0) === 2);
    if (dexComplete && !rewards.dexComplete) {
      rewards.dexComplete = true;
      this.addItem('capsule_master', 4);
      this.state.money += 500000;
      this.rewardNotices.push([
        '몬스터 도감을 완성했다!',
        '도감 완성 보상으로 마스터캡슐 4개를 받았다!',
        '도감 완성 보상으로 500,000원을 받았다!',
      ]);
    }

    const badgeIds = Object.keys(BADGES);
    const badgeComplete = badgeIds.length > 0
      && badgeIds.every((id) => !!this.state.badges?.[id]);
    if (badgeComplete && !rewards.badgeComplete) {
      rewards.badgeComplete = true;
      this.addItem('capsule_master', 2);
      this.rewardNotices.push([
        '증표 도감을 완성했다!',
        '모든 체육관을 제패한 보상으로 마스터캡슐 2개를 받았다!',
      ]);
    }
  }

  awardBadge(id, leaderName = '') {
    const badge = BADGES[id];
    if (!badge || this.state.badges?.[id]) return false;
    if (!this.state.badges) this.state.badges = {};
    this.state.badges[id] = { obtained: true, at: Date.now(), leader: leaderName };
    this.claimCollectionRewards();
    sfx.caught();
    this.flash = 0.9;
    this.say([
      `${badge.name}을(를) 획득했다!`,
      `${badge.town} 체육관 제패 기록이 증표 도감에 등록되었다.`,
    ]);
    return true;
  }

  useItemInField(id) {
    const item = ITEMS[id];
    if (item?.equip) {
      this.push(new PartyMenu({
        mode:'select', title:'누구에게 장착할까?',
        onSelect:(m)=>{
          if (m.equipment === id) { sfx.deny(); this.say(`${displayName(m)}은(는) 이미 ${item.name}을(를) 장착 중이다.`); return; }
          if (!this.equipItem(m,id)) { sfx.deny(); this.say('장비를 장착할 수 없다.'); return; }
          this.say(`${displayName(m)}에게 ${item.name}을(를) 장착했다!`);
        },
      }));
      return;
    }
    if (item.levelUp) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구에게 먹일까?',
        onSelect: (m) => this.useCandy(id, m),
      }));
      return;
    }
    if (item.teachMove) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구에게 가르칠까?',
        onSelect: (m) => this.useMoveCD(id, m),
      }));
      return;
    }
    if (item.returnHome) {
      const visited = Object.keys(RETURN_POINTS).filter((k) => (this.state.visited || {})[k]);
      if (!visited.length || (visited.length === 1 && visited[0] === this.world.mapId)) {
        sfx.deny();
        this.say('아직 돌아갈 만한 마을을 들르지 않았다.');
        return;
      }
      this.push(new ReturnScene(id));
      return;
    }
    if (item.category === '포획') { this.say('여기서는 사용할 수 없다.'); return; }
    if (item.revive) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구를 되살릴까?',
        onSelect: (m) => {
          if (m.hp > 0) { sfx.deny(); this.say(`${displayName(m)}은(는) 멀쩡하다.`); return; }
          this.removeItem(id, 1);
          m.hp = Math.max(1, Math.ceil(m.maxHp * item.revive));
          sfx.levelup();
          this.flash = 0.7;
          this.say(`${displayName(m)}이(가) 기운을 차렸다!`);
        },
      }));
      return;
    }
    if (item.heal) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구에게 사용할까?',
        onSelect: (m) => {
          if (m.hp >= m.maxHp) { this.say(`${displayName(m)}의 HP는 이미 가득하다.`); return; }
          this.removeItem(id, 1);
          m.hp = Math.min(m.maxHp, m.hp + item.heal);
          sfx.heal();
          this.say(`${displayName(m)}의 HP가 회복되었다!`);
        },
      }));
      return;
    }
    if (item.spHeal || item.spFull) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구에게 사용할까?',
        onSelect: (m) => {
          normalizeSp(m);
          if (m.sp >= m.maxSp) { this.say(`${displayName(m)}의 SP는 이미 가득하다.`); return; }
          this.removeItem(id, 1);
          const beforeSp = m.sp;
          m.sp = item.spFull ? m.maxSp : Math.min(m.maxSp, m.sp + item.spHeal);
          normalizeSp(m);
          sfx.heal();
          this.autoSave(`${item.name} 사용 · SP ${beforeSp}→${m.sp}`);
          this.say(`${displayName(m)}의 SP가 ${beforeSp} → ${m.sp}로 회복되었다!`);
        },
      }));
      return;
    }
    if (item.friendship) {
      this.push(new PartyMenu({
        mode: 'select', title: '누구에게 줄까?',
        onSelect: (m) => {
          this.removeItem(id, 1);
          m.friendship = Math.min(255, m.friendship + item.friendship);
          sfx.blip();
          this.say(`${displayName(m)}이(가) ${item.name}을(를) 맛있게 먹었다!`);
        },
      }));
    }
  }

  shopFarewell() { this.say('또 들러 주세요!'); }

  // 귀환 주문서 사용
  useReturnScroll(itemId, target) {
    this.removeItem(itemId, 1);
    sfx.heal();
    this.flash = 0.9;
    this.startTransition(() => {
      this.overlays.length = 0;
      this.state.map = target.id;
      this.world.load(target.id, target.x, target.y, target.dir);
      this.syncPosition();
      this.say(`${target.name}(으)로 돌아왔다!`);
    }, 0.5);
  }

  // ---------------------------------------------------------- 전투
  startTrainerBattle(npc, isRematch = false) {
    if (!this.state.party.some((m) => m.hp > 0)) {
      this.say(['싸울 수 있는 몬스터가 없다…']);
      return;
    }
    const t = npc.trainer;
    const levelBonus = isRematch ? (t.rematchBonus || 3) : 0;
    const roster = t.party.map((e) => createInstance(e.id, e.level + levelBonus, { resonant:false }));
    const trainer = {
      id: npc.id, name: npc.name, roster, index: 0,
      reward: t.reward || 500, before: t.before || [], lose: t.lose || [],
      badge: t.badge || null, gym: !!t.gym, rematch:!!t.rematch, isRematch, rematchMinutes:t.rematchMinutes || 5,
    };
    this.flash = 1;
    this.startTransition(() => {
      this.mode = 'battle';
      this.battle = new Battle(this, roster[0], { trainer });
      this.overlays.length = 0;
    }, 0.5);
  }

  // 포획 직후 별명 입력 (채팅 입력창을 빌려 쓴다)
  askName(inst, done) {
    const base = MONSTERS[inst.id].name;
    if (!this.chat || !this.chat.askText) { done(); return; }
    this.chat.askText(`${base}의 새 별명을 입력하세요 (그냥 확인하면 그대로)`, (text) => {
      const nick = String(text || '').trim().slice(0, 8);
      if (nick && nick !== base) {
        inst.nick = nick;
        this.toast(`${base} → ${nick}`);
      }
      done();
    });
  }

  toast(text) { this.toastMsg = { text, t: 2 }; }

  autoSave(label) {
    this.syncPosition();
    if (save.write(this.state)) this.toast(label || '자동 저장됨');
  }

  startWildBattle(table, opts = {}) {
    if (!this.state.party.some((m) => m.hp > 0)) return; // 싸울 몬스터가 없으면 조우하지 않는다
    const enemy = rollFromTable(table, !(opts.legendary || opts.fieldBoss));
    const launch = () => {
      this.flash = 1;
      this.startTransition(() => {
        this.mode = 'battle';
        this.battle = new Battle(this, enemy, opts);
        this.overlays.length = 0;
      }, MONSTERS[enemy.id]?.mythical ? 0.68 : 0.5);
    };
    if (MONSTERS[enemy.id]?.mythical && !opts.skipMythicalIntro) {
      this.push(new MythicalIntroScene(enemy.id, launch));
      return;
    }
    launch();
  }

  endBattle(result) {
    if (this.battle && this.battle.legendary) {
      const flag = this.battle.legendary.flag;
      const now = Date.now();
      if (result === 'caught') {
        // 전설 포획 성공: 현실 시간 기준 24시간 후 다시 등장
        this.state.legendaryRespawn[flag] = now + 24 * 60 * 60 * 1000;
      } else if (result === 'win') {
        // 전설 격파: 현실 시간 기준 10분 후 다시 등장
        this.state.legendaryRespawn[flag] = now + 10 * 60 * 1000;
      } else {
        // 도망/전멸은 전설을 쓰러뜨린 것이 아니므로 다음 방문부터 즉시 재도전 가능
        delete this.state.flags[flag];
        delete this.state.legendaryRespawn[flag];
      }
    }
    if (this.battle && this.battle.fieldBoss) {
      const flag = this.battle.fieldBoss.flag;
      if (result === 'caught' || result === 'win') this.state.fieldBossRespawn[flag] = Date.now() + 30 * 60 * 1000;
      else { delete this.state.flags[flag]; delete this.state.fieldBossRespawn[flag]; }
    }
    const done = () => {
      this.mode = 'field';
      this.battle = null;
      if (result !== 'whiteout') this.world.refreshObjects();
      this.claimCollectionRewards();
      if (result === 'whiteout') {
        healParty(this.state.party);
        this.world.load(RESPAWN.map, RESPAWN.x, RESPAWN.y, RESPAWN.dir);
        this.syncPosition();
        this.say([
          '정신을 차려 보니 몬스터센터였다.',
          '몬스터의 상태가 모두 회복되었습니다!',
        ]);
      }
    };
    this.startTransition(done, 0.4);
  }

  // ---------------------------------------------------------- 저장
  confirmSave() {
    this.syncPosition();
    this.say(['이 시점에서 저장할까요?'], {
      choices: [{ label: '예', value: true }, { label: '아니오', value: false }],
      onChoose: (v) => {
        if (!v) return;
        const ok = save.write(this.state);
        sfx[ok ? 'heal' : 'deny']();
        this.say(ok ? '저장했습니다!' : '저장에 실패했습니다.');
      },
    });
  }

  saveNow() {
    this.syncPosition();
    return save.write(this.state);
  }

  hasBackupSave() { return save.hasBackup(); }

  restoreBackupSave() {
    if (!save.hasBackup()) {
      sfx.deny();
      this.say('복구할 백업 세이브가 없습니다.');
      return false;
    }
    const ok = save.restoreBackup();
    sfx[ok ? 'heal' : 'deny']();
    if (!ok) { this.say('백업 세이브 복구에 실패했습니다.'); return false; }
    this.say(['이전 백업 세이브를 복구했습니다.', '이어하기를 다시 선택하면 복구된 시점에서 시작합니다.']);
    return true;
  }

  exportSaveFile() {
    try {
      const data = save.read() || this.state;
      const payload = { ...data, saveVersion:SAVE_VERSION, exportedAt:Date.now() };
      delete payload._recoveredFromBackup;
      const blob = new Blob([JSON.stringify(payload,null,2)], {type:'application/json'});
      const url = URL.createObjectURL(blob);
      const a=document.createElement('a'); a.href=url; a.download='MONSTIA_save_backup.json';
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(url),1000);
      this.say('MONSTIA 저장 백업 파일을 내보냈습니다.');
    } catch (e) { this.say('저장 파일 내보내기에 실패했습니다.'); }
  }

  importSaveFile(autoContinue=false) {
    try {
      const input=document.createElement('input'); input.type='file'; input.accept='.json,application/json'; input.style.display='none';
      document.body.appendChild(input);
      input.onchange=()=>{
        const f=input.files&&input.files[0]; if(!f){input.remove();return;}
        const reader=new FileReader();
        reader.onload=()=>{
          try {
            let d=JSON.parse(String(reader.result||'')); d=migrate(d);
            if (!d || typeof d!=='object' || !MAPS[d.map || START_MAP] || !Array.isArray(d.party || [])) throw new Error('invalid');
            d={...this.freshState(),...d};
            if (!d.box || !Array.isArray(d.box)) d.box=Array.from({length:BOX_COUNT},()=>[]);
            save.write(d);
            input.remove();
            this.title=new TitleScene(this);
            if(autoContinue){ this.overlays.length=0; this.continueGame(); }
            else this.say('저장 파일을 정상적으로 불러왔습니다.');
          } catch(e){ input.remove(); this.say('올바른 MONSTIA 저장 파일이 아닙니다.'); }
        };
        reader.onerror=()=>{input.remove();this.say('저장 파일을 읽지 못했습니다.');};
        reader.readAsText(f,'utf-8');
      };
      input.click();
    } catch(e){ this.say('이 환경에서는 저장 파일 불러오기를 사용할 수 없습니다.'); }
  }

  deleteSave() {
    save.clear();
    sfx.cancel();
    this.title = new TitleScene(this);
    this.overlays.length = 0;
    this.mode = 'title';
  }

  mapInfoText() {
    const m = this.world.map;
    const table = m.encounterTable ? ENCOUNTER_TABLES[m.encounterTable] : null;
    const pages = [`현재 위치: ${m.name}`];
    if (table) {
      const known = table
        .filter((e) => (this.state.dex[e.id] || 0) > 0)
        .map((e) => `${MONSTERS[e.id].name}(Lv.${e.min}~${e.max})`);
      pages.push(known.length
        ? `여기서 만난 적 있는 몬스터: ${known.join(', ')}`
        : '아직 이곳의 야생 몬스터를 만나 본 적이 없다.');
    } else {
      pages.push('이곳에는 야생 몬스터가 나타나지 않는다.');
    }
    const mins = Math.floor(this.state.playtime / 60);
    pages.push(`플레이 시간: ${Math.floor(mins / 60)}시간 ${mins % 60}분   소지금: ${this.state.money}원`);
    return pages;
  }

  // ---------------------------------------------------------- 리사이즈
  fit() {
    const stage = this.root.querySelector('#stage');
    const rect = stage.getBoundingClientRect();
    this.screen.resize(rect.width, rect.height);
  }
}


/* ===== js/core/console.js ===== */
// ============================================================


/* ===== js/core/console.js ===== */
// 이름(한글) 또는 id 로 몬스터 찾기

// console.js — 채팅창 / 치트 명령어
// ------------------------------------------------------------
// 캔버스 위가 아니라 실제 <input> 을 쓴다. 한글 IME 가 캔버스에서는
// 제대로 동작하지 않기 때문이다.
// 명령어를 추가하려면 COMMANDS 에 항목 하나만 더 쓰면 된다.
// ============================================================






// 이름(한글) 또는 id 로 몬스터 찾기
function findMonster(token) {
  if (!token) return null;
  const n = Number(token);
  if (!Number.isNaN(n) && MONSTERS[n]) return MONSTERS[n];
  const key = String(token).trim();
  return Object.values(MONSTERS).find((m) => m.name === key) || null;
}

// 이름(한글) 또는 키로 아이템 찾기
function findItem(token) {
  if (!token) return null;
  if (ITEMS[token]) return ITEMS[token];
  const key = String(token).trim();
  return Object.values(ITEMS).find((i) => i.name === key) || null;
}

const COMMANDS = {
  help: {
    cat: '기본',
    usage: '/help [명령어]',
    desc: '명령어 목록. /help tp 처럼 개별 사용법도 볼 수 있다',
    run(c, args) {
      const name = (args[0] || '').replace(/^\//, '').toLowerCase();
      const target = COMMANDS[name] || COMMANDS[ALIASES[name]];
      if (name && target) {
        c.print(`${target.usage}`, 'info');
        c.print(`  ${target.desc}`, 'dim');
        const alias = Object.entries(ALIASES).filter(([, v]) => v === (COMMANDS[name] ? name : ALIASES[name]));
        if (alias.length) c.print(`  같은 명령: ${alias.map(([k]) => '/' + k).join(', ')}`, 'dim');
        return;
      }
      if (name) c.print(`/${name} 은(는) 없는 명령어입니다.`, 'err');
      const groups = {};
      for (const [k, v] of Object.entries(COMMANDS)) (groups[v.cat || '기타'] ||= []).push([k, v]);
      for (const cat of ['기본', '몬스터', '소지품', '월드', '기타']) {
        if (!groups[cat]) continue;
        c.print(`── ${cat} ──`, 'info');
        for (const [, v] of groups[cat]) c.print(`  ${v.usage.padEnd(26)}${v.desc}`, 'dim');
      }
      c.print('이름은 한글로 써도 됩니다. 예: /give 참새기 30', 'dim');
    },
  },

  maps: {
    cat: '기본',
    usage: '/maps',
    desc: '이동 가능한 지역 목록',
    run(c) {
      for (const [id, m] of Object.entries(MAPS)) {
        const wild = m.encounterTable ? '  (야생 출현)' : '';
        c.print(`  ${id.padEnd(10)}${m.name}${wild}`, 'dim');
      }
      c.print('예: /tp forest01', 'info');
    },
  },

  money: {
    cat: '소지품',
    usage: '/money <금액>',
    desc: '소지금을 더한다 (음수면 차감)',
    run(c, args) {
      const n = Math.floor(Number(args[0]));
      if (!Number.isFinite(n)) return c.print('숫자를 입력하세요. 예: /money 100000', 'err');
      c.game.state.money = Math.max(0, c.game.state.money + n);
      sfx.buy();
      c.print(`소지금 ${n >= 0 ? '+' : ''}${n.toLocaleString()}원 → 현재 ${c.game.state.money.toLocaleString()}원`, 'ok');
    },
  },

  item: {
    cat: '소지품',
    usage: '/item <이름|키> [개수]',
    desc: '아이템을 지급한다 (예: /item 강화캡슐 20)',
    run(c, args) {
      if (args[0] === 'all') {
        const n = Math.max(1, Math.floor(Number(args[1])) || 20);
        Object.keys(ITEMS).forEach((k) => c.game.addItem(k, n));
        sfx.buy();
        return c.print(`모든 아이템을 ${n}개씩 지급했다.`, 'ok');
      }
      const it = findItem(args[0]);
      if (!it) return c.print(`아이템을 찾을 수 없음. 목록: ${Object.values(ITEMS).map((i) => i.name).join(', ')}`, 'err');
      const n = Math.max(1, Math.floor(Number(args[1])) || 1);
      c.game.addItem(it.id, n);
      sfx.buy();
      c.print(`${it.name} ×${n} 지급 → 보유 ${c.game.countItem(it.id)}개`, 'ok');
    },
  },

  give: {
    cat: '몬스터',
    usage: '/give <몬스터|id> [레벨]',
    desc: '몬스터를 파티(가득 차면 BOX)에 넣는다',
    run(c, args) {
      const sp = findMonster(args[0]);
      if (!sp) return c.print('몬스터를 찾을 수 없음. /dex list 로 이름을 확인하세요.', 'err');
      const lv = Math.max(1, Math.min(100, Math.floor(Number(args[1])) || 5));
      const inst = createInstance(sp.id, lv, { met: '치트' });
      const st = c.game.state;
      st.dex[sp.id] = 2;
      if (st.party.length < PARTY_MAX) {
        st.party.push(inst);
        c.print(`${sp.name} Lv.${lv} 이(가) 파티에 합류했다.`, 'ok');
      } else {
        const box = st.box.find((b) => b.length < 20) || st.box[st.box.length - 1];
        box.push(inst);
        c.print(`파티가 가득 차서 ${sp.name} Lv.${lv} 을(를) BOX로 보냈다.`, 'ok');
      }
      c.game.world.follower.visible = !!st.party.length;
      sfx.caught();
    },
  },

  lv: {
    cat: '몬스터',
    usage: '/lv <레벨> [파티번호]',
    desc: '몬스터 레벨을 바꾼다 (번호 생략 시 선두)',
    run(c, args) {
      const lv = Math.max(1, Math.min(100, Math.floor(Number(args[0]))));
      if (!Number.isFinite(lv)) return c.print('예: /lv 30', 'err');
      const idx = Math.max(0, (Math.floor(Number(args[1])) || 1) - 1);
      const m = c.game.state.party[idx];
      if (!m) return c.print(`파티 ${idx + 1}번이 비어 있음`, 'err');
      m.level = lv;
      m.exp = 0; m.expToNext = expToNext(lv);
      const st = statsFor(m.id, lv);
      m.maxHp = st.maxHp; m.atk = st.atk; m.def = st.def; m.hp = st.maxHp;
      m.moves = movesAtLevel(m.id, lv);
      sfx.levelup();
      c.print(`${displayName(m)} → Lv.${lv} (HP${st.maxHp} 공${st.atk} 방${st.def})`, 'ok');
      const evo = pendingEvolution(m);
      if (evo) c.print(`진화 조건 충족! /evolve 로 진화시킬 수 있다.`, 'dim');
    },
  },

  evolve: {
    cat: '몬스터',
    usage: '/evolve [파티번호]',
    desc: '진화 조건을 무시하고 즉시 다음 단계로 진화시킨다',
    run(c, args) {
      const idx = Math.max(0, (Math.floor(Number(args[0])) || 1) - 1);
      const m = c.game.state.party[idx];
      if (!m) return c.print(`파티 ${idx + 1}번이 비어 있음`, 'err');
      const sp = MONSTERS[m.id];
      if (!sp.evolution) return c.print(`${sp.name}은(는) 더 이상 진화하지 않는다.`, 'err');
      const before = sp.name;
      evolveInstance(m, sp.evolution.to);
      c.game.state.dex[m.id] = 2;
      for (const mid of evolutionMoveCandidates(m)) {
        if (tryLearn(m, mid)) c.print(`${MOVES[mid].name} 을(를) 익혔다.`, 'dim');
      }
      sfx.evolve();
      c.print(`${before} → ${MONSTERS[m.id].name} 진화 완료!`, 'ok');
    },
  },

  heal: {
    cat: '몬스터',
    usage: '/heal',
    desc: '파티 전체를 완전 회복한다',
    run(c) {
      if (!c.game.state.party.length) return c.print('파티가 비어 있음', 'err');
      healParty(c.game.state.party);
      sfx.heal();
      c.print('파티 전원 회복 완료.', 'ok');
    },
  },

  tp: {
    cat: '월드',
    usage: '/tp <맵> [x] [y]',
    desc: `맵 이동. 맵: ${Object.keys(MAPS).join(', ')}`,
    run(c, args) {
      const id = args[0];
      if (!MAPS[id]) return c.print(`없는 맵. 사용 가능: ${Object.keys(MAPS).join(', ')}`, 'err');
      const m = MAPS[id];
      let x = Math.floor(Number(args[1]));
      let y = Math.floor(Number(args[2]));
      if (!Number.isFinite(x) || !Number.isFinite(y)) {
        // 좌표 생략 시 그 맵에서 걸을 수 있는 첫 칸
        outer: for (let ty = 0; ty < m.grid.length; ty++) {
          for (let tx = 0; tx < m.grid[0].length; tx++) {
            if ('.,"-S=_:c'.includes(m.grid[ty][tx])) { x = tx; y = ty; break outer; }
          }
        }
      }
      c.game.overlays.length = 0;
      c.game.state.map = id;
      c.game.world.load(id, x, y, 'down');
      c.game.syncPosition();
      c.print(`${m.name} (${x}, ${y}) 로 이동`, 'ok');
    },
  },

  dex: {
    cat: '소지품',
    usage: '/dex <all|list|clear>',
    desc: '도감을 전부 채우거나 목록을 본다',
    run(c, args) {
      const mode = args[0] || 'list';
      if (mode === 'all') {
        DEX_ORDER.forEach((id) => { c.game.state.dex[id] = 2; });
        sfx.confirm();
        return c.print(`도감 ${DEX_ORDER.length}종 전부 포획 상태로 기록했다.`, 'ok');
      }
      if (mode === 'clear') {
        c.game.state.dex = {};
        return c.print('도감을 초기화했다.', 'ok');
      }
      c.print(DEX_ORDER.map((id) => `${id}:${MONSTERS[id].name}`).join('  '), 'dim');
    },
  },

  encounter: {
    cat: '월드',
    usage: '/encounter <몬스터|id> [레벨]',
    desc: '지정한 야생 몬스터와 즉시 전투한다',
    run(c, args) {
      const sp = findMonster(args[0]);
      if (!sp) return c.print('몬스터를 찾을 수 없음', 'err');
      if (!c.game.state.party.some((m) => m.hp > 0)) return c.print('싸울 수 있는 몬스터가 없음', 'err');
      const lv = Math.max(1, Math.min(100, Math.floor(Number(args[1])) || 5));
      c.close();
      c.game.startWildBattle([{ id: sp.id, weight: 1, min: lv, max: lv }]);
      c.print(`야생 ${sp.name} Lv.${lv} 출현!`, 'ok');
    },
  },

  rate: {
    cat: '월드',
    usage: '/rate <배수>',
    desc: '풀숲 조우 확률 배수 (0 이면 조우 없음, 기본 1)',
    run(c, args) {
      const v = Number(args[0]);
      if (!Number.isFinite(v) || v < 0) return c.print('예: /rate 0  또는  /rate 3', 'err');
      c.game.cheats.encounterMul = v;
      c.print(`조우 확률 ×${v}`, 'ok');
    },
  },

  noclip: {
    cat: '월드',
    usage: '/noclip',
    desc: '벽·물·건물 통과 토글',
    run(c) {
      c.game.cheats.noclip = !c.game.cheats.noclip;
      c.print(`벽 통과 ${c.game.cheats.noclip ? 'ON' : 'OFF'}`, 'ok');
    },
  },

  speed: {
    cat: '월드',
    usage: '/speed <배수>',
    desc: '이동 속도 배수 (기본 1, 최대 5)',
    run(c, args) {
      const v = Math.max(0.25, Math.min(5, Number(args[0]) || 1));
      c.game.world.moveTime = 0.17 / v;
      c.print(`이동 속도 ×${v}`, 'ok');
    },
  },

  party: {
    cat: '몬스터',
    usage: '/party',
    desc: '현재 파티 상태를 본다',
    run(c) {
      const p = c.game.state.party;
      if (!p.length) return c.print('파티가 비어 있음', 'dim');
      p.forEach((m, i) => c.print(
        `${i + 1}. ${displayName(m)} Lv.${m.level}  HP ${m.hp}/${m.maxHp}  친밀도 ${m.friendship}${i === 0 ? '  ← 선두' : ''}`,
        i === 0 ? 'ok' : 'dim'));
    },
  },

  lead: {
    cat: '몬스터',
    usage: '/lead <파티번호>',
    desc: '해당 번호를 선두(따라다니는 몬스터)로 올린다',
    run(c, args) {
      const idx = (Math.floor(Number(args[0])) || 0) - 1;
      const p = c.game.state.party;
      if (idx < 0 || idx >= p.length) return c.print(`1 ~ ${p.length} 사이의 번호를 넣으세요`, 'err');
      const [m] = p.splice(idx, 1);
      p.unshift(m);
      c.game.world.follower.visible = !!p.length;
      sfx.confirm();
      c.print(`${displayName(m)}이(가) 선두가 되었다.`, 'ok');
    },
  },

  moves: {
    cat: '몬스터',
    usage: '/moves [파티번호]',
    desc: '가지고 있는 기술을 본다',
    run(c, args) {
      const idx = Math.max(0, (Math.floor(Number(args[0])) || 1) - 1);
      const m = c.game.state.party[idx];
      if (!m) return c.print(`파티 ${idx + 1}번이 비어 있음`, 'err');
      if (!m.moves || !m.moves.length) m.moves = movesAtLevel(m.id, m.level);
      c.print(`${displayName(m)} Lv.${m.level} — 기술 ${m.moves.length}/${MOVE_MAX}`, 'ok');
      m.moves.forEach((id, i) => {
        const mv = MOVES[id];
        c.print(`  ${i + 1}. ${mv.name}  [${mv.type}] 위력 ${mv.power}`, 'dim');
      });
    },
  },

  learn: {
    cat: '몬스터',
    usage: '/learn <기술이름> [파티번호]',
    desc: '기술을 가르친다 (칸이 차 있으면 마지막 칸을 덮어쓴다)',
    run(c, args) {
      const key = args[0];
      const mv = MOVES[key] || Object.values(MOVES).find((x) => x.name === key);
      if (!mv) return c.print(`없는 기술. /movelist 로 목록을 보세요.`, 'err');
      const idx = Math.max(0, (Math.floor(Number(args[1])) || 1) - 1);
      const m = c.game.state.party[idx];
      if (!m) return c.print(`파티 ${idx + 1}번이 비어 있음`, 'err');
      if (!m.moves) m.moves = [];
      if (m.moves.includes(mv.id)) return c.print('이미 알고 있는 기술', 'err');
      if (tryLearn(m, mv.id)) c.print(`${displayName(m)}이(가) ${mv.name}을(를) 익혔다.`, 'ok');
      else {
        const old = MOVES[m.moves[MOVE_MAX - 1]].name;
        m.moves[MOVE_MAX - 1] = mv.id;
        c.print(`${old} 대신 ${mv.name}을(를) 익혔다.`, 'ok');
      }
      sfx.levelup();
    },
  },

  movelist: {
    cat: '몬스터',
    usage: '/movelist [타입]',
    desc: '기술 목록을 본다 (예: /movelist 불)',
    run(c, args) {
      const t = args[0];
      const list = Object.values(MOVES).filter((m) => !t || m.type === t);
      if (!list.length) return c.print('해당 타입의 기술이 없음', 'err');
      list.forEach((m) => c.print(`  ${m.name}  [${m.type}] 위력 ${m.power}  Lv${m.minLv}~  (${m.id})`, 'dim'));
    },
  },

  save: {
    cat: '기본',
    usage: '/save',
    desc: '즉시 저장한다',
    run(c) {
      c.game.syncPosition();
      c.print(c.game.saveNow() ? '저장 완료.' : '저장 실패.', 'ok');
    },
  },
};

// 짧은 별칭 — 왼쪽을 치면 오른쪽 명령이 실행된다
const ALIASES = {
  h: 'help', '?': 'help', gold: 'money', m: 'money',
  warp: 'tp', go: 'tp', mon: 'give', level: 'lv', lvl: 'lv',
  hp: 'heal', fight: 'encounter', wild: 'encounter',
  skill: 'moves', skills: 'moves', teach: 'learn', p: 'party',
};

class CheatConsole {
  constructor(game) {
    this.game = game;
    this.open = false;
    this.history = [];
    this.histIndex = -1;
    this.unlocked = false;
  }

  attach(root) {
    this.el = root.querySelector('#chat');
    this.logEl = root.querySelector('#chatlog');
    this.inputEl = root.querySelector('#chatinput');
    this.toggleEl = root.querySelector('#chattoggle');
    if (!this.el) return;

    this.toggleEl.addEventListener('click', () => this.toggle());
    root.querySelector('#chatsend').addEventListener('click', () => this.submit());
    this.inputEl.addEventListener('keydown', (e) => {
      e.stopPropagation();
      if (e.key === 'Enter') { e.preventDefault(); this.submit(); }
      else if (e.key === 'Escape') { e.preventDefault(); this.close(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); this.recall(1); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); this.recall(-1); }
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && !this.open && document.activeElement !== this.inputEl) {
        e.preventDefault(); this.toggle(true); this.inputEl.value = '/';
      }
    });

    this.print('채팅창입니다. 치트 명령어는 잠겨 있습니다.', 'info');
    this.print('암호 명령어를 입력해야 치트를 사용할 수 있습니다.', 'dim');
  }

  toggle(force) {
    this.open = force === undefined ? !this.open : force;
    this.el.classList.toggle('is-open', this.open);
    this.toggleEl.classList.toggle('is-open', this.open);
    if (this.open) setTimeout(() => this.inputEl.focus(), 30);
    else this.inputEl.blur();
  }

  close() { this.toggle(false); }

  lock(silent=false) {
    this.unlocked=false;
    if (!silent) this.print('치트 명령어를 다시 잠갔습니다.', 'info');
  }

  print(text, kind = 'plain') {
    if (!this.logEl) return;
    const line = document.createElement('div');
    line.className = `chatline ${kind}`;
    line.textContent = text;
    this.logEl.appendChild(line);
    while (this.logEl.childElementCount > 120) this.logEl.removeChild(this.logEl.firstChild);
    this.logEl.scrollTop = this.logEl.scrollHeight;
  }

  recall(dir) {
    if (!this.history.length) return;
    this.histIndex = Math.max(-1, Math.min(this.history.length - 1, this.histIndex + dir));
    this.inputEl.value = this.histIndex < 0 ? '' : this.history[this.histIndex];
  }

  // 게임이 텍스트 한 줄을 물어볼 때 (별명 입력 등)
  askText(prompt, cb) {
    this.pending = cb;
    this.toggle(true);
    this.print(prompt, 'info');
    this.inputEl.placeholder = '입력 후 Enter';
  }

  submit() {
    const raw = this.inputEl.value.trim();
    this.inputEl.value = '';
    if (this.pending) {
      const cb = this.pending;
      this.pending = null;
      this.inputEl.placeholder = '/help 를 입력해 보세요';
      this.print(raw ? `> ${raw}` : '> (변경 없음)', 'echo');
      this.toggle(false);
      cb(raw);
      return;
    }
    if (!raw) return;
    this.history.unshift(raw);
    this.histIndex = -1;
    this.print(raw.toLowerCase()==='/monstia' ? '> ••••••••' : `> ${raw}`, 'echo');
    this.run(raw);
  }

  run(raw) {
    if (!raw.startsWith('/')) return; // 명령어가 아니면 그냥 채팅 기록으로 남는다
    if (raw.trim().toLowerCase()==='/monstia') {
      this.unlocked=true; sfx.confirm();
      this.print('MONSTIA 개발자 치트가 해제되었습니다.', 'ok');
      this.print('/help 로 사용할 수 있는 명령어를 확인하세요.', 'dim');
      return;
    }
    if (!this.unlocked) {
      sfx.deny();
      this.print('치트가 잠겨 있습니다. 암호를 먼저 입력하세요.', 'err');
      return;
    }
    const parts = raw.slice(1).split(/\s+/);
    const name = parts[0].toLowerCase();
    const cmd = COMMANDS[name] || COMMANDS[ALIASES[name]];
    if (!cmd) {
      const near = Object.keys(COMMANDS).filter((k) => k.startsWith(name[0] || ''));
      this.print(`모르는 명령어: /${name}`, 'err');
      this.print(near.length ? `혹시 이건가요? ${near.map((k) => '/' + k).join(', ')}` : '/help 를 입력해 보세요.', 'dim');
      sfx.deny();
      return;
    }
    try { cmd.run(this, parts.slice(1)); }
    catch (e) { this.print(`오류: ${e.message}`, 'err'); }
  }
}



/* ===== js/main.js ===== */
// ============================================================


/* ===== js/main.js ===== */
// main.js — 부팅
// ============================================================






const root = document.getElementById('app');
const game = new Game(root);

input.attach(root);

const chat = new CheatConsole(game);
chat.attach(root);
game.chat = chat;
game.fit();
game.start();
// v0.8.0: 저장된 로그인 세션이 있으면 부팅 중 최신 클라우드 세이브를 확인한다.
cloud.init(game);

const refit = () => game.fit();
window.addEventListener('resize', refit);
window.addEventListener('orientationchange', () => setTimeout(refit, 120));
if (window.visualViewport) window.visualViewport.addEventListener('resize', refit);

// 오디오는 첫 사용자 입력에서 깨어난다 (모바일 브라우저 정책)
const wake = () => { sfx.ensure(); };
window.addEventListener('pointerdown', wake, { once: true });
window.addEventListener('keydown', wake, { once: true });

// 디버그용
window.MONSTIA = game;
window.CHAT = chat;

</script>
</body>
</html>
