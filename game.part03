const MOVE_MAX = 4;

// v7.4 — SP(스킬포인트)
// 기술 위력이 강할수록 SP 소모가 커진다. 보조기는 효과 강도에 따라 중간 비용을 사용한다.
function moveSpCost(move) {
  if (!move) return 0;
  if (Number.isFinite(move.spCost)) return move.spCost;
  if (!move.power) {
    if (move.heal) return move.heal >= 0.4 ? 14 : 11;
    if (move.effect?.status) return 10;
    if (move.effect?.stat) return 8;
    return 8;
  }
  if (move.power <= 28) return 4;
  if (move.power <= 38) return 6;
  if (move.power <= 48) return 8;
  if (move.power <= 58) return 11;
  if (move.power <= 68) return 14;
  return 18;
}
for (const mv of Object.values(MOVES)) mv.spCost = moveSpCost(mv);


// 타입별 기술 사다리 — 레벨이 오를수록 이 순서대로 강해진다
const TYPE_LADDER = {
  풀:   ['vine', 'grow', 'leafcut', 'seedbomb', 'leafblade'],
  불:   ['ember', 'willfire', 'fireclaw', 'heatwave', 'flame'],
  물:   ['bubble', 'aquaheal', 'watergun', 'surf', 'hydro'],
  전기: ['spark', 'staticwave', 'zap', 'discharge', 'thunder'],
  벌레: ['bugbite', 'silverwind', 'xscissor'],
  비행: ['gust', 'agility', 'wing', 'aerial', 'storm'],
  바위: ['rockdrop', 'rockseal', 'stoneedge'],
  독:   ['poisonsting', 'toxicmist', 'poisonjab', 'sludge'],
  얼음: ['frostbite', 'iceclaw', 'blizzard'], 강철: ['metalhit', 'ironclaw', 'meteoriron'],
  고스트: ['shadowtap', 'soulburst', 'phantom'], 드래곤: ['dragonfang', 'dragonrush', 'dragonstorm'],
  에스퍼: ['mindpulse', 'focus', 'psywave', 'transcend'], 페어리: ['fairywind', 'lullaby', 'moonkiss', 'fairyburst'],
  악: ['darkbite', 'intimidate', 'nightclaw', 'abyss'], 빛: ['lightorb', 'recover', 'rayblade', 'solarflare'],
  노말: ['focus', 'bite', 'guard', 'slam', 'takedown'],
};

// 종족 하나의 레벨업 학습표: 시작 기술 + 속성 사다리 + 노말 사다리
function buildLearnset(sp) {
  const ids = [sp.start, ...(TYPE_LADDER[sp.type] || []), ...TYPE_LADDER['노말']];
  const seen = new Set();
  const out = [];
  for (const id of ids) {
    if (!id || seen.has(id)) continue;
    seen.add(id);
    const mv = MOVES[id];
    // 진화 단계가 높을수록 조금 일찍 익힌다
    const lv = id === sp.start ? 1 : Math.max(2, mv.minLv - (sp.stage - 1) * 3);
    out.push({ level: lv, move: id });
  }
  return out.sort((a, b) => a.level - b.level || MOVES[a.move].power - MOVES[b.move].power);
}

// ------------------------------------------------------------
// 몬스터 도감 — 24종, 모든 계통이 3단 진화
//   stage : 1/2/3 — 전투 스프라이트 크기와 기술 습득 속도에 반영
//   deco  : 진화할수록 뿔·날개·갈기·왕관이 붙어 실루엣이 커진다
//   start : Lv1 부터 가지고 있는 기술
// ------------------------------------------------------------
function mon(o) {
  const num = String(o.id).padStart(3, '0');
  const sp = {
    expYield: 45, catchRate: 45, evolution: null, deco: [], stage: 1,
    sprite: `assets/monsters/mon_${num}.png`,
    backSprite: `assets/monsters/mon_${num}_back.png`,
    icon: `assets/monsters/icon_${num}.png`,
    ...o,
    dexNumber: o.id,
  };
  sp.learnset = buildLearnset(sp);
  return sp;
}

