    desc:'소지금 1,000,000원을 달성한다.',
    test:(game)=>Number(game.state.money||0)>=1000000,
    progress:(game)=>`${Math.min(1000000,Number(game.state.money||0)).toLocaleString()}/1,000,000원`,
  },
];

function refreshAchievements(game) {
  if (!game.state.achievements) game.state.achievements = {};
  const newly = [];
  for (const a of ACHIEVEMENTS) {
    if (!game.state.achievements[a.id] && a.test(game)) {
      game.state.achievements[a.id] = { unlockedAt:Date.now() };
      newly.push(a);
    }
  }
  return newly;
}

function activeTitleLabel(game) {
  return String(game.state.activeTitle || '신입 모험가');
}

