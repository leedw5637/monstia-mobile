  altar_wind(ctx, W, H) {
    px(ctx,1,H-6,W-2,6,'#627b92'); px(ctx,2,H-9,W-4,3,'#8ca4b8');
    px(ctx,4,H-12,W-8,3,'#b8cedd');
    const cx=Math.floor(W/2); px(ctx,cx-1,H-18,2,8,'#f1fbff'); px(ctx,cx-4,H-15,8,1,'#d8eaf5');
  },
  altar_thunder(ctx, W, H) {
    px(ctx,1,H-6,W-2,6,'#34364f'); px(ctx,2,H-9,W-4,3,'#555a78'); px(ctx,4,H-12,W-8,3,'#777da0');
    const cx=Math.floor(W/2); px(ctx,cx-1,H-19,2,9,'#f2d64a'); px(ctx,cx-5,H-15,10,1,'#68dce9');
    px(ctx,cx-3,H-17,2,2,'#fff19a'); px(ctx,cx+2,H-14,2,2,'#fff19a');
  },
  generator(ctx, W, H) {
    px(ctx,1,4,W-2,H-6,'#4d5668'); px(ctx,2,5,W-4,H-8,'#69758a');
    px(ctx,4,8,W-8,5,'#27334c'); px(ctx,5,9,W-10,3,'#66d9e8');
    px(ctx,4,H-8,4,3,'#f0d34c'); px(ctx,W-8,H-8,4,3,'#d75b4b');
  },
  coil_tower(ctx, W, H) {
    const cx=Math.floor(W/2); px(ctx,cx-4,H-5,8,5,'#454a5d'); px(ctx,cx-2,6,4,H-11,'#7d849b');
    for(let y=5;y<H-8;y+=5){ px(ctx,cx-5,y,10,2,'#c58c46'); px(ctx,cx-3,y-1,6,1,'#f0bd55'); }
    px(ctx,cx-1,1,2,5,'#f5e55e'); px(ctx,cx-4,3,3,1,'#65d9e8'); px(ctx,cx+1,3,3,1,'#65d9e8');
  },

  // ------------------------------ 마을 장식용 비입장 건물 / 소품
  decor_house(ctx, W, H) {
    px(ctx,1,Math.floor(H*.35),W-2,H-Math.floor(H*.35)-2,'#e6d1ad');
    px(ctx,0,Math.floor(H*.28),W,Math.max(5,Math.floor(H*.22)),'#a64b3f');
    px(ctx,2,Math.floor(H*.22),W-4,4,'#c55d4d');
    const cx=Math.floor(W/2); px(ctx,cx-3,H-11,6,9,'#765038');
    px(ctx,4,Math.floor(H*.53),5,5,'#8bc1db');
  },
  decor_workshop(ctx, W, H) {
    px(ctx,1,Math.floor(H*.35),W-2,H-Math.floor(H*.35)-2,'#a59479');
    px(ctx,0,Math.floor(H*.26),W,Math.max(5,Math.floor(H*.20)),'#5a5150');
    px(ctx,3,4,W-6,5,'#6d6260');
    px(ctx,W-9,1,4,Math.floor(H*.32),'#4b4240');
    const cx=Math.floor(W/2); px(ctx,cx-3,H-11,6,9,'#574237');
    px(ctx,4,H-15,5,4,'#d18a3d');
  },
  decor_warehouse(ctx, W, H) {
    px(ctx,1,Math.floor(H*.30),W-2,H-Math.floor(H*.30)-2,'#a67a57');
    px(ctx,0,Math.floor(H*.22),W,8,'#6d4e3b');
    for(let x=4;x<W-4;x+=7) px(ctx,x,Math.floor(H*.22),2,H-Math.floor(H*.22)-2,'#7e5b43');
    const cx=Math.floor(W/2); px(ctx,cx-5,H-13,10,11,'#4f3d35');
  },
  decor_cabin(ctx, W, H) {
    px(ctx,1,Math.floor(H*.34),W-2,H-Math.floor(H*.34)-2,'#b28c68');
    px(ctx,0,Math.floor(H*.24),W,8,'#6f7682');
    px(ctx,3,Math.floor(H*.18),W-6,4,'#dce7ef');
    const cx=Math.floor(W/2); px(ctx,cx-3,H-11,6,9,'#675244');
    px(ctx,4,H-16,5,5,'#9ec8dd');
  },
  market_stall(ctx, W, H) {
    px(ctx,1,7,W-2,4,'#8a6338'); px(ctx,2,11,W-4,H-13,'#b8874c');
    for(let x=1;x<W-1;x+=6){ px(ctx,x,2,5,5,'#d95c4a'); px(ctx,x+3,2,3,5,'#f0d27a'); }
    px(ctx,2,H-5,W-4,3,'#76502f');
  },
  bench(ctx, W, H) {
    px(ctx,2,6,W-4,3,'#9b6b3d'); px(ctx,2,10,W-4,3,'#8a5b34');
    px(ctx,4,13,2,H-13,'#624329'); px(ctx,W-6,13,2,H-13,'#624329');
  },
  well(ctx, W, H) {
    px(ctx,2,H-8,W-4,6,'#777b80'); px(ctx,3,H-9,W-6,2,'#a3a7aa');
    px(ctx,4,6,2,H-13,'#6f5035'); px(ctx,W-6,6,2,H-13,'#6f5035');
    px(ctx,2,3,W-4,4,'#9c6b3f');
  },
  crates(ctx, W, H) {
    px(ctx,1,5,W-2,H-6,'#9b6c3f'); px(ctx,2,6,W-4,H-8,'#b57d48');
    px(ctx,1,Math.floor(H/2),W-2,2,'#704b2f'); px(ctx,Math.floor(W/2)-1,5,2,H-6,'#704b2f');
  },
  snowman(ctx, W, H) {
    const cx=Math.floor(W/2); px(ctx,cx-5,H-8,10,7,'#f2f7fb'); px(ctx,cx-4,H-14,8,7,'#ffffff');
    px(ctx,cx-2,H-12,1,1,'#252933'); px(ctx,cx+2,H-12,1,1,'#252933'); px(ctx,cx,H-10,3,1,'#d87832');
    px(ctx,cx-4,H-16,8,2,'#556273');
  },

  gym_banner(ctx, W, H, theme) {
    const accent = ({grass:'#70bd55',rock:'#a476d8',harbor:'#62b7d8',snow:'#9ed7f3',thunder:'#f1d64c'})[theme] || '#d85b4d';
    px(ctx,2,1,W-4,H-3,'#242735');
    px(ctx,3,2,W-6,H-5,accent);
    const cx=Math.floor(W/2);
    px(ctx,cx-1,5,2,Math.max(2,H-12),'#fff1b0');
    px(ctx,4,H-8,W-8,2,'#fff1b0');
    px(ctx,1,H-2,W-2,2,'#171922');
  },
  gym_scoreboard(ctx, W, H, theme) {
    const accent = ({grass:'#70bd55',rock:'#a476d8',harbor:'#62b7d8',snow:'#9ed7f3',thunder:'#f1d64c'})[theme] || '#d85b4d';
    px(ctx,0,1,W,H-2,'#171a24'); px(ctx,2,3,W-4,H-6,'#2a2f3e');
    px(ctx,4,5,6,4,accent); px(ctx,W-10,5,6,4,accent);
    px(ctx,Math.floor(W/2)-1,4,2,H-8,'#f1d77a');
  },
  gym_trophy(ctx, W, H) {
    const cx=Math.floor(W/2);
    px(ctx,cx-4,3,8,3,'#d9a62d'); px(ctx,cx-3,6,6,5,'#f0c84b');
    px(ctx,cx-5,5,2,4,'#b77d20'); px(ctx,cx+3,5,2,4,'#b77d20');
    px(ctx,cx-1,11,2,2,'#a66b1c'); px(ctx,cx-4,13,8,2,'#68482a');
  },

  starter(ctx, W, H) {
    const cx = Math.floor(W / 2), cy = Math.floor(H / 2) + 2;
    px(ctx, cx - 5, cy + 4, 10, 2, '#8e8a9c');
    px(ctx, cx - 4, cy - 4, 8, 8, '#22202c');
    px(ctx, cx - 3, cy - 4, 6, 4, '#e0483c');
    px(ctx, cx - 3, cy, 6, 3, '#f0f0f4');
    px(ctx, cx - 3, cy - 1, 6, 1, '#22202c');
    px(ctx, cx - 1, cy - 1, 2, 2, '#c8c8d0');
  },
};

function paintObject(kind, wTiles, hTiles, theme = 'grass') {
  const W = wTiles * TILE, H = hTiles * TILE;
  const c = makeCanvas(W, H);
  const ctx = c.getContext('2d');
  const fn = OBJECT_PAINTERS[kind];
  if (fn) fn(ctx, W, H, theme);
  else { px(ctx, 1, 1, W - 2, H - 2, '#8a6338'); }
  return c;
}

// ------------------------------------------------------------
// 몬스터
// ------------------------------------------------------------
function paintMonster(species) {
  const shape = SHAPES[species.shape] || SHAPES.blob;
  const p = species.palette;
  const pal = {
    o: '#22202c', a: p.a, b: p.b, c: p.c, d: p.d || p.c,
    e: p.e || p.d || p.a, w: p.w || '#fdfdff', k: '#22202c',
  };
  const c = makeCanvas(TILE, TILE);
  const ctx = c.getContext('2d');
  const deco = species.deco || [];
  // 뒤 장식 -> 몸 -> 앞 장식 순으로 겹친다
  for (const name of deco) if (DECO_BACK.has(name) && DECOS[name]) paintGridInto(ctx, DECOS[name], pal);
  paintGridInto(ctx, shape, pal);
  for (const name of deco) if (!DECO_BACK.has(name) && DECOS[name]) paintGridInto(ctx, DECOS[name], pal);
  return c;
}

// v7.1 몬스터 화면 크기 규칙
// 필드: 1단계=1타일, 2단계=1.25타일, 최종=1.5타일, 전설=1.75타일.
function fieldMonsterSize(species) {
  if (species.legendary) return Math.round(TILE * 1.75); // 28px
  if (species.mythical) return Math.round(TILE * 1.625); // 26px, 일반 최종보다 크고 전설보다 작음
  const stage = Math.max(1, Math.min(3, species.stage || 1));
  return stage === 1 ? TILE : stage === 2 ? Math.round(TILE * 1.25) : Math.round(TILE * 1.5);
}

// 배틀: 도감 표시(약 54px) 이상을 기준으로 하되 160px 전투 화면을 침범하지 않는다.
function battleMonsterSize(species) {
  if (species.legendary) return 74;
  if (species.mythical) return 72;
  const stage = Math.max(1, Math.min(3, species.stage || 1));
  return stage === 1 ? 58 : stage === 2 ? 64 : 70;
}

function fitSpriteSize(img, maxW, maxH = maxW) {
  const iw = Math.max(1, img?.naturalWidth || img?.width || 1);
  const ih = Math.max(1, img?.naturalHeight || img?.height || 1);
  const s = Math.min(maxW / iw, maxH / ih);
  return { w: Math.max(1, Math.round(iw * s)), h: Math.max(1, Math.round(ih * s)) };
}

// ------------------------------------------------------------
// 인간 (플레이어 / NPC) — 방향 4종 x 프레임 3종
// ------------------------------------------------------------
function paintHuman(palette, dir, frame) {
  const base = dir === 'up' ? HUMAN.up : dir === 'down' ? HUMAN.down : HUMAN.side;
  const grid = base.slice(0, 13).concat(LEGS[frame % LEGS.length]);
  const pal = { o: palette.o, h: palette.h, c: palette.c, f: palette.f, k: palette.k, s: palette.s, p: palette.p, b: palette.b };
  let c = gridToCanvas(grid, pal);

  if (dir === 'left') {
    const mirrored = makeCanvas(16, 16);
    const mx = mirrored.getContext('2d');
    mx.imageSmoothingEnabled = false;
    mx.translate(16, 0); mx.scale(-1, 1);
    mx.drawImage(c, 0, 0);
    c = mirrored;
  }

  // v6.9: 모든 인간형 스프라이트를 동일한 24x32 캔버스에 중앙/하단 정렬.
  // 실제 PNG가 로딩되기 전 폴백도 같은 규격을 사용해 방향 전환 시 크기 점프를 막는다.
  const out = makeCanvas(24, 32);
  const ox = out.getContext('2d');
  ox.imageSmoothingEnabled = false;
  ox.drawImage(c, 2, 8, 20, 20);
  return out;
}

// 그림자
function paintShadow() {
  const c = makeCanvas(16, 16);
  const ctx = c.getContext('2d');
  ctx.fillStyle = 'rgba(0,0,0,0.22)';
  ctx.fillRect(4, 13, 8, 2);
  ctx.fillRect(3, 14, 10, 1);
  return c;
}


/* ===== js/core/assets.js ===== */
// ============================================================


/* ===== js/core/assets.js ===== */
// assets.js — AssetManager
// ------------------------------------------------------------
// 규칙: 먼저 절차적 그래픽으로 즉시 게임을 굴린다.
//       동시에 assets/ 의 PNG 를 비동기로 찾아보고,
//       파일이 있으면 그 자리에서 조용히 갈아 끼운다.
//       => PNG 를 넣기만 하면 코드 수정 없이 그래픽이 교체된다.
// ============================================================



class AssetManager {
  constructor() {
    this.cache = new Map();
    this.tried = new Set();
    this.enabled = true;
    this.coreEntries = [];
    this.corePreloaded = false;
  }

  _get(key, pngPath, generate) {
    let entry = this.cache.get(key);
    if (!entry) {
      const inline = !!(pngPath && globalThis.MONSTIA_INLINE_ASSETS && globalThis.MONSTIA_INLINE_ASSETS[pngPath]);
      entry = { img: generate(), ready: !inline, fromPng:false, path:pngPath || null };
      this.cache.set(key, entry);
      if (this.enabled && pngPath && !this.tried.has(pngPath)) {
        this.tried.add(pngPath);
        const im = new Image();
        im.decoding = 'async';
        im.onload = () => { entry.img = im; entry.fromPng = true; entry.ready = true; };
        im.onerror = () => { entry.ready = true; };
        im.src = (globalThis.MONSTIA_INLINE_ASSETS && globalThis.MONSTIA_INLINE_ASSETS[pngPath]) || pngPath;
        // decode()를 지원하는 브라우저는 실제 픽셀 디코딩까지 로딩 단계에서 끝낸다.
        if (im.decode) im.decode().then(() => {
          if (im.complete && im.naturalWidth) { entry.img=im; entry.fromPng=true; entry.ready=true; }
        }).catch(() => {});
      }
    }
    return entry.img;
  }

  preloadCore() {
    if (this.corePreloaded) return;
    this.corePreloaded = true;
    const dirs=['down','left','right','up'];
    for (const sp of Object.values(MONSTERS)) for (const d of dirs) this.fieldMonster(sp,d);
    const humans=['mom','professor','nurse','clerk','kid_male','kid_female','villager_male','villager_female',
      'old_male','old_female','hiker','gardener','camper','ranger','miner','stonemason','researcher','fisher',
      'sailor','dockworker','snow_scout','engineer','trainer','gym_saron','gym_rokan','gym_seira','gym_frion',
      'gym_seon','gym_kairan','gym_lumiel','hero'];
    for (const h of humans) for (const d of dirs) this.human(h,HUMAN_PALETTES.hero,d,0);
    for (const id of Object.keys(ITEMS)) { this.itemIcon(id); this.fieldItem(id); }
    // 맵 타일/건물/오브젝트도 미리 준비해 지역 첫 진입 때 절차적 이미지가 순간적으로 보이지 않게 한다.
    for (const [mapId,map] of Object.entries(MAPS)) {
      const theme=mapThemeFor(mapId,map), skin=mapSkinFor(mapId);
      const seen=new Set();
      for (const row of map.grid||[]) for (const ch of row) {
        const props=TILES[ch]||TILES['#'];
        const kk=`${props.key}:${theme}:${skin||''}`;
        if(seen.has(kk)) continue; seen.add(kk);
        for(let v=0;v<3;v++) this.tile(props.key,v,theme,skin);
      }
      for(const o of map.objects||[]){
        const w=o.w||1,h=o.h||1;
        if(o.kind==='building') this.building(o.style,w,h,(o.door??o.x)-o.x,theme);
        else if(o.kind!=='legendary'&&o.kind!=='fieldboss'&&o.kind!=='item') this.object(o.kind,w,h,theme,skin);
      }
    }
    this.uiImage('loading_v070'); this.uiImage('title_v070');
    this.shadow();
    this.coreEntries=[...this.cache.values()];
  }

  coreLoadRatio() {
    if (!this.coreEntries.length) return 1;
    const ready=this.coreEntries.filter(e=>e.ready).length;
    return ready/this.coreEntries.length;
  }

  tile(key, variant, theme = 'grass', skin = null) {
    const skinKey = skin || theme;
    const path = `assets/world/tiles/${skinKey}_${key}_${variant}.png`;
    return this._get(`tile:${skinKey}:${key}:${variant}`, path,
      () => paintTile(key, variant, theme));
  }

  building(style, w, h, door, theme = 'grass') {
    if (style === 'gym') {
      return this._get(`bld:hqgym:${theme}:${w}x${h}:${door}`, null,
        () => paintBuilding(style, w, h, door, theme));
    }
    const path = `assets/world/buildings/${theme}_${style}_${w}x${h}.png`;
    return this._get(`bld:${theme}:${style}:${w}x${h}:${door}`, path,
      () => paintBuilding(style, w, h, door, theme));
  }

  object(kind, w, h, theme = 'grass', skin = null) {
    const skinKey = skin || theme;
    const path = `assets/world/objects/${skinKey}_${kind}_${w}x${h}.png`;
    return this._get(`obj:${skinKey}:${kind}:${w}x${h}`, path,
      () => paintObject(kind, w, h, theme));
  }

  // v7.1: 사용자가 제공한 원본 텍스처를 방향별 HQ 자산으로 직접 사용한다.
  fieldMonster(species, dir = 'down') {
    const num = String(species.id).padStart(3, '0');
    const d = ['up','down','left','right'].includes(dir) ? dir : 'down';
    return this._get(`monhq:${species.id}:${d}`, `assets/monsters/hq_${num}_${d}.png`,
      () => paintMonster(species));
  }

  battleMonster(species) {
    // 같은 HQ 이미지를 재사용해 전투 진입 때 16px 폴백이 잠깐 보이거나 중복 디코딩되는 현상을 없앤다.
    // 전설은 도감/필드와 동일하게 측면 실루엣을 사용해 한눈에 읽히게 한다.
    return this.fieldMonster(species, species.legendary ? 'left' : 'down');
  }

  battleMonsterBack(species) {
    return this.fieldMonster(species, 'up');
  }

  monster(species) { return this.fieldMonster(species, 'down'); }

  human(paletteKey, palette, dir, frame) {
    const d = ['up','down','left','right'].includes(dir) ? dir : 'down';
    return this._get(`humhq:${paletteKey}:${d}`, `assets/humans/${paletteKey}_${d}.png`,
      () => paintHuman(palette, d, 0));
  }


  uiImage(name) {
    return this._get(`ui:${name}`, `assets/ui/${name}.png`, () => {
      const c = document.createElement('canvas'); c.width = 2; c.height = 2; return c;
    });
  }

  itemIcon(itemId) {
    return this._get(`item:${itemId}`, `assets/items/${itemId}.png`, () => {
      const c = document.createElement('canvas'); c.width = 16; c.height = 16;
      const x = c.getContext('2d'); x.imageSmoothingEnabled = false;
      if (ITEMS[itemId]?.equip) {
        x.fillStyle='#25283a'; x.fillRect(2,2,12,12);
        if (itemId==='attack_charm') {
          x.fillStyle='#e06c3c'; x.fillRect(7,2,2,12); x.fillRect(4,5,8,5); x.fillStyle='#ffd27a'; x.fillRect(6,6,4,3);
        } else if (itemId==='guard_charm') {
          x.fillStyle='#5f8fd0'; x.fillRect(4,3,8,7); x.fillRect(6,10,4,3); x.fillStyle='#d7e8ff'; x.fillRect(6,5,4,4);
        } else if (itemId==='life_necklace') {
          x.fillStyle='#d85b68'; x.fillRect(4,5,3,3); x.fillRect(9,5,3,3); x.fillRect(5,8,6,3); x.fillRect(7,11,2,2);
          x.fillStyle='#e9c65c'; x.fillRect(7,2,2,3);
        } else if (itemId==='speed_feather') {
          x.fillStyle='#83c985'; x.fillRect(4,10,8,2); x.fillRect(6,7,6,2); x.fillRect(8,4,4,2); x.fillRect(10,2,2,2);
          x.fillStyle='#e8f7df'; x.fillRect(6,11,1,2);
        } else {
          x.fillStyle='#67d5e3'; x.fillRect(7,2,2,12); x.fillRect(5,4,6,8); x.fillStyle='#d9fbff'; x.fillRect(7,4,2,5);
        }
        return c;
      }
      x.fillStyle = '#d8c995'; x.fillRect(3, 3, 10, 10);
      x.fillStyle = '#7f6a3d'; x.fillRect(5, 1, 6, 3);
      return c;
    });
  }

  fieldItem(itemId) {
    return this._get(`fielditem:${itemId}`, `assets/items/field_${itemId}.png`, () => this.itemIcon(itemId));
  }

  moveEffect(effectKey) {
    return this._get(`movefx:${effectKey}`, `assets/effects/moves/${effectKey}.png`, () => {
      const c = document.createElement('canvas'); c.width = 1; c.height = 1; return c;
    });
  }

  shadow() {
    return this._get('shadow', 'assets/effects/shadow.png', () => paintShadow());
  }
}

const assets = new AssetManager();

// 고해상도 세로 일러스트를 현재 160×224 논리 화면에 비율 유지 cover 방식으로 직접 렌더한다.
// world canvas 자체가 실제 출력 해상도라 저해상도 중간 캔버스를 거치지 않는다.
function drawCoverImage(ctx, img, x=0, y=0, w=160, h=224) {
  if (!img) return;
  const iw = Math.max(1, img.naturalWidth || img.width || 1);
  const ih = Math.max(1, img.naturalHeight || img.height || 1);
  const target = w / h, source = iw / ih;
  let sx=0, sy=0, sw=iw, sh=ih;
  if (source > target) { sw = ih * target; sx = (iw - sw) / 2; }
  else { sh = iw / target; sy = (ih - sh) / 2; }
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(img, sx, sy, sw, sh, x, y, w, h);
  ctx.imageSmoothingEnabled = false;
}


/* ===== js/core/input.js ===== */
// ============================================================


/* ===== js/core/input.js ===== */
// input.js — 키보드와 터치를 하나의 6버튼으로 통합
//   up / down / left / right / a / b
// ============================================================

const KEYMAP = {
  ArrowUp: 'up', KeyW: 'up',
  ArrowDown: 'down', KeyS: 'down',
  ArrowLeft: 'left', KeyA: 'left',
  ArrowRight: 'right', KeyD: 'right',
  KeyZ: 'a', Enter: 'a', Space: 'a',
  KeyX: 'b', Escape: 'b', Backspace: 'b', ShiftLeft: 'b',
};

class InputManager {
  constructor() {
    this.held = new Set();
    this.fresh = new Set();   // 이번 프레임에 새로 눌린 것
    this.repeat = new Map();  // 방향키 자동 반복 타이머
  }

  attach(root) {
    // 채팅 입력창에 포커스가 있으면 게임 조작키로 먹지 않는다
    const typing = () => {
      const a = document.activeElement;
      return !!a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.isContentEditable);
    };
    this.typing = typing;

    window.addEventListener('keydown', (e) => {
      if (typing()) return;
      const k = KEYMAP[e.code];
      if (!k) return;
      e.preventDefault();
      if (!this.held.has(k)) this.press(k);
    });
    window.addEventListener('keyup', (e) => {
      if (typing()) return;
      const k = KEYMAP[e.code];
      if (!k) return;
      e.preventDefault();
      this.release(k);
    });

    root.querySelectorAll('[data-key]').forEach((el) => {
      const k = el.dataset.key;
      const down = (e) => { e.preventDefault(); el.classList.add('is-down'); this.press(k); };
      const up = (e) => { e.preventDefault(); el.classList.remove('is-down'); this.release(k); };
      el.addEventListener('pointerdown', down);
      el.addEventListener('pointerup', up);
      el.addEventListener('pointercancel', up);
      el.addEventListener('pointerleave', up);
      el.addEventListener('contextmenu', (e) => e.preventDefault());
    });

    window.addEventListener('blur', () => { this.held.clear(); this.fresh.clear(); });
  }

  press(k) { if (!this.held.has(k)) this.fresh.add(k); this.held.add(k); }
  release(k) { this.held.delete(k); }

  down(k) { return this.held.has(k); }
  pressed(k) { return this.fresh.has(k); }

  // 방향 입력 하나만 (대각선 금지)
  direction() {
    for (const d of ['up', 'down', 'left', 'right']) if (this.held.has(d)) return d;
    return null;
  }
  freshDirection() {
    for (const d of ['up', 'down', 'left', 'right']) if (this.fresh.has(d)) return d;
    return null;
  }

  endFrame() { this.fresh.clear(); }
}

const input = new InputManager();


/* ===== js/core/audio.js ===== */
// ============================================================


/* ===== js/core/audio.js ===== */
// audio.js — 사각파 효과음. 파일 없이 코드로만 만든다.
// ============================================================

class Sfx {
  constructor() { this.ctx = null; this.on = true; }

  ensure() {
    if (!this.ctx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      this.ctx = new AC();
    }
    if (this.ctx.state === 'suspended') this.ctx.resume();
    return this.ctx;
  }

  tone(freq, dur, when = 0, type = 'square', vol = 0.06) {
    const ctx = this.ensure();
    if (!ctx || !this.on) return;
    const t = ctx.currentTime + when;
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    osc.connect(g); g.connect(ctx.destination);
    osc.start(t); osc.stop(t + dur + 0.02);
  }

  seq(notes, step = 0.08, type = 'square') {
    notes.forEach((f, i) => { if (f) this.tone(f, step * 0.9, i * step, type); });
  }

  blip()      { this.tone(520, 0.05, 0, 'square', 0.035); }
  confirm()   { this.seq([660, 880], 0.06); }
  cancel()    { this.seq([440, 300], 0.06); }
  step()      { this.tone(180, 0.03, 0, 'triangle', 0.02); }
  encounter() { this.seq([880, 0, 880, 0, 660, 990, 1320], 0.07); }
  mythical() {
    this.tone(110, 0.90, 0.00, 'sine', 0.035);
    this.tone(220, 0.72, 0.10, 'sine', 0.025);
    this.seq([392, 523, 659, 784, 1046, 1319], 0.13, 'triangle');
  }
  hit()       { this.tone(150, 0.12, 0, 'sawtooth', 0.05); }
  superHit()  { this.seq([260, 200, 150], 0.05, 'sawtooth'); }
  faint()     { this.seq([440, 380, 320, 260, 200], 0.07, 'triangle'); }
  levelup()   { this.seq([523, 659, 784, 1046], 0.09); }
  heal()      { this.seq([784, 988, 1175, 988, 1175], 0.09, 'triangle'); }
  ball()      { this.seq([300, 500], 0.05); }
  wobble()    { this.tone(420, 0.09, 0, 'square', 0.04); }
  caught()    { this.seq([659, 784, 1046, 1319], 0.1); }
  escape()    { this.seq([600, 400, 260], 0.07); }
  evolve()    { this.seq([523, 622, 784, 932, 1046, 1319], 0.11); }
  buy()       { this.seq([880, 1175], 0.06); }
  deny()      { this.tone(160, 0.14, 0, 'square', 0.05); }
}

const sfx = new Sfx();


/* ===== js/core/save.js ===== */
// ============================================================


/* ===== js/core/save.js ===== */
// save.js — localStorage 세이브
// ------------------------------------------------------------
// saveVersion 을 두고, 구조가 바뀌면 MIGRATIONS 에 함수를 추가한다.
// 옛 세이브도 순서대로 통과시켜서 깨지지 않게 만든다.
// ============================================================

const KEY = 'monstia.save.slot1';
const BACKUP_KEY = 'monstia.save.slot1.backup';
const SAVE_VERSION = 17;

// v(n) -> v(n+1) 변환 함수들. 예: MIGRATIONS[1] = (d) => {...; return d;}
const MIGRATIONS = {
  // v1 -> v2 : 기술 시스템 도입. 기술이 없는 옛 개체는 비워 두면
  //            불러오기 직후 레벨에 맞는 기술로 자동 보충된다.
  1: (d) => {
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) if (!Array.isArray(m.moves)) m.moves = null;
    return d;
  },
  // v2 -> v3 : 전설 몬스터가 마을별 히든 성역으로 재배치됐다.
  //            옛 세이브의 격파 기록을 지워서 새 위치에서 다시 만날 수 있게 한다.
  2: (d) => {
    if (d.flags) for (const k of Object.keys(d.flags)) if (k.startsWith('legendary_')) delete d.flags[k];
    d.legendaryRespawn = {};
    return d;
  },
  // v3 -> v4 : 체육관/증표 시스템 도입. 기존 진행과 몬스터는 그대로 보존한다.
  3: (d) => {
    if (!d.badges) d.badges = {};
    if (!d.legendaryRespawn) d.legendaryRespawn = {};
    return d;
  },
  // v4 -> v5 : 메인 진행 동선을 4개 지역 × 사냥터2 구조로 정리.
  //            옛 실험용/폐기 맵에 저장된 경우 가장 가까운 정상 진행 맵으로 옮긴다.
  4: (d) => {
    const remap = {
      route03: { map: 'route03b', x: 8, y: 18, dir: 'up' },
      route04: { map: 'route04b', x: 8, y: 18, dir: 'up' },
      town05:  { map: 'route04c', x: 8, y: 18, dir: 'up' },
    };
    const r = remap[d.map];
    if (r) { d.map = r.map; d.x = r.x; d.y = r.y; d.dir = r.dir; }
    if (!d.badges) d.badges = {};
    if (!d.legendaryRespawn) d.legendaryRespawn = {};
    return d;
  },
  // v5 -> v6 : 문스톤지역의 옛 샛길(route02b/c)을 메인 진행에서 제거.
  //            그 샛길에서 저장한 플레이어는 문스톤지역 사냥터2(route02)로 안전 복귀한다.
  5: (d) => {
    const remap = {
      route02b: { map: 'route02', x: 6,  y: 10, dir: 'up' },
      route02c: { map: 'route02', x: 13, y: 10, dir: 'up' },
    };
    const r = remap[d.map];
    if (r) { d.map = r.map; d.x = r.x; d.y = r.y; d.dir = r.dir; }
    if (!d.badges) d.badges = {};
    if (!d.legendaryRespawn) d.legendaryRespawn = {};
    return d;
  },
  // v6 -> v7 : 문스톤/노을/설원 마을을 태초마을급 크기로 확장했다.
  //            옛 좌표가 새 건물 안에 박히지 않도록 해당 마을에서만 중앙광장으로 옮긴다.
  6: (d) => {
    const safe = {
      town02: { x: 12, y: 9, dir: 'down' },
      town03: { x: 12, y: 9, dir: 'down' },
      town04: { x: 12, y: 9, dir: 'down' },
    };
    const r = safe[d.map];
    if (r) { d.x = r.x; d.y = r.y; d.dir = r.dir; }
    return d;
  },
  // v7 -> v8 : 전설 리젠을 플레이 시간이 아닌 현실 시간 타임스탬프로 변경하고
  //            도감/증표 완성 보상 수령 상태를 추가한다.
  7: (d) => {
    if (!d.collectionRewards) d.collectionRewards = { dexComplete: false, badgeComplete: false };
    if (!d.legendaryRespawn) d.legendaryRespawn = {};
    const now = Date.now();
    for (const id of [37, 38, 39, 40]) {
      const flag = `legendary_${id}`;
      if (!d.flags?.[flag]) continue;
      // 구버전에서 이미 잡은 전설은 24시간, 격파 기록만 있으면 10분 뒤 재등장하도록 변환한다.
      d.legendaryRespawn[flag] = (d.dex?.[id] || 0) === 2
        ? now + 24 * 60 * 60 * 1000
        : now + 10 * 60 * 1000;
    }
    return d;
  },
  8: (d) => {
    if (!d.collectionRewards) d.collectionRewards = { dexComplete:false, badgeComplete:false, dexMilestones:{} };
    if (!d.collectionRewards.dexMilestones) d.collectionRewards.dexMilestones = {};
    if (!d.quests) d.quests = {};
    if (!d.trainerRematch) d.trainerRematch = {};
    if (!d.fieldBossRespawn) d.fieldBossRespawn = {};
    if (!d.discoveredMaps) d.discoveredMaps = {};
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) {
      if (!m.nature) m.nature = 'balanced';
      if (!m.talent) m.talent = { hp:0, atk:0, def:0, spd:0 };
      if (m.resonant === undefined) m.resonant = false;
      if (m.status === undefined) m.status = null;
      if (m.statusTurns === undefined) m.statusTurns = 0;
    }
    return d;
  },  // v9 -> v10 : 5번째 뇌광 지역/전설 추가. 기존 진행도와 보상 수령 기록은 유지한다.
  9: (d) => {
    if (!d.badges) d.badges = {};
    if (!d.legendaryRespawn) d.legendaryRespawn = {};
    if (!d.discoveredMaps) d.discoveredMaps = {};
    if (!d.quests) d.quests = {};
    return d;
  },
  // v10 -> v11 : 포획에 사용한 캡슐 기록을 개체별로 보존한다.
  10: (d) => {
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) if (m.capturedWith === undefined) m.capturedWith = null;
    return d;
  },
  // v11 -> v12 : 필드 랜덤 드랍 보존 구조 추가.
  11: (d) => {
    if (!d.fieldDrops) d.fieldDrops = {};
    if (!d.attendance) d.attendance = { lastClaimDate:null, totalDays:0 };
    return d;
  },
  // v12 -> v13 : 필드 탑승 상태 추가. 불러올 때는 안전하게 내린 상태로 시작한다.
  12: (d) => {
    d.mount = null;
    return d;
  },
  // v13 -> v14 : 몬스터별 SP 시스템 추가. 실제 최대치는 불러오기 후 normalizeInstance에서 계산한다.
  13: (d) => {
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) {
      if (m.sp === undefined) m.sp = null;
      if (m.maxSp === undefined) m.maxSp = null;
    }
    return d;
  },
  // v14 -> v15 : 12~24번 도감 코드를 정식 순서로 복구한다. 기존 세이브의 개체/도감 기록도 같은 종을 유지하도록 재매핑한다.
  14: (d) => {
    const remap = {12:13,13:14,14:16,15:17,16:18,17:19,18:22,19:12,20:15,21:20,22:21,23:23,24:24};
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) if (remap[m.id]) m.id = remap[m.id];
    if (d.dex) {
      const next = {};
      for (const [k,v] of Object.entries(d.dex)) next[remap[Number(k)] || Number(k)] = v;
      d.dex = next;
    }
    // v7.4에서 많이 쌓인 동적 필드 드랍은 새 빈도 규칙에 맞춰 초기화한다.
    d.fieldDrops = {};
    d.mount = null;
    return d;
  },
  // v15 -> v16 : 상점 영구 업그레이드(자동줍기권) 상태 추가.
  15: (d) => {
    if (!d.upgrades) d.upgrades = { autoPickup:false };
    if (d.upgrades.autoPickup === undefined) d.upgrades.autoPickup = false;
    return d;
  },
  // v16 -> v17 : 퀘스트 추적 / 업적·칭호 / 몬스터 장비 추가.
  16: (d) => {
    if (d.trackedQuest === undefined) d.trackedQuest = null;
    if (!d.achievements) d.achievements = {};
    if (!d.activeTitle) d.activeTitle = '신입 모험가';
    const all = [...(d.party || []), ...((d.box || []).flat())];
    for (const m of all) if (m.equipment === undefined) m.equipment = null;
    return d;
  },
};

function migrate(data) {
  let v = data.saveVersion || 0;
  while (v < SAVE_VERSION) {
    const fn = MIGRATIONS[v];
    if (!fn) { data.saveVersion = SAVE_VERSION; break; }
    data = fn(data);
    v = data.saveVersion = v + 1;
  }
  return data;
}

const save = {
  has() {
    try { return !!localStorage.getItem(KEY) || !!localStorage.getItem(BACKUP_KEY); } catch { return false; }
  },
  write(state) {
    try {
      const previous = localStorage.getItem(KEY);
      if (previous) {
        try { JSON.parse(previous); localStorage.setItem(BACKUP_KEY, previous); } catch {}
      }
      const payload = JSON.stringify({ ...state, saveVersion: SAVE_VERSION, savedAt: Date.now() });
      localStorage.setItem(KEY, payload);
      // v0.9.2: 클라우드는 수동 동기화 전용. 로컬 저장만 수행한다.
      return true;
    } catch (e) { console.warn('저장 실패', e); return false; }
  },
  read() {
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) {
        try { return migrate(JSON.parse(raw)); }
        catch (e) { console.warn('주 저장 손상, 백업 확인', e); }
      }
      const backup = localStorage.getItem(BACKUP_KEY);
      if (!backup) return null;
      const data = migrate(JSON.parse(backup));
      data._recoveredFromBackup = true;
      return data;
    } catch (e) { console.warn('불러오기 실패', e); return null; }
  },
  restoreBackup() {
    try {
      const backup = localStorage.getItem(BACKUP_KEY);
      if (!backup) return false;
      JSON.parse(backup);
      localStorage.setItem(KEY, backup);
      return true;
    } catch { return false; }
  },
  hasBackup() { try { return !!localStorage.getItem(BACKUP_KEY); } catch { return false; } },
  clear() { try { localStorage.removeItem(KEY); localStorage.removeItem(BACKUP_KEY); } catch {} },
  peek() {
    const d = this.read();
    if (!d) return null;
    return {
      map: d.map, money: d.money,
      party: (d.party || []).length,
      caught: Object.values(d.dex || {}).filter((s) => s === 2).length,
      savedAt: d.savedAt,
      backupRecovered: !!d._recoveredFromBackup,
    };
  },
};

/* ===== MONSTIA v0.8.0 Cloud Save (Supabase REST, configured) ===== */
const CLOUD_CONFIG_KEY = 'monstia.cloud.config.v1';
const CLOUD_SESSION_KEY = 'monstia.cloud.session.v1';
const MONSTIA_SUPABASE_DEFAULT = Object.freeze({
  url: 'https://lpixnrsdyqpoqvleuzpj.supabase.co',
  key: 'sb_publishable_iYJSJVrUj5KMSTdhmMe5Vg_AYY0DdcJ',
});
const MONSTIA_AUTH_REDIRECT_URL = 'https://leedw5637.github.io/monstia-mobile/auth.html';

const cloud = {
  config: null,
  session: null,
  game: null,
  uploadTimer: null,
  uploading: false,
  pendingPayload: null,
  lastMessage: '클라우드 미설정',

  init(game) {
    this.game = game || this.game;
    this.config = this.readJson(CLOUD_CONFIG_KEY) || { ...MONSTIA_SUPABASE_DEFAULT };
    this.session = this.readJson(CLOUD_SESSION_KEY);
    globalThis.MONSTIA_CLOUD = this;
    // v0.9.2: 실행 시 자동 동기화하지 않는다.
    // 클라우드 데이터는 사용자가 '동기화' 버튼을 눌렀을 때만 비교/적용한다.
  },

  readJson(key) {
    try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; }
  },

  writeJson(key, value) {
    try {
      if (value == null) localStorage.removeItem(key);
      else localStorage.setItem(key, JSON.stringify(value));
    } catch {}
  },

  isConfigured() {
    return !!(this.config?.url && this.config?.key);
  },

  isLoggedIn() {
    return !!(this.session?.access_token && this.session?.user?.id);
  },

  accountLabel() {
    if (this.isLoggedIn()) return this.session.user.email || '로그인됨';
    if (this.isConfigured()) return '로그인 필요';
    return '설정 필요';
  },

  hudText() {
    if (!this.isConfigured()) return '☁ 설정 필요';
    if (!this.isLoggedIn()) return '☁ 로그인 필요';
    if (/실패|확인 필요|오류/.test(this.lastMessage || '')) return '☁ 연결 오류';
    if (/불러/.test(this.lastMessage || '')) return '☁ 불러오기 완료';
    if (/동기화 완료|클라우드 저장 완료/.test(this.lastMessage || '')) return '☁ 동기화 완료';
    return '☁ 수동 동기화';
  },

  normalizeUrl(url) {
    return String(url || '').trim().replace(/\/+$/, '');
  },

  saveConfig(url, key) {
    const u = this.normalizeUrl(url);
    const k = String(key || '').trim();
    if (!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(u)) {
      throw new Error('Project URL 형식이 올바르지 않습니다.');
    }
    if (!k || (!k.startsWith('sb_publishable_') && k.split('.').length !== 3)) {
      throw new Error('Publishable key 형식이 올바르지 않습니다.');
    }
    this.config = { url:u, key:k };
    this.writeJson(CLOUD_CONFIG_KEY, this.config);
    this.lastMessage = '클라우드 설정 저장됨';
  },

  clearConfig() {
    this.logout(false);
    this.config = null;
    this.writeJson(CLOUD_CONFIG_KEY, null);
    this.lastMessage = '클라우드 미설정';
  },

  async request(path, { method='GET', body=null, auth=false, headers={} } = {}) {
    if (!this.isConfigured()) throw new Error('Supabase 설정이 필요합니다.');
    if (auth) await this.ensureSession();
    const h = {
      'apikey': this.config.key,
      'Content-Type': 'application/json',
      ...headers,
    };
    if (auth && this.session?.access_token) h['Authorization'] = `Bearer ${this.session.access_token}`;
    const res = await fetch(this.config.url + path, {
      method,
      headers: h,
      body: body == null ? undefined : JSON.stringify(body),
    });
    const raw = await res.text();
    let data = null;
    try { data = raw ? JSON.parse(raw) : null; } catch { data = raw; }
    if (!res.ok) {
      const msg = data?.msg || data?.message || data?.error_description || data?.error || `${res.status} ${res.statusText}`;
      throw new Error(String(msg));
    }
    return data;
  },

  storeSession(data) {
    if (!data?.access_token) return false;
    const expiresAt = Number(data.expires_at || 0) || (Math.floor(Date.now()/1000) + Number(data.expires_in || 3600));
    this.session = {
      access_token: data.access_token,
      refresh_token: data.refresh_token || this.session?.refresh_token || '',
      expires_at: expiresAt,
      token_type: data.token_type || 'bearer',
      user: data.user || this.session?.user || null,
    };
    this.writeJson(CLOUD_SESSION_KEY, this.session);
    return true;
  },

  friendlyAuthError(err, action='인증') {
    const raw = String(err?.message || err || '').trim();
    const low = raw.toLowerCase();
    if (low.includes('rate limit') || low.includes('rate_limit') || low.includes('over_email_send_rate_limit') || low.includes('too many requests')) {
      return `${action} 요청이 너무 자주 발생해 서버의 이메일 전송 제한에 걸렸습니다. 잠시 후 다시 시도해 주세요. 계속 발생하면 Supabase Authentication의 이메일 전송 제한/SMTP 설정을 확인해야 합니다.`;
    }
    if (low.includes('user already registered') || low.includes('already been registered')) return '이미 가입된 이메일입니다. 회원가입이 아니라 로그인해 주세요.';
    if (low.includes('invalid login credentials')) return '이메일 또는 비밀번호가 올바르지 않습니다.';
    if (low.includes('email not confirmed')) return '이메일 인증이 아직 완료되지 않았습니다. 인증 메일을 확인해 주세요.';
    return raw || `${action} 중 알 수 없는 오류가 발생했습니다.`;
  },

  async signUp(email, password) {
    const data = await this.request(`/auth/v1/signup?redirect_to=${encodeURIComponent(MONSTIA_AUTH_REDIRECT_URL)}`, {
      method:'POST', body:{ email:String(email||'').trim(), password:String(password||'') }
    });
    if (data?.access_token) {
      this.storeSession(data);
      this.lastMessage = '회원가입 및 로그인 완료';
      return { loggedIn:true, message:'회원가입과 로그인이 완료되었습니다. 필요할 때 동기화 버튼을 눌러주세요.' };
    }
    this.lastMessage = '이메일 인증 대기';
    return { loggedIn:false, message:'회원가입 완료. 인증메일의 링크를 누르면 MONSTIA 인증 완료 페이지로 이동합니다. 인증 후 게임으로 돌아와 로그인해 주세요.' };
  },

  async signIn(email, password) {
    const data = await this.request('/auth/v1/token?grant_type=password', {
      method:'POST', body:{ email:String(email||'').trim(), password:String(password||'') }
    });
    this.storeSession(data);
    this.lastMessage = '로그인됨 · 수동 동기화 대기';
    return true;
  },

  logout(close=true) {
    this.session = null;
    this.pendingPayload = null;
    if (this.uploadTimer) clearTimeout(this.uploadTimer);
    this.uploadTimer = null;
    this.writeJson(CLOUD_SESSION_KEY, null);
    this.lastMessage = '로그아웃됨';
    if (close) this.renderModal('로그아웃되었습니다.');
  },

  async ensureSession() {
    if (!this.session?.refresh_token) throw new Error('로그인이 필요합니다.');
    const now = Math.floor(Date.now()/1000);
    if (this.session.access_token && Number(this.session.expires_at || 0) > now + 60) return true;
    const data = await this.request('/auth/v1/token?grant_type=refresh_token', {
      method:'POST', body:{ refresh_token:this.session.refresh_token }, auth:false
    });
    if (!this.storeSession(data)) throw new Error('로그인 갱신에 실패했습니다.');
    return true;
  },

  async fetchRemote() {
    await this.ensureSession();
    const uid = encodeURIComponent(this.session.user.id);
    const rows = await this.request(`/rest/v1/monstia_saves?user_id=eq.${uid}&select=save_data,saved_at,game_version&limit=1`, { auth:true });
    return Array.isArray(rows) && rows.length ? rows[0] : null;
  },

  cleanSaveData(data) {
    const d = { ...(data || {}) };
    delete d._recoveredFromBackup;
    d.saveVersion = SAVE_VERSION;
    if (!Number(d.savedAt)) d.savedAt = Date.now();
    return d;
  },

  async uploadData(data) {
    if (!this.isLoggedIn()) return false;
    const d = this.cleanSaveData(data);
    const row = {
      user_id: this.session.user.id,
      save_data: d,
      saved_at: Number(d.savedAt || Date.now()),
      game_version: GAME_VERSION,
      updated_at: new Date().toISOString(),
    };
    await this.request('/rest/v1/monstia_saves?on_conflict=user_id', {
      method:'POST', auth:true,
      headers:{ 'Prefer':'resolution=merge-duplicates,return=minimal' },
      body:[row],
    });
    this.lastMessage = '클라우드 저장 완료';
    return true;
  },

  queueUpload(payload) {
    if (!this.isLoggedIn()) return;
    this.lastMessage = '클라우드 저장 대기';
    this.pendingPayload = payload;
    if (this.uploadTimer) clearTimeout(this.uploadTimer);
    this.uploadTimer = setTimeout(() => this.flushUpload(), 500);
  },

  async flushUpload() {
    if (this.uploading || !this.pendingPayload || !this.isLoggedIn()) return;
    const raw = this.pendingPayload;
    this.pendingPayload = null;
    this.uploadTimer = null;
    this.uploading = true;
    this.lastMessage = '클라우드 저장 중';
    try {
      const data = typeof raw === 'string' ? JSON.parse(raw) : raw;
      await this.uploadData(data);
    } catch (e) {
      console.warn('클라우드 자동 저장 실패', e);
      this.lastMessage = '클라우드 저장 실패';
      if (!this.pendingPayload) this.pendingPayload = raw;
    } finally {
      this.uploading = false;
      if (this.pendingPayload && !this.uploadTimer) this.uploadTimer = setTimeout(() => this.flushUpload(), 1800);
    }
  },

  applyRemote(remote) {
    if (!remote?.save_data || typeof remote.save_data !== 'object') throw new Error('클라우드 세이브 형식이 올바르지 않습니다.');
    let d = migrate(this.cleanSaveData(remote.save_data));
    const remoteTime = Number(remote.saved_at || d.savedAt || Date.now());
    d.savedAt = remoteTime;
    const current = localStorage.getItem(KEY);
    if (current) {
      try { JSON.parse(current); localStorage.setItem(BACKUP_KEY, current); } catch {}
    }
    localStorage.setItem(KEY, JSON.stringify(d));
    this.lastMessage = '클라우드 데이터 불러옴';
    if (this.game) this.game.title = new TitleScene(this.game);
    return d;
  },

  async syncNow({ silent=false, startup=false, force='newest' } = {}) {
    if (!this.isConfigured() || !this.session?.refresh_token) return { action:'none' };
    await this.ensureSession();
    const remote = await this.fetchRemote();
    const local = save.read();

    if (!remote) {
      if (local) {
        await this.uploadData(local);
        if (!silent) this.lastMessage = '현재 기기 데이터를 클라우드에 등록했습니다.';
        return { action:'upload' };
      }
      this.lastMessage = '저장 데이터 없음';
      return { action:'empty' };
    }

    if (!local) {
      this.applyRemote(remote);
      if (!silent) this.lastMessage = '클라우드 데이터를 이 기기로 불러왔습니다.';
      return { action:'download' };
    }

    const lt = Number(local.savedAt || 0);
    const rt = Number(remote.saved_at || remote.save_data?.savedAt || 0);

    if (force === 'upload') {
      await this.uploadData(local);
      return { action:'upload' };
    }
    if (force === 'download') {
      this.applyRemote(remote);
      return { action:'download' };
    }

    if (rt > lt) {
      this.applyRemote(remote);
      if (startup && this.game) this.game.title = new TitleScene(this.game);
      return { action:'download', localTime:lt, remoteTime:rt };
    }
    if (lt > rt) {
      await this.uploadData(local);
      return { action:'upload', localTime:lt, remoteTime:rt };
    }
    this.lastMessage = '클라우드와 동기화됨';
    return { action:'same', localTime:lt, remoteTime:rt };
  },

  ensureStyle() {
    if (document.getElementById('monstia-cloud-style')) return;
    const st = document.createElement('style');
    st.id = 'monstia-cloud-style';
    st.textContent = `
      #monstia-cloud-modal{position:fixed;inset:0;z-index:99999;background:rgba(4,7,15,.86);display:flex;align-items:center;justify-content:center;padding:18px;touch-action:auto;-webkit-user-select:text;user-select:text}
      #monstia-cloud-card{width:min(430px,100%);max-height:92dvh;overflow:auto;background:#171b2b;color:#eef4ff;border:1px solid #4e638a;border-radius:14px;box-shadow:0 20px 70px rgba(0,0,0,.65);padding:18px;font-family:system-ui,-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif}
      #monstia-cloud-card h2{font-size:19px;margin:0 0 6px;color:#8cddff} #monstia-cloud-card p{font-size:12px;line-height:1.55;color:#bac6dc;margin:6px 0 12px}
      #monstia-cloud-card label{display:block;font-size:11px;color:#aebbd2;margin:10px 0 4px}
      #monstia-cloud-card input{width:100%;padding:11px 12px;border-radius:8px;border:1px solid #42516d;background:#0f1320;color:#fff;font-size:14px;touch-action:auto;-webkit-user-select:text;user-select:text}
      #monstia-cloud-card input:focus{outline:2px solid #4ebbe8;outline-offset:1px}
      .mc-auth-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.mc-auth-box{border:1px solid #384968;background:#101625;border-radius:10px;padding:11px}.mc-auth-box h3{margin:0 0 5px;font-size:14px;color:#9fe2ff}.mc-auth-box p{font-size:10px;margin:0 0 7px;color:#8494ae}@media(max-width:520px){.mc-auth-grid{grid-template-columns:1fr}}
      .mc-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.mc-btn{flex:1 1 120px;border:0;border-radius:8px;padding:11px 10px;background:#315a92;color:#fff;font-size:13px;font-weight:700;touch-action:auto}.mc-btn.alt{background:#30374a}.mc-btn.good{background:#277755}.mc-btn.warn{background:#8a4b42}.mc-status{padding:9px 10px;background:#0d1220;border-radius:8px;font-size:12px;color:#d8e6ff;margin:10px 0}.mc-small{font-size:10px!important;color:#8593ad!important;word-break:break-all}.mc-hide{display:none!important}
    `;
    document.head.appendChild(st);
  },

  open(game) {
    this.game = game || this.game;
    this.ensureStyle();
    let modal = document.getElementById('monstia-cloud-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'monstia-cloud-modal';
      modal.innerHTML = '<div id="monstia-cloud-card"></div>';
      document.body.appendChild(modal);
      // 모바일 APK에서 입력/터치가 배경 클릭으로 오인되어 창이 닫히는 현상 방지
      // 이제 클라우드 창은 '닫기' 버튼으로만 닫힌다.
    }
    modal.style.display = 'flex';
    this.renderModal();
  },

  close() {
    const el = document.getElementById('monstia-cloud-modal');
    if (el) el.style.display = 'none';
  },

  esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  },

  fmtTime(ms) {
    const n = Number(ms || 0);
    if (!n) return '없음';
    try { return new Date(n).toLocaleString('ko-KR'); } catch { return String(n); }
  },

  renderModal(message='') {
    const card = document.getElementById('monstia-cloud-card');
    if (!card) return;
    const cfg = this.config || {};
    const logged = this.isLoggedIn();
    const local = save.read();
    const email = this.session?.user?.email || '';

    card.innerHTML = `
      <h2>MONSTIA 클라우드 세이브</h2>
      <p>같은 계정으로 PC와 모바일의 저장 데이터를 공유할 수 있습니다. 자동 동기화는 하지 않으며, 사용자가 동기화 버튼을 눌렀을 때만 최신 저장을 비교해 적용합니다.</p>
      <div class="mc-status">${this.esc(message || this.lastMessage)}<br><b>${logged ? this.esc(email) : this.esc(this.accountLabel())}</b></div>

      <div id="mc-config" class="${this.isConfigured() ? 'mc-hide' : ''}">
        <label>Supabase Project URL</label>
        <input id="mc-url" inputmode="url" placeholder="https://xxxx.supabase.co" value="${this.esc(cfg.url || '')}">
        <label>Publishable key</label>
        <input id="mc-key" autocomplete="off" placeholder="sb_publishable_..." value="${this.esc(cfg.key || '')}">
        <div class="mc-row"><button class="mc-btn good" id="mc-save-config">설정 저장</button></div>
        <p class="mc-small">※ Secret key / service_role key는 절대 입력하지 마세요. 브라우저·APK에는 Publishable key만 사용합니다.</p>
      </div>

      <div id="mc-auth" class="${(!this.isConfigured() || logged) ? 'mc-hide' : ''}">
        <div class="mc-auth-grid">
          <div class="mc-auth-box">
            <h3>로그인</h3><p>이미 만든 MONSTIA 계정으로 접속합니다.</p>
            <label>이메일</label><input id="mc-login-email" type="email" autocomplete="email" placeholder="name@example.com">
            <label>비밀번호</label><input id="mc-login-password" type="password" autocomplete="current-password" placeholder="비밀번호">
            <div class="mc-row"><button class="mc-btn good" id="mc-login">로그인</button></div>
          </div>
          <div class="mc-auth-box">
            <h3>회원가입</h3><p>처음 이용할 때 새 계정을 만듭니다.</p>
            <label>이메일</label><input id="mc-signup-email" type="email" autocomplete="email" placeholder="name@example.com">
            <label>비밀번호</label><input id="mc-signup-password" type="password" autocomplete="new-password" placeholder="6자 이상">
            <label>비밀번호 확인</label><input id="mc-signup-password2" type="password" autocomplete="new-password" placeholder="한 번 더 입력">
            <div class="mc-row"><button class="mc-btn" id="mc-signup">회원가입</button></div>
          </div>
        </div>
      </div>

      <div id="mc-user" class="${logged ? '' : 'mc-hide'}">
        <p>현재 기기 저장: <b>${this.esc(this.fmtTime(local?.savedAt))}</b></p>
        <p class="mc-small">자동 동기화는 사용하지 않습니다. PC/모바일에서 원하는 시점에 아래 동기화 버튼을 누르면 로컬과 클라우드의 저장 시간을 비교해 더 최신 데이터를 적용합니다.</p>
        <div class="mc-row">
          <button class="mc-btn good" id="mc-sync">🔄 동기화</button>
          <button class="mc-btn alt" id="mc-logout">로그아웃</button>
        </div>
      </div>

      <div class="mc-row">
        <button class="mc-btn alt" id="mc-close">닫기</button>
      </div>
    `;

    const q = (id) => card.querySelector('#' + id);
    q('mc-close')?.addEventListener('click', () => this.close());
    q('mc-save-config')?.addEventListener('click', () => {
      try {
        this.saveConfig(q('mc-url').value, q('mc-key').value);
        this.renderModal('설정이 저장되었습니다. 이제 회원가입 또는 로그인하세요.');
      } catch (e) { this.renderModal(e.message); }
    });
    q('mc-reset-config')?.addEventListener('click', () => {
      if (confirm('클라우드 연결 설정과 로그인 정보를 이 기기에서 지울까요? 게임 세이브는 삭제되지 않습니다.')) {
        this.clearConfig(); this.renderModal('클라우드 설정을 초기화했습니다.');
      }
    });
    q('mc-login')?.addEventListener('click', async () => {
      const email=q('mc-login-email').value, pw=q('mc-login-password').value;
      if (!String(email).trim() || !String(pw)) { this.renderModal('로그인 이메일과 비밀번호를 모두 입력하세요.'); return; }
      this.renderModal('로그인 중...');
      try { await this.signIn(email,pw); this.renderModal('로그인 완료. 저장 데이터는 자동으로 동기화되지 않습니다. 필요할 때 동기화 버튼을 눌러주세요.'); }
      catch(e){ this.renderModal('로그인 실패: ' + this.friendlyAuthError(e,'로그인')); }
    });
    q('mc-signup')?.addEventListener('click', async () => {
      const email=q('mc-signup-email').value, pw=q('mc-signup-password').value, pw2=q('mc-signup-password2').value;
      if (!String(email).trim()) { this.renderModal('회원가입 이메일을 입력하세요.'); return; }
      if (String(pw).length < 6) { this.renderModal('비밀번호는 6자 이상으로 입력하세요.'); return; }
      if (pw !== pw2) { this.renderModal('비밀번호 확인이 일치하지 않습니다.'); return; }
      const now=Date.now();
      if (this.signupBusyUntil && now < this.signupBusyUntil) {
        const sec=Math.ceil((this.signupBusyUntil-now)/1000);
        this.renderModal(`회원가입 재요청은 ${sec}초 후에 가능합니다. 중복 요청으로 인한 서버 제한을 방지합니다.`); return;
      }
      this.signupBusyUntil = now + 60000;
      this.renderModal('회원가입 중...');
      try { const r=await this.signUp(email,pw); this.renderModal(r.message); }
      catch(e){ this.renderModal('회원가입 실패: ' + this.friendlyAuthError(e,'회원가입')); }
    });
    q('mc-logout')?.addEventListener('click', () => this.logout(true));
    q('mc-sync')?.addEventListener('click', async () => {
      this.renderModal('로컬/클라우드 저장 시간을 비교하는 중...');
      try {
        const r = await this.syncNow({silent:true});
        const msg =
          r.action === 'upload'   ? '동기화 완료: 이 기기의 최신 저장을 클라우드에 올렸습니다.' :
          r.action === 'download' ? '동기화 완료: 클라우드의 최신 저장을 이 기기에 적용했습니다. 게임을 다시 시작합니다.' :
          r.action === 'same'     ? '동기화 완료: 이 기기와 클라우드가 이미 같은 최신 상태입니다.' :
          r.action === 'empty'    ? '동기화할 저장 데이터가 없습니다.' :
                                    '동기화할 데이터가 없습니다.';
        this.renderModal(msg);
        if (r.action === 'download') setTimeout(()=>location.reload(), 900);
      } catch(e) {
        this.renderModal('동기화 실패: ' + e.message);
      }
    });
  },
};

globalThis.MONSTIA_CLOUD = cloud;


/* ===== js/ui/screen.js ===== */
// ============================================================


/* ===== js/ui/screen.js ===== */
// screen.js — 렌더 타깃과 UI 프리미티브
// ------------------------------------------------------------
// 세계는 160x224 저해상도 캔버스에 그려 정수배로 확대한다(픽셀 유지).
// 글자는 확대하지 않고 화면 해상도에 직접 그린다(한글 가독성).
// UI 좌표는 모두 "가상 좌표(160x224)" 기준이며 내부에서 scale 을 곱한다.
// ============================================================

const GAME_VERSION = '0.9.3';
const VW = 160;
const VH = 224;

const FONT_STACK = '"Galmuri11","DungGeunMo","Neo둥근모",system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif';

const COL = {
  ink: '#20202e',
  paper: '#f8f6ee',
  inner: '#9b8fb4',
  shade: '#c9c2d8',
  dim: '#6a6480',
  hp: '#4cc85c',
  hpMid: '#e8c020',
  hpLow: '#e04c3c',
  exp: '#4aa8e0',
  accent: '#e05a3c',
};

class Screen {
  constructor(canvas, world) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d', { alpha:false, desynchronized:true });
    this.world = world;
    this.wctx = world.getContext('2d', { alpha:true, desynchronized:true });
    this.wctx.imageSmoothingEnabled = false;
    this.scale = 2;
    this.cssScale = 2;
    this.renderRatio = 1.5;
    this.blink = 0;
  }

  resize(availW, availH) {
    const css = Math.max(1, Math.min(Math.floor(availW / VW), Math.floor(availH / VH)));
    // v7.3: 최소 1.5x 슈퍼샘플링, 고DPI에서는 최대 4x까지 사용한다.
    const rr = Math.max(1.5, Math.min(4, Number(window.devicePixelRatio) || 1));
    this.cssScale = css; this.renderRatio = rr; this.scale = css * rr;
    const cssW = VW * css, cssH = VH * css;
    const w = Math.round(cssW * rr), h = Math.round(cssH * rr);
    if (this.canvas.width !== w || this.canvas.height !== h) { this.canvas.width = w; this.canvas.height = h; }
    if (this.world.width !== w || this.world.height !== h) { this.world.width = w; this.world.height = h; }
    this.wctx.setTransform(this.scale, 0, 0, this.scale, 0, 0);
    this.wctx.imageSmoothingEnabled = false;
    this.canvas.style.width = `${cssW}px`; this.canvas.style.height = `${cssH}px`;
    this.ctx.imageSmoothingEnabled = true; this.ctx.imageSmoothingQuality = 'high';
    return { w:cssW, h:cssH };
  }

  get S() { return this.scale; }

  clear(color = '#000') {
    this.ctx.fillStyle = color;
    this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
  }

  blitWorld() {
    this.ctx.imageSmoothingEnabled = true;
    this.ctx.imageSmoothingQuality = 'high';
    this.ctx.drawImage(this.world, 0, 0, this.canvas.width, this.canvas.height);
  }

  // ---------------------------------------------------------- 도형
  fill(x, y, w, h, color) {
    const s = this.scale;
    this.ctx.fillStyle = color;
    this.ctx.fillRect(Math.round(x * s), Math.round(y * s), Math.round(w * s), Math.round(h * s));
  }

  box(x, y, w, h, opts = {}) {
    const paper = opts.paper || COL.paper;
    this.fill(x, y, w, h, opts.ink || COL.ink);
    this.fill(x + 1, y + 1, w - 2, h - 2, paper);
    this.fill(x + 2, y + 2, w - 4, 1, opts.inner || COL.inner);
    this.fill(x + 2, y + h - 3, w - 4, 1, opts.inner || COL.inner);
    this.fill(x + 2, y + 2, 1, h - 4, opts.inner || COL.inner);
    this.fill(x + w - 3, y + 2, 1, h - 4, opts.inner || COL.inner);
  }

  panel(x, y, w, h, color) {
    this.fill(x, y, w, h, COL.ink);
    this.fill(x + 1, y + 1, w - 2, h - 2, color);
  }

  // ---------------------------------------------------------- 글자
  font(size, weight = '400') {
    this.ctx.font = `${weight} ${Math.max(4, Math.round(size * this.scale))}px ${FONT_STACK}`;
  }

  fitText(str, maxW, size = 9, weight = '400', minSize = 4, ellipsis = true) {
    let out = String(str);
    let sz = size;
    if (!Number.isFinite(maxW) || maxW <= 0) return { text: out, size: sz };
    while (sz > minSize && this.textWidth(out, sz, weight) > maxW) sz -= 0.5;
    if (this.textWidth(out, sz, weight) <= maxW) return { text: out, size: sz };
    if (!ellipsis) {
      while (sz > 2.5 && this.textWidth(out, sz, weight) > maxW) sz -= 0.25;
      return { text: out, size: sz };
    }
    while (out.length > 1 && this.textWidth(`${out}…`, sz, weight) > maxW) out = out.slice(0, -1);
    return { text: out.length ? `${out}…` : '', size: sz };
  }

  text(str, x, y, opts = {}) {
    const s = this.scale;
    let size = opts.size || 9;
    let out = String(str);
    // 모든 UI 텍스트는 화면 경계 안에 자동으로 들어오게 한다.
    // 개별 레이아웃에서 maxW를 주면 그 폭을 우선 사용한다.
    const align = opts.align || 'left';
    let autoMaxW = opts.maxW;
    if (!autoMaxW) {
      if (align === 'right') autoMaxW = Math.max(8, x - 4);
      else if (align === 'center') autoMaxW = Math.max(8, Math.min(x - 4, VW - 4 - x) * 2);
      else autoMaxW = Math.max(8, VW - 4 - x);
    }
    if (autoMaxW) {
      const fit = this.fitText(out, autoMaxW, size, opts.weight || '400', opts.minSize ?? 4, opts.ellipsis !== false);
      out = fit.text; size = fit.size;
    }
    this.font(size, opts.weight);
    this.ctx.textAlign = opts.align || 'left';
    this.ctx.textBaseline = opts.baseline || 'top';
    if (opts.shadow) {
      this.ctx.fillStyle = opts.shadow;
      this.ctx.fillText(out, Math.round(x * s), Math.round(y * s) + Math.max(1, Math.round(s / 2)));
    }
    this.ctx.fillStyle = opts.color || COL.ink;
    this.ctx.fillText(out, Math.round(x * s), Math.round(y * s));
  }

  textWidth(str, size = 9, weight = '400') {
    this.font(size, weight);
    return this.ctx.measureText(str).width / this.scale;
  }

  // 가상 폭 기준 줄바꿈 (한글은 글자 단위, 영문은 단어 단위)
  wrap(str, maxW, size = 9) {
    this.font(size);
    const out = [];
    let line = '';
    const tokens = String(str).split(/(\s+)/);
    for (const tok of tokens) {
      if (tok === '') continue;
      let candidate = line + tok;
      if (this.ctx.measureText(candidate).width / this.scale <= maxW) { line = candidate; continue; }
      if (line.trim()) { out.push(line.trimEnd()); line = ''; }
      // 토큰 자체가 길면 글자 단위로 자른다
      for (const ch of tok) {
        if (this.ctx.measureText(line + ch).width / this.scale > maxW && line) {
          out.push(line); line = '';
        }
        if (ch === ' ' && line === '') continue;
        line += ch;
      }
    }
    if (line.trim()) out.push(line.trimEnd());
    return out.length ? out : [''];
  }

  // ---------------------------------------------------------- 게이지
  bar(x, y, w, h, ratio, color) {
    this.fill(x, y, w, h, COL.ink);
    this.fill(x + 1, y + 1, w - 2, h - 2, '#585070');
    const inner = Math.max(0, Math.round((w - 2) * Math.max(0, Math.min(1, ratio))));
    if (inner > 0) {
      this.fill(x + 1, y + 1, inner, h - 2, color);
      this.fill(x + 1, y + 1, inner, 1, 'rgba(255,255,255,0.45)');
    }
  }

  hpColor(ratio) { return ratio > 0.5 ? COL.hp : ratio > 0.2 ? COL.hpMid : COL.hpLow; }

  // 깜빡이는 ▼
  arrow(x, y) {
    if (Math.floor(this.blink * 2) % 2) return;
    this.fill(x, y, 5, 1, COL.accent);
    this.fill(x + 1, y + 1, 3, 1, COL.accent);
    this.fill(x + 2, y + 2, 1, 1, COL.accent);
  }

  cursor(x, y) {
    this.fill(x, y, 1, 5, COL.ink);
    this.fill(x + 1, y + 1, 1, 3, COL.ink);
    this.fill(x + 2, y + 2, 1, 1, COL.ink);
  }

  // 화면 해상도 캔버스에 픽셀 스프라이트 확대 그리기 (가상 좌표)
  pixel(img, x, y, scale = 1) {
    const s = this.scale;
    this.ctx.imageSmoothingEnabled = false;
    this.ctx.drawImage(img,
      Math.round(x * s), Math.round(y * s),
      Math.round(img.width * scale * s), Math.round(img.height * scale * s));
  }

  // 고해상도 몬스터 일러스트를 축소할 때는 고품질 보간을 사용한다.
  hqPixel(img, x, y, scale = 1) {
    const s = this.scale;
    this.ctx.imageSmoothingEnabled = true;
    this.ctx.imageSmoothingQuality = 'high';
    this.ctx.drawImage(img,
      Math.round(x * s), Math.round(y * s),
      Math.round(img.width * scale * s), Math.round(img.height * scale * s));
    this.ctx.imageSmoothingEnabled = false;
  }

  // 고해상도 이미지를 지정 UI 박스 안에 비율 유지/중앙 정렬해 절대 넘치지 않게 그린다.
  hqFit(img, x, y, w, h, opts = {}) {
    if (!img) return;
    const iw = Math.max(1, img.naturalWidth || img.width || 1);
    const ih = Math.max(1, img.naturalHeight || img.height || 1);
    const pad = opts.pad ?? 0.5;
    const k = Math.min(Math.max(1,w-2*pad) / iw, Math.max(1,h-2*pad) / ih);
    const dw = iw * k, dh = ih * k;
    const ax = opts.ax ?? 0.5, ay = opts.ay ?? 0.5;
    const dx = x + (w - dw) * ax, dy = y + (h - dh) * ay;
    const s = this.scale;
    const smooth = opts.smooth === true;
    this.ctx.imageSmoothingEnabled = smooth;
    if (smooth) this.ctx.imageSmoothingQuality = 'high';
    this.ctx.drawImage(img, Math.round(dx*s), Math.round(dy*s), Math.round(dw*s), Math.round(dh*s));
    this.ctx.imageSmoothingEnabled = false;
  }

  // 저해상도 캔버스에 픽셀 스프라이트 확대 그리기
  sprite(img, x, y, scale = 1) {
    this.wctx.imageSmoothingEnabled = false;
    this.wctx.drawImage(img, Math.round(x), Math.round(y),
      Math.round(img.width * scale), Math.round(img.height * scale));
  }
}

// 커서가 있는 메뉴 목록 헬퍼
class MenuCursor {
  constructor(length, cols = 1) { this.i = 0; this.len = length; this.cols = cols; }
  set(len) { this.len = len; if (this.i >= len) this.i = Math.max(0, len - 1); }
  move(dir) {
    if (this.len === 0) return false;
    const prev = this.i;
    const rows = Math.ceil(this.len / this.cols);
    let r = Math.floor(this.i / this.cols), c = this.i % this.cols;
    if (dir === 'up') r = (r - 1 + rows) % rows;
    else if (dir === 'down') r = (r + 1) % rows;
    else if (dir === 'left') c = (c - 1 + this.cols) % this.cols;
    else if (dir === 'right') c = (c + 1) % this.cols;
    let n = r * this.cols + c;
    if (n >= this.len) n = this.len - 1;
    this.i = n;
    return this.i !== prev;
  }
}


/* ===== js/systems/monsters.js ===== */
// ============================================================


/* ===== js/systems/monsters.js ===== */
// monsters.js — 몬스터 개체 시스템
// ------------------------------------------------------------
// 종족(MONSTERS)은 불변 데이터, 개체(instance)는 세이브에 들어가는 값.
// ============================================================



const PARTY_MAX = 6;
const BOX_SIZE = 20;
const BOX_COUNT = 3;

let sidCounter = 1;
function resetSid(n) { sidCounter = n || 1; }

function species(inst) { return MONSTERS[inst.id]; }
function displayName(inst) { const base = inst.nick || MONSTERS[inst.id].name; return inst.resonant ? `✦${base}` : base; }

function expToNext(level) {
  return 30 + level * 18 + level * level;
}

function baseSpeedFor(sp) {
  const shapeBonus = { bird:18, serpent:10, flame:8, quad:2, plant:-4, blob:-5, worm:-2, rock:-18, aqua:-4 }[sp.shape] || 0;
  return sp.base.spd ?? Math.max(28, Math.round(sp.base.atk * 0.72 + sp.base.hp * 0.22 - sp.base.def * 0.12 + shapeBonus));
}

function traitValue(traits, key) {
  return Math.max(0, Math.min(4, Number(traits?.talent?.[key] || 0)));
}

function statsFor(id, level, traits = null) {
  const s = MONSTERS[id];
  const nature = NATURES[traits?.nature] || NATURES.balanced;
  const mods = nature.mods;
  const talentScale = level / 28;
  const rawHp = Math.floor(s.base.hp * level / 14) + level + 18 + Math.floor(traitValue(traits, 'hp') * talentScale);
  const rawAtk = Math.floor(s.base.atk * level / 45) + 6 + Math.floor(traitValue(traits, 'atk') * talentScale * 0.65);
  const rawDef = Math.floor(s.base.def * level / 45) + 6 + Math.floor(traitValue(traits, 'def') * talentScale * 0.65);
  const rawSpd = Math.floor(baseSpeedFor(s) * level / 45) + 6 + Math.floor(traitValue(traits, 'spd') * talentScale * 0.65);
  const equip = ITEMS[traits?.equipment]?.equip || {};
  return {
    maxHp: Math.max(1, Math.floor(rawHp * mods.hp * Number(equip.hpMul || 1))),
    atk: Math.max(1, Math.floor(rawAtk * mods.atk * Number(equip.atkMul || 1))),
    def: Math.max(1, Math.floor(rawDef * mods.def * Number(equip.defMul || 1))),
    spd: Math.max(1, Math.floor(rawSpd * mods.spd * Number(equip.spdMul || 1))),
  };
}

const NATURE_KEYS = Object.keys(NATURES);
function randomNature() { return NATURE_KEYS[Math.floor(Math.random() * NATURE_KEYS.length)] || 'balanced'; }
function randomTalent() {
  return { hp: Math.floor(Math.random() * 5), atk: Math.floor(Math.random() * 5), def: Math.floor(Math.random() * 5), spd: Math.floor(Math.random() * 5) };
}

function normalizeInstance(inst) {
  if (!inst.nature || !NATURES[inst.nature]) inst.nature = 'balanced';
  if (!inst.talent) inst.talent = { hp:0, atk:0, def:0, spd:0 };
  for (const k of ['hp','atk','def','spd']) if (!Number.isFinite(inst.talent[k])) inst.talent[k] = 0;
  if (inst.resonant === undefined) inst.resonant = false;
  if (inst.status === undefined) inst.status = null;
  if (!Number.isFinite(inst.statusTurns)) inst.statusTurns = 0;
  if (inst.capturedWith === undefined) inst.capturedWith = null;
  if (inst.equipment === undefined || (inst.equipment && !ITEMS[inst.equipment]?.equip)) inst.equipment = null;
  const oldMax = Math.max(1, Number(inst.maxHp || 1));
  const ratio = Math.max(0, Math.min(1, Number(inst.hp ?? oldMax) / oldMax));
  const st = statsFor(inst.id, inst.level, inst);
  inst.maxHp = st.maxHp; inst.atk = st.atk; inst.def = st.def; inst.spd = st.spd;
  inst.hp = Math.max(inst.hp > 0 ? 1 : 0, Math.min(inst.maxHp, Math.round(inst.maxHp * ratio)));
  normalizeSp(inst);
  return inst;
}

// ------------------------------------------------------------
// 기술
// ------------------------------------------------------------
function movesAtLevel(id, level) {
  const sp = MONSTERS[id];
  const learned = sp.learnset.filter((e) => e.level <= level).map((e) => e.move);
  const uniq = [...new Set(learned)];
  return uniq.slice(-MOVE_MAX);   // 가장 최근에 배운 4개
}

function knowsMove(inst, mid) { return (inst.moves || []).includes(mid); }

// 자리가 있으면 바로 배운다. 꽉 찼으면 false (교체 화면이 필요하다).
function tryLearn(inst, mid) {
  if (!inst.moves) inst.moves = [];
  if (knowsMove(inst, mid)) return true;
  if (inst.moves.length < MOVE_MAX) { inst.moves.push(mid); return true; }
  return false;
}

function replaceMove(inst, slot, mid) { inst.moves[slot] = mid; }

// 이번 레벨에서 배울 후보: 학습표에 걸린 기술 + 낮은 확률의 랜덤 습득
function levelUpMoveCandidates(inst, level) {
  const sp = MONSTERS[inst.id];
  const out = [];
  for (const e of sp.learnset) {
    if (e.level === level && !knowsMove(inst, e.move)) out.push(e.move);
  }
  if (Math.random() < 0.3) {
    const pool = randomMovePool(sp).filter(
      (m) => MOVES[m].minLv <= level && !knowsMove(inst, m) && !out.includes(m));
    if (pool.length) out.push(pool[Math.floor(Math.random() * pool.length)]);
  }
  return out;
}

// 진화 직후, 새 모습의 시작 기술을 아직 모르면 배울 기회를 준다
function evolutionMoveCandidates(inst) {
  const sp = MONSTERS[inst.id];
  return knowsMove(inst, sp.start) ? [] : [sp.start];
}

function createInstance(id, level, opts = {}) {
  const nature = opts.nature || randomNature();
  const talent = opts.talent || randomTalent();
  const resonant = opts.resonant !== undefined ? !!opts.resonant : Math.random() < (1 / 777);
  const equipment = opts.equipment || null;
  const traits = { nature, talent, equipment };
  const st = statsFor(id, level, traits);
  const maxSp = maxSpFor(id, level, traits);
  return {
    sid: sidCounter++,
    id, nick: opts.nick || null,
    level, exp: opts.exp || 0, expToNext: expToNext(level),
    hp: opts.hp ?? st.maxHp,
    maxHp: st.maxHp, atk: st.atk, def: st.def, spd: st.spd,
    sp: opts.sp ?? maxSp, maxSp,
    friendship: opts.friendship ?? 50,
    met: opts.met || null,
    capturedWith: opts.capturedWith || null,
    moves: opts.moves || movesAtLevel(id, level),
    nature, talent, resonant,
    equipment,
    status: opts.status || null,
    statusTurns: opts.statusTurns || 0,
  };
}

function isFainted(inst) { return inst.hp <= 0; }
function partyAlive(party) { return party.some((m) => m.hp > 0); }
function firstAlive(party) { return party.find((m) => m.hp > 0) || null; }

function healInstance(inst) {
  normalizeInstance(inst);
  const st = statsFor(inst.id, inst.level, inst);
  inst.maxHp = st.maxHp; inst.atk = st.atk; inst.def = st.def; inst.spd = st.spd;
  inst.hp = inst.maxHp;
  inst.maxSp = maxSpFor(inst.id, inst.level, inst);
  inst.sp = inst.maxSp;
  inst.status = null; inst.statusTurns = 0;
}

function healParty(party) { party.forEach(healInstance); }

// 경험치 부여. 레벨업/진화 후보를 이벤트 배열로 돌려준다.
function gainExp(inst, amount) {
  const events = [];
  inst.exp += amount;
  while (inst.exp >= inst.expToNext) {
    inst.exp -= inst.expToNext;
    inst.level += 1;
    const before = { maxHp: inst.maxHp, maxSp: inst.maxSp || maxSpFor(inst.id, inst.level - 1, inst), atk: inst.atk, def: inst.def, spd: inst.spd };
    const st = statsFor(inst.id, inst.level, inst);
    const gained = st.maxHp - before.maxHp;
    inst.maxHp = st.maxHp; inst.atk = st.atk; inst.def = st.def; inst.spd = st.spd;
    if (inst.hp > 0) inst.hp = Math.min(inst.maxHp, inst.hp + gained);
    const newMaxSp = maxSpFor(inst.id, inst.level, inst);
    const spGained = Math.max(0, newMaxSp - before.maxSp);
    inst.maxSp = newMaxSp;
    inst.sp = Math.min(inst.maxSp, Math.max(0, Number(inst.sp ?? before.maxSp)) + spGained);
    inst.expToNext = expToNext(inst.level);
    inst.friendship = Math.min(255, inst.friendship + 2);
    events.push({ type: 'levelup', level: inst.level, gained: {
      hp: st.maxHp - before.maxHp, sp: spGained, atk: st.atk - before.atk, def: st.def - before.def, spd: st.spd - before.spd,
    } });
    for (const mid of levelUpMoveCandidates(inst, inst.level)) {
      events.push({ type: 'learn', move: mid });
    }
    const evo = pendingEvolution(inst);
    if (evo) events.push({ type: 'evolve', to: evo });
  }
  return events;
}

function pendingEvolution(inst) {
  const s = MONSTERS[inst.id];
  if (s.evolution && inst.level >= s.evolution.level) return s.evolution.to;
  return null;
}

function evolveInstance(inst, toId) {
  const ratio = inst.hp / inst.maxHp;
  const oldMaxSp = Math.max(1, Number(inst.maxSp || maxSpFor(inst.id, inst.level, inst)));
  const oldSp = Math.max(0, Number(inst.sp ?? oldMaxSp));
  inst.id = toId;
  const st = statsFor(toId, inst.level, inst);
  inst.maxHp = st.maxHp; inst.atk = st.atk; inst.def = st.def; inst.spd = st.spd;
  inst.hp = Math.max(1, Math.round(inst.maxHp * ratio));
  inst.maxSp = maxSpFor(toId, inst.level, inst);
  inst.sp = Math.min(inst.maxSp, oldSp + Math.max(0, inst.maxSp - oldMaxSp));
  inst.friendship = Math.min(255, inst.friendship + 5);
}

// 야생 개체 생성 (출현표 한 줄에서)
// v7.8 — 야생 몬스터의 레벨과 진화단계를 일치시킨다.
// 1단계는 2단계 진화 레벨 미만, 2단계는 최종 진화 조건까지,
// 최종단계는 2단계의 최종 진화 조건보다 높은 레벨에서만 등장한다.
const WILD_EVOLUTION_PREV = (() => {
  const out = {};
  for (const sp of Object.values(MONSTERS)) {
    if (sp?.evolution) out[sp.evolution.to] = { from:sp.id, level:sp.evolution.level };
  }
  return out;
})();

function wildFamilyRoot(id) {
  let cur = id, guard = 0;
  while (WILD_EVOLUTION_PREV[cur] && guard++ < 5) cur = WILD_EVOLUTION_PREV[cur].from;
  return cur;
}

function wildSpeciesForLevel(entryId, level) {
  const original = MONSTERS[entryId];
  if (!original) return entryId;
  // 전설은 고정 종으로 유지한다.
  if (original.legendary) return entryId;
  // 환상 최종형은 기존 규칙대로 야생 미등장. 환상 1단계만 유지한다.
  if (original.mythical) return entryId;

  let id = wildFamilyRoot(entryId), guard = 0;
  while (guard++ < 5) {
    const sp = MONSTERS[id];
    if (!sp?.evolution) break;
    const next = MONSTERS[sp.evolution.to];
    const nextIsFinal = !!next && !next.evolution;
    // 최종단계는 2단계 진화조건 '초과'부터 야생 등장.
    const required = nextIsFinal && (sp.stage || 1) >= 2
      ? sp.evolution.level + 1
      : sp.evolution.level;
    if (level < required) break;
    id = sp.evolution.to;
  }
  return id;
}

function rollFromTable(table, enforceEvolutionStages = true) {
  const total = table.reduce((a, e) => a + e.weight, 0);
  let r = Math.random() * total;
  let chosen = table[0];
  for (const e of table) {
    r -= e.weight;
    if (r <= 0) { chosen = e; break; }
  }

  let min = chosen.min, max = chosen.max;
  const base = MONSTERS[chosen.id];
  if (enforceEvolutionStages && base?.mythical && base.evolution) {
    // 환상 1단계는 최종형으로 자동 진화시키지 않고 진화 직전 레벨까지만 등장.
    const cap = Math.max(1, base.evolution.level - 1);
    max = Math.min(max, cap);
    if (min > max) min = Math.max(1, max - 4);
  }
  const lv = min + Math.floor(Math.random() * (Math.max(min, max) - min + 1));
  const id = enforceEvolutionStages ? wildSpeciesForLevel(chosen.id, lv) : chosen.id;
  return createInstance(id, lv);
}

// 포획 판정: HP 비율과 종족 포획률, 캡슐 보정.
// v5.15부터 p 자체가 '최종 포획 성공 확률'이 되도록 계산한다.
// 이전 방식은 3회의 흔들림 판정을 모두 통과해야 해서 체감 확률이 지나치게 낮았다.
function catchChance(target, ballBonus, failedAttempts = 0) {
  const s = MONSTERS[target.id];
  const hpFactor = (3 * target.maxHp - 2 * target.hp) / (3 * target.maxHp);
  let p = (s.catchRate / 255) * hpFactor * ballBonus * 1.65;
  // 고레벨 패널티는 유지하되 기존보다 완만하게 한다.
  p *= (1 - Math.min(0.18, target.level * 0.0045));
  // 같은 전투에서 실패할 때마다 절대 확률 +1.5%p, 최대 5회(+7.5%p).
  // 희귀/전설 몬스터처럼 기본 확률이 낮아도 매 실패마다 체감 상승이 생긴다.
  p += Math.min(5, Math.max(0, failedAttempts)) * 0.015;
  return Math.max(0.03, Math.min(0.97, p));
}

function shakeCount(p) {
  // p를 실제 포획 성공률로 사용한다. 실패했을 때는 p가 높을수록 더 오래 흔들려
  // '거의 잡을 뻔한' 연출이 자연스럽게 나오도록 한다.
  if (Math.random() < p) return 3;
  const closeness = Math.random();
  const twoShake = Math.min(0.72, 0.18 + p * 0.65);
  const oneShake = Math.min(0.94, twoShake + 0.32 + p * 0.12);
  if (closeness < twoShake) return 2;
  if (closeness < oneShake) return 1;
  return 0;
}


/* ===== js/systems/world.js ===== */
// ============================================================


/* ===== js/systems/world.js ===== */
// world.js — 맵 / 카메라 / 플레이어 / 따라오는 몬스터 / 조우
// ============================================================








const VIEW_W = 160;
const VIEW_H = 224;
const DEFAULT_MOVE_TIME = 0.17;   // 한 칸 이동 시간(초)
const TURN_TIME = 0.07;   // 제자리 회전 시간

const DIRV = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };

function buildingEntryCols(o) {
  if (Array.isArray(o.entryCols) && o.entryCols.length) return o.entryCols;
  const w = o.w || 1;
  // Even-width buildings in the supplied art have a centered double doorway.
  // Let both center tiles work; odd-width buildings use the single center tile.
  return w % 2 === 0 ? [w / 2 - 1, w / 2] : [Math.floor(w / 2)];
}

function mapThemeFor(mapId, map) {
  if (['town07','route07a','route07b','center7','shop7','gym7','backroad07'].includes(mapId)) return 'aurora';
  if (['town06','route06a','route06b','center6','shop6','gym6','backroad06'].includes(mapId)) return 'astral';
  if (['backroad05'].includes(mapId)) return 'thunder';
  if (['backroad04'].includes(mapId)) return 'snow';
  if (['sunset_alley','backroad03'].includes(mapId)) return 'harbor';
  if (['backroad02'].includes(mapId)) return 'rock';
  if (['backroad01'].includes(mapId)) return 'grass';
  if (['town05','route05a','route05b','center5','shop5','gym5','hidden_thunder'].includes(mapId)) return 'thunder';
  if (['town04','route04','route04b','route04c','center4','shop4','gym4','hidden_wind'].includes(mapId)) return 'snow';
  if (['town03','route03','route03b','route03c','center3','shop3','gym3','hidden_water'].includes(mapId)) return 'harbor';
  if (['town02','cave01','route02','route02b','route02c','center2','shop2','gym2','hidden_fire'].includes(mapId)) return 'rock';
  if (['town','route01','forest01','home','lab','center','shop','gym1','hidden_grass'].includes(mapId)) return 'grass';
  return map?.indoor ? 'grass' : 'grass';
}

function mapSkinFor(mapId) {
  const skins = {
    town:'grass_town', route01:'grass_route', forest01:'forest',
    town02:'moonstone_town', cave01:'cave', route02:'rock_route', route02b:'rock_route', route02c:'cave',
    town03:'port_town', route03:'cape', route03b:'cape', route03c:'sandbar',
    town04:'snow_town', route04:'snow_route', route04b:'snow_route', route04c:'frost_valley',
    town05:'thunder_town', route05a:'electric_field', route05b:'thunder_plateau',
    hidden_grass:'hidden_grass', hidden_fire:'hidden_fire', hidden_water:'hidden_water',
    hidden_wind:'hidden_wind', hidden_thunder:'hidden_thunder',
  };
  return skins[mapId] || null;
}



function npcSpriteKey(n, mapId) {
  const name = String(n?.name || '');
  const pal = String(n?.palette || '');
  // 체육관장은 팔레트보다 전용 캐릭터를 최우선한다. (간호사 오인 방지)
  if (n?.trainer?.gym) {
    if (/새론/.test(name)) return 'gym_saron';
    if (/로칸/.test(name)) return 'gym_rokan';
    if (/세이마|세이라/.test(name)) return 'gym_seira';
    if (/프리온/.test(name)) return 'gym_frion';
    if (/세온/.test(name)) return 'gym_seon';
    if (/카일란|미라/.test(name)) return 'gym_kairan';
    if (/루미엘|루멘/.test(name)) return 'gym_lumiel';
  }
  if (n?.role === 'shop' || /점원|상인|장수|주인|용품상/.test(name)) return 'clerk';
  if (pal === 'nurse' || /간호/.test(name)) return 'nurse';
  if (pal === 'mom' || /엄마/.test(name)) return 'mom';
  if (/박사/.test(name)) return 'professor';
  if (n?.trainer) return 'trainer';
  if (/석공/.test(name)) return 'stonemason';
  if (/광부/.test(name)) return 'miner';
  if (/낚시/.test(name)) return 'fisher';
  if (/부두/.test(name)) return 'dockworker';
  if (/선원/.test(name)) return 'sailor';
  if (/정원/.test(name)) return 'gardener';
  if (/캠퍼/.test(name)) return 'camper';
  if (/숲지기|장작꾼/.test(name)) return 'ranger';
  if (/등산/.test(name)) return 'hiker';
  if (/설원|극지/.test(name)) return 'snow_scout';
  if (/전기|전력|정비|고압|뇌우|전류|기술자/.test(name)) return 'engineer';
  if (/연구|조사|지질|관측|탐험/.test(name)) return 'researcher';
  if (/노인|노기술자|늙은/.test(name)) return pal === 'villagerB' || /여/.test(name) ? 'old_female' : 'old_male';
  if (/소녀|여자아이/.test(name)) return 'kid_female';
  if (/소년|꼬마|아이/.test(name)) return pal === 'villagerB' ? 'kid_female' : 'kid_male';
  if (pal === 'villagerB') return 'villager_female';
  if (pal === 'kid') return 'kid_male';
  if (pal === 'prof') return 'researcher';
  return 'villager_male';
}

function mkActor(x, y, dir) {
  return { tx: x, ty: y, px: x * TILE, py: y * TILE, dir, moving: false, t: 0, fx: x, fy: y, frame: 0, anim: 0 };
}

class World {
  constructor(game) {
    this.game = game;
    this.mapId = null;
    this.map = null;
    this.player = mkActor(0, 0, 'down');
    this.follower = mkActor(0, 0, 'down');
    this.follower.visible = false;
    this.cam = { x: 0, y: 0 };
    this.time = 0;
    this.turnTimer = 0;
    this.stepsSinceEncounter = 0;
    this.nextRandomDropAt = 0;
    this.moveTime = DEFAULT_MOVE_TIME;   // 치트로 조절 가능
  }

  // ---------------------------------------------------------- 맵
  load(mapId, x, y, dir = 'down') {
    this.mapId = mapId;
    this.map = MAPS[mapId];
    this.theme = mapThemeFor(mapId, this.map);
    this.skin = mapSkinFor(mapId);
    this.w = this.map.grid[0].length;
    this.h = this.map.grid.length;
    this.player = mkActor(x, y, dir);
    this.follower = mkActor(x, y, dir);
    this.follower.visible = !!this.game.state.party.length && !this.game.isMounted();
    this.npcs = (this.map.npcs || []).map((n) => ({ ...n, ox: n.x, oy: n.y, frame: 0 }));
    if (!this.game.state.discoveredMaps) this.game.state.discoveredMaps = {};
    this.game.state.discoveredMaps[mapId] = true;
    // 발을 들인 마을은 귀환 목적지로 열린다
    if (RETURN_POINTS[mapId]) {
      if (!this.game.state.visited) this.game.state.visited = {};
      this.game.state.visited[mapId] = true;
    }
    this.buildSolids();
    // 야외 필드에는 정체를 숨긴 랜덤 아이템을 추가 배치한다.
    if (this.ensureRandomFieldDrops(true)) this.buildSolids();
    this.nextRandomDropAt = Date.now() + 240000 + Math.random() * 120000;
    this.updateCamera(true);
  }

  buildSolids() {
    this.solids = new Set();
    this.objects = [];
    for (const o of (this.map.objects || [])) {
      if (o.kind === 'building') {
        const entries = new Set(buildingEntryCols(o).map((rel) => o.x + rel));
        for (let dx = 0; dx < o.w; dx++) {
          for (let dy = 0; dy < o.h; dy++) {
            const tx = o.x + dx, ty = o.y + dy;
            if (ty === o.y + o.h - 1 && entries.has(tx)) continue; // 보이는 중앙 문 폭 전체 통과
            this.solids.add(`${tx},${ty}`);
          }
        }
        this.objects.push(o);
        continue;
      }
      if (o.kind === 'item') {
        if (this.game.state.flags[o.flag]) continue;  // 이미 주운 아이템
        this.objects.push({ w: 1, h: 1, ...o });
        continue;
      }
      if (o.kind === 'legendary') {
        const st = this.game.state;
        if (st.flags[o.flag]) {
          const resp = st.legendaryRespawn && st.legendaryRespawn[o.flag];
          if (resp !== undefined && Date.now() >= resp) {
            delete st.flags[o.flag];
            delete st.legendaryRespawn[o.flag];
          } else {
            continue; // 포획으로 소멸했거나, 아직 리젠 시간이 안 됨
          }
        }
        this.objects.push({ w: 1, h: 1, ...o });
        this.solids.add(`${o.x},${o.y}`);
        continue;
      }
      if (o.kind === 'fieldboss') {
        const st = this.game.state;
        if (st.flags[o.flag]) {
          const resp = st.fieldBossRespawn && st.fieldBossRespawn[o.flag];
          if (resp !== undefined && Date.now() >= resp) {
            delete st.flags[o.flag];
            delete st.fieldBossRespawn[o.flag];
          } else {
            continue;
          }
        }
        this.objects.push({ w:1, h:1, ...o });
        this.solids.add(`${o.x},${o.y}`);
        continue;
      }
      const ob = { w: 1, h: 1, ...o };
      this.objects.push(ob);
      if (ob.solid) {
        for (let dx = 0; dx < ob.w; dx++)
          for (let dy = 0; dy < ob.h; dy++) this.solids.add(`${ob.x + dx},${ob.y + dy}`);
      }
    }
    const dyn = this.game.state.fieldDrops?.[this.mapId] || [];
    for (const d of dyn) this.objects.push({ kind:'item', w:1, h:1, dynamic:true, ...d });
  }

  randomFieldDropSpec() {
    const pool = [
      ['capsule',28], ['potion',23], ['berry',17], ['capsule_plus',12],
      ['potion_plus',9], ['sp_potion',6], ['sp_potion_plus',2.2], ['sp_potion_supreme',0.35], ['goddess_tear',0.65],
      ['candy_small',5], ['scroll',3], ['revive',2],
      ['capsule_supreme',0.8], ['capsule_ultra',0.2], ['move_cd',0.4],
    ];
    let r=Math.random()*pool.reduce((a,v)=>a+v[1],0), id='capsule';
    for (const [k,w] of pool) { r-=w; if (r<=0) { id=k; break; } }
    const count = ['capsule','potion','berry'].includes(id) ? (1+Math.floor(Math.random()*3))
      : ['capsule_plus','potion_plus'].includes(id) ? (1+Math.floor(Math.random()*2)) : 1;
    return { item:id, count };
  }

  ensureRandomFieldDrops(initial=false) {
    if (!this.map || this.map.indoor) return false;
    const st=this.game.state;
    if (!st.fieldDrops) st.fieldDrops={};
    const list=st.fieldDrops[this.mapId] ||= [];
    const targetInitial = this.map.areaType==='hunt' ? 1 : this.map.areaType==='hidden' ? 1 : 0;
    const maxDrops = this.map.areaType==='hunt' ? 2 : this.map.areaType==='hidden' ? 1 : 1;
    const target = initial ? targetInitial : Math.min(maxDrops, list.length + 1);
    let changed=false, guard=0;
    while (list.length < target && guard++ < 120) {
      const x=1+Math.floor(Math.random()*Math.max(1,this.w-2));
      const y=1+Math.floor(Math.random()*Math.max(1,this.h-2));
      if (!this.tileProps(x,y).walkable || this.solids.has(`${x},${y}`) || this.npcAt(x,y)) continue;
      if (Math.abs(x-this.player.tx)+Math.abs(y-this.player.ty)<3) continue;
      if (this.warpAt(x,y)) continue;
      const occupied=this.objects.some(o=>x>=o.x&&x<o.x+(o.w||1)&&y>=o.y&&y<o.y+(o.h||1));
      if (occupied || list.some(d=>d.x===x&&d.y===y)) continue;
      const spec=this.randomFieldDropSpec();
      list.push({ dropId:`${this.mapId}_${Date.now()}_${Math.floor(Math.random()*1e8)}`, x,y, item:spec.item, count:spec.count, spawnedAt:Date.now() });
      changed=true;
    }
    return changed;
  }

  refreshObjects() { this.buildSolids(); }

  refreshExpiredLegendary() {
    const st = this.game.state;
    const now = Date.now();
    let changed = false;
    for (const o of (this.map.objects || [])) {
      if ((o.kind === 'legendary' || o.kind === 'fieldboss') && st.flags[o.flag]) {
        const store = o.kind === 'legendary' ? st.legendaryRespawn : st.fieldBossRespawn;
        const resp = store?.[o.flag];
        if (resp !== undefined && now >= resp) {
          delete st.flags[o.flag];
          if (store) delete store[o.flag];
          changed = true;
        }
      }
    }
    if (changed) this.buildSolids();
  }

  tileChar(x, y) {
    if (x < 0 || y < 0 || y >= this.h || x >= this.w) return '#';
    return this.map.grid[y][x];
  }
  tileProps(x, y) { return TILES[this.tileChar(x, y)] || TILES['#']; }

  npcAt(x, y) { return this.npcs.find((n) => n.x === x && n.y === y) || null; }

  objectAt(x, y) {
    return this.objects.find((o) => o.kind !== 'building'
      && x >= o.x && x < o.x + (o.w || 1) && y >= o.y && y < o.y + (o.h || 1)) || null;
  }

  warpAt(x, y) {
    const exact = (this.map.warps || []).find((w) => w.x === x && w.y === y);
    if (exact) return exact;
    // v6.7: 4타일 폭 건물은 중앙 2칸 문을 모두 실제 출입구로 사용한다.
    // If the player steps on either half, reuse the building's canonical warp.
    const b = this.objects.find((o) => o.kind === 'building'
      && y === o.y + o.h - 1
      && buildingEntryCols(o).some((rel) => x === o.x + rel));
    if (!b) return null;
    const canonicalY = b.y + b.h - 1;
    return (this.map.warps || []).find((w) => w.y === canonicalY && w.x === b.door) || null;
  }

  walkable(x, y) {
    if (this.game.cheats && this.game.cheats.noclip) {
      return x >= 0 && y >= 0 && x < this.w && y < this.h;
    }
    const props=this.tileProps(x,y);
    const waterRide = props.key === 'water' && this.game.state.mount?.mode === 'water' && !!this.game.mountedMonster();
    if (!props.walkable && !waterRide) return false;
    if (this.solids.has(`${x},${y}`)) return false;
    if (this.npcAt(x, y)) return false;
    return true; // 따라오는 몬스터는 자리를 비켜 주므로 막지 않는다
  }

  moveDuration() {
    const mount=this.game.state.mount;
    if (mount?.mode==='land' && this.game.mountedMonster()) return 0.085;
    if (mount?.mode==='water' && this.game.mountedMonster()) return 0.105;
    return this.moveTime;
  }

  // ---------------------------------------------------------- 이동
  tryMove(dir) {
    const p = this.player;
    if (p.moving || this.turnTimer > 0) return;
    if (p.dir !== dir) { p.dir = dir; this.turnTimer = TURN_TIME; return; }
    const [dx, dy] = DIRV[dir];
    const nx = p.tx + dx, ny = p.ty + dy;
    if (!this.walkable(nx, ny)) return;

    // 따라오는 몬스터는 플레이어가 "있던" 칸으로 들어온다 (순간이동 금지)
    const f = this.follower;
    if (f.visible && (f.tx !== p.tx || f.ty !== p.ty)) {
      f.fx = f.tx; f.fy = f.ty;
      f.dir = f.tx < p.tx ? 'right' : f.tx > p.tx ? 'left' : f.ty < p.ty ? 'down' : 'up';
      f.tx = p.tx; f.ty = p.ty; f.moving = true; f.t = 0;
    }

    p.fx = p.tx; p.fy = p.ty;
    p.tx = nx; p.ty = ny; p.moving = true; p.t = 0;
    p.parity = !p.parity;
    if (f.moving) f.parity = !f.parity;
    sfx.step();
  }

  update(dt, allowInput) {
    this.time += dt;
    this.refreshExpiredLegendary();
    if (!this.map?.indoor && Date.now() >= this.nextRandomDropAt) {
      if (this.ensureRandomFieldDrops(false)) this.buildSolids();
      this.nextRandomDropAt = Date.now() + 240000 + Math.random() * 120000;
    }
    if (this.turnTimer > 0) this.turnTimer = Math.max(0, this.turnTimer - dt);

    for (const a of [this.player, this.follower]) {
      if (!a.moving) continue;
      a.t += dt / (a === this.player ? this.moveDuration() : this.moveTime);
      if (a.t >= 1) {
        a.t = 1; a.moving = false;
        a.px = a.tx * TILE; a.py = a.ty * TILE;
      } else {
        a.px = (a.fx + (a.tx - a.fx) * a.t) * TILE;
        a.py = (a.fy + (a.ty - a.fy) * a.t) * TILE;
      }
      a.anim += dt;
    }

    // 걷기 프레임: 한 칸마다 좌우 발을 번갈아 낸다
    for (const a of [this.player, this.follower]) {
      a.frame = a.moving ? (a.parity ? 1 : 2) : 0;
    }

    const p = this.player;
    if (!p.moving && p.t === 1) { p.t = 0; this.onStepComplete(); }

    if (allowInput && !p.moving && this.turnTimer === 0) {
      const dir = this.game.input.direction();
      if (dir) this.tryMove(dir);
    }
    this.updateCamera();
  }

  onStepComplete() {
    const p = this.player;
    const warp = this.warpAt(p.tx, p.ty);
    if (warp) { this.game.doWarp(warp); return; }

    const props = this.tileProps(p.tx, p.ty);
    // 물 탑승 상태에서 육지로 올라오면 자동으로 내린다.
    if (this.game.state.mount?.mode === 'water' && props.key !== 'water') this.game.dismount(true, false);
    // v7.8: 자동줍기권 보유 시 주변 2칸의 랜덤 드랍을 이동만 해도 수거한다.
    if (this.game.state.upgrades?.autoPickup) this.game.autoPickupFieldItems(2);
    if (props.encounter && this.map.encounterTable) {
      this.stepsSinceEncounter++;
      const party = this.game.state.party;
      if (party.some((m) => m.hp > 0) && this.stepsSinceEncounter > 2
          && Math.random() < ENCOUNTER_RATE * (this.game.cheats?.encounterMul ?? 1)) {
        this.stepsSinceEncounter = 0;
        const table = ENCOUNTER_TABLES[this.map.encounterTable];
        if (table && table.length) this.game.startWildBattle(table);
      }
    }
  }

  facingTile() {
    const p = this.player;
    const [dx, dy] = DIRV[p.dir];
    return { x: p.tx + dx, y: p.ty + dy, dx, dy };
  }

  updateCamera(snap) {
    const mw = this.w * TILE, mh = this.h * TILE;
    let cx = this.player.px + TILE / 2 - VIEW_W / 2;
    let cy = this.player.py + TILE / 2 - VIEW_H / 2;
    cx = mw <= VIEW_W ? (mw - VIEW_W) / 2 : Math.max(0, Math.min(mw - VIEW_W, cx));
    cy = mh <= VIEW_H ? (mh - VIEW_H) / 2 : Math.max(0, Math.min(mh - VIEW_H, cy));
    this.cam.x = Math.round(cx);
    this.cam.y = Math.round(cy);
    if (snap) { this.player.px = this.player.tx * TILE; this.player.py = this.player.ty * TILE; }
  }

  // ---------------------------------------------------------- 그리기
  draw(ctx) {
    const cam = this.cam;
    ctx.fillStyle = this.map.bgColor || (this.map.indoor ? '#101018' : '#2f7a3a');
    ctx.fillRect(0, 0, VIEW_W, VIEW_H);

    const x0 = Math.max(0, Math.floor(cam.x / TILE));
    const y0 = Math.max(0, Math.floor(cam.y / TILE));
    const x1 = Math.min(this.w - 1, Math.ceil((cam.x + VIEW_W) / TILE));
    const y1 = Math.min(this.h - 1, Math.ceil((cam.y + VIEW_H) / TILE));
    const waterFrame = Math.floor(this.time * 2.5) % 3;

    for (let y = y0; y <= y1; y++) {
      for (let x = x0; x <= x1; x++) {
        const props = this.tileProps(x, y);
        const variant = props.key === 'water' ? waterFrame : Math.floor(hash2(x, y) * 3);
        ctx.drawImage(assets.tile(props.key, variant, this.theme, this.skin), x * TILE - cam.x, y * TILE - cam.y);
      }
    }

    // 깊이 정렬 엔티티
    const ents = [];
    for (const o of this.objects) {
      const w = o.w || 1, h = o.h || 1;
      const isMonsterObj = o.kind === 'fieldboss' || o.kind === 'legendary';
      const isItemObj = o.kind === 'item' && o.item;
      const monsterSp = isMonsterObj ? MONSTERS[o.monster] : null;
      const img = o.kind === 'building'
        ? assets.building(o.style, w, h, o.door - o.x, this.theme)
        : isMonsterObj ? assets.fieldMonster(monsterSp, o.dir || (o.kind === 'legendary' ? 'left' : 'down'))
        : isItemObj ? assets.fieldItem('capsule')
        : assets.object(o.kind, w, h, this.theme, this.skin);
      if (isMonsterObj) {
        const sz = fitSpriteSize(img, fieldMonsterSize(monsterSp));
        ents.push({ img, dw:sz.w, dh:sz.h, hq:true,
          x: o.x * TILE + (TILE - sz.w) / 2,
          y: (o.y + 1) * TILE - sz.h,
          sort: (o.y + 1) * TILE,
          shadow: true, shadowX:o.x*TILE, shadowY:o.y*TILE });
      } else if (isItemObj) {
        const sz = fitSpriteSize(img, 18, 18);
        ents.push({ img, dw:sz.w, dh:sz.h, hq:true,
          x: o.x * TILE + (TILE - sz.w) / 2,
          y: (o.y + 1) * TILE - sz.h,
          sort: (o.y + 1) * TILE,
          shadow: true, shadowX:o.x*TILE, shadowY:o.y*TILE });
      } else {
        ents.push({ img, x: o.x * TILE, y: o.y * TILE, sort: (o.y + h) * TILE, shadow: false });
      }
    }
    for (const n of this.npcs) {
      const paletteKey = npcSpriteKey(n, this.mapId);
      const img = assets.human(paletteKey, HUMAN_PALETTES[n.palette] || HUMAN_PALETTES.villagerA, n.dir, 0);
      const sz = fitSpriteSize(img, 20, 25);
      ents.push({
        img, dw:sz.w, dh:sz.h, hq:false,
        x: n.x * TILE + (TILE - sz.w) / 2,
        y: (n.y + 1) * TILE - sz.h + 1,
        sort: (n.y + 1) * TILE + 1,
        shadow: true, shadowX:n.x*TILE, shadowY:n.y*TILE,
      });
    }
    const f = this.follower;
    if (f.visible && this.game.state.party[0] && !this.game.isMounted()) {
      const sp = MONSTERS[this.game.state.party[0].id];
      const bob = f.moving && f.frame === 1 ? -1 : 0;
      const img = assets.fieldMonster(sp, f.dir);
      const sz = fitSpriteSize(img, fieldMonsterSize(sp));
      const fx=Math.round(f.px), fy=Math.round(f.py);
      ents.push({ img, dw:sz.w, dh:sz.h, hq:false,
        x: fx + (TILE - sz.w) / 2,
        y: fy + TILE - sz.h + bob,
        sort: fy + TILE, shadow: true, shadowX:fx, shadowY:fy });
    }
    const p = this.player;
    const ppX=Math.round(p.px), ppY=Math.round(p.py);
    const mounted=this.game.mountedMonster();
    if (mounted) {
      const msp=MONSTERS[mounted.id];
      const mimg=assets.fieldMonster(msp,p.dir);
      const max=this.game.state.mount?.mode==='water' ? 30 : 34;
      const msz=fitSpriteSize(mimg,max,max);
      ents.push({
        img:mimg,dw:msz.w,dh:msz.h,hq:false,
        x:ppX+(TILE-msz.w)/2,y:ppY+TILE-msz.h+3,
        sort:ppY+TILE+1,shadow:true,shadowX:ppX,shadowY:ppY,
      });
    }
    {
      const img = assets.human('hero', HUMAN_PALETTES.hero, p.dir, p.frame);
      const sz = fitSpriteSize(img, mounted ? 15 : 19, mounted ? 20 : 24);
      ents.push({
        img, dw:sz.w, dh:sz.h, hq:false,
        x: ppX + (TILE - sz.w) / 2,
        y: ppY + TILE - sz.h + (mounted ? -7 : 1),
        sort: ppY + TILE + 3,
        shadow: !mounted, shadowX:ppX, shadowY:ppY, isPlayer: true,
      });
    }

    ents.sort((a, b) => a.sort - b.sort);
    for (const e of ents) {
      const dx = Math.round(e.x - cam.x), dy = Math.round(e.y - cam.y);
      if (dx < -64 || dy < -64 || dx > VIEW_W + 64 || dy > VIEW_H + 64) continue;
      if (e.shadow) {
        const sx = Math.round((e.shadowX ?? e.x) - cam.x);
        const sy = Math.round((e.shadowY ?? e.y) - cam.y);
        ctx.drawImage(assets.shadow(), sx, sy);
      }
      ctx.imageSmoothingEnabled = false;
      if (e.dw && e.dh) ctx.drawImage(e.img, dx, dy, e.dw, e.dh);
      else ctx.drawImage(e.img, dx, dy);
      ctx.imageSmoothingEnabled = false;
    }
    if (mounted && this.game.state.mount?.mode==='water') {
      const rx=Math.round(ppX-cam.x+TILE/2), ry=Math.round(ppY-cam.y+TILE-2);
      ctx.strokeStyle='rgba(190,240,255,0.85)';
      ctx.lineWidth=1;
      ctx.beginPath(); ctx.ellipse(rx,ry,13,4,0,0,Math.PI*2); ctx.stroke();
      ctx.strokeStyle='rgba(80,180,235,0.55)';
      ctx.beginPath(); ctx.ellipse(rx,ry+2,9,3,0,0,Math.PI*2); ctx.stroke();
    }
    if (f.visible && this.game.state.party[0]?.resonant) {
      const fx=Math.round(f.px-cam.x+8), fy=Math.round(f.py-cam.y+6);
      ctx.fillStyle='#fff2a0';
      for(let i=0;i<4;i++){ const a=this.time*3+i*Math.PI/2; ctx.fillRect(Math.round(fx+Math.cos(a)*10),Math.round(fy+Math.sin(a)*8),1,1); }
    }

    // 풀숲에 서 있으면 발밑을 풀로 덮어 준다
    this.drawGrassOverlay(ctx, p);
    if (f.visible) this.drawGrassOverlay(ctx, f);
  }

  drawGrassOverlay(ctx, a) {
    const tx = Math.round(a.px / TILE), ty = Math.round(a.py / TILE);
    if (this.tileProps(tx, ty).key !== 'tallgrass') return;
    const img = assets.tile('tallgrass', Math.floor(hash2(tx, ty) * 3), this.theme, this.skin);
    ctx.drawImage(img, 0, 9, TILE, 7,
      tx * TILE - this.cam.x, ty * TILE + 9 - this.cam.y, TILE, 7);
  }
}


/* ===== js/ui/menus.js ===== */
// ============================================================


/* ===== js/ui/menus.js ===== */
// menus.js — 대화창과 각종 메뉴 화면
// ------------------------------------------------------------
// 모든 씬은 { update(dt, game), drawUI(sc, game) } 인터페이스만 지킨다.
// game.push(scene) / game.pop() 으로 스택처럼 쌓인다.
// ============================================================








const TEXT_SPEEDS = [26, 55, 100000];

// ============================================================
// 대화창
// ============================================================
class Dialogue {
  constructor(pages, opts = {}) {
    this.pages = Array.isArray(pages) ? pages : [pages];
    this.i = 0;
    this.chunk = 0;
    this.chars = 0;
    this._forPage = -1;
    this.opts = opts;
    this.choices = opts.choices || null;
    this.choosing = false;
    this.cursor = new MenuCursor(this.choices ? this.choices.length : 0);
    this.speaker = opts.speaker || null;
  }

  ensure(game) {
    if (this._forPage === this.i) return;
    const all = game.screen.wrap(this.pages[this.i], 136, 9);
    this.chunks = [];
    for (let k = 0; k < all.length; k += 3) this.chunks.push(all.slice(k, k + 3));
    if (!this.chunks.length) this.chunks = [['']];
    this._forPage = this.i;
    this.chunk = 0;
    this.chars = 0;
  }

  get lines() { return this.chunks[this.chunk] || ['']; }
  get total() { return this.lines.join('').length; }
  get full() { return this.chars >= this.total; }

  atEnd() {
    return this.chunk >= this.chunks.length - 1 && this.i >= this.pages.length - 1;
  }

  advance(game) {
    if (this.chunk < this.chunks.length - 1) { this.chunk++; this.chars = 0; sfx.blip(); return; }
    if (this.i < this.pages.length - 1) { this.i++; this._forPage = -1; sfx.blip(); return; }
    if (this.choices) { this.choosing = true; sfx.blip(); return; }
    this.close(game);
  }

  close(game) {
    game.pop();
    if (this.opts.onDone) this.opts.onDone();
  }

  update(dt, game) {
    this.ensure(game);
    if (this.choosing) {
      const d = game.input.freshDirection();
      if (d && this.cursor.move(d)) sfx.blip();
      if (game.input.pressed('a')) {
        sfx.confirm();
        const pick = this.choices[this.cursor.i];
        game.pop();
        if (this.opts.onChoose) this.opts.onChoose(pick.value, pick);
      } else if (game.input.pressed('b') && this.opts.cancelable !== false) {
        sfx.cancel();
        game.pop();
        if (this.opts.onChoose) this.opts.onChoose(null);
      }
      return;
    }

    if (!this.full) this.chars += TEXT_SPEEDS[game.state.settings.textSpeed] * dt;

    if (game.input.pressed('a')) {
      if (!this.full) { this.chars = 1e9; return; }
      this.advance(game);
    } else if (game.input.pressed('b')) {
      if (!this.full) { this.chars = 1e9; return; }
      if (this.choices) { this.advance(game); return; }
      sfx.cancel();
      this.close(game);
    }
  }

  drawUI(sc, game) {
    this.ensure(game);
    const boxY = this.choosing ? 164 : 164;
    sc.box(3, boxY, 154, 57);
    if (this.speaker) {
      sc.box(3, 150, 52, 16);
      sc.text(this.speaker, 12, 154, { size: 8, weight: '700', color: COL.accent, maxW:136, minSize:6 });
    }
    if (this.choosing) {
      sc.text(this.pages[this.pages.length - 1], 11, 172, { size: 8, color: COL.dim });
      sc.box(104, 150, 53, 20 + this.choices.length * 13);
      this.choices.forEach((c, i) => {
        const y = 158 + i * 13;
        if (this.cursor.i === i) sc.cursor(110, y + 2);
        sc.text(c.label, 117, y, { size: 9 });
      });
      return;
    }
    let budget = Math.floor(this.chars);
    this.lines.forEach((line, i) => {
      const take = Math.max(0, Math.min(line.length, budget));
      budget -= line.length;
      if (take > 0) sc.text(line.slice(0, take), 11, 174 + i * 13, { size: 9 });
    });
    if (this.full) sc.arrow(146, 210);
  }
}

// ============================================================
// 필드 진화 연출 (레벨업사탕 등 전투 밖 진화용)
// ============================================================
class EvolutionScene {
  constructor(inst, toId, opts = {}) {
    this.inst = inst;
    this.fromId = inst.id;
    this.toId = toId;
    this.fromName = displayName(inst);
    this.toName = MONSTERS[toId]?.name || '???';
    this.t = 0;
    this.done = false;
    this.onComplete = opts.onComplete || null;
    this.duration = 3.25;
    this.started = false;
  }

  update(dt, game) {
    if (!this.started) {
      this.started = true;
      sfx.evolve();
    }
    this.t += dt;
    if (this.t < this.duration || this.done) return;
    this.done = true;
    game.pop();
    if (this.onComplete) this.onComplete();
  }

  drawUI(sc, game) {
    const t = this.t;
    // 필드/메뉴를 완전히 덮어 독립된 진화 장면으로 보이게 한다.
    sc.fill(0, 0, 160, 224, '#111522');

    // 배경 광선
    const cx = 80, cy = 93;
    const rays = 18;
    for (let i = 0; i < rays; i++) {
      const a = (i / rays) * Math.PI * 2 + t * 0.45;
      const r1 = 35 + Math.sin(t * 4 + i) * 4;
      const r2 = 72 + Math.sin(t * 2 + i) * 8;
      const x1 = cx + Math.cos(a) * r1;
      const y1 = cy + Math.sin(a) * r1;
      const x2 = cx + Math.cos(a) * r2;
      const y2 = cy + Math.sin(a) * r2;
      const steps = 12;
      for (let k = 0; k < steps; k++) {
        const q = k / steps;
        sc.fill(x1 + (x2 - x1) * q, y1 + (y2 - y1) * q, 1, 1,
          i % 2 ? '#5d6fa4' : '#8b78b8');
      }
    }

    sc.text('어라…?', 80, 18, { size: 11, weight: '700', align: 'center', color: '#f8f6ee' });
    sc.text(`${this.fromName}의 모습이…!`, 80, 35, { size: 9, align: 'center', color: '#d8d3e8', maxW:140, minSize:6 });

    // 전투 진화와 같은 방식으로 옛 모습/새 모습을 점점 빠르게 교차한다.
    const freq = 1.6 + t * t * 2.0;
    const finalPhase = t >= 2.55;
    const showNew = finalPhase || (t > 0.55 && Math.floor(t * freq) % 2 === 1);
    const sp = MONSTERS[showNew ? this.toId : this.fromId];
    const img = assets.battleMonster(sp);
    if (img) {
      const stageBoost = 1 + Math.max(0, (sp.stage || 1) - 1) * 0.08;
      const pulse = 1 + Math.sin(t * 8) * (finalPhase ? 0.025 : 0.05);
      const box = Math.min(88, 68 * stageBoost) * pulse;
      sc.hqFit(img, cx-box/2, cy-box/2, box, box, {ay:0.5});
    }

    // 교차 구간 흰 베일 / 완성 플래시
    if (t < 2.45) {
      const alpha = 0.08 + Math.abs(Math.sin(t * freq * Math.PI)) * 0.16;
      sc.fill(0, 0, 160, 150, `rgba(255,255,255,${alpha})`);
    }
    if (t >= 2.45 && t < 2.78) {
      const alpha = Math.max(0, 1 - (t - 2.45) / 0.33);
      sc.fill(0, 0, 160, 150, `rgba(255,255,255,${alpha})`);
    }

    // 최종 단계 반짝임
    if (finalPhase) {
      for (let i = 0; i < 20; i++) {
        const a = (i / 20) * Math.PI * 2 + t * (i % 2 ? 1.8 : -1.3);
        const r = 36 + ((t - 2.55) * 55 + i * 5) % 42;
        const size = i % 4 === 0 ? 2 : 1;
        sc.fill(cx + Math.cos(a) * r, cy + Math.sin(a) * r, size, size,
          i % 2 ? '#fff19a' : '#ffffff');
      }
      sc.text(`${this.toName}!`, 80, 145, { size: 12, weight: '700', align: 'center', color: '#fff3a8', maxW:140, minSize:7 });
    }

    sc.box(8, 170, 144, 42, { paper: '#f8f6ee' });
    const msg = finalPhase
      ? `${this.fromName}은(는) ${this.toName}(으)로 진화했다!`
      : '몸에서 강한 빛이 뿜어져 나온다…';
    sc.text(msg, 80, 181, { size: 8, align: 'center', color: '#20202e' });
    void game;
  }
}

// ============================================================
// 환상 몬스터 조우 전용 연출
// ============================================================
class MythicalIntroScene {
  constructor(monsterId, onDone) {
    this.id=monsterId; this.onDone=onDone; this.t=0; this.done=false;
    this.seed=(monsterId*977)%997;
    sfx.mythical();
  }
  update(dt, game) {
    this.t += dt;
    if ((this.t >= 3.45 || (this.t > 1.65 && game.input.pressed('a'))) && !this.done) {
      this.done=true;
      game.pop();
      if(this.onDone) this.onDone();
    }
  }
  drawUI(sc, game) {
    const sp=MONSTERS[this.id], ctx=sc.ctx, t=this.t;
    const psychic=sp.type==='에스퍼';
    const c1=psychic?'#8b5cff':'#ffd45e', c2=psychic?'#5ce2ff':'#8fe8ff';

    // Screen.ctx는 실제 해상도 좌표이므로 논리 160x224 좌표로 맞춰 그린다.
    ctx.save();
    ctx.scale(sc.scale, sc.scale);
    const g=ctx.createRadialGradient(80,92,8,80,92,126);
    g.addColorStop(0, psychic?'rgba(70,38,132,0.82)':'rgba(104,76,18,0.78)');
    g.addColorStop(0.48,'rgba(9,16,38,0.93)');
    g.addColorStop(1,'rgba(2,4,14,0.99)');
    ctx.fillStyle=g; ctx.fillRect(0,0,160,224);

    // 느리게 흘러가는 성운/여명 안개
    ctx.save();
    for(let i=0;i<7;i++){
      const yy=42+i*22+Math.sin(t*0.9+i*1.7)*5;
      const xx=((t*(7+i*0.7)+i*31)%210)-30;
      ctx.globalAlpha=0.07+(i%3)*0.025;
      ctx.fillStyle=i%2?c1:c2;
      ctx.beginPath(); ctx.ellipse(xx,yy,46+i*3,6+(i%2)*2,0,0,Math.PI*2); ctx.fill();
    }
    ctx.restore();

    // 공명 고리 + 별가루
    ctx.save(); ctx.translate(80,92);
    for(let j=0;j<4;j++){
      const rr=20+((t*24+j*22)%78);
      ctx.globalAlpha=Math.max(0,0.48-rr/190);
      ctx.strokeStyle=j%2?c1:c2; ctx.lineWidth=1;
      ctx.beginPath(); ctx.arc(0,0,rr,0,Math.PI*2); ctx.stroke();
    }
    for(let i=0;i<32;i++){
      const a=i*2.399963+t*(i%2?0.23:-0.16);
      const r=24+((i*17+this.seed)%63);
      ctx.globalAlpha=0.28+0.72*Math.abs(Math.sin(t*2.3+i*1.41));
      ctx.fillStyle=i%3===0?'#ffffff':(i%2?c1:c2);
      const s=i%7===0?2:1;
      ctx.fillRect(Math.round(Math.cos(a)*r),Math.round(Math.sin(a)*r),s,s);
    }
    ctx.restore(); ctx.globalAlpha=1;
    ctx.restore();

    const img=assets.fieldMonster(sp,'left');
    const target=76+Math.sin(t*2.6)*2;
    ctx.globalAlpha=t<0.9?Math.max(0,t/0.9):1;
    sc.hqFit(img,80-target/2,73-target/2,target,target,{ay:0.5,smooth:false,pad:1});
    ctx.globalAlpha=1;

    if(t>0.35){
      sc.text('공간의 결이 흔들린다…',80,18,{size:7.5,weight:'700',align:'center',color:'#f6f0ff'});
      sc.text('낯선 공명이 현실에 스며든다',80,31,{size:6.5,align:'center',color:psychic?'#d9c5ff':'#fff0a5'});
    }
    if(t>1.05){
      sc.panel(42,137,76,13,'rgba(11,16,38,0.90)');
      sc.text('MYTHICAL ENCOUNTER',80,140,{size:6.3,weight:'800',align:'center',color:c2});
      sc.text(sp.name,80,158,{size:18,weight:'800',align:'center',color:'#ffffff',shadow:'#15101f',maxW:140,minSize:9});
      sc.text(`${sp.type} 타입 · 환상 몬스터`,80,181,{size:7,align:'center',color:psychic?'#d6b6ff':'#ffe48a'});
    }
    if(t>1.65) sc.text('A 건너뛰기',80,207,{size:6,align:'center',color:'#858da8'});
    void game;
  }
}

// ============================================================
// 전설 조우 전용 연출
// ============================================================
class LegendaryIntroScene {
  constructor(monsterId, onDone) { this.id=monsterId; this.onDone=onDone; this.t=0; this.done=false; }
  update(dt, game) {
    this.t += dt;
    if ((this.t >= 2.8 || (this.t > 1.2 && game.input.pressed('a'))) && !this.done) {
      this.done = true; game.pop(); if (this.onDone) this.onDone();
    }
  }
  drawUI(sc, game) {
    const sp=MONSTERS[this.id], ctx=sc.ctx, t=this.t;
    const alpha=Math.min(0.92, t*0.8);
    ctx.fillStyle=`rgba(5,5,12,${alpha})`; ctx.fillRect(0,0,160,224);
    const col=TYPE_COLORS[sp.type] || '#d8d0a0';
    ctx.save(); ctx.translate(80,91);
    for(let i=0;i<12;i++) {
      const a=i/12*Math.PI*2+t*(i%2?0.8:-0.55); const r=34+Math.sin(t*3+i)*5;
      ctx.fillStyle=i%2?col:'#ffffff'; ctx.globalAlpha=0.35+0.35*Math.abs(Math.sin(t*4+i));
      ctx.fillRect(Math.round(Math.cos(a)*r),Math.round(Math.sin(a)*r),2,2);
    }
    ctx.restore(); ctx.globalAlpha=1;
    const img=sp.legendary ? assets.fieldMonster(sp,'left') : assets.battleMonster(sp); const target=78+Math.sin(t*7)*2; sc.hqFit(img,80-target/2,78-target/2,target,target,{ay:0.5});
    if (t>0.45) {
      sc.text('전설의 공명이 울려 퍼진다',80,29,{size:8,weight:'700',align:'center',color:'#fff4c0'});
      sc.panel(46,41,68,12,col); sc.text(`${sp.type} · LEGEND`,80,43,{size:7,align:'center',color:'#fff'});
    }
    if (t>1.2) {
      sc.text(sp.name,80,146,{size:17,weight:'800',align:'center',color:'#fff',shadow:'#111',maxW:142,minSize:7,ellipsis:false});
      sc.text('강대한 존재가 당신을 바라본다…',80,170,{size:7,align:'center',color:'#d8d8e8'});
      sc.text('A 건너뛰기',80,204,{size:6,align:'center',color:'#8f91a8'});
    }
    void game;
  }
}

// ============================================================
// 탑승 가능한 전설 몬스터 선택
// ============================================================
class MountMenu {
  constructor(game) {
    this.list=(game.state.party||[]).filter(m=>m.hp>0 && MONSTERS[m.id]?.legendary);
    this.cursor=new MenuCursor(Math.max(1,this.list.length));
  }
  update(dt,game) {
    const d=game.input.freshDirection();
    if(d&&this.cursor.move(d)) sfx.blip();
    if(game.input.pressed('b')){sfx.cancel();game.pop();return;}
    if(!game.input.pressed('a')) return;
    if(!this.list.length){sfx.deny();game.push(new Dialogue('파티에 탑승 가능한 전설 몬스터가 없다.'));return;}
    const m=this.list[this.cursor.i];
    sfx.confirm();
    if(game.mountMonster(m,'land')) {
      game.pop(); // 탑승 목록
      game.pop(); // 메인 메뉴
    }
    void dt;
  }
  drawUI(sc,game) {
    sc.box(12,22,136,178);
    sc.text('전설 몬스터 탑승',80,30,{size:10,weight:'700',align:'center',color:COL.accent});
    sc.text('탑승 중 이동 속도가 크게 증가합니다.',80,44,{size:6,align:'center',color:COL.dim});
    if(!this.list.length){
      sc.text('파티에 탑승 가능한 전설 몬스터가 없습니다.',80,92,{size:7,align:'center',color:COL.dim,maxW:112});
    } else {
      this.list.forEach((m,i)=>{
        const y=61+i*28;
        if(this.cursor.i===i){sc.panel(22,y-3,116,24,'#e8e2f4');sc.cursor(17,y+4);}
        const sp=MONSTERS[m.id], img=assets.fieldMonster(sp,'left');
        sc.hqFit(img,26,y-1,22,20,{pad:1});
        sc.text(displayName(m),53,y,{size:8,weight:'700',maxW:76});
        sc.text(`Lv.${m.level} · ${sp.type}`,53,y+11,{size:6,color:COL.dim});
      });
    }
    sc.text('A 타기',35,188,{size:6.5,align:'center',weight:'700',color:COL.dim});
    sc.text('B 뒤로',125,188,{size:6.5,align:'center',weight:'700',color:COL.dim});
    void game;
  }
}

// ============================================================
// 메인 메뉴
// ============================================================
class MainMenu {
  constructor() {
    this.items = ['몬스터', 'BOX', '도감', '증표', '퀘스트', '업적', '가방', '지도', '저장', '설정', '타기', '클라우드', '나가기'];
    this.cursor = new MenuCursor(this.items.length);
  }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    sfx.confirm();
    switch (this.cursor.i) {
      case 0: game.push(new PartyMenu()); break;
      case 1: game.push(new BoxMenu()); break;
      case 2: game.push(new DexMenu()); break;
      case 3: game.push(new BadgeDexMenu()); break;
      case 4: game.push(new QuestMenu()); break;
      case 5: game.push(new AchievementTitleMenu()); break;
      case 6: game.push(new BagMenu()); break;
      case 7: game.push(new WorldMapMenu()); break;
      case 8: game.confirmSave(); break;
      case 9: game.push(new SettingsMenu()); break;
      case 10:
        if (game.isMounted()) {
          if (game.dismount(false,true)) game.pop();
        } else {
          game.push(new MountMenu(game));
        }
        break;
      case 11:
        cloud.open(game);
        break;
      case 12:
        game.push(new Dialogue('현재 진행을 저장하고 게임을 종료하여 시작화면으로 돌아갈까요?', {
          choices:[{label:'취소',value:false},{label:'나가기',value:true}],
          onChoose:(v)=>{ if(v) game.returnToTitle(); },
        }));
        break;
    }
  }
  drawUI(sc, game) {
    const h = 14 + this.items.length * 14;
    sc.box(101, 6, 55, h);
    this.items.forEach((it, i) => {
      const y = 14 + i * 14;
      if (this.cursor.i === i) sc.cursor(107, y + 2);
      const label=(i===10 && game.isMounted()) ? '내리기' : it;
      sc.text(label, 114, y, { size: 9, maxW:38, minSize:6 });
    });
    refreshAchievements(game);
    sc.box(3, 6, 94, 54);
    sc.text(game.world.map.name, 10, 11, { size: 9, weight: '700', maxW: 80 });
    sc.text(`소지금 ${game.state.money.toLocaleString()}원`, 10, 23, { size: 7, color: COL.dim, maxW: 80 });
    sc.text(`칭호 ${activeTitleLabel(game)}`,10,34,{size:6.5,color:'#8a631b',weight:'700',maxW:80,minSize:5});
    if (game.isMounted()) {
      const m=game.mountedMonster();
      sc.text(`탑승 ${displayName(m)}`,10,45,{size:6,color:COL.accent,maxW:80,minSize:5});
    }
  }
}

// ============================================================
// 증표 도감
// ============================================================
class BadgeDexMenu {
  constructor() {
    this.ids = Object.keys(BADGES);
    this.cursor = new MenuCursor(this.ids.length);
  }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); }
    void dt;
  }
  drawUI(sc, game) {
    sc.box(5, 7, 150, 208);
    sc.text('증표 도감', 80, 13, { size: 11, weight:'700', align:'center', color:COL.accent });
    sc.text(`${Object.keys(game.state.badges || {}).length}/${this.ids.length}`, 145, 15, { size:7, align:'right', color:COL.dim });
    const rows=5;
    const start=Math.max(0,Math.min(this.cursor.i-2,Math.max(0,this.ids.length-rows)));
    for(let k=0;k<Math.min(rows,this.ids.length);k++){
      const i=start+k, id=this.ids[i], b=BADGES[id];
      const got=!!game.state.badges?.[id], y=31+k*28;
      sc.panel(12,y,136,23,this.cursor.i===i?'#e8e2f4':'#efece2');
      if(this.cursor.i===i) sc.cursor(6,y+7);
      sc.text(got?'◆':'◇',19,y+5,{size:9,color:got?COL.accent:COL.shade});
      sc.text(got?b.name:'????의 증표',34,y+3,{size:8,weight:got?'700':'400',maxW:108});
      sc.text(got?`${b.town} · 획득 완료`:`${b.town} · 미획득`,34,y+13,{size:6,color:COL.dim,maxW:108});
    }
    if(this.ids.length>rows){
      sc.text(start>0?'▲':'',152,28,{size:7,align:'right',color:COL.dim});
      sc.text(start+rows<this.ids.length?'▼':'',152,166,{size:7,align:'right',color:COL.dim});
    }
    const all=this.ids.every(id=>!!game.state.badges?.[id]);
    const claimed=!!game.state.collectionRewards?.badgeComplete;
    sc.text(all?(claimed?'완성 보상: 마스터캡슐 2개 수령 완료':'완성 보상 지급 대기'):'완성 보상: 마스터캡슐 2개',
      80,181,{size:6,align:'center',color:all?COL.accent:COL.dim,maxW:136});
    sc.text('B 뒤로',80,204,{size:7,align:'center',color:COL.dim});
  }
}

// ============================================================
// 퀘스트 목록
// ============================================================
class QuestMenu {
  constructor() {
    this.ids = Object.keys(QUESTS);
    this.cursor = new MenuCursor(Math.max(1, this.ids.length));
  }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (game.input.pressed('a')) {
      const id = this.ids[this.cursor.i];
      const st = game.state.quests?.[id]?.status || 'none';
      if (st !== 'active') {
        sfx.deny();
        game.toast(st === 'done' ? '이미 완료한 퀘스트입니다.' : '먼저 의뢰인에게 수락하세요.');
        return;
      }
      if (game.state.trackedQuest === id) {
        game.state.trackedQuest = null;
        game.toast('퀘스트 추적 해제');
      } else {
        game.state.trackedQuest = id;
        game.toast(`추적: ${QUESTS[id].name}`);
      }
      sfx.confirm();
    }
    void dt;
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    sc.text('서브 퀘스트', 12, 12, { size:10, weight:'700', color:COL.accent });
    const active = this.ids.filter(id => game.state.quests?.[id]?.status === 'active').length;
    const done = this.ids.filter(id => game.state.quests?.[id]?.status === 'done').length;
    sc.text(`진행 ${active} · 완료 ${done}/${this.ids.length}`, 148, 14, { size:7, align:'right', color:COL.dim });

    const rows = 5;
    const start = Math.max(0, Math.min(this.cursor.i - 2, Math.max(0, this.ids.length - rows)));
    for (let k = 0; k < Math.min(rows, this.ids.length); k++) {
      const i = start + k;
      const id = this.ids[i];
      const q = QUESTS[id];
      const st = game.state.quests?.[id]?.status || 'none';
      const y = 32 + k * 25;
      if (this.cursor.i === i) { sc.panel(9, y - 2, 142, 22, '#e8e2f4'); sc.cursor(4, y + 6); }
      const tracked = game.state.trackedQuest === id && st === 'active';
      const mark = st === 'done' ? '✓' : tracked ? '★' : st === 'active' ? '◆' : '◇';
      const stateText = st === 'done' ? '완료' : tracked ? '추적 중' : st === 'active' ? '진행 중' : '미수락';
      sc.text(mark, 15, y + 3, { size:8, color:st === 'done' ? COL.hp : COL.accent });
      sc.text(q.name, 29, y, { size:8, weight:'700', maxW:116 });
      sc.text(`${q.town} · ${q.giver} · ${stateText}`, 29, y + 11, { size:6, color:COL.dim, maxW:116 });
    }
    if (this.ids.length > rows) {
      sc.text(start > 0 ? '▲' : '', 153, 30, { size:7, align:'right', color:COL.dim });
      sc.text(start + rows < this.ids.length ? '▼' : '', 153, 151, { size:7, align:'right', color:COL.dim });
    }

    const q = QUESTS[this.ids[this.cursor.i]];
    if (q) {
      const st = game.state.quests?.[q.id]?.status || 'none';
      sc.panel(10, 158, 140, 40, '#efece2');
      sc.wrap(q.desc, 130, 6.5).slice(0, 2).forEach((line,i)=>sc.text(line,15,163+i*8,{size:6.5}));
      if (st === 'active') {
        const prog = game.questComplete(q) ? '목표 완료 · 의뢰인에게 돌아가기' : game.questProgressText(q);
        sc.text(prog,15,181,{size:6.5,color:game.questComplete(q)?COL.hp:COL.accent,maxW:130,minSize:5});
      }
    }
    sc.text('A 진행 퀘스트 추적/해제   B 뒤로', 80, 207, { size:6.5, align:'center', color:COL.dim });
  }
}


// ============================================================
// v0.9.0 업적 · 칭호
// ============================================================
class AchievementTitleMenu {
  constructor() {
    this.cursor = new MenuCursor(Math.max(1, ACHIEVEMENTS.length));
    this.synced = false;
  }
  update(dt, game) {
    if (!this.synced) {
      const newly = refreshAchievements(game);
      if (newly.length) game.toast(`새 업적 ${newly.length}개 해금!`);
      this.synced = true;
    }
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const a = ACHIEVEMENTS[this.cursor.i];
    if (!a || !game.state.achievements?.[a.id]) {
      sfx.deny(); game.toast('아직 달성하지 않은 업적입니다.'); return;
    }
    game.state.activeTitle = a.title;
    sfx.confirm();
    game.autoSave(`칭호 '${a.title}' 장착 · 자동 저장`);
  }
  drawUI(sc, game) {
    refreshAchievements(game);
    sc.box(4, 6, 152, 212);
    sc.text('업적 · 칭호', 12, 12, {size:10,weight:'700',color:COL.accent});
    const unlocked = ACHIEVEMENTS.filter((a)=>!!game.state.achievements?.[a.id]).length;
    sc.text(`${unlocked}/${ACHIEVEMENTS.length}`,148,14,{size:7,align:'right',color:COL.dim});
    sc.text(`현재 칭호: ${activeTitleLabel(game)}`,12,26,{size:7,weight:'700',color:'#8a631b',maxW:136,minSize:5});

    const rows = 5;
    const start = Math.max(0, Math.min(this.cursor.i-2, Math.max(0, ACHIEVEMENTS.length-rows)));
    for (let k=0;k<Math.min(rows,ACHIEVEMENTS.length);k++) {
      const i=start+k, a=ACHIEVEMENTS[i];
      const got=!!game.state.achievements?.[a.id];
      const active=got && game.state.activeTitle===a.title;
      const y=43+k*25;
      if (this.cursor.i===i) { sc.panel(9,y-2,142,22,'#e8e2f4'); sc.cursor(4,y+6); }
      sc.text(active?'●':got?'✓':'◇',15,y+3,{size:8,color:active?'#b48a18':got?COL.hp:COL.shade});
      sc.text(a.name,29,y,{size:8,weight:'700',color:got?COL.ink:COL.shade,maxW:112});
      sc.text(got?`칭호 · ${a.title}`:a.progress(game),29,y+11,{size:6,color:got?COL.accent:COL.dim,maxW:112,minSize:5});
    }

    const a=ACHIEVEMENTS[this.cursor.i];
    if (a) {
      sc.panel(10,171,140,28,'#efece2');
      sc.wrap(a.desc,130,6.5).slice(0,2).forEach((line,i)=>sc.text(line,15,176+i*8,{size:6.5}));
      if (!game.state.achievements?.[a.id]) sc.text(a.progress(game),145,190,{size:6,align:'right',color:COL.dim,maxW:125,minSize:5});
    }
    sc.text('A 해금 칭호 장착   B 뒤로',80,207,{size:6.5,align:'center',color:COL.dim});
  }
}

const WORLD_ROUTE = [
  { map:'town', badge:'verdant' }, { map:'route01' }, { map:'forest01' },
  { map:'town02', badge:'moonstone' }, { map:'cave01' }, { map:'route02' },
  { map:'town03', badge:'sunset' }, { map:'route03b' }, { map:'route03c' },
  { map:'town04', badge:'frost' }, { map:'route04b' }, { map:'route04c' },
  { map:'town05', badge:'thunder' }, { map:'route05a' }, { map:'route05b' },
  { map:'town06', badge:'astral' }, { map:'route06a' }, { map:'route06b' },
  { map:'town07', badge:'dawn' }, { map:'route07a' }, { map:'route07b' },
];
const HIDDEN_BY_REGION = ['hidden_grass','hidden_fire','hidden_water','hidden_wind','hidden_thunder',null,null];

// ============================================================
// 월드 지도 — 방문 지역 / 체육관 / 히든 발견 상태
// ============================================================
class WorldMapMenu {
  constructor() { this.cursor = new MenuCursor(WORLD_ROUTE.length); }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); }
    void dt;
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    sc.text('MONSTIA 월드맵', 80, 12, { size:10, weight:'700', align:'center', color:COL.accent });
    const rows = 9;
    const start = Math.max(0, Math.min(this.cursor.i - 4, WORLD_ROUTE.length - rows));
    for (let k=0;k<rows;k++) {
      const idx = start + k; if (idx >= WORLD_ROUTE.length) break;
      const node = WORLD_ROUTE[idx]; const map = MAPS[node.map];
      const seen = !!game.state.discoveredMaps?.[node.map] || game.world.mapId === node.map;
      const current = game.world.mapId === node.map;
      const y = 31 + k * 16;
      if (this.cursor.i === idx) { sc.panel(9, y-2, 142, 16, '#e8e2f4'); sc.cursor(4,y+3); }
      const connector = idx < WORLD_ROUTE.length-1 ? '│' : ' ';
      sc.text(connector, 19, y+10, { size:6, color:COL.shade });
      sc.text(current ? '▶' : seen ? '●' : '○', 14, y, { size:7, color:current ? COL.accent : seen ? COL.hp : COL.shade });
      sc.text(seen ? map.name : '????', 30, y, { size:8, weight:current ? '700':'400', color:seen ? COL.ink : COL.shade, maxW:104 });
      if (node.badge) sc.text(game.state.badges?.[node.badge] ? '◆' : '◇', 145, y, { size:7, align:'right', color:game.state.badges?.[node.badge] ? COL.accent : COL.shade });
    }
    const node = WORLD_ROUTE[this.cursor.i];
    if (node) {
      const region = Math.min(6, Math.floor(this.cursor.i / 3));
      const hidden = HIDDEN_BY_REGION[region];
      const discovered = hidden ? !!game.state.discoveredMaps?.[hidden] : false;
      sc.panel(10, 180, 140, 22, '#efece2');
      sc.text(`선택: ${MAPS[node.map].name}`, 15, 184, { size:7, weight:'700', maxW:130 });
      sc.text(hidden ? `지역 히든: ${discovered ? MAPS[hidden].name : '??? (미발견)'}` : '지역 히든: 없음 · 필드에서 환상 몬스터 출현',
        15, 193, { size:6, color:(hidden&&discovered)?COL.accent:COL.dim, maxW:130 });
    }
    sc.text('● 방문  ▶ 현재  ◆ 체육관 제패', 80, 205, { size:6, align:'center', color:COL.dim });
  }
}

// ============================================================
// 파티 화면 (선택 모드 겸용)
// ============================================================
class PartyMenu {
  constructor(opts = {}) {
    this.cursor = new MenuCursor(1);
    this.mode = opts.mode || 'view';     // view | select
    this.onSelect = opts.onSelect;
    this.title = opts.title || '몬스터';
    this.sub = null;                     // 항목 선택 후 뜨는 작은 메뉴
    this.notice = '';
    this.noticeT = 0;
  }

  subItems(game) {
    const i = this.cursor.i;
    const items = [{ label: '상세보기', key: 'detail' }];
    const m = game.state.party[i];
    items.push({ label: m?.equipment ? '장비변경' : '장비장착', key: 'equip' });
    if (m && (m.moves || []).length > 1) items.push({ label: '기술순서', key: 'moves' });
    if (i !== 0) items.push({ label: '선두로', key: 'lead' });
    if (i > 0) items.push({ label: '위로', key: 'up' });
    if (i < game.state.party.length - 1) items.push({ label: '아래로', key: 'down' });
    if (game.state.party.length > 1) items.push({ label: 'BOX로', key: 'box' });
    if (game.state.party.length > 1) items.push({ label: '놓아주기', key: 'release' });
    items.push({ label: '취소', key: 'cancel' });
    return items;
  }

  swap(game, a, b) {
    const p = game.state.party;
    [p[a], p[b]] = [p[b], p[a]];
    this.cursor.i = b;
    // 선두가 바뀌면 따라다니는 몬스터도 그 자리에서 바로 바뀐다
    game.world.follower.visible = !!p.length;
  }

  update(dt, game) {
    const party = game.state.party;
    this.cursor.set(Math.max(1, party.length));
    if (this.noticeT > 0) this.noticeT -= dt;

    if (this.sub) {
      const items = this.subItems(game);
      this.sub.set(items.length);
      const d = game.input.freshDirection();
      if (d && this.sub.move(d)) sfx.blip();
      if (game.input.pressed('b')) { sfx.cancel(); this.sub = null; return; }
      if (!game.input.pressed('a')) return;
      const key = items[this.sub.i].key;
      const i = this.cursor.i;
      this.sub = null;
      if (key === 'cancel') { sfx.cancel(); return; }
      sfx.confirm();
      if (key === 'detail') { game.push(new MonsterDetail(party[i])); return; }
      if (key === 'equip') { game.push(new EquipmentMenu(party[i])); return; }
      if (key === 'moves') { game.push(new MoveOrderMenu(party[i])); return; }
      if (key === 'release') {
        if (party.length <= 1) {
          sfx.deny(); this.notice = '마지막 파티 몬스터는 놓아줄 수 없다.'; this.noticeT = 2.4; return;
        }
        const target = party[i];
        game.push(new Dialogue(`${displayName(target)}을(를) 정말 놓아줄까요?`, {
          choices: [{ label: '아니오', value: false }, { label: '예', value: true }],
          onChoose: (v) => {
            if (!v) return;
            const idx = game.state.party.findIndex((m) => m.sid === target.sid);
            if (idx < 0 || game.state.party.length <= 1) return;
            const [gone] = game.state.party.splice(idx, 1);
            if (gone?.equipment) {
              game.addItem(gone.equipment, 1);
              gone.equipment = null;
            }
            this.cursor.i = Math.max(0, Math.min(this.cursor.i, game.state.party.length - 1));
            game.world.follower.visible = !!game.state.party.length;
            this.notice = `${displayName(gone)}을(를) 놓아주었다.`;
            this.noticeT = 2.4;
          },
        }));
        return;
      }
      if (key === 'lead') {
        const [m] = party.splice(i, 1);
        party.unshift(m);
        this.cursor.i = 0;
        game.world.follower.visible = !!party.length;
        this.notice = `${displayName(m)}이(가) 선두가 되었다!`;
        this.noticeT = 2.2;
        return;
      }
      if (key === 'box') {
        const box = game.state.box.find((b) => b.length < BOX_SIZE);
        if (!box) { sfx.deny(); this.notice = 'BOX가 가득 찼다!'; this.noticeT = 2.2; return; }
        const [m] = party.splice(i, 1);
        box.push(m);
        this.cursor.i = Math.min(i, party.length - 1);
        game.world.follower.visible = !!party.length;
        this.notice = `${displayName(m)}을(를) BOX에 맡겼다.`;
        this.noticeT = 2.2;
        return;
      }
      if (key === 'up') this.swap(game, i, i - 1);
      if (key === 'down') this.swap(game, i, i + 1);
      return;
    }

    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const m = party[this.cursor.i];
    if (!m) { sfx.deny(); return; }
    sfx.confirm();
    if (this.mode === 'select') { game.pop(); this.onSelect(m); return; }
    this.sub = new MenuCursor(this.subItems(game).length);
  }

  drawUI(sc, game) {
    const party = game.state.party;
    sc.box(3, 6, 154, 212);
    sc.text(this.title, 12, 12, { size: 10, weight: '700', color: COL.accent });
    sc.text(`${party.length}/${PARTY_MAX}`, 148, 13, { size: 8, align: 'right', color: COL.dim });
    if (!party.length) {
      sc.text('아직 몬스터가 없다.', 12, 40, { size: 9 });
      sc.text('연구소에서 파트너를 받자.', 12, 54, { size: 8, color: COL.dim });
      return;
    }
    party.forEach((m, i) => {
      normalizeSp(m);
      const y = 28 + i * 30;
      const sel = this.cursor.i === i;
      sc.panel(10, y, 140, 27, sel ? '#e8e2f4' : '#efece2');
      if (sel) sc.cursor(4, y + 10);
      if (i === 0) sc.panel(10, y, 2, 27, COL.accent);   // 선두 표시
      const sp = MONSTERS[m.id];
      sc.hqFit(assets.battleMonster(sp), 12, y + 2, 20, 22, { ay:1 });
      // v6.7: 이름은 절대 '…'로 자르지 않고 전체 표기. 길면 폰트만 축소한다.
      const pnameFull = displayName(m);
      const partyLv = `Lv.${m.level}`;
      sc.text(pnameFull, 34, y + 3, { size: 9, minSize: 3.0, maxW: 47, ellipsis: false, weight: '700' });
      sc.text(partyLv, 101, y + 4, { size: 6, align: 'right', color: COL.dim, weight: '700' });
      if (i === 0) sc.text('선두', 34, y + 16, { size: 7, color: COL.accent, weight: '700' });
      sc.panel(78, y + 15, 22, 8, TYPE_COLORS[sp.type] || '#888');
      sc.text(sp.type, 89, y + 16, { size: 6, align: 'center', color: '#fff' });
      const r = m.hp / m.maxHp;
      sc.bar(104, y + 6, 40, 5, r, sc.hpColor(r));
      sc.text(`${m.hp}/${m.maxHp}`, 144, y + 14, { size: 7, align: 'right', color: m.hp > 0 ? COL.dim : COL.hpLow });
      sc.bar(104, y + 22, 40, 3, m.exp / m.expToNext, COL.exp);
    });

    if (this.sub) {
      const items = this.subItems(game);
      const h = 10 + items.length * 14;
      const y = Math.min(206 - h, 34 + this.cursor.i * 30);
      sc.box(88, y, 62, h);
      items.forEach((it, i) => {
        const iy = y + 5 + i * 14;
        if (this.sub.i === i) sc.cursor(94, iy + 2);
        sc.text(it.label, 101, iy, { size: 8, maxW:45, minSize:6 });
      });
      return;
    }

    if (this.noticeT > 0) {
      sc.box(3, 190, 154, 24);
      sc.text(this.notice, 80, 197, { size: 8, align: 'center', color: COL.accent, maxW:146, minSize:6 });
      return;
    }
    sc.text(this.mode === 'select' ? 'A 선택   B 뒤로' : 'A 메뉴   B 뒤로',
      80, 206, { size: 7, align: 'center', color: COL.dim });
  }
}


// ============================================================
// v0.9.0 몬스터 장비
// ============================================================
class EquipmentMenu {
  constructor(inst) {
    this.m = inst;
    this.cursor = new MenuCursor(1);
  }
  list(game) {
    const rows = [{ id:null, name:'장비 해제', desc:'현재 장비를 가방으로 돌려보낸다.' }];
    for (const id of EQUIPMENT_IDS) {
      const n = game.countItem(id);
      if (n > 0 || this.m.equipment === id) {
        rows.push({ id, name:ITEMS[id].name, desc:ITEMS[id].desc, n });
      }
    }
    return rows;
  }
  update(dt, game) {
    const list=this.list(game);
    this.cursor.set(Math.max(1,list.length));
    const d=game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const row=list[this.cursor.i];
    if (!row) return;
    if (!row.id) {
      if (!this.m.equipment) { sfx.deny(); game.toast('장착 중인 장비가 없습니다.'); return; }
      sfx.confirm();
      game.unequipItem(this.m);
      this.cursor.i=0;
      return;
    }
    if (this.m.equipment===row.id) {
      sfx.deny(); game.toast('이미 장착 중인 장비입니다.'); return;
    }
    if (game.countItem(row.id)<=0) {
      sfx.deny(); game.toast('가방에 해당 장비가 없습니다.'); return;
    }
    sfx.confirm();
    game.equipItem(this.m,row.id);
  }
  drawUI(sc, game) {
    const list=this.list(game);
    sc.box(5,7,150,208);
    sc.text('몬스터 장비',80,13,{size:10,weight:'700',align:'center',color:COL.accent});
    sc.text(displayName(this.m),12,29,{size:8,weight:'700',maxW:82,minSize:5});
    const current=this.m.equipment ? ITEMS[this.m.equipment]?.name : '없음';
    sc.text(`현재: ${current}`,148,29,{size:6.5,align:'right',color:'#8a631b',maxW:62,minSize:4.5});

    const rows=6;
    const start=Math.max(0,Math.min(this.cursor.i-2,Math.max(0,list.length-rows)));
    for(let k=0;k<Math.min(rows,list.length);k++){
      const i=start+k,row=list[i],y=48+k*22,sel=this.cursor.i===i;
      sc.panel(12,y,136,19,sel?'#e8e2f4':'#efece2');
      if(sel) sc.cursor(6,y+5);
      if(row.id) sc.hqFit(assets.itemIcon(row.id),18,y+2,14,14,{ay:0.5});
      sc.text(row.name,row.id?38:26,y+3,{size:7.5,weight:'700',maxW:78,minSize:5});
      if(row.id) sc.text(this.m.equipment===row.id?'장착 중':`×${game.countItem(row.id)}`,143,y+4,{size:6.5,align:'right',color:this.m.equipment===row.id?COL.accent:COL.dim});
    }
    const row=list[this.cursor.i];
    if(row){
      sc.panel(10,181,140,20,'#efece2');
      sc.wrap(row.desc,130,6.2).slice(0,2).forEach((line,i)=>sc.text(line,15,185+i*7,{size:6.2}));
    }
    sc.text('A 장착/해제   B 뒤로',80,207,{size:6.5,align:'center',color:COL.dim});
  }
}

// ============================================================
// 몬스터 상세
// ============================================================
class MonsterDetail {
  constructor(inst) { this.m = inst; }
  update(dt, game) {
    if (game.input.pressed('b') || game.input.pressed('a')) { sfx.cancel(); game.pop(); }
  }
  drawUI(sc, game) {
    const m = this.m, sp = MONSTERS[m.id];
    if (!m.moves || !m.moves.length) m.moves = movesAtLevel(m.id, m.level);
    const nature = NATURES[m.nature] || NATURES.balanced;
    const talentTotal = Object.values(m.talent || {}).reduce((a,b)=>a+(Number(b)||0),0);
    const stars = '★'.repeat(Math.max(1, Math.min(5, Math.ceil((talentTotal + 1) / 3.4))));
    sc.box(3, 6, 154, 212);
    sc.text(`No.${String(sp.dexNumber).padStart(3, '0')}`, 12, 12, { size:7, color:COL.dim });
    const detailNameFull = displayName(m);
    sc.text(detailNameFull, 12, 21, { size:12, minSize:4, maxW:84, ellipsis:false, weight:'700', color:m.resonant ? '#b48a18' : COL.ink });
    if (m.resonant) sc.text('공명개체', 148, 13, { size:7, align:'right', color:'#b48a18', weight:'700' });
    sc.panel(12, 38, 26, 10, TYPE_COLORS[sp.type] || '#888');
    sc.text(sp.type, 25, 39, { size:7, align:'center', color:'#fff' });
    normalizeSp(m);
    sc.text(`Lv.${m.level}`, 44, 38, { size:9, weight:'700' });
    sc.text(`${sp.stage}단계`, 44, 50, { size:6, color:COL.dim });
    sc.text(`SP ${m.sp}/${m.maxSp}`, 96, 39, { size:5.7, align:'right', color:'#3974b8', weight:'700', maxW:46, minSize:4.5 });
    { const img=assets.battleMonster(sp); sc.hqFit(img,108,12,39,43,{ay:0.5}); }
    const capId = m.capturedWith;
    const capLabel = capId === 'starter' ? '연구소 지급' : (capId && ITEMS[capId] ? ITEMS[capId].name : '기록 없음');
    sc.text('획득', 44, 56, { size:5.5, color:COL.dim });
    if (capId && ITEMS[capId]) {
      sc.hqFit(assets.itemIcon(capId), 59, 53, 10, 10, {ay:0.5});
      sc.text(capLabel, 71, 56, { size:5.5, maxW:25, minSize:4 });
    } else sc.text(capLabel, 59, 56, { size:5.5, maxW:36, minSize:4, color:COL.dim });

    const r = m.hp / m.maxHp;
    sc.text('HP', 14, 62, { size:8, color:COL.dim }); sc.bar(36,63,62,6,r,sc.hpColor(r)); sc.text(`${m.hp}/${m.maxHp}`,146,62,{size:8,align:'right'});
    sc.text('공격',14,76,{size:8,color:COL.dim}); sc.text(String(m.atk),62,76,{size:8,align:'right'});
    sc.text('방어',76,76,{size:8,color:COL.dim}); sc.text(String(m.def),146,76,{size:8,align:'right'});
    sc.text('속도',14,90,{size:8,color:COL.dim}); sc.text(String(m.spd || 0),62,90,{size:8,align:'right'});
    sc.text('성격',76,90,{size:8,color:COL.dim}); sc.text(nature.name,146,90,{size:7,align:'right'});
    sc.text('잠재력',14,103,{size:8,color:COL.dim}); sc.text(stars,62,103,{size:7,align:'right',color:'#b48a18'});
    sc.text('상태',76,103,{size:8,color:COL.dim}); sc.text(m.status ? STATUS_NAMES[m.status] : '정상',146,103,{size:7,align:'right',color:m.status?COL.hpLow:COL.hp});
    const eq = m.equipment ? ITEMS[m.equipment] : null;
    sc.text('장비',14,116,{size:8,color:COL.dim});
    if (eq) {
      sc.hqFit(assets.itemIcon(m.equipment),40,113,10,10,{ay:0.5});
      sc.text(eq.name,54,116,{size:7,weight:'700',color:'#8a631b',maxW:92,minSize:5});
    } else sc.text('없음',46,116,{size:7,color:COL.dim});

    sc.text('EXP',14,129,{size:8,color:COL.dim}); sc.bar(38,130,60,5,m.exp/m.expToNext,COL.exp); sc.text(`${m.exp}/${m.expToNext}`,146,129,{size:7,align:'right',color:COL.dim});
    sc.text('진화',14,141,{size:8,color:COL.dim}); sc.text(sp.evolution ? `Lv.${sp.evolution.level} → ${MONSTERS[sp.evolution.to].name}` : '최종 단계',146,141,{size:7,align:'right',color:sp.evolution?COL.ink:COL.dim,maxW:72,minSize:5});

    sc.text('기술',14,153,{size:8,weight:'700',color:COL.accent}); sc.text(`${m.moves.length}/${MOVE_MAX}`,146,153,{size:7,align:'right',color:COL.dim});
    for (let i=0;i<MOVE_MAX;i++) {
      const y=163+i*11, mid=m.moves[i]; sc.panel(10,y,140,10,'#efece2');
      if (!mid) { sc.text('—',80,y+1,{size:6.5,align:'center',color:COL.shade}); continue; }
      const mv=MOVES[mid]; sc.panel(13,y+1,22,8,TYPE_COLORS[mv.type]||'#888'); sc.text(mv.type,24,y+2,{size:5,align:'center',color:'#fff'});
      sc.text(mv.name,40,y+1,{size:6.5,maxW:68,minSize:4.8}); sc.text(mv.power ? `위력 ${mv.power}` : '보조',146,y+1,{size:5.5,align:'right',color:COL.dim});
    }
    sc.text('A/B 뒤로',80,209,{size:6.5,align:'center',color:COL.dim}); void game;
  }
}

// ============================================================
// 보유 기술 순서 변경 — 이 순서가 전투 기술 메뉴에도 그대로 적용된다.
// ============================================================
class MoveOrderMenu {
  constructor(inst) {
    this.m = inst;
    if (!this.m.moves || !this.m.moves.length) this.m.moves = movesAtLevel(this.m.id, this.m.level);
    this.cursor = new MenuCursor(Math.max(1, this.m.moves.length));
    this.picked = null;
    this.notice = 'A로 기술을 선택한 뒤 교환할 위치를 선택하세요.';
  }
  update(dt, game) {
    this.cursor.set(Math.max(1, this.m.moves.length));
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) {
      if (this.picked !== null) { this.picked = null; this.notice = '첫 선택을 취소했다.'; sfx.cancel(); }
      else { sfx.cancel(); game.pop(); }
      return;
    }
    if (!game.input.pressed('a')) return;
    if (!this.m.moves[this.cursor.i]) { sfx.deny(); return; }
    sfx.confirm();
    if (this.picked === null) {
      this.picked = this.cursor.i;
      this.notice = `${MOVES[this.m.moves[this.picked]].name}: 교환할 위치를 선택하세요.`;
      return;
    }
    const a = this.picked, b = this.cursor.i;
    if (a !== b) {
      [this.m.moves[a], this.m.moves[b]] = [this.m.moves[b], this.m.moves[a]];
      this.notice = '기술 순서를 변경했다!';
    } else {
      this.notice = '같은 위치를 선택해 순서 변경을 취소했다.';
    }
    this.picked = null;
  }
  drawUI(sc, game) {
    const sp = MONSTERS[this.m.id];
    sc.box(5, 7, 150, 208);
    sc.text('기술 순서 변경', 80, 13, { size: 10, weight:'700', align:'center', color:COL.accent });
    sc.text(displayName(this.m), 12, 29, { size:9, weight:'700', maxW:132, minSize:6 });
    sc.text('위에서부터 전투 메뉴 1→4번', 148, 30, { size:6, align:'right', color:COL.dim });
    for (let i = 0; i < MOVE_MAX; i++) {
      const y = 48 + i * 31;
      const mid = this.m.moves[i];
      const sel = this.cursor.i === i && !!mid;
      const picked = this.picked === i;
      sc.panel(12, y, 136, 26, picked ? '#f7e5ae' : (sel ? '#e8e2f4' : '#efece2'));
      if (sel) sc.cursor(6, y + 8);
      sc.text(`${i + 1}`, 18, y + 8, { size:7, color:COL.dim });
      if (!mid) { sc.text('— 비어 있음 —', 80, y + 8, { size:8, align:'center', color:COL.shade }); continue; }
      const mv = MOVES[mid];
      sc.panel(30, y + 8, 24, 9, TYPE_COLORS[mv.type] || '#888');
      sc.text(mv.type, 42, y + 9, { size:6, align:'center', color:'#fff' });
      sc.text(mv.name, 60, y + 5, { size:9, weight: picked ? '700' : '400', maxW:55, minSize:6 });
      sc.text(mv.power ? `위력 ${mv.power}` : '보조', 143, y + 9, { size:7, align:'right', color:COL.dim });
    }
    sc.wrap(this.notice, 136, 7).slice(0, 2).forEach((line, i) =>
      sc.text(line, 80, 180 + i * 10, { size:7, align:'center', color:COL.accent }));
    sc.text(this.picked === null ? 'A 선택   B 뒤로' : 'A 교환   B 선택취소',
      80, 204, { size:7, align:'center', color:COL.dim });
    void sp; void game;
  }
}

// ============================================================
// 기술 교체 (기술칸이 꽉 찼을 때)
// ============================================================
class LearnMoveScene {
  constructor(inst, newMove, onDone) {
    this.m = inst;
    this.newMove = newMove;
    this.onDone = onDone;
    this.cursor = new MenuCursor(MOVE_MAX + 1);
    this.confirm = null;
  }
  finish(game, slot) {
    game.pop();
    if (this.onDone) this.onDone(slot);
  }
  update(dt, game) {
    if (this.confirm !== null) {
      const d = game.input.freshDirection();
      if (d === 'left' || d === 'right') { this.confirm = this.confirm === 0 ? 1 : 0; sfx.blip(); }
      if (game.input.pressed('b')) { sfx.cancel(); this.confirm = null; return; }
      if (game.input.pressed('a')) {
        sfx.confirm();
        const yes = this.confirm === 0;
        const slot = this.pendingSlot;
        this.confirm = null;
        if (yes) this.finish(game, slot);
      }
      return;
    }
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); this.finish(game, null); return; }
    if (!game.input.pressed('a')) return;
    sfx.confirm();
    if (this.cursor.i === MOVE_MAX) { this.finish(game, null); return; }
    this.pendingSlot = this.cursor.i;
    this.confirm = 0;
  }
  drawUI(sc, game) {
    const m = this.m;
    const nm = MOVES[this.newMove];
    sc.box(3, 6, 154, 212);
    sc.text('기술칸이 가득 찼다!', 80, 12, { size: 10, weight: '700', align: 'center', color: COL.accent });
    sc.text('무엇을 잊게 할까?', 80, 26, { size: 8, align: 'center', color: COL.dim });

    // 새로 배우려는 기술
    sc.panel(10, 40, 140, 26, '#fdf3d8');
    sc.text('NEW', 16, 44, { size: 6, weight: '700', color: COL.accent });
    sc.panel(16, 53, 24, 9, TYPE_COLORS[nm.type] || '#888');
    sc.text(nm.type, 28, 54, { size: 6, align: 'center', color: '#fff' });
    sc.text(nm.name, 46, 44, { size: 10, weight: '700', maxW:66, minSize:6 });
    sc.text(nm.power ? `위력 ${nm.power}` : '보조 기술', 146, 54, { size: 8, align: 'right', color: COL.dim });

    for (let i = 0; i < MOVE_MAX; i++) {
      const mid = m.moves[i];
      const mv = MOVES[mid];
      const y = 76 + i * 26;
      const sel = this.cursor.i === i;
      sc.panel(10, y, 140, 23, sel ? '#e8e2f4' : '#efece2');
      if (sel) sc.cursor(4, y + 8);
      sc.panel(16, y + 6, 24, 9, TYPE_COLORS[mv.type] || '#888');
      sc.text(mv.type, 28, y + 7, { size: 6, align: 'center', color: '#fff' });
      sc.text(mv.name, 46, y + 5, { size: 9, maxW:62, minSize:6 });
      sc.text(mv.power ? `위력 ${mv.power}` : '보조', 146, y + 7, { size: 7, align: 'right', color: COL.dim });
      if (nm.power > 0 && mv.power > 0 && mv.power < nm.power) sc.text('↓', 136, y + 7, { size: 7, align:'right', color:COL.hpLow });
    }

    const cy = 76 + MOVE_MAX * 26;
    const selCancel = this.cursor.i === MOVE_MAX;
    sc.panel(10, cy, 140, 18, selCancel ? '#e8e2f4' : '#efece2');
    if (selCancel) sc.cursor(4, cy + 6);
    sc.text(`${nm.name}을(를) 배우지 않는다`, 46, cy + 4, { size: 8, color: COL.dim });

    if (this.confirm !== null) {
      const forget = MOVES[m.moves[this.pendingSlot]];
      sc.box(14, 150, 132, 56);
      sc.wrap(`${forget.name}을(를) 잊고 ${nm.name}을(를) 익힐까요?`, 116, 8)
        .slice(0, 2).forEach((l, i) => sc.text(l, 22, 158 + i * 11, { size: 8 }));
      ['예', '아니오'].forEach((lab, i) => {
        const x = 40 + i * 52;
        if (this.confirm === i) sc.cursor(x - 8, 186);
        sc.text(lab, x, 184, { size: 9 });
      });
    }
    void game;
  }
}

// ============================================================
// BOX — 파티에 못 들어간 몬스터 보관
// ============================================================
class BoxMenu {
  constructor() {
    this.box = 0;
    this.cursor = new MenuCursor(1);
    this.sub = null;
    this.notice = '';
    this.noticeT = 0;
  }
  subItems() {
    return [
      { label:'파티로', key:'party' },
      { label:'상세보기', key:'detail' },
      { label:'기술순서', key:'moves' },
      { label:'놓아주기', key:'release' },
      { label:'취소', key:'cancel' },
    ];
  }
  update(dt, game) {
    if (this.noticeT > 0) this.noticeT -= dt;
    const list = game.state.box[this.box] || [];
    this.cursor.set(Math.max(1, list.length));

    if (this.sub) {
      const items = this.subItems();
      this.sub.set(items.length);
      const d = game.input.freshDirection();
      if (d && this.sub.move(d)) sfx.blip();
      if (game.input.pressed('b')) { sfx.cancel(); this.sub = null; return; }
      if (!game.input.pressed('a')) return;
      const m = list[this.cursor.i];
      if (!m) { this.sub = null; sfx.deny(); return; }
      const key = items[this.sub.i].key;
      this.sub = null;
      if (key === 'cancel') { sfx.cancel(); return; }
      sfx.confirm();
      if (key === 'detail') { game.push(new MonsterDetail(m)); return; }
      if (key === 'moves') {
        if ((m.moves || []).length <= 1) { this.notice='기술이 2개 이상일 때 순서를 바꿀 수 있다.'; this.noticeT=2.2; return; }
        game.push(new MoveOrderMenu(m)); return;
      }
      if (key === 'party') {
        if (game.state.party.length >= PARTY_MAX) {
          sfx.deny(); this.notice = '파티가 가득 찼다. 먼저 한 마리를 맡기자.'; this.noticeT = 2.4; return;
        }
        list.splice(this.cursor.i, 1);
        game.state.party.push(m);
        this.cursor.i = Math.max(0, Math.min(this.cursor.i, list.length - 1));
        game.world.follower.visible = true;
        this.notice = `${displayName(m)}을(를) 파티에 넣었다!`;
        this.noticeT = 2.2;
        return;
      }
      if (key === 'release') {
        const target = m;
        game.push(new Dialogue(`${displayName(target)}을(를) 정말 놓아줄까요? 이 작업은 되돌릴 수 없습니다.`, {
          choices: [{ label:'아니오', value:false }, { label:'예', value:true }],
          onChoose: (v) => {
            if (!v) return;
            const box = game.state.box[this.box] || [];
            const idx = box.findIndex((x) => x.sid === target.sid);
            if (idx < 0) return;
            const [gone] = box.splice(idx, 1);
            this.cursor.i = Math.max(0, Math.min(this.cursor.i, box.length - 1));
            this.notice = `${displayName(gone)}을(를) 놓아주었다.`;
            this.noticeT = 2.4;
          },
        }));
        return;
      }
      return;
    }

    const d = game.input.freshDirection();
    if (d === 'left' || d === 'right') {
      const n = game.state.box.length;
      this.box = (this.box + (d === 'right' ? 1 : n - 1)) % n;
      this.cursor.i = 0; sfx.blip(); return;
    }
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const m = list[this.cursor.i];
    if (!m) { sfx.deny(); return; }
    sfx.confirm();
    this.sub = new MenuCursor(this.subItems().length);
  }
  drawUI(sc, game) {
    const list = game.state.box[this.box] || [];
    sc.box(3, 6, 154, 212);
    sc.text(`BOX ${this.box + 1}`, 12, 12, { size: 10, weight: '700', color: COL.accent });
    sc.text(`${list.length}/${BOX_SIZE}   파티 ${game.state.party.length}/${PARTY_MAX}`,
      148, 14, { size: 7, align: 'right', color: COL.dim });
    if (!list.length) {
      sc.text('이 BOX는 비어 있다.', 12, 40, { size: 9 });
    } else {
      const rows = 9;
      const start = Math.max(0, Math.min(this.cursor.i - 4, Math.max(0, list.length - rows)));
      for (let k = 0; k < Math.min(rows, list.length); k++) {
        const idx = start + k, m = list[idx];
        if (!m) break;
        const y = 30 + k * 19;
        const sel = this.cursor.i === idx;
        sc.panel(10, y, 140, 17, sel ? '#e8e2f4' : '#efece2');
        if (sel) sc.cursor(4, y + 5);
        const sp = MONSTERS[m.id];
        sc.hqFit(assets.battleMonster(sp), 12, y + 1, 18, 15, { ay:1 });
        sc.text(displayName(m), 32, y + 3, { size: 8, maxW:61, minSize:3.5, ellipsis:false });
        sc.text(`Lv.${m.level}`, 96, y + 4, { size: 7, color: COL.dim });
        sc.panel(118, y + 4, 22, 8, TYPE_COLORS[sp.type] || '#888');
        sc.text(sp.type, 129, y + 5, { size: 6, align: 'center', color: '#fff' });
      }
    }

    if (this.sub && list[this.cursor.i]) {
      const items = this.subItems();
      const h = 10 + items.length * 14;
      const y = Math.min(188 - h, 36 + Math.min(7, this.cursor.i) * 18);
      sc.box(88, y, 62, h);
      items.forEach((it, i) => {
        const iy = y + 5 + i * 14;
        if (this.sub.i === i) sc.cursor(94, iy + 2);
        sc.text(it.label, 101, iy, { size:8 });
      });
      return;
    }

    if (this.noticeT > 0) {
      sc.box(3, 186, 154, 22);
      sc.text(this.notice, 80, 192, { size: 8, align: 'center', color: COL.accent });
    }
    sc.text('◀▶ BOX   A 메뉴   B 뒤로', 80, 208, { size: 7, align: 'center', color: COL.dim });
  }
}

// ============================================================
// 도감
// ============================================================
class DexMenu {
  constructor() { this.cursor = new MenuCursor(DEX_ORDER.length); }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (game.input.pressed('a')) {
      const id = DEX_ORDER[this.cursor.i];
      if (id) { sfx.confirm(); game.push(new DexDetail(id)); }
    }
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    const dex = game.state.dex;
    const seen = DEX_ORDER.filter((id) => (dex[id] || 0) >= 1).length;
    const caught = DEX_ORDER.filter((id) => (dex[id] || 0) === 2).length;
    sc.text('몬스터 도감', 12, 12, { size: 10, weight: '700', color: COL.accent });
    sc.text(`발견 ${seen}  포획 ${caught}`, 148, 14, { size: 7, align: 'right', color: COL.dim });

    const rows = 10;
    const start = Math.max(0, Math.min(this.cursor.i - 5, DEX_ORDER.length - rows));
    for (let k = 0; k < rows; k++) {
      const idx = start + k;
      if (idx >= DEX_ORDER.length) break;
      const id = DEX_ORDER[idx];
      const st = dex[id] || 0;
      const sp = MONSTERS[id];
      const y = 30 + k * 16;
      if (this.cursor.i === idx) { sc.panel(9, y - 2, 142, 16, '#e8e2f4'); sc.cursor(4, y + 3); }
      sc.text(String(sp.dexNumber).padStart(3, '0'), 14, y, { size: 8, color: COL.dim });
      sc.text(sp.name, 38, y, {
        size: 8, maxW:82, minSize:4, ellipsis:false,
        color: st === 0 ? COL.dim : COL.ink,
      });
      sc.text(st === 2 ? '포획' : st === 1 ? '발견' : '미발견', 146, y, {
        size: 7, align: 'right',
        color: st === 2 ? COL.hp : st === 1 ? COL.dim : COL.shade,
      });
    }
    const completed = caught === DEX_ORDER.length;
    const claimed = !!game.state.collectionRewards?.dexComplete;
    const next = DEX_MILESTONES.find(m => caught < m.count);
    // 목록과 겹치지 않도록 보상 안내는 하단 왼쪽에 아주 작게 한 줄만 표시한다.
    const rewardLine = completed
      ? (claimed ? '완성 보상 수령완료' : '완성 보상 지급 대기')
      : next ? `다음 보상 ${next.count}종 · ${caught}/${next.count}` : '완성 보상까지 진행 중';
    sc.text(rewardLine, 9, 190, { size:5, align:'left', color:completed ? COL.accent : COL.dim, maxW:140 });
    sc.text('A 상세   B 뒤로', 80, 208, { size: 7, align: 'center', color: COL.dim });
  }
}

class DexDetail {
  constructor(id) { this.id = id; }
  update(dt, game) {
    if (game.input.pressed('b') || game.input.pressed('a')) { sfx.cancel(); game.pop(); }
  }
  drawUI(sc, game) {
    const sp = MONSTERS[this.id];
    const st = game.state.dex[this.id] || 0;
    sc.box(3, 6, 154, 212);
    sc.text(`No.${String(sp.dexNumber).padStart(3, '0')}`, 12, 12, { size: 7, color: COL.dim });
    sc.text(sp.name, 12, 22, { size: 12, weight: '700', maxW:76, minSize:4, ellipsis:false });
    sc.panel(12, 42, 26, 10, TYPE_COLORS[sp.type] || '#888');
    sc.text(sp.type, 25, 43, { size: 7, align: 'center', color: '#fff' });
    { const img=sp.legendary ? assets.fieldMonster(sp,'left') : assets.battleMonster(sp); sc.hqFit(img,91,14,57,48,{ay:0.5}); }
    sc.text(st === 2 ? '포획 완료' : st === 1 ? '발견' : '미발견', 148, 12, {
      size: 7, align: 'right', color: st === 2 ? COL.hp : st === 1 ? COL.dim : COL.shade,
    });

    // 설명/능력치/기술을 212px 패널 안에 고정 배치해 하단 글씨가 잘리지 않게 한다.
    sc.panel(10, 68, 140, 40, '#efece2');
    const lines = sc.wrap(sp.desc, 130, 7).slice(0, 4);
    lines.forEach((l, i) => sc.text(l, 15, 73 + i * 8, { size: 7 }));

    let y = 114;
    const row = (a, b) => {
      sc.text(a, 14, y, { size: 7, color: COL.dim, maxW:70 });
      sc.text(b, 146, y, { size: 7, align: 'right', maxW:76, minSize:5 });
      y += 10;
    };
    row('기본 HP / 공 / 방', `${sp.base.hp} / ${sp.base.atk} / ${sp.base.def}`);
    row('기본 속도', String(baseSpeedFor(sp)));
    row('진화 단계', `${sp.stage}단계`);
    row('진화', sp.evolution ? `Lv.${sp.evolution.level} → ${MONSTERS[sp.evolution.to].name}` : '최종 단계');

    sc.text('배우는 기술', 14, 157, { size: 8, weight: '700', color: COL.accent });
    sp.learnset.slice(0, 4).forEach((e, i) => {
      const mv = MOVES[e.move];
      const yy = 169 + i * 9;
      sc.text(`Lv.${e.level}`, 18, yy, { size: 6.5, color: COL.dim });
      sc.text(mv.name, 48, yy, { size: 6.5, maxW:62, minSize:5 });
      sc.text(mv.power ? `${mv.type} ${mv.power}` : `${mv.type} 보조`, 146, yy, { size: 6.5, align: 'right', color: COL.dim, maxW:54, minSize:5 });
    });
    sc.text('B 뒤로', 80, 207, { size: 7, align: 'center', color: COL.dim });
  }
}

// ============================================================
// 가방
// ============================================================
const BAG_CATEGORIES = ['포획', '회복', '장비', '기타'];

class BagMenu {
  constructor() { this.tab = 0; this.cursor = new MenuCursor(1); this.action = null; }
  list(game) {
    return Object.entries(game.state.bag)
      .filter(([id, n]) => n > 0 && ITEMS[id] && ITEMS[id].category === BAG_CATEGORIES[this.tab])
      .map(([id, n]) => ({ id, n, item: ITEMS[id] }));
  }
  actionItems(entry) {
    return [
      { label:'사용', key:'use' },
      { label:'1개 버리기', key:'drop1' },
      ...(entry?.n > 1 ? [{ label:'전부 버리기', key:'dropAll' }] : []),
      { label:'취소', key:'cancel' },
    ];
  }
  update(dt, game) {
    const list = this.list(game);
    this.cursor.set(Math.max(1, list.length));

    if (this.action) {
      const entry = list[this.cursor.i];
      if (!entry) { this.action = null; return; }
      const actions = this.actionItems(entry);
      this.action.set(actions.length);
      const d = game.input.freshDirection();
      if (d && this.action.move(d)) sfx.blip();
      if (game.input.pressed('b')) { sfx.cancel(); this.action = null; return; }
      if (!game.input.pressed('a')) return;
      const key = actions[this.action.i]?.key;
      if (key === 'cancel') { sfx.cancel(); this.action = null; return; }
      if (key === 'use') { sfx.confirm(); this.action = null; game.useItemInField(entry.id); return; }
      const count = key === 'dropAll' ? entry.n : 1;
      sfx.confirm();
      this.action = null;
      game.push(new Dialogue(`${entry.item.name} ${count}개를 정말 버릴까요?`, {
        choices: [{ label:'아니오', value:false }, { label:'예', value:true }],
        onChoose: (yes) => {
          if (!yes) return;
          const actual = Math.min(count, game.countItem(entry.id));
          if (actual <= 0) return;
          game.removeItem(entry.id, actual);
          game.autoSave(`${entry.item.name} 버림 · 자동 저장`);
          game.toast(`${entry.item.name} ${actual}개를 버렸다.`);
          this.cursor.i = Math.max(0, Math.min(this.cursor.i, this.list(game).length - 1));
        },
      }));
      return;
    }

    const d = game.input.freshDirection();
    if (d === 'left' || d === 'right') {
      this.tab = (this.tab + (d === 'right' ? 1 : BAG_CATEGORIES.length - 1)) % BAG_CATEGORIES.length;
      this.cursor.i = 0; sfx.blip(); return;
    }
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const entry = list[this.cursor.i];
    if (!entry) { sfx.deny(); return; }
    sfx.confirm();
    this.action = new MenuCursor(this.actionItems(entry).length);
    void dt;
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    sc.text('가방', 12, 12, { size: 10, weight: '700', color: COL.accent });
    sc.text(`${game.state.money.toLocaleString()}원`, 148, 14, { size: 8, align: 'right', color: COL.dim, maxW:80, minSize:6 });
    const tabGap=2, tabW=Math.floor((136-tabGap*(BAG_CATEGORIES.length-1))/BAG_CATEGORIES.length);
    BAG_CATEGORIES.forEach((c, i) => {
      const x = 12 + i * (tabW + tabGap);
      sc.panel(x, 28, tabW, 14, i === this.tab ? COL.accent : '#d8d3c6');
      sc.text(c, x + tabW/2, 31, { size: 7, align: 'center', color: i === this.tab ? '#fff' : COL.dim, maxW:tabW-4,minSize:5.5 });
    });
    const list = this.list(game);
    if (!list.length) { sc.text('아무것도 없다.', 14, 54, { size: 9, color: COL.dim }); return; }
    const rows = 7;
    const start = Math.max(0, Math.min(this.cursor.i - 3, list.length - rows));
    for (let k = 0; k < Math.min(rows, list.length); k++) {
      const idx = start + k, e = list[idx];
      if (!e) break;
      const y = 50 + k * 16;
      if (this.cursor.i === idx) { sc.panel(9, y - 2, 142, 16, '#e8e2f4'); sc.cursor(4, y + 3); }
      sc.hqFit(assets.itemIcon(e.id), 13, y - 4, 16, 16, {ay:0.5});
      sc.text(e.item.name, 32, y, { size: 8, maxW:88, minSize:5 });
      sc.text(`×${e.n}`, 146, y, { size: 8, align: 'right', color: COL.dim });
    }
    const sel = list[this.cursor.i];
    if (sel) {
      sc.panel(10, 168, 140, 32, '#efece2');
      sc.wrap(sel.item.desc, 130, 8).slice(0, 3)
        .forEach((l, i) => sc.text(l, 15, 173 + i * 10, { size: 8 }));
    }

    if (this.action && sel) {
      const actions = this.actionItems(sel);
      const h = 10 + actions.length * 14;
      const y = Math.max(48, 202 - h);
      sc.box(82, y, 68, h);
      actions.forEach((it, i) => {
        const yy = y + 5 + i * 14;
        if (this.action.i === i) sc.cursor(88, yy + 2);
        sc.text(it.label, 98, yy, { size:7.5, maxW:46, minSize:5.5, color:it.key.startsWith('drop') ? COL.hpLow : COL.ink });
      });
      return;
    }
    sc.text('◀▶ 분류   A 메뉴   B 뒤로', 80, 206, { size: 7, align: 'center', color: COL.dim });
  }
}

// ============================================================
// 귀환 주문서 — 들렀던 마을 중에서 고른다
// ============================================================
class ReturnScene {
  constructor(itemId) {
    this.itemId = itemId;
    this.cursor = new MenuCursor(1);
    this.confirm = null;
  }
  list(game) {
    const visited = game.state.visited || {};
    return Object.entries(RETURN_POINTS)
      .filter(([id]) => visited[id])
      .map(([id, p]) => ({ id, ...p, here: game.world.mapId === id }));
  }
  update(dt, game) {
    const list = this.list(game);
    this.cursor.set(Math.max(1, list.length));
    if (this.confirm !== null) {
      const d = game.input.freshDirection();
      if (d === 'left' || d === 'right') { this.confirm = this.confirm === 0 ? 1 : 0; sfx.blip(); }
      if (game.input.pressed('b')) { sfx.cancel(); this.confirm = null; return; }
      if (game.input.pressed('a')) {
        const yes = this.confirm === 0;
        this.confirm = null;
        if (!yes) { sfx.cancel(); return; }
        sfx.confirm();
        const target = list[this.cursor.i];
        game.pop();
        game.useReturnScroll(this.itemId, target);
      }
      return;
    }
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    const target = list[this.cursor.i];
    if (!target || target.here) { sfx.deny(); return; }
    sfx.confirm();
    this.confirm = 0;
  }
  drawUI(sc, game) {
    const list = this.list(game);
    sc.box(3, 40, 154, 140);
    sc.text('귀환주문서', 80, 47, { size: 11, weight: '700', align: 'center', color: COL.accent });
    sc.text('어느 마을로 돌아갈까?', 80, 62, { size: 8, align: 'center', color: COL.dim });
    if (!list.length) {
      sc.text('아직 들른 마을이 없다.', 80, 100, { size: 9, align: 'center' });
      sc.text('B 닫기', 80, 168, { size: 7, align: 'center', color: COL.dim });
      return;
    }
    const rows = 4;
    const start = Math.max(0, Math.min(this.cursor.i - 1, Math.max(0, list.length - rows)));
    for (let k = 0; k < Math.min(rows, list.length); k++) {
      const idx = start + k, t = list[idx];
      if (!t) break;
      const y = 78 + k * 24;
      const sel = this.cursor.i === idx;
      sc.panel(12, y, 136, 20, sel ? '#e8e2f4' : '#efece2');
      if (sel) sc.cursor(6, y + 7);
      sc.text(t.name, 22, y + 5, { size: 9, color: t.here ? COL.shade : COL.ink, maxW:90 });
      if (t.here) sc.text('현재 위치', 142, y + 6, { size: 7, align: 'right', color: COL.dim });
    }
    if (list.length > rows) {
      sc.text(start > 0 ? '▲' : '', 146, 76, { size: 8, align: 'right', color: COL.dim });
      sc.text(start + rows < list.length ? '▼' : '', 146, 176, { size: 8, align: 'right', color: COL.dim });
    }
    sc.text(`보유 ${game.countItem(this.itemId)}개`, 148, 47, { size: 7, align: 'right', color: COL.dim });
    sc.text('A 결정   B 닫기', 80, 168, { size: 7, align: 'center', color: COL.dim });
    if (this.confirm !== null) {
      const t = list[this.cursor.i];
      sc.box(14, 120, 132, 52);
      sc.text(`${t.name}(으)로 돌아갈까요?`, 80, 130, { size: 8, align: 'center', maxW:120 });
      ['예', '아니오'].forEach((lab, i) => {
        const x = 44 + i * 48;
        if (this.confirm === i) sc.cursor(x - 8, 152);
        sc.text(lab, x, 150, { size: 9 });
      });
    }
  }
}

// ============================================================
// 상점
// ============================================================
class ShopMenu {
  constructor() {
    this.mode = 'choose'; // choose | buy | sell
    this.cursor = new MenuCursor(3);
    this.qty = null;
    this.sellItems = [];
  }
  sellPrice(item) {
    if (!item || item.unsellable) return 0;
    if (Number(item.sellPrice) > 0) return Math.floor(Number(item.sellPrice));
    if (!item.price || item.price <= 0) return 0;
    return Math.max(1, Math.floor(item.price * (item.sellRate ?? 0.5)));
  }
  refreshSellItems(game) {
    this.sellItems = Object.keys(ITEMS).filter((id) => game.countItem(id) > 0 && this.sellPrice(ITEMS[id]) > 0);
  }
  setMode(mode, game) {
    this.mode = mode;
    this.qty = null;
    if (mode === 'choose') this.cursor = new MenuCursor(3);
    else if (mode === 'buy') this.cursor = new MenuCursor(SHOP_STOCK.length + 1);
    else {
      this.refreshSellItems(game);
      this.cursor = new MenuCursor(this.sellItems.length + 1);
    }
  }
  exit(game) {
    sfx.cancel();
    game.pop();
    game.shopFarewell();
  }
  update(dt, game) {
    if (this.qty) return this.updateQty(game);
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();

    if (this.mode === 'choose') {
      if (game.input.pressed('b')) { this.exit(game); return; }
      if (!game.input.pressed('a')) return;
      if (this.cursor.i === 0) { sfx.confirm(); this.setMode('buy', game); return; }
      if (this.cursor.i === 1) { sfx.confirm(); this.setMode('sell', game); return; }
      this.exit(game); return;
    }

    if (game.input.pressed('b')) { sfx.cancel(); this.setMode('choose', game); return; }
    if (!game.input.pressed('a')) return;

    const list = this.mode === 'buy' ? SHOP_STOCK : this.sellItems;
    if (this.cursor.i === list.length) { sfx.cancel(); this.setMode('choose', game); return; }
    const id = list[this.cursor.i];
    if (!id) { sfx.deny(); return; }
    const selectedItem = ITEMS[id];
    if (this.mode === 'buy' && selectedItem?.upgrade && game.state.upgrades?.[selectedItem.upgrade]) {
      sfx.deny();
      game.push(new Dialogue(`${selectedItem.name}은(는) 이미 활성화되어 있습니다.`));
      return;
    }
    sfx.confirm();
    this.qty = { id, n:1, action:this.mode };
    void dt;
  }
  updateQty(game) {
    const item = ITEMS[this.qty.id];
    const selling = this.qty.action === 'sell';
    const unit = selling ? this.sellPrice(item) : item.price;
    const max = item.upgrade ? 1 : selling
      ? Math.max(1, Math.min(99, game.countItem(this.qty.id)))
      : Math.max(1, Math.min(99, Math.floor(game.state.money / Math.max(1, unit))));
    const d = game.input.freshDirection();
    if (d === 'up') { this.qty.n = Math.min(max, this.qty.n + 1); sfx.blip(); }
    if (d === 'down') { this.qty.n = Math.max(1, this.qty.n - 1); sfx.blip(); }
    if (game.input.pressed('b')) { sfx.cancel(); this.qty = null; return; }
    if (!game.input.pressed('a')) return;

    const n = this.qty.n;
    if (selling) {
      if (game.countItem(this.qty.id) < n || unit <= 0) {
        sfx.deny(); game.push(new Dialogue('판매할 수 없는 아이템입니다.')); this.qty = null; return;
      }
      game.removeItem(this.qty.id, n);
      game.state.money += unit * n;
      sfx.buy();
      this.qty = null;
      this.refreshSellItems(game);
      this.cursor.set(this.sellItems.length + 1);
      game.push(new Dialogue(`${item.name} ${n}개를 ${unit * n}원에 판매했다!`));
      return;
    }

    const cost = unit * n;
    if (cost > game.state.money) {
      sfx.deny(); game.push(new Dialogue('소지금이 부족합니다.')); this.qty = null; return;
    }
    game.state.money -= cost;
    if (item.upgrade) {
      if (!game.state.upgrades) game.state.upgrades = {};
      game.state.upgrades[item.upgrade] = true;
      sfx.buy();
      this.qty = null;
      game.autoSave(`${item.name} 활성화 · 자동 저장`);
      game.push(new Dialogue(`${item.name}을(를) 구입했다!\n이제 가까운 필드 랜덤 아이템을 자동으로 줍는다.`));
      return;
    }
    game.addItem(this.qty.id, n);
    sfx.buy();
    this.qty = null;
    game.push(new Dialogue(`${item.name} ${n}개를 구입했다!  감사합니다!`));
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    sc.text('상점', 12, 12, { size:10, weight:'700', color:COL.accent });
    sc.text(`소지금 ${game.state.money.toLocaleString()}원`, 148, 14, { size:8, align:'right', color:COL.dim, maxW:92 });

    if (this.mode === 'choose') {
      const items = [
        ['구매', '필요한 아이템을 구입한다'],
        ['판매', '소지품을 판매해 돈을 받는다'],
        ['나간다', '상점을 나간다'],
      ];
      items.forEach(([label, desc], i) => {
        const y = 58 + i * 38;
        if (this.cursor.i === i) { sc.panel(18, y - 7, 124, 30, '#e8e2f4'); sc.cursor(12, y + 2); }
        sc.text(label, 32, y, { size:11, weight:'700', color:i===1 ? COL.accent : COL.ink });
        sc.text(desc, 32, y + 13, { size:6, color:COL.dim, maxW:100 });
      });
      sc.text('일반 판매가는 구매가의 50% · 일부 아이템은 전용 판매가 적용', 80, 184, { size:6.2, align:'center', color:COL.dim, maxW:136, minSize:5 });
      sc.text('A 선택   B 나가기', 80, 204, { size:7, align:'center', color:COL.dim });
      return;
    }

    const list = this.mode === 'buy' ? SHOP_STOCK : this.sellItems;
    const total = list.length + 1; // +1 = 뒤로
    const rows = 6;
    const start = Math.max(0, Math.min(this.cursor.i - 3, Math.max(0, total - rows)));
    sc.text(this.mode === 'buy' ? '구매' : '판매', 12, 27, { size:8, weight:'700', color:COL.accent });
    if (this.mode === 'sell' && list.length === 0) sc.text('판매 가능한 소지품이 없습니다.', 80, 82, { size:8, align:'center', color:COL.dim });
    for (let k = 0; k < Math.min(rows, total); k++) {
      const idx = start + k;
      if (idx >= total) break;
      const y = 43 + k * 18;
      const isBack = idx === list.length;
      if (this.cursor.i === idx) { sc.panel(9, y - 2, 142, 18, '#e8e2f4'); sc.cursor(4, y + 4); }
      if (isBack) { sc.text('뒤로', 16, y, { size:9 }); continue; }
      const id = list[idx], it = ITEMS[id];
      sc.hqFit(assets.itemIcon(id), 13, y - 4, 16, 16, {ay:0.5});
      sc.text(it.name, 32, y, { size:8, maxW:76, minSize:5 });
      const price = this.mode === 'buy' ? it.price : this.sellPrice(it);
      sc.text(`${price.toLocaleString()}원`, 146, y, { size:8, align:'right', color:this.mode==='sell' ? COL.accent : COL.dim });
      const ownedText = it.upgrade ? (game.state.upgrades?.[it.upgrade] ? '활성화됨' : '영구권') : `보유 ${game.countItem(id)}`;
      sc.text(ownedText, 146, y + 9, { size:6, align:'right', color:it.upgrade && game.state.upgrades?.[it.upgrade] ? COL.accent : COL.shade });
    }
    if (total > rows) {
      sc.text(start > 0 ? '▲' : '', 154, 41, { size:8, align:'right', color:COL.dim });
      sc.text(start + rows < total ? '▼' : '', 154, 145, { size:8, align:'right', color:COL.dim });
    }

    sc.box(3, 158, 154, 60);
    if (this.qty) {
      const it = ITEMS[this.qty.id];
      sc.hqFit(assets.itemIcon(this.qty.id), 12, 164, 22, 22, {ay:0.5});
      const selling = this.qty.action === 'sell';
      const unit = selling ? this.sellPrice(it) : it.price;
      sc.text(`${it.name}`, 12, 166, { size:9, weight:'700', maxW:134 });
      sc.text(it.upgrade ? '영구 기능 해금' : `▲▼ 개수    ${this.qty.n}개`, 12, 180, { size:9 });
      sc.text(`${selling ? '받는 돈' : '합계'} ${(unit * this.qty.n).toLocaleString()}원`, 146, 194, { size:9, align:'right', color:COL.accent });
      sc.text(`A ${selling ? '판매' : '구입'}   B 취소`, 12, 202, { size:7, color:COL.dim });
    } else {
      const id = list[this.cursor.i];
      if (id) {
        const it = ITEMS[id];
        sc.wrap(it.desc, 138, 8).slice(0, 3).forEach((l, i) => sc.text(l, 11, 167 + i * 11, { size:8 }));
        if (this.mode === 'sell') sc.text(`판매가 ${this.sellPrice(it).toLocaleString()}원`, 146, 201, { size:7, align:'right', color:COL.accent });
      } else sc.text('A 선택   B 이전 메뉴', 80, 184, { size:8, align:'center', color:COL.dim });
    }
  }
}

// ============================================================
// 스타팅 몬스터 선택
// ============================================================
class StarterMenu {
  constructor() { this.cursor = new MenuCursor(STARTER_IDS.length); }
  update(dt, game) {
    const d = game.input.freshDirection();
    if (d && this.cursor.move(d)) sfx.blip();
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    sfx.confirm();
    const id = STARTER_IDS[this.cursor.i];
    const sp = MONSTERS[id];
    game.push(new Dialogue(`${sp.name}(으)로 정하겠습니까?`, {
      choices: [{ label: '예', value: true }, { label: '아니오', value: false }],
      onChoose: (v) => { if (v) { game.pop(); game.giveStarter(id); } },
    }));
  }
  drawUI(sc, game) {
    sc.box(3, 6, 154, 212);
    sc.text('파트너를 골라 주세요', 80, 14, { size: 10, weight: '700', align: 'center', color: COL.accent });
    STARTER_IDS.forEach((id, i) => {
      const sp = MONSTERS[id];
      const y = 32 + i * 56;
      const sel = this.cursor.i === i;
      sc.panel(10, y, 140, 52, sel ? '#e8e2f4' : '#efece2');
      if (sel) sc.cursor(4, y + 22);
      { const img=assets.battleMonster(sp); sc.hqFit(img,12,y+4,43,42,{ay:0.5}); }
      sc.text(sp.name, 62, y + 6, { size: 9.5, weight: '700', maxW:84, minSize:4, ellipsis:false });
      sc.panel(62, y + 19, 26, 9, TYPE_COLORS[sp.type] || '#888');
      sc.text(sp.type, 75, y + 20, { size: 6.3, align: 'center', color: '#fff' });
      // v7.3: 설명은 카드 안쪽 3줄 전용 영역에 고정한다.
      sc.wrap(sp.desc, 82, 5.9).slice(0, 3)
        .forEach((l, k) => sc.text(l, 62, y + 31 + k * 7, { size: 5.9, color: COL.dim, maxW:82, minSize:4.8, ellipsis:false }));
    });
    sc.text('▲▼ 선택   A 결정', 80, 206, { size: 7, align: 'center', color: COL.dim });
    void game;
  }
}

// ============================================================
// 설정
// ============================================================
class SettingsMenu {
  constructor(opts = {}) {
    this.fromTitle = !!opts.fromTitle;
    this.cursor = new MenuCursor(6);
  }
  update(dt, game) {
    const s = game.state.settings;
    const d = game.input.freshDirection();
    if (d === 'up' || d === 'down') { if (this.cursor.move(d)) sfx.blip(); }
    if (d === 'left' || d === 'right') {
      const dir = d === 'right' ? 1 : -1;
      if (this.cursor.i === 0) s.textSpeed = (s.textSpeed + dir + 3) % 3;
      if (this.cursor.i === 1) { s.sound = !s.sound; sfx.on = s.sound; }
      sfx.blip();
    }
    if (game.input.pressed('b')) { sfx.cancel(); game.pop(); return; }
    if (!game.input.pressed('a')) return;
    if (this.cursor.i === 2) { sfx.confirm(); game.exportSaveFile(); return; }
    if (this.cursor.i === 3) { sfx.confirm(); game.importSaveFile(true); return; }
    if (this.cursor.i === 4) {
      sfx.confirm();
      if (!game.hasBackupSave()) { game.push(new Dialogue('복구할 자동 백업 세이브가 없습니다.')); return; }
      game.push(new Dialogue('직전 자동 백업으로 되돌릴까요?\n현재 주 세이브는 백업 시점으로 교체됩니다.', {
        choices: [{ label: '취소', value: false }, { label: '복구', value: true }],
        onChoose: (v) => { if (v) game.restoreBackupSave(); },
      }));
      return;
    }
    if (this.cursor.i === 5) {
      sfx.confirm();
      game.push(new Dialogue('저장 데이터를 정말 삭제할까요?', {
        choices: [{ label: '취소', value: false }, { label: '삭제', value: true }],
        onChoose: (v) => { if (v) game.deleteSave(); },
      }));
    }
  }
  drawUI(sc, game) {
    const s = game.state.settings;
    sc.box(3, 31, 154, 169);
    sc.text('환경 설정 / 저장 관리', 12, 39, { size: 10, weight: '700', color: COL.accent });
    const rows = [
      ['텍스트 속도', ['느림', '보통', '빠름'][s.textSpeed]],
      ['효과음', s.sound ? 'ON' : 'OFF'],
      ['저장 파일 내보내기', 'A'],
      ['저장 파일 불러오기', 'A'],
      ['자동 백업 복구', game.hasBackupSave() ? 'A' : '없음'],
      ['저장 데이터 삭제', 'A'],
    ];
    rows.forEach(([label, value], i) => {
      const y = 58 + i * 21;
      if (this.cursor.i === i) { sc.panel(9, y - 3, 142, 19, '#e8e2f4'); sc.cursor(4, y + 3); }
      sc.text(label, 16, y, { size: 8.5, maxW:90, minSize:5 });
      sc.text(i < 2 ? `◀ ${value} ▶` : (value === '없음' ? '없음' : '▶'), 146, y, { size: 7.5, align: 'right', color: COL.dim });
    });
    sc.text('B 뒤로', 80, 184, { size: 7, align:'center', color:COL.dim });
  }
}

// ============================================================
// 타이틀
// ============================================================
class LoadingScene {
  constructor(game) {
    this.t = 0;
    this.progress = 0;
    this.bg = assets.uiImage('loading_v070');
    this.titleBg = assets.uiImage('title_v070');
    // v7.4: 필드/전투/도감에서 즉시 보이는 몬스터·NPC·아이템을 로딩 화면에서 실제 디코딩까지 끝낸다.
    // 따라서 첫 접근 때 절차적 fallback 이미지가 한 프레임 깜빡이는 현상을 막는다.
    assets.preloadCore();
  }
  update(dt, game) {
    this.t += dt;
    const decoded = assets.coreLoadRatio();
    const visual = Math.min(1, this.t / 2.05);
    this.progress = Math.min(visual, decoded);
    // 모든 핵심 PNG가 준비된 뒤에만 타이틀로 넘어간다. 오류 자산은 onerror가 ready 처리한다.
    if (decoded >= 0.999 && visual >= 1 && this.t > 2.10) {
      this.progress = 1;
      game.mode = 'title';
      game.title = new TitleScene(game);
    }
  }
  drawWorld(sc) {
    const ctx=sc.wctx;
    ctx.fillStyle='#070912'; ctx.fillRect(0,0,160,224);
    drawCoverImage(ctx,assets.uiImage('loading_v070'),0,0,160,224);
    const g=ctx.createLinearGradient(0,145,0,224);
    g.addColorStop(0,'rgba(3,5,15,0)'); g.addColorStop(1,'rgba(3,5,15,0.86)');
    ctx.fillStyle=g; ctx.fillRect(0,130,160,94);
  }
  drawUI(sc) {
    const p=Math.max(0,Math.min(1,this.progress));
    sc.text('MONSTIA',80,169,{size:13,weight:'800',align:'center',color:'#fff7d8',shadow:'#15152a'});
    sc.text('WORLD SYNC',80,184,{size:6.5,weight:'700',align:'center',color:'#dbe7ff',shadow:'#15152a'});
    // loading rail
    sc.fill(19,198,122,8,'rgba(8,12,26,0.90)');
    sc.fill(20,199,120,6,'#253149');
    sc.fill(21,200,Math.max(1,Math.round(118*p)),4,'#55cfff');
    sc.fill(21,200,Math.max(1,Math.round(118*p)),1,'#c5f5ff');
    // 물방울 얼굴이 게이지 진행과 함께 이동한다.
    const s=sc.scale, cx=(21+118*p)*s, cy=202*s, ctx=sc.ctx;
    ctx.save(); ctx.translate(cx,cy);
    ctx.fillStyle='#68d9ff'; ctx.strokeStyle='#e6fbff'; ctx.lineWidth=Math.max(1,s*0.55);
    ctx.beginPath(); ctx.moveTo(0,-6*s); ctx.bezierCurveTo(5*s,-1*s,6*s,2*s,4*s,5*s); ctx.bezierCurveTo(2*s,8*s,-2*s,8*s,-4*s,5*s); ctx.bezierCurveTo(-6*s,2*s,-5*s,-1*s,0,-6*s); ctx.fill(); ctx.stroke();
    ctx.fillStyle='#10213a'; ctx.beginPath(); ctx.arc(-1.7*s,1*s,0.65*s,0,Math.PI*2); ctx.arc(1.7*s,1*s,0.65*s,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#10213a'; ctx.lineWidth=Math.max(1,s*0.38); ctx.beginPath(); ctx.arc(0,2.7*s,1.5*s,0.15,Math.PI-0.15); ctx.stroke(); ctx.restore();
    sc.text(`${Math.round(p*100)}%`,80,211,{size:6.5,align:'center',color:'#eaf7ff',shadow:'#10131f'});
  }
}

class BackupLoadScene {
  constructor() { this.t=0; this.done=false; }
  update(dt, game) {
    this.t += dt;
    if (!this.done && this.t > 1.15) {
      this.done=true;
      const ok=save.restoreBackup();
      if (ok) { game.overlays.length=0; game.continueGame(); }
      else { game.pop(); game.say('이전 백업 데이터를 불러오지 못했습니다.'); }
    }
  }
  drawUI(sc) {
    sc.fill(0,0,160,224,'rgba(5,8,18,0.70)');
    sc.box(20,83,120,59,{paper:'#f5f1e6'});
    sc.text('이전 데이터 불러오는 중...',80,96,{size:8.5,weight:'700',align:'center'});
    const p=Math.min(1,this.t/1.15);
    sc.bar(31,118,98,7,p,'#55bfe8');
    sc.text('백업 세이브 검증 및 복구',80,131,{size:6,align:'center',color:COL.dim});
  }
}

