/* ===== js/gfx/painter.js ===== */
// painter.js — 절차적 픽셀아트 생성기
// ------------------------------------------------------------
// PNG 에셋이 없을 때 쓰이는 "기본 그래픽"을 코드로 그린다.
// assets/ 폴더에 같은 이름의 PNG를 넣으면 AssetManager 가
// 자동으로 이쪽 결과를 버리고 PNG 를 쓴다.
// ============================================================



const TILE = 16;

function makeCanvas(w, h) {
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  return c;
}

// 문자 그리드를 기존 컨텍스트에 겹쳐 그린다
function paintGridInto(ctx, grid, palette, scale = 1) {
  for (let y = 0; y < grid.length; y++) {
    const row = grid[y];
    for (let x = 0; x < row.length; x++) {
      const ch = row[x];
      if (ch === '.' || ch === undefined) continue;
      const col = palette[ch];
      if (!col) continue;
      ctx.fillStyle = col;
      ctx.fillRect(x * scale, y * scale, scale, scale);
    }
  }
}

// 문자 그리드 -> 캔버스
function gridToCanvas(grid, palette, scale = 1) {
  const h = grid.length, w = grid[0].length;
  const c = makeCanvas(w * scale, h * scale);
  paintGridInto(c.getContext('2d'), grid, palette, scale);
  return c;
}

// 위치 기반 결정적 난수 (같은 칸은 항상 같은 무늬)
function hash2(x, y) {
  let h = x * 374761393 + y * 668265263;
  h = (h ^ (h >> 13)) * 1274126177;
  return ((h ^ (h >> 16)) >>> 0) / 4294967296;
}

function px(ctx, x, y, w, h, color) {
  ctx.fillStyle = color;
  ctx.fillRect(x, y, w, h);
}

// ------------------------------------------------------------
// 타일
// ------------------------------------------------------------
const GRASS_BASE = '#79c159';
const GRASS_DARK = '#5aa645';
const GRASS_LIGHT = '#94d46f';

function paintGrass(ctx, v) {
  px(ctx, 0, 0, 16, 16, GRASS_BASE);
  const tufts = [[2, 3], [9, 6], [5, 11], [12, 13], [7, 1], [1, 9], [13, 4], [10, 10]];
  for (let i = 0; i < tufts.length; i++) {
    if ((i + v) % 3 === 0) continue;
    const [x, y] = tufts[i];
    px(ctx, x, y, 2, 1, GRASS_DARK);
    px(ctx, x + 1, y - 1, 1, 1, GRASS_LIGHT);
  }
}

const TILE_PAINTERS = {
  grass: paintGrass,

  flower(ctx, v) {
    paintGrass(ctx, v);
    const cols = ['#f06a8a', '#f8e05a', '#e8f0f8', '#c07ae8'];
    const spots = [[3, 4], [10, 3], [6, 10], [12, 11]];
    for (let i = 0; i < spots.length; i++) {
      const [x, y] = spots[i];
      const c = cols[(i + v) % cols.length];
      px(ctx, x, y - 1, 1, 1, c);
      px(ctx, x - 1, y, 3, 1, c);
      px(ctx, x, y + 1, 1, 1, c);
      px(ctx, x, y, 1, 1, '#f8f0b0');
    }
  },

  tallgrass(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#4e9840');
    px(ctx, 0, 12, 16, 4, '#3f7f36');
    for (let i = 0; i < 8; i++) {
      const x = ((i * 3 + v * 2) % 15);
      const hgt = 5 + ((i + v) % 4);
      px(ctx, x, 16 - hgt - 2, 1, hgt, '#66b854');
      px(ctx, x + 1, 16 - hgt, 1, hgt - 1, '#8ad46c');
    }
    px(ctx, 0, 0, 16, 1, '#3f7f36');
  },

  path(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#dcc492');
    px(ctx, 0, 0, 16, 1, '#e8d4a8');
    const spots = [[3, 5], [11, 2], [7, 9], [13, 12], [2, 13]];
    for (let i = 0; i < spots.length; i++) {
      if ((i + v) % 2 === 0) continue;
      px(ctx, spots[i][0], spots[i][1], 2, 1, '#c8ac78');
    }
  },

  sand(ctx) { px(ctx, 0, 0, 16, 16, '#e8d8a8'); px(ctx, 4, 6, 3, 1, '#d8c48c'); },

  bridge(ctx) {
    px(ctx, 0, 0, 16, 16, '#b8874c');
    for (let y = 0; y < 16; y += 4) px(ctx, 0, y, 16, 1, '#8f6634');
    px(ctx, 0, 0, 1, 16, '#8f6634');
    px(ctx, 15, 0, 1, 16, '#8f6634');
  },

  tree(ctx, v) {
    paintGrass(ctx, v);
    px(ctx, 6, 11, 4, 5, '#7a5330');
    px(ctx, 6, 11, 1, 5, '#5c3d22');
    px(ctx, 2, 1, 12, 11, '#2f7a3a');
    px(ctx, 1, 3, 14, 7, '#2f7a3a');
    px(ctx, 3, 0, 10, 2, '#3d9048');
    px(ctx, 3, 2, 8, 5, '#49a352');
    px(ctx, 5, 3, 4, 2, '#62bd68');
    px(ctx, 2, 9, 12, 3, '#256330');
    px(ctx, 1, 6, 1, 3, '#256330');
    px(ctx, 14, 6, 1, 3, '#256330');
  },

  water(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#3f7fd0');
    px(ctx, 0, 0, 16, 3, '#4d8ede');
    const rows = [[2, 3], [9, 8], [5, 12], [11, 5]];
    for (let i = 0; i < rows.length; i++) {
      const [x, y] = rows[i];
      const off = (v * 3) % 6;
      px(ctx, (x + off) % 12, y, 4, 1, '#79b4ef');
      px(ctx, (x + off) % 12 + 1, y + 1, 2, 1, '#a4d2f7');
    }
  },

  rock(ctx, v) {
    paintGrass(ctx, v);
    px(ctx, 3, 6, 10, 8, '#8d8677');
    px(ctx, 2, 8, 12, 5, '#8d8677');
    px(ctx, 4, 4, 8, 3, '#a8a08e');
    px(ctx, 5, 5, 5, 2, '#c0b8a2');
    px(ctx, 3, 12, 10, 2, '#6b6558');
    px(ctx, 2, 13, 12, 1, '#585245');
  },

  fence(ctx, v) {
    paintGrass(ctx, v);
    px(ctx, 2, 4, 2, 11, '#a07845');
    px(ctx, 11, 4, 2, 11, '#a07845');
    px(ctx, 0, 6, 16, 2, '#b98c52');
    px(ctx, 0, 11, 16, 2, '#b98c52');
    px(ctx, 0, 7, 16, 1, '#8a6338');
  },

  wood(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#c39257');
    for (let y = 0; y < 16; y += 5) px(ctx, 0, y, 16, 1, '#a3773f');
    px(ctx, (v * 5) % 12, 2, 5, 1, '#d0a469');
  },

  floor(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#e2e7f0');
    px(ctx, 0, 0, 16, 1, '#c3cade');
    px(ctx, 0, 0, 1, 16, '#c3cade');
    if (v % 2 === 0) px(ctx, 4, 4, 8, 8, '#ecf0f6');
  },

  carpet(ctx) {
    px(ctx, 0, 0, 16, 16, '#c8546a');
    px(ctx, 0, 0, 16, 2, '#e0788c');
    px(ctx, 0, 14, 16, 2, '#a13c50');
  },

  wall(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#7d6f93');
    px(ctx, 0, 0, 16, 8, '#8e7fa6');
    for (let y = 0; y < 16; y += 4) {
      px(ctx, 0, y, 16, 1, '#6a5d80');
      const off = ((y / 4 + v) % 2) * 8;
      px(ctx, off, y, 1, 4, '#6a5d80');
      px(ctx, (off + 8) % 16, y, 1, 4, '#6a5d80');
    }
    px(ctx, 0, 12, 16, 1, '#5a4f6e');
  },

  doormat(ctx) {
    px(ctx, 0, 0, 16, 16, '#e2e7f0');
    px(ctx, 2, 4, 12, 9, '#8f5f3a');
    px(ctx, 3, 5, 10, 7, '#a87447');
    px(ctx, 4, 8, 8, 1, '#c08c58');
  },

  gymfloor(ctx, v) {
    // 체육관 전용 고무/석재 바닥. 병원식 흰 바닥과 확실히 구분한다.
    px(ctx, 0, 0, 16, 16, '#343746');
    px(ctx, 0, 0, 16, 2, '#45495a');
    px(ctx, 0, 14, 16, 2, '#292c38');
    px(ctx, 0, 0, 1, 16, '#292c38');
    if (v % 2 === 0) { px(ctx, 4, 5, 2, 1, '#555a6e'); px(ctx, 11, 10, 2, 1, '#555a6e'); }
  },

  arena(ctx, v) {
    // 배틀 매트: 중앙 링/훈련장처럼 읽히도록 굵은 테두리와 라인을 넣는다.
    px(ctx, 0, 0, 16, 16, '#b84e45');
    px(ctx, 0, 0, 16, 2, '#e6bd65');
    px(ctx, 0, 14, 16, 2, '#7c302c');
    px(ctx, 0, 0, 2, 16, '#e6bd65');
    px(ctx, 14, 0, 2, 16, '#7c302c');
    px(ctx, 7, 0, 2, 16, '#f0d790');
    if (v % 2 === 0) { px(ctx, 3, 7, 3, 2, '#d86858'); px(ctx, 10, 7, 3, 2, '#d86858'); }
  },

  cavefloor(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#5a4f45');
    px(ctx, 0, 0, 16, 1, '#6b5f52');
    const spots = [[3, 5], [11, 3], [7, 10], [13, 12], [2, 13]];
    for (let i = 0; i < spots.length; i++) {
      if ((i + v) % 2 === 0) continue;
      px(ctx, spots[i][0], spots[i][1], 2, 1, '#483f37');
      px(ctx, spots[i][0], spots[i][1] - 1, 1, 1, '#7a6d5e');
    }
  },

  caverock(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#3a332c');
    px(ctx, 1, 1, 14, 12, '#4d443a');
    px(ctx, 2, 2, 12, 5, '#5f5548');
    px(ctx, 3, 3, 8, 2, '#726557');
    px(ctx, 0, 13, 16, 3, '#2b251f');
    px(ctx, (v * 5) % 10 + 2, 8, 3, 1, '#2b251f');
  },

  snow(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#eef3fb');
    px(ctx, 0, 0, 16, 2, '#ffffff');
    const spots = [[3, 5], [11, 3], [7, 10], [13, 12], [2, 13]];
    for (let i = 0; i < spots.length; i++) {
      if ((i + v) % 2 === 0) continue;
      px(ctx, spots[i][0], spots[i][1], 2, 1, '#cfdcee');
    }
  },

  rockground(ctx, v) {
    
    px(ctx, 0, 0, 16, 16, '#8a8172');
    px(ctx, 0, 0, 16, 2, '#9b917f');
    const cracks = [[3, 5], [10, 4], [6, 11], [12, 9], [2, 13]];
    for (let i = 0; i < cracks.length; i++) {
      if ((i + v) % 3 === 0) continue;
      px(ctx, cracks[i][0], cracks[i][1], 3, 1, '#6f6759');
      px(ctx, cracks[i][0] + 1, cracks[i][1] - 1, 1, 1, '#a9a08c');
    }
  },

  snowground(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#e9eff8');
    px(ctx, 0, 0, 16, 2, '#ffffff');
    px(ctx, 0, 14, 16, 2, '#d3ddec');
    const spots = [[4, 6], [11, 4], [7, 11], [13, 9]];
    for (let i = 0; i < spots.length; i++) {
      if ((i + v) % 2 === 0) continue;
      px(ctx, spots[i][0], spots[i][1], 2, 1, '#c9d6e8');
    }
  },

  // 전설 성역 전용 타일. PNG가 없어도 각 성역이 완전히 다른 분위기로 보이게 한다.
  verdantstone(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#4e7446');
    px(ctx, 0, 0, 16, 1, '#72935e');
    px(ctx, 0, 15, 16, 1, '#315532');
    const cracks = [[2,4],[9,3],[5,10],[12,12]];
    for (let i=0;i<cracks.length;i++) {
      const [x,y]=cracks[i];
      px(ctx,x,y,3,1,'#365d37');
      if ((i+v)%2===0) px(ctx,x+1,y-1,1,1,'#8fbd6d');
    }
    px(ctx, 3 + (v*4)%8, 7, 2, 2, '#6f9f51');
  },

  magmafloor(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#4c332b');
    px(ctx, 0, 0, 16, 2, '#654238');
    const cracks = [[2,5],[8,3],[5,11],[12,9]];
    for (let i=0;i<cracks.length;i++) {
      const [x,y]=cracks[i];
      px(ctx,x,y,4,1,'#2d2321');
      if ((i+v)%2===0) px(ctx,x+1,y,2,1,'#d85a25');
    }
  },

  lava(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#a62e17');
    px(ctx, 0, 2, 16, 3, '#d94c1f');
    px(ctx, 0, 9, 16, 3, '#e86a27');
    const off=(v*3)%9;
    px(ctx, off, 6, 7, 1, '#ffb13f');
    px(ctx, (off+5)%12, 13, 4, 1, '#ffdf6a');
  },

  tidalstone(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#5d8f9a');
    px(ctx, 0, 0, 16, 2, '#80b4bd');
    px(ctx, 0, 14, 16, 2, '#3d6975');
    px(ctx, 2, 5, 5, 1, '#9fd4d7');
    px(ctx, 9, 10, 4, 1, '#9fd4d7');
    if (v%2===0) { px(ctx, 5, 7, 2, 2, '#4b7f88'); px(ctx, 11, 3, 2, 2, '#6aa3ad'); }
  },

  icecrystal(ctx, v) {
    px(ctx, 0, 0, 16, 16, '#b8d4e8');
    px(ctx, 0, 0, 16, 2, '#e9f7ff');
    px(ctx, 0, 14, 16, 2, '#8eafc8');
    px(ctx, 3, 5, 7, 1, '#dff3ff');
    px(ctx, 9, 10, 5, 1, '#7ea4c3');
    if (v%2===0) { px(ctx, 5, 3, 1, 4, '#ffffff'); px(ctx, 11, 7, 1, 3, '#dff3ff'); }
  },

  copperstone(ctx, v) {
    px(ctx,0,0,16,16,'#536074'); px(ctx,0,0,16,2,'#657389'); px(ctx,0,14,16,2,'#3d485b');
    px(ctx,2,5,5,1,'#9b7441'); px(ctx,6,5,1,4,'#9b7441'); px(ctx,6,8,5,1,'#9b7441');
    if (v%2===0) { px(ctx,11,3,2,2,'#e5c74c'); px(ctx,3,11,1,1,'#e5c74c'); }
  },
  voltgrass(ctx, v) {
    px(ctx,0,0,16,16,'#425f56'); px(ctx,0,14,16,2,'#30463f');
    const tufts=[[3,10],[8,6],[12,11],[5,3]];
    for (let i=0;i<tufts.length;i++) { const [x,y]=tufts[i]; px(ctx,x,y,1,4,'#6f9a68'); px(ctx,x+1,y+1,1,3,'#83b376'); }
    if (v%2===0) { px(ctx,9,4,3,1,'#f1d64c'); px(ctx,10,3,1,3,'#fff18a'); }
  },
  stormglass(ctx, v) {
    px(ctx,0,0,16,16,'#2d3155'); px(ctx,0,0,16,2,'#444b7a'); px(ctx,0,14,16,2,'#1d203e');
    px(ctx,2,7,4,1,'#6ee4ef'); px(ctx,5,5,1,3,'#6ee4ef'); px(ctx,5,5,5,1,'#f1d94f');
    px(ctx,9,5,1,4,'#f1d94f'); px(ctx,9,8,4,1,'#6ee4ef');
    if (v%2===0) { px(ctx,3,3,2,1,'#fff7a0'); px(ctx,12,11,1,2,'#fff7a0'); }
  },

  void(ctx) { px(ctx, 0, 0, 16, 16, '#101018'); },
};

const THEME_TINT = {
  grass: null,
  rock:   { tint:'#7d746b', alpha:0.24, accent:'#9d68d6' },
  harbor: { tint:'#598aa0', alpha:0.16, accent:'#e2c27f' },
  snow:   { tint:'#dcecff', alpha:0.34, accent:'#ffffff' },
  thunder:{ tint:'#304f59', alpha:0.24, accent:'#f1d74e' },
  astral: { tint:'#6650a4', alpha:0.24, accent:'#79e6ff' },
  aurora: { tint:'#7aa9cf', alpha:0.18, accent:'#ffd86a' },
};

function paintTile(key, variant, theme = 'grass') {
  const c = makeCanvas(TILE, TILE);
  const ctx = c.getContext('2d');
  const fn = TILE_PAINTERS[key] || TILE_PAINTERS.grass;
  fn(ctx, variant);
  const t = THEME_TINT[theme];
  if (t) {
    ctx.save();
    ctx.globalCompositeOperation = 'source-atop';
    ctx.globalAlpha = t.alpha;
    ctx.fillStyle = t.tint;
    ctx.fillRect(0,0,TILE,TILE);
    ctx.restore();
    // 지역별 상징 픽셀을 더해 같은 타일도 확실히 다른 지역처럼 보이게 한다.
    if (theme === 'rock' && ['grass','rockground','rock','path','cavefloor'].includes(key)) {
      // 회갈색 석재 + 월석 수정 조각
      px(ctx, 12, 2 + (variant%2)*7, 2, 3, '#8c62c8'); px(ctx,13,1 + (variant%2)*7,1,1,'#e5d6ff');
      px(ctx, 3 + (variant%3)*3, 12, 4, 1, '#5f5a58'); px(ctx, 5 + (variant%2)*4, 13, 1, 2, '#a89e92');
    } else if (theme === 'harbor' && ['path','sand','grass'].includes(key)) {
      // 젖은 항구 돌길 / 밧줄색 포인트
      px(ctx, 1, 14, 6, 1, '#b69a68'); px(ctx, 10, 4 + (variant%3)*2, 4, 1, '#efe0b5');
      px(ctx, 2 + (variant%3)*4, 2, 2, 1, '#8bb6c8');
    } else if (theme === 'snow' && !['water','lava','magmafloor'].includes(key)) {
      px(ctx,0,0,16,2,'rgba(255,255,255,0.86)');
      if (key === 'tree' || key === 'rock') { px(ctx,3,1,9,2,'#f7fbff'); px(ctx,5,3,5,1,'#e6f1fb'); }
      if (['grass','path','snow','snowground'].includes(key)) { px(ctx,3+(variant%3)*4,5+(variant%2)*6,1,1,'#ffffff'); px(ctx,11,11-(variant%2)*4,1,1,'#cfe9ff'); }
    } else if (theme === 'thunder' && ['grass','voltgrass','path','rockground','stormglass'].includes(key)) {
      // 청록 회로선 + 금빛 방전 조각
      px(ctx, 11, 3, 3, 1, '#f1d74e'); px(ctx, 12, 2, 1, 2, '#fff39a');
      px(ctx, 3, 11, 1, 3, '#65e8ef'); px(ctx, 4, 10, 4, 1, '#65e8ef');
      if (variant % 2 === 0) { px(ctx,7,9,1,2,'#65e8ef'); px(ctx,8,8,3,1,'#65e8ef'); }
    } else if (theme === 'astral' && ['grass','stormglass','path','rockground'].includes(key)) {
      px(ctx, 3+(variant%3)*4, 4+(variant%2)*6, 1, 1, '#d8c8ff');
      px(ctx, 11, 3+(variant%3)*3, 1, 2, '#79e6ff');
      if(variant%2===0){ px(ctx,10,4+(variant%3)*3,3,1,'#79e6ff'); }
    } else if (theme === 'aurora' && ['grass','icecrystal','path','snowground'].includes(key)) {
      px(ctx,2+(variant%4)*3,5+(variant%2)*6,1,1,'#fff1a6');
      px(ctx,12,2+(variant%3)*3,1,2,'#a8f3ff');
      if(variant%2===1){ px(ctx,10,3+(variant%3)*3,4,1,'#ffd86a'); }
    } else if (theme === 'grass' && ['grass','path','flower'].includes(key)) {
      // 태초 지역은 작은 야생화와 잎 점으로 생동감 추가
      if (variant % 3 === 0) { px(ctx,12,3,1,1,'#f6e78d'); px(ctx,11,4,1,1,'#ffffff'); }
      px(ctx,2+(variant%4)*3,13,2,1,'#4f963f');
    }
  }
  return c;
}

// ------------------------------------------------------------
// 건물 (타일 단위 크기 + 위로 8px 여유)
// ------------------------------------------------------------
const BUILDING_STYLES = {
  house:  { roof: '#c0453c', roofDark: '#8f2e28', wall: '#f0e0c0', wallDark: '#cdb894', sign: null },
  lab:    { roof: '#5f6272', roofDark: '#43465a', wall: '#c9ccd8', wallDark: '#a3a7b8', sign: 'LAB' },
  center: { roof: '#e05a3c', roofDark: '#ab3d26', wall: '#f2f4f8', wallDark: '#ccd2dd', sign: '＋' },
  shop:   { roof: '#3f76c0', roofDark: '#2b5490', wall: '#dfe6f2', wallDark: '#b8c3d6', sign: 'SHOP' },
  gym:    { roof: '#d1a63b', roofDark: '#8d6a22', wall: '#eee5cf', wallDark: '#b8aa8a', sign: 'GYM' },
};

function lightHex(hex, amount = 0.2) {
  const m = /^#([0-9a-f]{6})$/i.exec(hex || '');
  if (!m) return '#ffffff';
  const n = parseInt(m[1],16);
  const r=(n>>16)&255,g=(n>>8)&255,b=n&255;
  const f=(v)=>Math.max(0,Math.min(255,Math.round(v+(255-v)*amount)));
  return `rgb(${f(r)},${f(g)},${f(b)})`;
}

function addCanvasOutline(canvas, color = '#202331') {
  try {
    const ctx = canvas.getContext('2d');
    const im = ctx.getImageData(0,0,canvas.width,canvas.height);
    const src = new Uint8ClampedArray(im.data);
    const out = im.data, W=canvas.width, H=canvas.height;
    const rgb = /^#([0-9a-f]{6})$/i.exec(color);
    const rr = rgb ? parseInt(rgb[1].slice(0,2),16) : 32;
    const gg = rgb ? parseInt(rgb[1].slice(2,4),16) : 35;
    const bb = rgb ? parseInt(rgb[1].slice(4,6),16) : 49;
    for (let y=0;y<H;y++) for (let x=0;x<W;x++) {
      const i=(y*W+x)*4; if (src[i+3] > 18) continue;
      let near=false;
      for (let oy=-1;oy<=1 && !near;oy++) for(let ox=-1;ox<=1;ox++) {
        if (!ox && !oy) continue; const xx=x+ox, yy=y+oy;
        if (xx<0||yy<0||xx>=W||yy>=H) continue;
        if (src[(yy*W+xx)*4+3] > 96) { near=true; break; }
      }
      if (near) { out[i]=rr; out[i+1]=gg; out[i+2]=bb; out[i+3]=255; }
    }
    ctx.putImageData(im,0,0);
  } catch {}
  return canvas;
}

function paintBuilding(style, wTiles, hTiles, doorCol, theme = 'grass') {
  const base = BUILDING_STYLES[style] || BUILDING_STYLES.house;
  const themeMods = {
    grass:   {roof:null, wall:null, accent:'#72ad4c'},
    rock:    {roof:'#54576a', wall:'#d0c3a8', accent:'#9d68d6'},
    harbor:  {roof:'#315f93', wall:'#e7dcc6', accent:'#5aa5cc'},
    snow:    {roof:'#8ca8cf', wall:'#edf4fb', accent:'#79c9ee'},
    thunder: {roof:'#39465e', wall:'#c9c6b4', accent:'#f1d74e'},
    astral:  {roof:'#43335f', wall:'#d9d2e6', accent:'#79e6ff'},
    aurora:  {roof:'#6b88aa', wall:'#f0ead9', accent:'#ffd86a'},
  }[theme] || {};
  const s = { ...base, roof: themeMods.roof || base.roof, wall: themeMods.wall || base.wall };
  const W = wTiles * TILE, H = hTiles * TILE;
  const c = makeCanvas(W, H);
  const ctx = c.getContext('2d');
  const roofH = Math.floor(H * 0.42);

  // 벽
  px(ctx, 0, roofH, W, H - roofH, s.wall);
  px(ctx, 0, H - 4, W, 4, s.wallDark);
  px(ctx, 0, roofH, 2, H - roofH, s.wallDark);
  px(ctx, W - 2, roofH, 2, H - roofH, s.wallDark);

  // 지붕
  px(ctx, 0, roofH - 4, W, 4, s.roofDark);
  for (let y = 0; y < roofH - 4; y++) {
    const inset = Math.floor((roofH - 4 - y) * (W * 0.18) / (roofH - 4));
    px(ctx, inset, y, W - inset * 2, 1, y < 3 ? s.roofDark : s.roof);
  }
  // v7.6: 신규 마을 지붕에서 삐져나와 보이던 세로 선 패턴 제거.
  // 경사 지붕 내부에만 짧은 결을 넣어 테두리를 깨끗하게 유지한다.
  for (let y = 6; y < roofH - 7; y += 6) {
    const inset2 = Math.floor((roofH - 4 - y) * (W * 0.18) / Math.max(1, roofH - 4));
    const x0 = Math.max(inset2 + 4, 4), x1 = Math.min(W - inset2 - 4, W - 4);
    for (let x = x0; x < x1; x += 10) px(ctx, x, y, Math.min(4, x1 - x), 1, lightHex(s.roof, 0.10));
  }

  // 창문
  const winY = roofH + 4;
  for (let i = 0; i < wTiles; i++) {
    const wx = i * TILE + 4;
    if (i === doorCol) continue;
    px(ctx, wx, winY, 8, 8, '#3d5a80');
    px(ctx, wx + 1, winY + 1, 6, 3, '#7fb0e0');
    px(ctx, wx + 1, winY + 5, 6, 2, '#5b87b8');
  }

  // 문
  const dx = doorCol * TILE + 3;
  const dh = 14;
  px(ctx, dx, H - dh, 10, dh, '#5c3c22');
  px(ctx, dx + 1, H - dh + 1, 8, dh - 1, '#8a5c34');
  px(ctx, dx + 7, H - Math.floor(dh / 2), 1, 2, '#e8d060');
  px(ctx, dx - 1, H - dh - 2, 12, 2, s.wallDark);

  // 간판
  if (s.sign) {
    const sw = Math.min(W - 8, s.sign.length * 6 + 8);
    const sx = Math.floor((W - sw) / 2);
    px(ctx, sx, roofH + 1, sw, 9, '#2a2a38');
    ctx.fillStyle = '#f6f2e2';
    ctx.font = '7px monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(s.sign, Math.floor(W / 2), roofH + 6);
  }
  // 마을 테마 장식: 참고 이미지를 자른 것이 아니라 게임용 픽셀 도형을 직접 그린다.
  const accent = themeMods.accent || '#72ad4c';
  if (theme === 'rock') {
    px(ctx,3,Math.max(2,roofH-8),3,6,accent); px(ctx,W-6,Math.max(3,roofH-7),3,5,accent);
    px(ctx,4,Math.max(1,roofH-10),1,2,'#e5d6ff');
  } else if (theme === 'harbor') {
    px(ctx,1,roofH-2,W-2,2,'#d6b06f');
    for(let x=4;x<W-4;x+=8) px(ctx,x,H-5,4,1,'#8b6945');
  } else if (theme === 'snow') {
    px(ctx,2,0,W-4,3,'#f7fbff'); px(ctx,4,3,W-8,1,'#d9e9f7');
    px(ctx,W-7,roofH+3,3,4,accent);
  } else if (theme === 'thunder') {
    for(let x=4;x<W-4;x+=10){ px(ctx,x,roofH-1,5,1,accent); px(ctx,x+2,roofH-3,1,3,'#fff39a'); }
    px(ctx,2,H-6,2,4,'#8b6638'); px(ctx,W-4,H-6,2,4,'#8b6638');
  } else {
    px(ctx,2,H-5,2,2,accent); px(ctx,W-4,H-5,2,2,accent);
  }

  // v6.1 건물 디테일: 낮은 해상도에서도 재질이 읽히도록 픽셀 레이어를 분리한다.
  // 벽돌/목재 이음선
  for (let yy = roofH + 12; yy < H - 5; yy += 7) {
    for (let xx = 3 + ((yy/7)&1)*4; xx < W-4; xx += 9) px(ctx, xx, yy, 5, 1, theme === 'snow' ? '#d7e4ee' : theme === 'rock' ? '#aa9e8e' : '#c8b694');
  }
  // 지붕 하이라이트와 처마 그림자
  px(ctx,2,Math.max(2,roofH-6),W-4,1,theme === 'thunder' ? '#697893' : theme === 'snow' ? '#d9efff' : lightHex(s.roof, 0.22));
  px(ctx,1,roofH-1,W-2,2,'rgba(30,28,36,0.28)');
  // 스타일별 한눈에 읽히는 심볼
  const sx=Math.floor(W/2), sy=roofH+5;
  if (style === 'center') { px(ctx,sx-1,sy-2,3,7,'#f5f4ef'); px(ctx,sx-3,sy,7,3,'#f5f4ef'); }
  else if (style === 'shop') { px(ctx,sx-4,sy-2,8,5,'#f0d27a'); px(ctx,sx-2,sy-4,4,2,'#8a6338'); }
  else if (style === 'gym') {
    // 체육관 외관: 병원형 십자가를 완전히 배제하고, 큰 속성 문장 + GYM 간판 + 기둥으로 체육관 정체성을 고정한다.
    px(ctx,sx-13,sy-7,26,14,'#202331');
    px(ctx,sx-12,sy-6,24,12,accent);
    px(ctx,sx-11,sy-5,22,10,'#303748');
    const light='#fff3bd';
    if (theme === 'grass') { // 잎
      px(ctx,sx-1,sy-5,3,7,light); px(ctx,sx-5,sy-2,5,3,light); px(ctx,sx+1,sy-3,5,3,light); px(ctx,sx-3,sy+2,5,2,light);
    } else if (theme === 'rock') { // 결정
      px(ctx,sx,sy-5,1,8,light); px(ctx,sx-4,sy-2,9,2,light); px(ctx,sx-3,sy-4,7,7,'#efe2ff'); px(ctx,sx-1,sy-5,3,9,light);
    } else if (theme === 'harbor') { // 파도
      px(ctx,sx-7,sy-2,5,2,light); px(ctx,sx-2,sy-4,5,2,light); px(ctx,sx+3,sy-2,5,2,light); px(ctx,sx-6,sy+1,12,2,light); px(ctx,sx-4,sy+3,8,1,light);
    } else if (theme === 'snow') { // 눈꽃
      px(ctx,sx,sy-5,1,10,light); px(ctx,sx-5,sy,11,1,light); px(ctx,sx-4,sy-4,1,1,light); px(ctx,sx+4,sy+4,1,1,light); px(ctx,sx+4,sy-4,1,1,light); px(ctx,sx-4,sy+4,1,1,light);
    } else if (theme === 'astral') { // 별/공명
      px(ctx,sx,sy-5,1,10,light); px(ctx,sx-5,sy,11,1,light); px(ctx,sx-3,sy-3,7,7,'#d8c8ff');
      px(ctx,sx-1,sy-5,3,11,light); px(ctx,sx-5,sy-1,11,3,light);
    } else if (theme === 'aurora') { // 태양/여명
      px(ctx,sx-3,sy-3,7,7,light); px(ctx,sx-2,sy-2,5,5,'#ffd86a');
      px(ctx,sx,sy-6,1,2,light); px(ctx,sx,sy+5,1,2,light); px(ctx,sx-6,sy,2,1,light); px(ctx,sx+5,sy,2,1,light);
    } else { // 번개
      px(ctx,sx+1,sy-5,4,3,light); px(ctx,sx-1,sy-2,4,3,light); px(ctx,sx-3,sy+1,4,3,light); px(ctx,sx-4,sy+4,3,1,light);
    }
    // 입구 양옆 체육관 기둥/배너
    px(ctx,5,roofH+8,3,Math.max(4,H-roofH-16),'#41465a');
    px(ctx,W-8,roofH+8,3,Math.max(4,H-roofH-16),'#41465a');
    px(ctx,6,roofH+9,1,Math.max(3,H-roofH-18),accent);
    px(ctx,W-7,roofH+9,1,Math.max(3,H-roofH-18),accent);
    // 하단 픽셀 GYM 표기 (3x5 글리프)
    const gy=Math.min(H-8,sy+8), gx=sx-10, c=light;
    // G
    px(ctx,gx,gy,5,1,c); px(ctx,gx,gy+1,1,4,c); px(ctx,gx,gy+4,5,1,c); px(ctx,gx+3,gy+2,2,1,c); px(ctx,gx+4,gy+2,1,3,c);
    // Y
    px(ctx,gx+8,gy,1,2,c); px(ctx,gx+12,gy,1,2,c); px(ctx,gx+9,gy+2,3,1,c); px(ctx,gx+10,gy+3,1,2,c);
    // M
    px(ctx,gx+16,gy,1,5,c); px(ctx,gx+20,gy,1,5,c); px(ctx,gx+17,gy+1,1,1,c); px(ctx,gx+19,gy+1,1,1,c); px(ctx,gx+18,gy+2,1,1,c);
  }
  else if (style === 'lab') { px(ctx,sx-3,sy-3,6,6,'#7fb0e0'); px(ctx,sx-1,sy-5,2,3,'#d9f4ff'); }
  if (style === 'gym') addCanvasOutline(c, '#202331');
  return c;
}

// ------------------------------------------------------------
// 실내/야외 오브젝트
// ------------------------------------------------------------
const OBJECT_PAINTERS = {
  bed(ctx, W, H) {
    px(ctx, 1, 2, W - 2, H - 3, '#8a5c34');
    px(ctx, 2, 3, W - 4, H - 6, '#e8e4ec');
    px(ctx, 2, 3, W - 4, 8, '#f4f0f8');
    px(ctx, 3, 4, W - 6, 5, '#dfe4f2');
    px(ctx, 2, H - 8, W - 4, 5, '#5f86c8');
    px(ctx, 1, H - 3, W - 2, 3, '#6b4526');
  },
  desk(ctx, W, H) {
    px(ctx, 0, 3, W, H - 3, '#a3773f');
    px(ctx, 0, 3, W, 4, '#c39257');
    px(ctx, 3, 8, W - 6, H - 12, '#8a6338');
    px(ctx, 4, 0, W - 8, 5, '#dfe4f2');
    px(ctx, 5, 1, W - 10, 3, '#7fb0e0');
  },
  tv(ctx, W, H) {
    px(ctx, 1, 1, W - 2, H - 3, '#3a3a48');
    px(ctx, 3, 3, W - 6, H - 8, '#6fa8dc');
    px(ctx, 4, 4, W - 10, 3, '#c8e4f8');
    px(ctx, Math.floor(W / 2) - 3, H - 3, 6, 3, '#22202c');
  },
  shelf(ctx, W, H) {
    px(ctx, 0, 0, W, H, '#8a6338');
    px(ctx, 1, 1, W - 2, H - 2, '#a3773f');
    for (let y = 4; y < H - 1; y += 6) px(ctx, 1, y, W - 2, 1, '#6b4526');
    const cols = ['#c0453c', '#3f76c0', '#4aa06a', '#e0c060'];
    for (let x = 3; x < W - 3; x += 3) px(ctx, x, 2, 2, 5, cols[(x / 3 | 0) % 4]);
  },
  counter(ctx, W, H) {
    px(ctx, 0, 0, W, H, '#c85a44');
    px(ctx, 0, 0, W, 3, '#e8785c');
    px(ctx, 0, H - 3, W, 3, '#973c2c');
    for (let x = 4; x < W; x += 8) px(ctx, x, 4, 1, H - 7, '#a84634');
  },
  table(ctx, W, H) {
    px(ctx, 0, 0, W, H, '#b8b4c4');
    px(ctx, 0, 0, W, 3, '#d4d0dd');
    px(ctx, 0, H - 3, W, 3, '#8e8a9c');
  },
  machine(ctx, W, H) {
    px(ctx, 0, 0, W, H, '#5f6272');
    px(ctx, 1, 1, W - 2, H - 2, '#7d8193');
    px(ctx, 3, 3, W - 6, Math.floor(H / 2) - 2, '#4aa0d8');
    px(ctx, 4, 4, W - 10, 3, '#a8dcf4');
    px(ctx, 3, H - 6, 3, 3, '#e05a3c');
    px(ctx, W - 6, H - 6, 3, 3, '#e0c040');
  },
  sign(ctx, W, H) {
    px(ctx, Math.floor(W / 2) - 1, H - 6, 3, 6, '#7a5330');
    px(ctx, 1, 1, W - 2, H - 6, '#8a6338');
    px(ctx, 2, 2, W - 4, H - 9, '#c39257');
    px(ctx, 4, 4, W - 8, 1, '#8a6338');
    px(ctx, 4, 6, W - 9, 1, '#8a6338');
  },
  item(ctx, W, H) {
    const cx = Math.floor(W / 2), cy = Math.floor(H / 2) + 1;
    px(ctx, cx - 4, cy - 4, 8, 8, '#22202c');
    px(ctx, cx - 3, cy - 4, 6, 4, '#e0483c');
    px(ctx, cx - 3, cy, 6, 3, '#f0f0f4');
    px(ctx, cx - 3, cy - 1, 6, 1, '#22202c');
    px(ctx, cx - 1, cy - 1, 2, 2, '#c8c8d0');
    px(ctx, cx - 2, cy - 3, 2, 1, '#f08078');
  },
  legendary(ctx, W, H) {
    const cx = Math.floor(W / 2);
    px(ctx, cx - 6, H - 5, 12, 5, '#4a4458');
    px(ctx, cx - 5, H - 8, 10, 4, '#6a6280');
    px(ctx, cx - 3, H - 8, 6, 1, '#8880a0');
    px(ctx, cx - 3, 2, 6, 6, '#f8f0a0');
    px(ctx, cx - 2, 3, 4, 4, '#fffde0');
    px(ctx, cx - 1, 4, 2, 2, '#ffffff');
  },
  // 히든 성역 입구는 번쩍이는 포털 대신 지형에 섞인 작은 표식으로 보인다.
  secret_grass(ctx, W, H) {
    px(ctx, 2, 11, 12, 3, '#315f30');
    px(ctx, 4, 9, 8, 2, '#4f8a43');
    px(ctx, 5, 7, 2, 3, '#7fb85d'); px(ctx, 9, 7, 2, 3, '#7fb85d');
    px(ctx, 7, 10, 2, 2, '#203d24');
  },
  secret_fire(ctx, W, H) {
    px(ctx, 2, 9, 12, 3, '#55483b');
    px(ctx, 4, 7, 8, 2, '#6f5d49');
    px(ctx, 7, 6, 1, 5, '#d45a2b');
    px(ctx, 8, 8, 3, 1, '#e68236');
    px(ctx, 5, 10, 2, 1, '#d45a2b');
  },
  secret_water(ctx, W, H) {
    px(ctx, 2, 11, 12, 2, '#c4955c');
    px(ctx, 4, 9, 8, 2, '#e0b06f');
    px(ctx, 6, 8, 4, 1, '#79c8dc');
    px(ctx, 5, 10, 2, 1, '#79c8dc'); px(ctx, 9, 10, 2, 1, '#79c8dc');
  },
  secret_wind(ctx, W, H) {
    px(ctx, 3, 11, 10, 2, '#dbe6f4');
    px(ctx, 5, 9, 7, 1, '#b9c9de');
    px(ctx, 4, 7, 5, 1, '#a9bdd7');
    px(ctx, 8, 6, 4, 1, '#c8d8ea');
  },
  secret_thunder(ctx, W, H) {
    px(ctx,3,11,10,2,'#334044'); px(ctx,5,9,6,2,'#58656a');
    px(ctx,8,5,2,5,'#f1d64a'); px(ctx,6,7,5,1,'#f1d64a'); px(ctx,6,7,1,3,'#7be4ef');
    px(ctx,4,10,2,1,'#7be4ef');
  },

  // ------------------------------ 전설 성역 조형물
  statue_grass(ctx, W, H) {
    const cx=Math.floor(W/2);
    px(ctx,cx-6,H-5,12,5,'#35513b'); px(ctx,cx-5,H-8,10,3,'#58705a');
    px(ctx,cx-3,6,6,H-14,'#6e8170'); px(ctx,cx-5,5,4,8,'#6e8170'); px(ctx,cx+1,5,4,8,'#6e8170');
    px(ctx,cx-7,2,5,5,'#4d7350'); px(ctx,cx+2,2,5,5,'#4d7350');
    px(ctx,cx-1,1,2,6,'#9ac676'); px(ctx,cx-4,4,3,2,'#85b66a'); px(ctx,cx+1,4,3,2,'#85b66a');
  },
  statue_fire(ctx, W, H) {
    const cx=Math.floor(W/2);
    px(ctx,cx-6,H-5,12,5,'#392a28'); px(ctx,cx-5,H-8,10,3,'#5a4038');
    px(ctx,cx-3,7,6,H-15,'#75605a'); px(ctx,cx-5,5,4,5,'#75605a'); px(ctx,cx+1,5,4,5,'#75605a');
    px(ctx,cx-1,1,2,7,'#e8682e'); px(ctx,cx-4,4,3,4,'#b94222'); px(ctx,cx+1,4,3,4,'#b94222');
    px(ctx,cx-1,2,2,2,'#ffd05c');
  },
  statue_water(ctx, W, H) {
    const cx=Math.floor(W/2);
    px(ctx,cx-6,H-5,12,5,'#385b68'); px(ctx,cx-5,H-8,10,3,'#547b86');
    px(ctx,cx-3,7,6,H-15,'#6e9299');
    px(ctx,cx-7,5,5,3,'#6e9299'); px(ctx,cx+2,5,5,3,'#6e9299');
    px(ctx,cx-6,3,4,3,'#8bc2c9'); px(ctx,cx+2,3,4,3,'#8bc2c9');
    px(ctx,cx-1,1,2,7,'#c5f0ef'); px(ctx,cx-3,3,6,1,'#a5dfe0');
  },
  statue_wind(ctx, W, H) {
    const cx=Math.floor(W/2);
    px(ctx,cx-6,H-5,12,5,'#657c94'); px(ctx,cx-5,H-8,10,3,'#8399ad');
