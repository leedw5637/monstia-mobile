          party: [{ id: 20, level: 17 }, { id: 28, level: 16 }, { id: 19, level: 15 }],
          reward: 1200,
          before: ['동굴에서 만난 것도 인연이지.', '내 바위들을 뚫어 보게!'],
          lose: ['단단하기로는 자신 있었는데 말이야!'],
        },
      },
      { id:'cave_ace', name:'동굴탐사자', x:13, y:10, dir:'left', palette:'villagerA',
        lines:['동굴에서 단련하면 감각이 날카로워져. 나중에 다시 겨뤄도 좋아.'],
        trainer:{ rematch:true, rematchMinutes:5, rematchBonus:4, party:[{id:20,level:21},{id:29,level:22},{id:32,level:23}], reward:1800,
          before:['어두운 곳에선 한 번의 판단이 중요하지. 승부다!'], lose:['좋아, 더 단련해서 다시 붙자.'] } },
